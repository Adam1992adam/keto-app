---
// src/components/Sidebar.astro

interface Props {
  userName:   string;
  planType:   string;
  tierLabel:  string;   // accepted from pages; not used in template
  currentDay: number;
  avatarUrl?: string;
  activePage?: string;
}

const { userName, planType, currentDay, avatarUrl = '', activePage = '' } = Astro.props;

const isEmojiAvatar = avatarUrl.startsWith('emoji:');
const emojiChar     = isEmojiAvatar ? avatarUrl.replace('emoji:', '') : '';
const hasImageAvatar = !isEmojiAvatar && avatarUrl.length > 0;
const isElite  = planType === 'elite_12';
const initial  = (userName[0] || 'U').toUpperCase();
const tierMono = planType === 'elite_12' ? 'ELITE' : planType === 'pro_6' ? 'PRO' : 'BASIC';

const nav = [
  { href: '/dashboard',          id: 'dashboard', label: 'Today',    icon: '<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>' },
  { href: '/dashboard/food-log', id: 'food-log',  label: 'Meals',    icon: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 00-5 5v6c0 1.1.9 2 2 2h3zm0 0v7"/>' },
  { href: '/dashboard/fasting',  id: 'fasting',   label: 'Fasting',  icon: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>' },
  { href: '/dashboard/progress', id: 'progress',  label: 'Progress', icon: '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>' },
  { href: '/dashboard/recipes',  id: 'recipes',   label: 'Recipes',  icon: '<path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>' },
  { href: '/dashboard/habits',   id: 'habits',    label: 'Habits',   icon: '<polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>' },
  { href: '/dashboard/shopping', id: 'shopping',  label: 'Shopping', icon: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>' },
];

const activeMap: Record<string, string> = {
  'food-photo': 'food-photo', 'food-log': 'food-log',
  'recipe': 'recipes', 'recipes': 'recipes', 'favorites': 'recipes', 'collections': 'recipes',
  'meal-planner': 'recipes',
  'checkin': 'progress', 'photos': 'photos', 'ketones': 'ketones', 'steps': 'steps',
  'reflections': 'progress', 'share': 'share',
  'weekly': 'shopping', 'meal-prep': 'shopping',
  'billing': 'billing', 'notification-preferences': 'notification-preferences',
  'notifications': 'notifications',
  'community': 'community', 'guide': 'guide', 'learn': 'learn',
  'keto-calculator': 'keto-calculator',
  'referrals': 'referrals', 'export': 'export',
};
const activeId = activeMap[activePage] || activePage;
---

<!-- Apply saved theme before first paint (prevents flash) -->
<script is:inline>
(function () {
  try {
    var t = localStorage.getItem('keto-theme') || localStorage.getItem('rv-theme');
    if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
  } catch (e) {}
})();
</script>

<style is:global>
  /* ── Light mode: Rose Vital palette (single source for dashboard) ── */
  :root {
    --rv-bg:       #FAF6F1;
    --rv-bg-alt:   #F2EDE5;
    --rv-card:     #FFFFFF;
    --rv-card2:    #F7F3EE;
    --rv-line:     #E5DED2;
    --rv-ink:      #16110F;
    --rv-ink-soft: #4A4340;
    --rv-muted:    #8A8077;
    --rv-accent:   #FF5C7A;
    --rv-accent-2: #B6FF3C;
    --rv-accent-3: #FF914D;
    /* Legacy aliases */
    --bg:      #FAF6F1;
    --bg-alt:  #F2EDE5;
    --card:    #FFFFFF;
    --card2:   #F7F3EE;
    --border:  #E5DED2;
    --border2: rgba(255, 90, 122, .30);
    --text:    #16110F;
    --soft:    #4A4340;
    --muted:   #8A8077;
    --ink:     #16110F;
    --line:    #E5DED2;
    --accent:  #FF5C7A;
    --green:   #FF5C7A;
    --green2:  #B6FF3C;
    --gold:    #F59E0B;
    --blue:    #3B82F6;
    --red:     #EF4444;
    --purple:  #8B5CF6;
  }

  /* ── Dark mode: warm dark palette ──────────────────────────── */
  html[data-theme="dark"] {
    --rv-bg:       #0F0A08;
    --rv-bg-alt:   #1E1410;
    --rv-card:     #1A1210;
    --rv-card2:    #221814;
    --rv-line:     rgba(255, 90, 122, .13);
    --rv-ink:      #F2E8E0;
    --rv-ink-soft: #BCA090;
    --rv-muted:    #6A5248;
    --rv-accent:   #FF5C7A;
    --rv-accent-2: #B6FF3C;
    --rv-accent-3: #FF914D;
    /* Legacy aliases in dark mode */
    --bg:      #0F0A08;
    --bg-alt:  #1E1410;
    --card:    #1A1210;
    --card2:   #221814;
    --border:  rgba(255, 90, 122, .13);
    --border2: rgba(255, 90, 122, .26);
    --text:    #F2E8E0;
    --soft:    #BCA090;
    --muted:   #6A5248;
    --ink:     #F2E8E0;
    --line:    rgba(255, 90, 122, .13);
    --accent:  #FF5C7A;
    --green:   #FF5C7A;
    --green2:  #B6FF3C;
  }
  html { transition: background-color .2s; }

  /* ── Floating top-right action bar ─────────────────────────── */
  .rv-tbar {
    position: fixed; top: 14px; right: 18px; z-index: 300;
    display: flex; align-items: center; gap: 6px;
  }

  /* shared icon button style */
  .rv-tbar-btn {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--rv-card, #fff);
    border: 1px solid var(--rv-line, #E5DED2);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; position: relative;
    color: var(--rv-ink-soft, #4A4340);
    transition: border-color .15s, background .15s;
    text-decoration: none;
  }
  .rv-tbar-btn:hover { border-color: var(--rv-accent, #FF5C7A); background: var(--rv-bg-alt, #F2EDE5); }
  .rv-tbar-btn svg { width: 16px; height: 16px; pointer-events: none; }

  /* dark-mode pill inside the button */
  .rv-dm-pill {
    width: 34px; height: 18px; border-radius: 9px;
    background: var(--rv-line, #E5DED2);
    position: relative; transition: background .2s;
    border: none; cursor: pointer; flex-shrink: 0;
  }
  .rv-dm-pill.on { background: var(--rv-accent, #FF5C7A); }
  .rv-dm-pill::after {
    content: ''; position: absolute; top: 2px; left: 2px;
    width: 14px; height: 14px; border-radius: 50%; background: #fff;
    transition: transform .2s; box-shadow: 0 1px 2px rgba(0,0,0,.2);
  }
  .rv-dm-pill.on::after { transform: translateX(16px); }

  /* dark-mode button wrapper */
  .rv-tbar-dm {
    width: auto; padding: 0 10px; gap: 7px; min-width: 36px;
    display: flex; align-items: center;
  }
  .rv-dm-label {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .72rem; font-weight: 600; white-space: nowrap;
    color: var(--rv-ink-soft, #4A4340);
  }

  /* bell badge */
  .rv-tbar-badge {
    display: none; position: absolute; top: -5px; right: -5px;
    min-width: 16px; height: 16px; border-radius: 8px;
    background: var(--rv-accent, #FF5C7A); color: #fff;
    font-size: .58rem; font-weight: 700; padding: 0 3px;
    align-items: center; justify-content: center;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif; line-height: 1;
  }
  .rv-tbar-badge.visible { display: flex; }

  /* ── Notification dropdown ──────────────────────────────────── */
  .rv-notif-drop {
    display: none; position: absolute; top: calc(100% + 8px); right: 0;
    width: 340px; max-height: 480px; overflow-y: auto;
    background: var(--rv-card, #fff);
    border: 1px solid var(--rv-line, #E5DED2);
    border-radius: 14px; box-shadow: 0 8px 32px rgba(0,0,0,.12);
    z-index: 400;
  }
  .rv-notif-drop.open { display: block; }

  .rv-nd-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px 10px;
    border-bottom: 1px solid var(--rv-line, #E5DED2);
  }
  .rv-nd-title {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .88rem; font-weight: 700; color: var(--rv-ink, #16110F);
  }
  .rv-nd-see-all {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .72rem; font-weight: 600; color: var(--rv-accent, #FF5C7A);
    text-decoration: none;
  }
  .rv-nd-see-all:hover { text-decoration: underline; }

  .rv-nd-section {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .62rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
    color: var(--rv-muted, #8A8077); padding: 10px 16px 4px;
  }

  .rv-nd-item {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 10px 16px; transition: background .12s; cursor: default;
  }
  .rv-nd-item:hover { background: var(--rv-bg-alt, #F2EDE5); }
  .rv-nd-dot {
    width: 7px; height: 7px; border-radius: 50%; margin-top: 5px; flex-shrink: 0;
    background: var(--rv-accent, #FF5C7A);
  }
  .rv-nd-dot.read { background: var(--rv-line, #E5DED2); }
  .rv-nd-body { flex: 1; min-width: 0; }
  .rv-nd-lbl {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .8rem; font-weight: 600; color: var(--rv-ink, #16110F);
    line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .rv-nd-sub {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .72rem; color: var(--rv-ink-soft, #4A4340); line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .rv-nd-task {
    display: flex; align-items: center; gap: 8px;
    padding: 8px 16px; transition: background .12s;
  }
  .rv-nd-task:hover { background: var(--rv-bg-alt, #F2EDE5); }
  .rv-nd-task-ic {
    width: 22px; height: 22px; border-radius: 6px; flex-shrink: 0;
    background: rgba(255,90,122,.1); display: flex; align-items: center; justify-content: center;
    font-size: .72rem;
  }
  .rv-nd-task-nm {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .8rem; font-weight: 500; color: var(--rv-ink, #16110F);
    flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .rv-nd-task-xp {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .66rem; font-weight: 700; color: var(--rv-accent, #FF5C7A);
  }

  .rv-nd-empty {
    padding: 16px; text-align: center;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .78rem; color: var(--rv-muted, #8A8077);
  }
  .rv-nd-footer {
    border-top: 1px solid var(--rv-line, #E5DED2); padding: 10px 16px;
  }
  .rv-nd-dash-link {
    display: block; text-align: center; text-decoration: none;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .78rem; font-weight: 600;
    color: var(--rv-ink-soft, #4A4340); padding: 6px;
    border-radius: 8px; transition: background .12s;
  }
  .rv-nd-dash-link:hover { background: var(--rv-bg-alt, #F2EDE5); color: var(--rv-ink, #16110F); }

  @media (max-width: 900px) {
    .rv-tbar { top: auto; bottom: 72px; right: 12px; flex-direction: column-reverse; }
    .rv-notif-drop { right: 0; top: auto; bottom: calc(100% + 8px); }
    .rv-dm-label { display: none; }
    .rv-tbar-dm { padding: 0 8px; }
  }

  /* ── Reserve top-right space for floating bar (desktop) ─────── */
  @media (min-width: 901px) {
    .rv-pg-main { padding-top: 58px; }
  }
</style>

<style>
  /* ── Sidebar shell ─────────────────────────────────────────── */
  .rv-sb {
    width: 232px; position: sticky; top: 0; height: 100vh;
    background: var(--rv-card, #fff); border-right: 1px solid var(--rv-line, #E5DED2);
    display: flex; flex-direction: column; padding: 20px 14px;
    overflow-y: auto; gap: 4px; z-index: 50; flex-shrink: 0;
  }
  .rv-sb-logo {
    display: flex; align-items: center; gap: 10px;
    text-decoration: none; margin-bottom: 24px; padding: 0 4px; flex-shrink: 0;
  }
  .rv-logo-mark {
    width: 30px; height: 30px; border-radius: 7px; flex-shrink: 0;
    background: var(--rv-ink, #16110F);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-weight: 800; font-size: .92rem; color: var(--rv-accent-2, #B6FF3C);
  }
  .rv-logo-word { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-size: .74rem; font-weight: 500; letter-spacing: .07em; color: var(--rv-ink-soft, #4A4340); }
  .rv-logo-word strong { font-weight: 800; color: var(--rv-ink, #16110F); }

  .rv-sb-nav { display: flex; flex-direction: column; gap: 2px; }
  .rv-ni {
    display: flex; align-items: center; gap: 11px; padding: 9px 12px;
    border-radius: 10px; text-decoration: none;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .84rem; font-weight: 500; color: var(--rv-ink-soft, #4A4340); transition: all .15s;
  }
  .rv-ni:hover { background: var(--rv-bg-alt, #F2EDE5); color: var(--rv-ink, #16110F); }
  .rv-ni--active { background: var(--rv-ink, #16110F); color: var(--rv-bg, #FAF6F1) !important; }
  .rv-ni--active .rv-ni-ic { color: var(--rv-accent-2, #B6FF3C); }
  .rv-ni--elite .rv-ni-ic { color: var(--rv-accent, #FF5C7A); }
  .rv-ni-ic { width: 17px; height: 17px; flex-shrink: 0; }

  .rv-sb-section {
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .62rem; font-weight: 700; letter-spacing: .1em;
    color: var(--rv-muted, #8A8077); text-transform: uppercase; padding: 12px 12px 4px; margin-top: 4px;
  }

  .rv-sb-fill { flex: 1; min-height: 16px; }
  .rv-sb-user {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px;
    border-radius: 10px; text-decoration: none;
    border: 1px solid var(--rv-line, #E5DED2); transition: border-color .15s; flex-shrink: 0;
  }
  .rv-sb-user:hover { border-color: var(--rv-accent, #FF5C7A); }
  .rv-sb-avatar {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
    background: var(--rv-accent, #FF5C7A); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-weight: 700; font-size: .88rem;
  }
  .rv-sb-info { display: flex; flex-direction: column; min-width: 0; }
  .rv-sb-name { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-size: .82rem; font-weight: 600; color: var(--rv-ink, #16110F); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rv-sb-plan { font-size: .67rem; letter-spacing: .07em; color: var(--rv-muted, #8A8077); font-family: 'Geist Mono', monospace; margin-top: 1px; }

  .rv-mobnav {
    display: none; position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;
    background: var(--rv-card, #fff); border-top: 1px solid var(--rv-line, #E5DED2);
    padding: 6px 0 max(6px, env(safe-area-inset-bottom));
  }
  .rv-mobnav-inner { display: flex; justify-content: space-around; }
  .rv-mn {
    display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 4px 12px;
    text-decoration: none; font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .6rem; font-weight: 500; letter-spacing: .03em; color: var(--rv-ink-soft, #4A4340); transition: color .15s;
  }
  .rv-mn:hover, .rv-mn.active { color: var(--rv-accent, #FF5C7A); }
  .rv-mn-ic { width: 20px; height: 20px; }
  .rv-mn-more { background: none; border: none; cursor: pointer; }

  /* Mobile sheet */
  .rv-mob-sheet { position: fixed; inset: 0; z-index: 500; }
  .rv-mob-sheet-bg { position: absolute; inset: 0; background: rgba(22,17,15,.4); backdrop-filter: blur(4px); }
  .rv-mob-sheet-panel {
    position: absolute; bottom: 0; left: 0; right: 0;
    background: var(--rv-card, #fff); border-radius: 20px 20px 0 0;
    padding: 12px 16px max(20px, env(safe-area-inset-bottom));
    box-shadow: 0 -8px 32px rgba(0,0,0,.12);
    animation: sheetUp .22s ease-out;
  }
  @keyframes sheetUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .rv-mob-sheet-handle {
    width: 36px; height: 4px; border-radius: 2px;
    background: var(--rv-line, #E5DED2); margin: 0 auto 16px;
  }
  .rv-mob-sheet-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;
  }
  .rv-mob-tile {
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    padding: 12px 6px; border-radius: 12px; text-decoration: none;
    background: var(--rv-bg-alt, #F2EDE5);
    font-family: 'Bricolage Grotesque', system-ui, sans-serif;
    font-size: .65rem; font-weight: 600; color: var(--rv-ink-soft, #4A4340);
    transition: background .15s, color .15s;
  }
  .rv-mob-tile:hover, .rv-mob-tile:active { background: var(--rv-line, #E5DED2); color: var(--rv-ink, #16110F); }
  .rv-mob-tile svg { width: 22px; height: 22px; stroke: var(--rv-ink-soft, #4A4340); }
  .rv-mob-tile:hover svg, .rv-mob-tile:active svg { stroke: var(--rv-accent, #FF5C7A); }

  @media (max-width: 900px) {
    .rv-sb { display: none; }
    .rv-mobnav { display: block; }
  }
</style>

<!-- Desktop sidebar -->
<aside class="rv-sb">
  <a href="/dashboard" class="rv-sb-logo">
    <span class="rv-logo-mark">K</span>
    <span class="rv-logo-word">KETO<strong>JOURNEY</strong></span>
  </a>

  <nav class="rv-sb-nav">
    {nav.map(item => (
      <a href={item.href} class={`rv-ni${activeId === item.id ? ' rv-ni--active' : ''}`}>
        <svg class="rv-ni-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon}></svg>
        <span>{item.label}</span>
      </a>
    ))}
    <a href="/dashboard/profile" class={`rv-ni${activePage === 'profile' ? ' rv-ni--active' : ''}`}>
      <svg class="rv-ni-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      <span>Profile</span>
    </a>
  </nav>

  <div class="rv-sb-section">Discover</div>
  <nav class="rv-sb-nav">
    <a href="/dashboard/community" class={`rv-ni${activeId === 'community' ? ' rv-ni--active' : ''}`}>
      <svg class="rv-ni-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
      <span>Community</span>
    </a>
    <a href="/dashboard/guide" class={`rv-ni${activeId === 'guide' ? ' rv-ni--active' : ''}`}>
      <svg class="rv-ni-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span>Keto Guide</span>
    </a>
    <a href="/dashboard/referrals" class={`rv-ni${activeId === 'referrals' ? ' rv-ni--active' : ''}`}>
      <svg class="rv-ni-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z"/></svg>
      <span>Refer a Friend</span>
    </a>
  </nav>

  <div class="rv-sb-section">Tools</div>
  <nav class="rv-sb-nav">
    <a href="/dashboard/keto-calculator" class={`rv-ni${activeId === 'keto-calculator' ? ' rv-ni--active' : ''}`}>
