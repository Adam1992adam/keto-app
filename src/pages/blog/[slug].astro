---
import { createClient } from '@supabase/supabase-js';
import { marked } from 'marked';
marked.use({ gfm: true, breaks: false });

const supabaseUrl  = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const db = createClient(supabaseUrl, supabaseAnon);

const { slug } = Astro.params;
const SITE_URL  = (import.meta.env.PUBLIC_APP_URL || 'https://ketojourney.fun').replace(/\/$/, '');

const { data: post } = await db
  .from('blog_posts')
  .select('*')
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (!post) return Astro.redirect('/blog');

// Prevent Vercel Edge Cache from serving stale content after edits
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
Astro.response.headers.set('Pragma', 'no-cache');

// Related posts (same category, excluding current)
const { data: relatedRaw } = await db
  .from('blog_posts')
  .select('id, title, slug, excerpt, cover_image_url, category, read_time_min, published_at')
  .eq('published', true)
  .eq('category', post.category)
  .neq('id', post.id)
  .limit(3);
const related = relatedRaw || [];

const rawContent = (post.content || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n').trim();
const isHtml = rawContent.startsWith('<');
// If HTML paragraphs contain raw Markdown heading syntax (## / #), extract text and re-parse
const textOnly = isHtml
  ? rawContent
    .replace(/<br\s*\/?>/gi, '\n')
    .replace(/<\/p>/gi, '\n\n').replace(/<\/div>/gi, '\n\n')
    .replace(/<\/h[1-6]>/gi, '\n\n').replace(/<\/li>/gi, '\n')
    .replace(/<[^>]+>/g, '')
    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"')
    .replace(/\n{3,}/g, '\n\n').trim()
  : rawContent;
const needsReparse = isHtml && /^#{1,6} /m.test(textOnly);
const contentHtml = (!isHtml || needsReparse) ? await marked.parse(textOnly) : rawContent;

const pageTitle = post.seo_title || post.title;
const pageDesc  = post.seo_description || post.excerpt || '';
const ogImage   = post.cover_image_url || `${SITE_URL}/api/og?title=${encodeURIComponent(post.title || '')}&type=blog`;
const publishedDate = post.published_at ? new Date(post.published_at).toISOString() : '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{pageTitle} | KetoJourney Blog</title>
  <meta name="description" content={pageDesc}/>
  <link rel="canonical" href={`${SITE_URL}/blog/${post.slug}`}/>
  <meta property="og:type"        content="article"/>
  <meta property="og:title"       content={pageTitle}/>
  <meta property="og:description" content={pageDesc}/>
  <meta property="og:url"         content={`${SITE_URL}/blog/${post.slug}`}/>
  <meta property="og:image"       content={ogImage}/>
  <meta name="twitter:card"       content="summary_large_image"/>
  <meta name="twitter:title"      content={pageTitle}/>
  <meta name="twitter:description"content={pageDesc}/>
  <meta name="twitter:image"      content={ogImage}/>
  {publishedDate && <meta property="article:published_time" content={publishedDate}/>}
  <meta property="article:author" content={post.author_name}/>
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-72.png"/>
  <meta name="theme-color" content="#FF5C7A"/>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"Article",
    "headline": post.title,
    "description": pageDesc,
    "image": ogImage,
    "author":{"@type":"Person","name": post.author_name},
    "publisher":{"@type":"Organization","name":"KetoJourney","url":SITE_URL},
    "datePublished": publishedDate,
    "mainEntityOfPage": `${SITE_URL}/blog/${post.slug}`
  })}/>
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    a { color:inherit; text-decoration:none; }
    img { display:block; max-width:100%; }
    :root {
      --bg:#FAF6F1; --bg-alt:#F2EDE5; --ink:#16110F; --ink-soft:#4A4340;
      --muted:#8A8077; --line:#E5DED2; --accent:#FF5C7A; --accent-2:#B6FF3C;
      --card:#FFFFFF;
      --display:'Bricolage Grotesque',system-ui,sans-serif;
      --serif:'Instrument Serif',serif;
      --body:'Geist',system-ui,sans-serif;
    }
    body { font-family:var(--body); background:var(--bg); color:var(--ink); overflow-x:hidden; }

    /* NAV */
    .nav { position:sticky; top:0; z-index:100; background:rgba(250,246,241,.92); backdrop-filter:blur(12px); border-bottom:1px solid var(--line); padding:16px 32px; display:flex; align-items:center; justify-content:space-between; }
    .nav-logo { display:flex; align-items:center; gap:10px; }
    .nav-logo-mark { width:34px; height:34px; background:var(--ink); border-radius:8px; display:flex; align-items:center; justify-content:center; font-family:var(--display); font-weight:800; font-size:.9rem; color:var(--accent-2); }
    .nav-logo-text { font-family:var(--display); font-weight:800; font-size:1rem; }
    .nav-links { display:flex; align-items:center; gap:8px; }
    .nav-link { font-size:.85rem; font-weight:500; color:var(--ink-soft); padding:6px 12px; border-radius:8px; transition:all .15s; }
    .nav-link:hover { color:var(--ink); background:var(--bg-alt); }
    .nav-cta { background:var(--accent); color:#fff; padding:8px 18px; border-radius:999px; font-size:.85rem; font-weight:700; font-family:var(--display); transition:opacity .15s; }
    .nav-cta:hover { opacity:.88; }
    @media(max-width:640px){ .nav-links{display:none;} .nav{padding:14px 18px;} }

    /* LAYOUT */
    .page { max-width:1100px; margin:0 auto; padding:40px 32px 80px; display:grid; grid-template-columns:1fr 320px; gap:48px; align-items:start; }
    @media(max-width:900px){ .page{grid-template-columns:1fr; padding:32px 18px 64px;} .sidebar{display:none;} }

    /* ARTICLE */
    .article-header { margin-bottom:32px; }
    .article-breadcrumb { display:flex; align-items:center; gap:6px; font-size:.78rem; color:var(--muted); margin-bottom:20px; }
    .article-breadcrumb a { transition:color .15s; }
    .article-breadcrumb a:hover { color:var(--ink); }
    .article-cat { display:inline-block; font-size:.72rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); background:rgba(255,92,122,.08); border:1px solid rgba(255,92,122,.2); padding:4px 12px; border-radius:999px; margin-bottom:16px; }
    .article-title { font-family:var(--display); font-size:clamp(1.7rem,4vw,2.6rem); font-weight:800; line-height:1.15; color:var(--ink); margin-bottom:20px; }
    .article-meta { display:flex; align-items:center; gap:12px; font-size:.82rem; color:var(--muted); flex-wrap:wrap; margin-bottom:28px; }
    .article-meta-dot { width:3px; height:3px; border-radius:50%; background:var(--muted); }
    .article-cover { width:100%; border-radius:20px; aspect-ratio:16/9; object-fit:cover; margin-bottom:36px; }

    /* READING PROGRESS */
    .read-progress { position:fixed; top:0; left:0; width:0%; height:3px; background:linear-gradient(90deg,var(--accent),#ff8fa3); z-index:200; transition:width .1s linear; }

    /* PROSE */
    .prose { font-size:1.05rem; line-height:1.85; color:var(--ink-soft); max-width:720px; }
    .prose h1,.prose h2,.prose h3,.prose h4 { font-family:var(--display); color:var(--ink); line-height:1.2; }
    .prose h1 { font-size:2rem; font-weight:800; margin:2.5em 0 .7em; }
    .prose h2 {
      font-size:1.65rem; font-weight:800; margin:2.8em 0 .7em;
      padding-left:16px; border-left:4px solid var(--accent);
      color:var(--ink);
    }
    .prose h3 {
      font-size:1.4rem; font-weight:700; margin:2em 0 .55em;
      color:var(--accent); letter-spacing:-.01em;
    }
    .prose h4 { font-size:1.1rem; font-weight:700; margin:1.5em 0 .4em; color:var(--ink-soft); text-transform:uppercase; letter-spacing:.04em; }
    .prose > p:first-of-type { font-size:1.15rem; line-height:1.8; color:var(--ink); font-weight:400; }
    .prose p { margin:0 0 1.3em; }
    .prose ul,.prose ol { padding-left:1.6em; margin:0 0 1.4em; }
    .prose li { margin-bottom:.55em; }
    .prose li::marker { color:var(--accent); font-weight:700; }
    .prose strong { color:var(--ink); font-weight:700; }
    .prose em { font-family:var(--serif); font-style:italic; color:var(--ink); }
    .prose a { color:var(--accent); text-decoration:underline; text-underline-offset:3px; transition:opacity .15s; }
    .prose a:hover { opacity:.75; }
    .prose blockquote {
      border-left:4px solid var(--accent); padding:20px 24px;
      margin:2.2em 0; background:rgba(255,92,122,.05);
      border-radius:0 16px 16px 0;
    }
    .prose blockquote p { margin:0; color:var(--ink); font-family:var(--serif); font-style:italic; font-size:1.15em; line-height:1.65; }
    .prose code { background:var(--bg-alt); padding:2px 7px; border-radius:5px; font-size:.87em; color:var(--ink); border:1px solid var(--line); }
    .prose pre { background:var(--ink); color:var(--bg); padding:22px; border-radius:14px; overflow-x:auto; margin:1.8em 0; }
    .prose pre code { background:none; padding:0; color:inherit; border:none; }
    .prose hr { border:none; border-top:1px solid var(--line); margin:3em 0; }
    .prose img { border-radius:14px; margin:2em auto; box-shadow:0 8px 32px rgba(22,17,15,.1); }

    /* TABLE — magazine style */
    .prose table { width:100%; border-collapse:collapse; margin:2em 0; font-size:.92em; border-radius:14px; overflow:hidden; box-shadow:0 1px 0 var(--line); }
    .prose thead tr { background:var(--ink); }
    .prose th { padding:13px 16px; text-align:left; font-weight:700; color:#fff; font-size:.82rem; letter-spacing:.04em; text-transform:uppercase; white-space:nowrap; }
    .prose td { padding:12px 16px; border-bottom:1px solid var(--line); color:var(--ink-soft); }
    .prose tbody tr:nth-child(even) td { background:var(--bg-alt); }
    .prose tbody tr:hover td { background:rgba(255,92,122,.04); }
    .prose tbody tr:last-child td { border-bottom:none; }

    /* COVER PLACEHOLDER */
    .article-cover-ph { width:100%; border-radius:20px; aspect-ratio:16/9; margin-bottom:36px; background:linear-gradient(135deg,#f0ebe3 0%,#e5ddd3 50%,#f5f0ea 100%); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; }
    .article-cover-ph-icon { font-size:2.5rem; line-height:1; }
    .article-cover-ph-cat { font-size:.75rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }

    /* TAGS */
    .article-tags { display:flex; gap:8px; flex-wrap:wrap; margin-top:36px; padding-top:28px; border-top:1px solid var(--line); }
    .tag { padding:5px 14px; border-radius:999px; font-size:.78rem; font-weight:600; background:var(--bg-alt); color:var(--ink-soft); border:1px solid var(--line); }

    /* AUTHOR */
    .author-box { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:20px 24px; margin-top:32px; display:flex; align-items:center; gap:16px; }
    .author-avatar { width:48px; height:48px; border-radius:50%; background:linear-gradient(135deg,var(--accent),#ff8fa3); display:flex; align-items:center; justify-content:center; font-family:var(--display); font-weight:800; font-size:1.1rem; color:#fff; flex-shrink:0; }
    .author-name { font-weight:700; font-size:.95rem; color:var(--ink); }
    .author-label { font-size:.78rem; color:var(--muted); }

    /* SIDEBAR */
    .sidebar { display:flex; flex-direction:column; gap:24px; position:sticky; top:90px; }
    .sidebar-card { background:var(--card); border:1px solid var(--line); border-radius:20px; padding:24px; }
    .sidebar-card-title { font-family:var(--display); font-size:1rem; font-weight:800; color:var(--ink); margin-bottom:12px; }
    .sidebar-cta { background:linear-gradient(135deg,var(--ink) 0%,#2D1F1A 100%); color:#fff; }
    .sidebar-cta .sidebar-card-title { color:#fff; }
    .cta-eyebrow { font-size:.68rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--accent-2); margin-bottom:10px; }
    .cta-sub { font-size:.84rem; color:rgba(255,255,255,.65); line-height:1.55; margin-bottom:16px; }
    .cta-btn { display:block; text-align:center; padding:11px 20px; border-radius:999px; font-size:.85rem; font-weight:700; font-family:var(--display); transition:opacity .15s; margin-bottom:8px; }
    .cta-btn-primary { background:var(--accent); color:#fff; }
    .cta-btn-primary:hover { opacity:.88; }
    .cta-btn-outline { background:rgba(255,255,255,.1); color:#fff; border:1px solid rgba(255,255,255,.2); }
    .cta-btn-outline:hover { background:rgba(255,255,255,.18); }
    .toc-list { list-style:none; display:flex; flex-direction:column; gap:8px; }
    .toc-item a { font-size:.84rem; color:var(--ink-soft); transition:color .15s; display:block; padding:2px 0; border-left:2px solid transparent; padding-left:10px; }
    .toc-item a:hover { color:var(--accent); border-left-color:var(--accent); }

    /* TABLE OF CONTENTS — inline collapsible */
    .toc-wrap { margin-bottom:36px; }
    .toc-details { background:var(--card); border:1.5px solid var(--line); border-radius:18px; overflow:hidden; transition:border-color .2s, box-shadow .2s; }
    .toc-details[open] { border-color:rgba(255,92,122,.28); box-shadow:0 4px 24px rgba(255,92,122,.07); }
    .toc-summary { list-style:none; padding:14px 18px; display:flex; align-items:center; gap:10px; cursor:pointer; user-select:none; }
    .toc-summary::-webkit-details-marker { display:none; }
    .toc-sum-ic { width:30px; height:30px; border-radius:8px; background:rgba(255,92,122,.1); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .toc-sum-ic svg { width:14px; height:14px; stroke:var(--accent); }
    .toc-sum-title { font-family:var(--display); font-size:.9rem; font-weight:700; color:var(--ink); flex:1; }
    .toc-sum-count { font-size:.7rem; font-weight:700; color:var(--accent); background:rgba(255,92,122,.08); border:1px solid rgba(255,92,122,.18); border-radius:999px; padding:2px 10px; white-space:nowrap; }
    .toc-sum-arrow { width:16px; height:16px; stroke:var(--muted); transition:transform .22s ease; flex-shrink:0; }
    .toc-details[open] .toc-sum-arrow { transform:rotate(90deg); }
    .toc-body { border-top:1px solid var(--line); padding:10px 14px 14px; }
    .toc-ol { list-style:none; counter-reset:toc-h2; margin:0; padding:0; display:flex; flex-direction:column; gap:1px; }
    .toc-ol > li { counter-increment:toc-h2; }
    .toc-ol > li > a { display:flex; align-items:center; gap:10px; padding:7px 10px; border-radius:10px; font-size:.86rem; font-weight:500; color:var(--ink-soft); text-decoration:none; transition:all .15s; }
    .toc-ol > li > a:hover { background:rgba(255,92,122,.06); color:var(--accent); }
    .toc-ol > li > a.toc-active { color:var(--accent); background:rgba(255,92,122,.07); font-weight:600; }
    .toc-num { min-width:24px; height:24px; border-radius:7px; background:var(--bg-alt); border:1px solid var(--line); display:inline-flex; align-items:center; justify-content:center; font-size:.66rem; font-weight:700; color:var(--muted); flex-shrink:0; font-family:var(--display); transition:all .15s; }
    .toc-ol > li > a.toc-active .toc-num { background:rgba(255,92,122,.12); border-color:rgba(255,92,122,.22); color:var(--accent); }
    .toc-h3s { list-style:none; padding:2px 0 4px 34px; margin:0; display:flex; flex-direction:column; gap:1px; }
    .toc-h3s li a { display:flex; align-items:center; gap:7px; padding:5px 10px; border-radius:8px; font-size:.8rem; color:var(--muted); text-decoration:none; transition:all .15s; }
    .toc-h3s li a::before { content:''; width:5px; height:5px; border-radius:50%; background:var(--line); flex-shrink:0; transition:background .15s; }
    .toc-h3s li a:hover { color:var(--ink-soft); background:rgba(255,92,122,.04); }
    .toc-h3s li a:hover::before { background:var(--accent); }
    .toc-h3s li a.toc-active { color:var(--accent); font-weight:500; }
    .toc-h3s li a.toc-active::before { background:var(--accent); }

    /* LEAD CARD — dark download CTA (sidebar) */
    .lead-card { background:linear-gradient(135deg,#0d1a0f,#0a1a12); border:1.5px solid rgba(255,92,122,.3); border-radius:20px; padding:24px; }
    .lead-card-eyebrow { font-size:.68rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#B6FF3C; margin-bottom:8px; }
    .lead-card-title { font-size:1.05rem; font-weight:800; color:#dfeedd; font-family:var(--display); line-height:1.3; margin-bottom:8px; }
    .lead-card-sub { font-size:.82rem; color:rgba(255,255,255,.5); line-height:1.55; margin-bottom:14px; }
    .lead-perks { list-style:none; margin-bottom:16px; display:flex; flex-direction:column; gap:5px; }
    .lead-perks li { font-size:.78rem; color:rgba(255,255,255,.55); display:flex; align-items:center; gap:6px; }
    .lead-perks li::before { content:'✓'; color:#B6FF3C; font-weight:800; font-size:.75rem; }
    .lead-dl-btn { display:block; text-align:center; padding:11px 20px; border-radius:999px; background:linear-gradient(135deg,#FF5C7A,#ff8fa3); color:#fff; font-size:.88rem; font-weight:800; font-family:var(--display); transition:opacity .2s; }
    .lead-dl-btn:hover { opacity:.88; }
    .lead-note { font-size:.7rem; color:rgba(255,255,255,.28); text-align:center; margin-top:8px; }

    /* INLINE LEAD — mobile, below article */
    .inline-lead { background:linear-gradient(135deg,#f7fdf9,#eefaf3); border:1.5px solid rgba(255,92,122,.2); border-radius:20px; padding:28px 24px; margin:40px 0; }
    .inline-lead-title { font-family:var(--display); font-size:1.2rem; font-weight:800; color:#0a1a10; margin-bottom:6px; }
    .inline-lead-sub { font-size:.88rem; color:#3d6b4a; line-height:1.6; margin-bottom:16px; }
    .inline-lead-dl { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; background:#FF5C7A; border-radius:999px; color:#fff; font-size:.9rem; font-weight:800; font-family:var(--display); transition:opacity .2s; }
    .inline-lead-dl:hover { opacity:.88; }
    .inline-lead-note { font-size:.72rem; color:#8aab90; margin-top:10px; }
    @media(min-width:901px){ .inline-lead{ display:none; } }

    /* RELATED */
    .related { margin-top:56px; }
    .related-title { font-family:var(--display); font-size:1.3rem; font-weight:800; color:var(--ink); margin-bottom:24px; }
    .related-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:20px; }
    .related-card { background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; display:flex; flex-direction:column; transition:transform .2s, box-shadow .2s; }
    .related-card:hover { transform:translateY(-3px); box-shadow:0 12px 36px rgba(22,17,15,.07); }
    .related-img { width:100%; aspect-ratio:16/9; object-fit:cover; background:var(--bg-alt); }
    .related-img-ph { width:100%; aspect-ratio:16/9; background:linear-gradient(135deg,var(--bg-alt),var(--line)); display:flex; align-items:center; justify-content:center; font-size:1.8rem; }
    .related-body { padding:18px; }
    .related-cat { font-size:.68rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); margin-bottom:6px; }
    .related-title-text { font-family:var(--display); font-size:.98rem; font-weight:700; color:var(--ink); line-height:1.3; margin-bottom:6px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .related-meta { font-size:.75rem; color:var(--muted); }

    /* BOTTOM CTA */
    .bottom-cta { background:var(--ink); border-radius:24px; margin:40px 0 0; padding:44px 40px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .bottom-cta h2 { font-family:var(--display); font-size:1.5rem; font-weight:800; color:#fff; margin-bottom:8px; }
    .bottom-cta p { font-size:.88rem; color:rgba(255,255,255,.6); max-width:400px; line-height:1.6; }
    .bottom-cta-btns { display:flex; gap:10px; flex-shrink:0; flex-wrap:wrap; }
    .bcta-primary { background:var(--accent); color:#fff; padding:12px 24px; border-radius:999px; font-size:.88rem; font-weight:700; font-family:var(--display); transition:opacity .15s; white-space:nowrap; }
    .bcta-primary:hover { opacity:.88; }
    .bcta-ghost { background:rgba(255,255,255,.1); color:#fff; padding:12px 24px; border-radius:999px; font-size:.88rem; font-weight:600; border:1px solid rgba(255,255,255,.2); transition:background .15s; white-space:nowrap; }
    .bcta-ghost:hover { background:rgba(255,255,255,.18); }
    @media(max-width:640px){ .bottom-cta{flex-direction:column;padding:28px 22px;} }

    /* FOOTER */
    .footer { border-top:1px solid var(--line); padding:28px 32px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
    .footer-copy { font-size:.8rem; color:var(--muted); }
    .footer-links { display:flex; gap:20px; }
    .footer-links a { font-size:.8rem; color:var(--muted); transition:color .15s; }
    .footer-links a:hover { color:var(--ink); }
  </style>
</head>
<body>
<div class="read-progress" id="readProgress"></div>

<nav class="nav">
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">K</div>
    <span class="nav-logo-text">KetoJourney</span>
  </a>
  <div class="nav-links">
    <a href="/" class="nav-link">Home</a>
    <a href="/blog" class="nav-link">Blog</a>
    <a href="/recipes" class="nav-link">Recipes</a>
  </div>
  <a href="/start" class="nav-cta">Start Free Trial</a>
</nav>

<div class="page">

  <!-- ── Main article ── -->
  <main>
    <div class="article-header">
      <div class="article-breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog">Blog</a>
        <span>/</span>
        <span>{post.category}</span>
      </div>

      <span class="article-cat">{post.category}</span>
      <h1 class="article-title">{post.title}</h1>

      <div class="article-meta">
        <span>{post.author_name}</span>
        <span class="article-meta-dot"></span>
        <span>{post.read_time_min} min read</span>
        {post.published_at && (
          <>
            <span class="article-meta-dot"></span>
            <time datetime={post.published_at}>
              {new Date(post.published_at).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}
            </time>
          </>
        )}
      </div>

      {post.cover_image_url
        ? <img src={post.cover_image_url} alt={post.title} class="article-cover" loading="eager"/>
        : (
          <div class="article-cover-ph">
            <div class="article-cover-ph-icon">
              {post.category === 'Recipes' ? '🥗' : post.category === 'Science' ? '🔬' : post.category === 'Success Stories' ? '🏆' : post.category === 'Meal Prep' ? '🍱' : '📖'}
            </div>
            <div class="article-cover-ph-cat">{post.category}</div>
          </div>
        )
      }
    </div>

    <!-- Collapsible Table of Contents (SEO-friendly <nav>, hidden until headings found) -->
    <nav class="toc-wrap" aria-label="Table of contents" id="tocWrap" style="display:none">
      <details class="toc-details" id="tocDetails">
        <summary class="toc-summary">
          <span class="toc-sum-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
          </span>
          <span class="toc-sum-title">In this article</span>
          <span class="toc-sum-count" id="tocCount"></span>
          <svg class="toc-sum-arrow" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </summary>
        <div class="toc-body">
          <ol class="toc-ol" id="tocOl"></ol>
        </div>
      </details>
    </nav>

    <!-- Article body -->
    <article class="prose" set:html={contentHtml}/>

    <!-- Tags -->
    {post.tags && post.tags.length > 0 && (
      <div class="article-tags">
        {post.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
      </div>
    )}

    <!-- Author -->
    <div class="author-box">
      <div class="author-avatar">{post.author_name.charAt(0).toUpperCase()}</div>
      <div>
        <div class="author-name">{post.author_name}</div>
        <div class="author-label">KetoJourney Team</div>
      </div>
    </div>

    <!-- Inline lead capture (mobile only — sidebar hidden below 900px) -->
    <div class="inline-lead">
      <p style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#FF5C7A;margin-bottom:6px;">📖 Free Recipe Book</p>
      <div class="inline-lead-title">50+ keto smoothie &amp; snack recipes — download instantly</div>
      <p class="inline-lead-sub">Full macros included · Under 5g net carbs each · Prep tips included</p>
      <a href="/free-book" class="inline-lead-dl">Download Free Book →</a>
      <p class="inline-lead-note">No account needed · Instant download</p>
    </div>

    <!-- Bottom CTA -->
    <div class="bottom-cta">
      <div>
        <h2>Ready to start your keto journey?</h2>
        <p>Get a personalized keto plan, daily coaching, and expert recipes — all in one app.</p>
      </div>
      <div class="bottom-cta-btns">
        <a href="/start" class="bcta-primary">Start Free 7-Day Trial</a>
        <a href="/free-book" class="bcta-ghost">Get Free Guide</a>
      </div>
    </div>

    <!-- Related articles -->
    {related.length > 0 && (
      <div class="related">
        <h2 class="related-title">Keep reading</h2>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/blog/${r.slug}`} class="related-card">
              {r.cover_image_url
                ? <img src={r.cover_image_url} alt={r.title} class="related-img" loading="lazy"/>
                : <div class="related-img-ph">📝</div>
              }
              <div class="related-body">
                <div class="related-cat">{r.category}</div>
                <div class="related-title-text">{r.title}</div>
                <div class="related-meta">{r.read_time_min} min read</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </main>

  <!-- ── Sidebar ── -->
  <aside class="sidebar">

    <!-- Free book download card -->
    <div class="lead-card">
      <p class="lead-card-eyebrow">📖 Free Recipe Book</p>
      <div class="lead-card-title">50+ Keto Smoothie &amp; Snack Recipes — Free</div>
      <p class="lead-card-sub">Creamy smoothies &amp; satisfying snacks · Full macros · Under 5g net carbs each</p>
      <ul class="lead-perks">
        <li>50+ beginner-friendly recipes</li>
        <li>Full nutrition breakdown</li>
        <li>Ingredient swap guide included</li>
      </ul>
      <a href="/free-book" class="lead-dl-btn">Download Free →</a>
      <p class="lead-note">Instant download · No account needed</p>
    </div>

    <!-- CTA card -->
    <div class="sidebar-card sidebar-cta">
      <p class="cta-eyebrow">Free 7-Day Trial</p>
      <div class="sidebar-card-title">Start your keto transformation today</div>
      <p class="cta-sub">Personalized meal plans, daily coaching, and recipes tailored to your goals.</p>
      <a href="/start" class="cta-btn cta-btn-primary">Start Free Trial</a>
      <a href="/free-book" class="cta-btn cta-btn-outline">Get Free Recipe Book</a>
    </div>

    <!-- Share -->
    <div class="sidebar-card">
      <div class="sidebar-card-title">Share this article</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px">
        <a id="shareTwitter" href="#" target="_blank" rel="noopener" style="padding:8px 16px;border-radius:999px;background:var(--bg-alt);font-size:.8rem;font-weight:600;color:var(--ink-soft);border:1px solid var(--line);transition:all .15s" onmouseover="this.style.borderColor='#1DA1F2';this.style.color='#1DA1F2'" onmouseout="this.style.borderColor='var(--line)';this.style.color='var(--ink-soft)'">𝕏 Twitter</a>
        <a id="shareFacebook" href="#" target="_blank" rel="noopener" style="padding:8px 16px;border-radius:999px;background:var(--bg-alt);font-size:.8rem;font-weight:600;color:var(--ink-soft);border:1px solid var(--line);transition:all .15s" onmouseover="this.style.borderColor='#1877F2';this.style.color='#1877F2'" onmouseout="this.style.borderColor='var(--line)';this.style.color='var(--ink-soft)'">Facebook</a>
        <button id="copyLink" style="padding:8px 16px;border-radius:999px;background:var(--bg-alt);font-size:.8rem;font-weight:600;color:var(--ink-soft);border:1px solid var(--line);cursor:pointer;transition:all .15s" onmouseover="this.style.borderColor='var(--accent)';this.style.color='var(--accent)'" onmouseout="this.style.borderColor='var(--line)';this.style.color='var(--ink-soft)'">Copy link</button>
      </div>
    </div>

  </aside>
</div>

<footer class="footer">
  <span class="footer-copy">© {new Date().getFullYear()} KetoJourney. All rights reserved.</span>
  <div class="footer-links">
    <a href="/privacy-policy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href="/blog">Blog</a>
  </div>
</footer>

<script is:inline>
/* Reading progress bar */
(function() {
  var bar = document.getElementById('readProgress');
  if (!bar) return;
  function update() {
    var scrollTop = window.scrollY || document.documentElement.scrollTop;
    var docH = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = (docH > 0 ? Math.min(100, (scrollTop / docH) * 100) : 0) + '%';
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
})();

/* Table of Contents — numbered sections, slug IDs, scroll spy */
(function() {
  var prose  = document.querySelector('.prose');
  var wrap   = document.getElementById('tocWrap');
  var ol     = document.getElementById('tocOl');
  var countEl = document.getElementById('tocCount');
  if (!prose || !wrap || !ol) return;
  var headings = prose.querySelectorAll('h2, h3');
  if (headings.length < 2) return;

  /* Slug-based IDs for SEO-friendly anchor links */
  function slugify(text) {
    return (text || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80);
  }
  var usedIds = {};
  function uniqueId(base) {
    var id = base || 'section'; var n = 1;
    while (usedIds[id]) { id = base + '-' + (++n); }
    usedIds[id] = true; return id;
  }

  var allLinks = [];
  var currentLi = null;
  var currentH3ul = null;
  var h2Count = 0;

  headings.forEach(function(h) {
    var id = uniqueId(slugify(h.textContent));
    h.id = id;

    if (h.tagName === 'H2') {
      h2Count++;
      currentLi = document.createElement('li');

      var numSpan = document.createElement('span');
      numSpan.className = 'toc-num';
      numSpan.textContent = h2Count < 10 ? '0' + h2Count : String(h2Count);

      var a = document.createElement('a');
      a.href = '#' + id;
      a.appendChild(numSpan);
      a.appendChild(document.createTextNode(h.textContent));

      currentLi.appendChild(a);
      ol.appendChild(currentLi);
      currentH3ul = null;
      allLinks.push({ el: h, link: a });

    } else if (h.tagName === 'H3') {
      if (!currentH3ul) {
        currentH3ul = document.createElement('ul');
        currentH3ul.className = 'toc-h3s';
        if (currentLi) currentLi.appendChild(currentH3ul);
        else ol.appendChild(currentH3ul);
      }
      var li3 = document.createElement('li');
      var a3 = document.createElement('a');
      a3.href = '#' + id;
      a3.textContent = h.textContent;
      li3.appendChild(a3);
      currentH3ul.appendChild(li3);
      allLinks.push({ el: h, link: a3 });
    }
  });

  if (!h2Count) return;
  if (countEl) countEl.textContent = h2Count + (h2Count === 1 ? ' section' : ' sections');
  wrap.style.display = 'block';

  /* Scroll spy */
  function onScroll() {
    var scrollY = window.scrollY + 140;
    var active = null;
    for (var i = 0; i < allLinks.length; i++) {
      if (allLinks[i].el.getBoundingClientRect().top + window.scrollY <= scrollY) active = allLinks[i];
    }
    allLinks.forEach(function(item) { item.link.classList.remove('toc-active'); });
    if (active) active.link.classList.add('toc-active');
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();

/* Share links */
(function() {
  var url   = window.location.href;
  var title = document.title;
  var tw = document.getElementById('shareTwitter');
  var fb = document.getElementById('shareFacebook');
  var cp = document.getElementById('copyLink');
  if (tw) tw.href = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(title);
  if (fb) fb.href = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url);
  if (cp) cp.addEventListener('click', function() {
    navigator.clipboard.writeText(url).then(function() {
      cp.textContent = '✓ Copied!';
      setTimeout(function(){ cp.textContent = 'Copy link'; }, 2000);
    });
  });
})();

</script>
</body>
</html>
