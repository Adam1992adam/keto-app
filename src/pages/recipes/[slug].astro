<!-- RATING + COMMENTS SCRIPT -->
<script is:inline define:vars={{ recipeId: recipe.id, initAvg: ratingAvg, initCount: ratingCount }}>
(function () {
  /* ── STAR RATING ── */
  var selected = 0;
  var starsWrap  = document.getElementById('starsWrap');
  var rateRow    = document.getElementById('rateEmailRow');
  var rateEmail  = document.getElementById('rateEmail');
  var rateSubmit = document.getElementById('rateSubmit');
  var rateMsg    = document.getElementById('rateMsg');
  var starBtns   = starsWrap ? Array.from(starsWrap.querySelectorAll('.star-btn')) : [];

  function setHover(val) {
    starBtns.forEach(function (b) {
      var n = parseInt(b.dataset.val, 10);
      b.classList.toggle('hover', n <= val);
    });
  }
  function setSelected(val) {
    selected = val;
    starBtns.forEach(function (b) {
      var n = parseInt(b.dataset.val, 10);
      b.classList.toggle('active', n <= val);
      b.classList.remove('hover');
    });
    if (rateRow) rateRow.style.display = 'flex';
  }

  starBtns.forEach(function (b) {
    b.addEventListener('mouseenter', function () { setHover(parseInt(b.dataset.val, 10)); });
    b.addEventListener('mouseleave', function () { setHover(selected); });
    b.addEventListener('click',      function () { setSelected(parseInt(b.dataset.val, 10)); });
  });

  if (rateSubmit) rateSubmit.addEventListener('click', function () {
    var email = rateEmail ? rateEmail.value.trim() : '';
    if (!selected) { showRateMsg('Please select a star rating first.', false); return; }
    if (!email || !email.includes('@')) { showRateMsg('Please enter a valid email.', false); return; }

    rateSubmit.disabled    = true;
    rateSubmit.textContent = 'Saving…';

    fetch('/api/blog/rate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ recipe_id: recipeId, email: email, rating: selected })
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d.success) {
        showRateMsg('✓ Thanks for rating!', true);
        rateSubmit.textContent = 'Saved ✓';
        updateHeroRating(d.avg, d.count);
      } else {
        showRateMsg(d.error || 'Something went wrong.', false);
        rateSubmit.disabled    = false;
        rateSubmit.textContent = 'Submit →';
      }
    })
    .catch(function () {
      showRateMsg('Network error. Please try again.', false);
      rateSubmit.disabled    = false;
      rateSubmit.textContent = 'Submit →';
    });
  });

  function showRateMsg(text, ok) {
    if (!rateMsg) return;
    rateMsg.textContent = text;
    rateMsg.className   = 'rate-msg ' + (ok ? 'ok' : 'err');
  }

  function updateHeroRating(avg, count) {
    var row = document.querySelector('.rating-row');
    if (!row) {
      /* create it if didn't exist yet */
      var title = document.querySelector('.recipe-title');
      if (!title) return;
      row = document.createElement('div');
      row.className = 'rating-row';
      title.after(row);
    }
    var filled = Math.round(avg);
    var starsHtml = [1,2,3,4,5].map(function (n) {
      return '<span class="star-disp">' + (n <= filled ? '★' : '☆') + '</span>';
    }).join('');
    row.innerHTML = '<div class="rating-stars-disp">' + starsHtml + '</div>'
      + '<span class="rating-meta">' + avg + ' (' + count + ' ' + (count === 1 ? 'rating' : 'ratings') + ')</span>';
  }

  /* ── COMMENTS ── */
  var cfName   = document.getElementById('cfName');
  var cfEmail  = document.getElementById('cfEmail');
  var cfBody   = document.getElementById('cfBody');
  var cfSubmit = document.getElementById('cfSubmit');
  var cfMsg    = document.getElementById('cfMsg');
  var cfList   = document.getElementById('commentList');
  var cfCount  = document.getElementById('commentsCount');

  if (cfSubmit) cfSubmit.addEventListener('click', function () {
    var name  = cfName  ? cfName.value.trim()  : '';
    var email = cfEmail ? cfEmail.value.trim() : '';
    var body  = cfBody  ? cfBody.value.trim()  : '';

    if (!name)  { showCfMsg('Please enter your name.', false); return; }
    if (!email || !email.includes('@')) { showCfMsg('Please enter a valid email.', false); return; }
    if (body.length < 10) { showCfMsg('Comment must be at least 10 characters.', false); return; }

    cfSubmit.disabled    = true;
    cfSubmit.textContent = 'Posting…';
    cfMsg.className      = 'cf-msg';

    fetch('/api/blog/comment', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ recipe_id: recipeId, name: name, email: email, body: body })
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d.success) {
        showCfMsg('✓ Comment posted — thank you!', true);
        if (cfName)  cfName.value  = '';
        if (cfEmail) cfEmail.value = '';
        if (cfBody)  cfBody.value  = '';
        cfSubmit.textContent = 'Post Comment →';
        cfSubmit.disabled    = false;
        prependComment(d.comment);
      } else {
        showCfMsg(d.error || 'Something went wrong.', false);
        cfSubmit.disabled    = false;
        cfSubmit.textContent = 'Post Comment →';
      }
    })
    .catch(function () {
      showCfMsg('Network error. Please try again.', false);
      cfSubmit.disabled    = false;
      cfSubmit.textContent = 'Post Comment →';
    });
  });

  function showCfMsg(text, ok) {
    if (!cfMsg) return;
    cfMsg.textContent = text;
    cfMsg.className   = 'cf-msg ' + (ok ? 'ok' : 'err');
  }

  function prependComment(c) {
    if (!cfList) return;
    /* remove empty-state message if present */
    var empty = cfList.querySelector('.comment-empty');
    if (empty) empty.remove();

    var initial = c.name ? c.name.charAt(0).toUpperCase() : '?';
    var date    = new Date(c.created_at).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' });
    var card    = document.createElement('div');
    card.className = 'comment-card';
    card.innerHTML =
      '<div class="comment-header">'
      +  '<div class="comment-avatar">' + initial + '</div>'
      +  '<div class="comment-meta">'
      +    '<span class="comment-name">' + escHtml(c.name) + '</span>'
      +    '<span class="comment-date">' + date + '</span>'
      +  '</div>'
      + '</div>'
      + '<p class="comment-body">' + escHtml(c.body) + '</p>';
    cfList.insertBefore(card, cfList.firstChild);

    /* update count badge */
    if (cfCount) {
      var n = parseInt(cfCount.textContent, 10) || 0;
      cfCount.textContent = String(n + 1);
    }
  }

  function escHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
}());
</script>

<!-- LEAD CAPTURE FORMS SCRIPT -->
<script is:inline>
(function () {
  function submitLead(name, email, btnEl, msgEl, onSuccess) {
    btnEl.disabled    = true;
    btnEl.textContent = 'Sending…';
    fetch('/api/leads/collect', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name: name, email: email })
    })
    .then(function (r) { return r.json(); })
    .then(function (d) {
      if (d.success) {
        if (onSuccess) onSuccess();
        else window.location.href = '/free-book-success';
      } else {
        showMsg(msgEl, d.error || 'Something went wrong. Please try again.', false);
        btnEl.disabled    = false;
        btnEl.textContent = 'Download Free Book →';
      }
    })
    .catch(function () {
      showMsg(msgEl, 'Network error. Please try again.', false);
      btnEl.disabled    = false;
      btnEl.textContent = 'Download Free Book →';
    });
  }

  function showMsg(el, text, ok) {
    if (!el) return;
    el.textContent   = text;
    el.style.display = 'block';
    el.style.background   = ok ? 'rgba(182,255,60,.1)' : 'rgba(255,92,122,.1)';
    el.style.border       = ok ? '1px solid rgba(182,255,60,.25)' : '1px solid rgba(255,92,122,.25)';
    el.style.color        = ok ? '#B6FF3C' : '#ff8fa3';
    el.style.borderRadius = '8px';
    el.style.padding      = '9px 12px';
  }

  /* ── Mid-page form ── */
  var mlBtn   = document.getElementById('mlBtn');
  var mlName  = document.getElementById('mlName');
  var mlEmail = document.getElementById('mlEmail');
  var mlMsg   = document.getElementById('mlMsg');

  if (mlBtn) mlBtn.addEventListener('click', function () {
    var name  = mlName  ? mlName.value.trim()  : '';
    var email = mlEmail ? mlEmail.value.trim() : '';
    if (!email || !email.includes('@')) {
      showMsg(mlMsg, 'Please enter a valid email address.', false); return;
    }
    submitLead(name, email, mlBtn, mlMsg, function () {
      window.location.href = '/free-book-success';
    });
  });

  /* ── Mobile inline form ── */
  var ilBtn   = document.getElementById('ilBtn');
  var ilName  = document.getElementById('ilName');
  var ilEmail = document.getElementById('ilEmail');
  var ilMsg   = document.getElementById('ilMsg');

  if (ilBtn) ilBtn.addEventListener('click', function () {
    var name  = ilName  ? ilName.value.trim()  : '';
    var email = ilEmail ? ilEmail.value.trim() : '';
    if (!email || !email.includes('@')) {
      if (ilMsg) {
        ilMsg.textContent   = 'Please enter a valid email address.';
        ilMsg.style.display = 'block';
        ilMsg.style.background   = 'rgba(255,92,122,.1)';
        ilMsg.style.border       = '1px solid rgba(255,92,122,.25)';
        ilMsg.style.color        = '#dc2626';
        ilMsg.style.borderRadius = '8px';
        ilMsg.style.padding      = '9px 12px';
      }
      return;
    }
    submitLead(name, email, ilBtn, ilMsg, function () {
      window.location.href = '/free-book-success';
    });
  });
}());
</script>

