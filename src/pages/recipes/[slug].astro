    <ul class="exit-perks">
      <li>50+ smoothie &amp; snack recipes</li>
      <li>Under 5g net carbs per recipe</li>
      <li>Full nutrition breakdown included</li>
      <li>Perfect for keto beginners</li>
    </ul>
    <a href="/free-book" class="exit-cta">Get the Free Book →</a>
    <button class="exit-dismiss" id="exitDismiss">No thanks, I'll keep reading</button>
  </div>
</div>

<script is:inline>
(function () {
  var KEY = 'kj_exit_shown';
  if (sessionStorage.getItem(KEY)) return;

  var overlay  = document.getElementById('exitPopup');
  var btnClose = document.getElementById('exitClose');
  var btnSkip  = document.getElementById('exitDismiss');

  function openPopup() {
    if (!overlay) return;
    overlay.classList.add('open');
    sessionStorage.setItem(KEY, '1');
  }
  function closePopup() {
    if (overlay) overlay.classList.remove('open');
  }

  /* Desktop only — exit-intent fires when cursor leaves toward browser chrome */
  if (window.matchMedia('(pointer:fine)').matches) {
    var armed = false;
    setTimeout(function () { armed = true; }, 5000); /* arm after 5 s on page */
    document.addEventListener('mouseleave', function (e) {
      if (armed && e.clientY < 60) openPopup();
    });
  }

  if (btnClose) btnClose.addEventListener('click', closePopup);
  if (btnSkip)  btnSkip.addEventListener('click', closePopup);
  if (overlay)  overlay.addEventListener('click', function (e) {
    if (e.target === overlay) closePopup();
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closePopup();
  });
}());
</script>

