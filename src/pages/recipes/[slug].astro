---
import { createClient } from '@supabase/supabase-js';

const supabaseUrl  = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseAnon = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const db = createClient(supabaseUrl, supabaseAnon);

const { slug } = Astro.params;
const SITE_URL  = (import.meta.env.PUBLIC_APP_URL || 'https://ketojourney.fun').replace(/\/$/, '');

const { data: recipe } = await db
  .from('blog_recipes')
  .select('*')
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (!recipe) return Astro.redirect('/recipes');

// Related recipes (same difficulty, excluding current)
const { data: relatedRaw } = await db
  .from('blog_recipes')
  .select('id, title, slug, cover_image_url, difficulty, calories, net_carbs, prep_time, cook_time')
  .eq('published', true)
  .eq('difficulty', recipe.difficulty)
  .neq('id', recipe.id)
  .limit(3);
const related = relatedRaw || [];

// Related articles (recent blog posts, limit 3)
const { data: relatedArticlesRaw } = await db
  .from('blog_posts')
  .select('id, title, slug, excerpt, cover_image_url, category, read_time_min, published_at')
  .eq('published', true)
  .order('published_at', { ascending: false })
  .limit(3);
const relatedArticles = relatedArticlesRaw || [];

// Ratings aggregate
const { data: ratingsRaw } = await db
  .from('blog_recipe_ratings')
  .select('rating')
  .eq('recipe_id', recipe.id);
const ratingCount = ratingsRaw?.length || 0;
const ratingAvg   = ratingCount
  ? Math.round(ratingsRaw!.reduce((s, r) => s + r.rating, 0) / ratingCount * 10) / 10
  : 0;

// Comments (approved, newest first, limit 20)
const { data: commentsRaw } = await db
  .from('blog_recipe_comments')
  .select('id, name, body, created_at')
  .eq('recipe_id', recipe.id)
  .eq('approved', true)
  .order('created_at', { ascending: false })
  .limit(20);
const comments = commentsRaw || [];

// Parse ingredients and instructions (one per line)
const ingredients  = (recipe.ingredients || '').split('\n').map((l: string) => l.trim()).filter(Boolean);
const instructions = (recipe.instructions || '').split('\n').map((l: string) => l.trim()).filter(Boolean);
const totalTime    = (recipe.prep_time || 0) + (recipe.cook_time || 0);

const pageTitle = recipe.seo_title || recipe.title;
const pageDesc  = recipe.seo_description || recipe.description || '';
const ogImage   = recipe.cover_image_url || `${SITE_URL}/api/og?title=${encodeURIComponent(recipe.title || '')}&type=recipe`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{pageTitle} — Keto Recipe | KetoJourney</title>
  <meta name="description" content={pageDesc}/>
  <link rel="canonical" href={`${SITE_URL}/recipes/${recipe.slug}`}/>
  <meta property="og:type"        content="article"/>
  <meta property="og:title"       content={pageTitle}/>
  <meta property="og:description" content={pageDesc}/>
  <meta property="og:url"         content={`${SITE_URL}/recipes/${recipe.slug}`}/>
  <meta property="og:image"       content={ogImage}/>
  <meta name="twitter:card"       content="summary_large_image"/>
  <meta name="twitter:title"      content={pageTitle}/>
  <meta name="twitter:description"content={pageDesc}/>
  <meta name="twitter:image"      content={ogImage}/>
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-72.png"/>
  <meta name="theme-color" content="#FF5C7A"/>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"Recipe",
    "name": recipe.title,
    "description": pageDesc,
    "image": ogImage,
    "prepTime": `PT${recipe.prep_time || 0}M`,
    "cookTime": `PT${recipe.cook_time || 0}M`,
    "totalTime": `PT${totalTime}M`,
    "recipeYield": `${recipe.servings} servings`,
    "recipeCategory": "Keto",
    "keywords": recipe.tags?.join(', ') || 'keto, low-carb',
    "nutrition": {
      "@type":"NutritionInformation",
      "calories": `${recipe.calories} calories`,
      "carbohydrateContent": `${recipe.carbs}g`,
      "fiberContent": `${recipe.fiber}g`,
      "proteinContent": `${recipe.protein}g`,
      "fatContent": `${recipe.fat}g`
    },
    "recipeIngredient": ingredients,
    "recipeInstructions": instructions.map((step: string, i: number) => ({
      "@type":"HowToStep", "position": i+1, "text": step
    })),
    "author":{"@type":"Organization","name":"KetoJourney","url":SITE_URL},
    "publisher":{"@type":"Organization","name":"KetoJourney","url":SITE_URL}
  })}/>
  <style>
    *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    a { color:inherit; text-decoration:none; }
    img { display:block; max-width:100%; }
    :root {
      --bg:#FAF6F1; --bg-alt:#F2EDE5; --ink:#16110F; --ink-soft:#4A4340;
      --muted:#8A8077; --line:#E5DED2; --accent:#FF5C7A; --accent-2:#B6FF3C;
      --card:#FFFFFF;
      --display:'Bricolage Grotesque',system-ui,sans-serif;
      --serif:'Instrument Serif',serif;
      --body:'Geist',system-ui,sans-serif;
    }
    body { font-family:var(--body); background:var(--bg); color:var(--ink); overflow-x:hidden; }
    .nav { position:sticky; top:0; z-index:100; background:rgba(250,246,241,.92); backdrop-filter:blur(12px); border-bottom:1px solid var(--line); padding:16px 32px; display:flex; align-items:center; justify-content:space-between; }
    .nav-logo { display:flex; align-items:center; gap:10px; }
    .nav-logo-mark { width:34px; height:34px; background:var(--ink); border-radius:8px; display:flex; align-items:center; justify-content:center; font-family:var(--display); font-weight:800; font-size:.9rem; color:var(--accent-2); }
    .nav-logo-text { font-family:var(--display); font-weight:800; font-size:1rem; }
    .nav-links { display:flex; align-items:center; gap:8px; }
    .nav-link { font-size:.85rem; font-weight:500; color:var(--ink-soft); padding:6px 12px; border-radius:8px; transition:all .15s; }
    .nav-link:hover { color:var(--ink); background:var(--bg-alt); }
    .nav-cta { background:var(--accent); color:#fff; padding:8px 18px; border-radius:999px; font-size:.85rem; font-weight:700; font-family:var(--display); transition:opacity .15s; }
    .nav-cta:hover { opacity:.88; }
    @media(max-width:640px){ .nav-links{display:none;} .nav{padding:14px 18px;} }

    /* LAYOUT */
    .page { max-width:1100px; margin:0 auto; padding:40px 32px 80px; display:grid; grid-template-columns:1fr 300px; gap:48px; align-items:start; }
    @media(max-width:900px){ .page{grid-template-columns:1fr; padding:28px 18px 64px;} .sidebar{display:none;} }

    /* HERO */
    .recipe-hero { margin-bottom:32px; }
    .breadcrumb { display:flex; align-items:center; gap:6px; font-size:.78rem; color:var(--muted); margin-bottom:18px; }
    .breadcrumb a:hover { color:var(--ink); }
    .recipe-diff { display:inline-flex; padding:4px 12px; border-radius:999px; font-size:.72rem; font-weight:700; margin-bottom:14px; }
    .diff-easy { background:rgba(255,92,122,.1); color:#E0394F; }
    .diff-medium { background:rgba(245,158,11,.1); color:#d97706; }
    .diff-hard { background:rgba(239,68,68,.1); color:#dc2626; }
    .recipe-title { font-family:var(--display); font-size:clamp(1.7rem,4vw,2.6rem); font-weight:800; line-height:1.15; color:var(--ink); margin-bottom:14px; }
    .recipe-desc-text { font-size:1.05rem; color:var(--ink-soft); line-height:1.7; margin-bottom:24px; }
    .recipe-cover { width:100%; border-radius:20px; aspect-ratio:16/9; object-fit:cover; margin-bottom:0; }

    /* TIME + SERVINGS STRIP */
    .info-strip { display:flex; gap:0; background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; margin:28px 0; }
    .info-item { flex:1; padding:16px 12px; text-align:center; border-right:1px solid var(--line); }
    .info-item:last-child { border-right:none; }
    .info-icon { font-size:1.3rem; margin-bottom:5px; }
    .info-val { font-family:var(--display); font-size:1.1rem; font-weight:800; color:var(--ink); }
    .info-label { font-size:.7rem; color:var(--muted); text-transform:uppercase; letter-spacing:.06em; margin-top:2px; }

    /* SECTIONS */
    .section-head { margin-bottom:22px; }
    .section-label { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--accent); display:block; margin-bottom:6px; }
    .section-title { font-family:var(--display); font-size:1.45rem; font-weight:800; color:var(--ink); line-height:1.2; }
    .section-divider { height:1px; background:var(--line); margin-top:14px; }

    /* INGREDIENTS — editorial list */
    .ing-list { list-style:none; margin-bottom:44px; }
    .ing-item { display:flex; align-items:baseline; gap:14px; padding:13px 0; border-bottom:1px solid var(--line); font-size:.97rem; color:var(--ink-soft); line-height:1.55; }
    .ing-list .ing-item:first-child { border-top:1px solid var(--line); }
    .ing-dot { width:6px; height:6px; border-radius:50%; background:var(--accent); flex-shrink:0; position:relative; top:-1px; margin-top:8px; }

    /* INSTRUCTIONS — magazine style */
    .step-list { list-style:none; margin-bottom:44px; display:flex; flex-direction:column; gap:0; }
    .step-item { display:grid; grid-template-columns:64px 1fr; gap:0; align-items:start; padding:28px 0; border-bottom:1px solid var(--line); }
    .step-item:first-child { border-top:1px solid var(--line); }
    .step-n { font-family:var(--display); font-size:2.6rem; font-weight:800; color:rgba(255,92,122,.15); line-height:1; padding-top:2px; letter-spacing:-.04em; }
    .step-p { font-size:1rem; color:var(--ink-soft); line-height:1.82; padding-top:6px; }

    /* TAGS */
    .tags { display:flex; gap:8px; flex-wrap:wrap; margin-top:20px; }
    .tag { padding:5px 14px; border-radius:999px; font-size:.78rem; font-weight:600; background:var(--bg-alt); color:var(--ink-soft); border:1px solid var(--line); }

    /* SIDEBAR */
    .sidebar { display:flex; flex-direction:column; gap:20px; position:sticky; top:90px; }
    .sidebar-card { background:var(--card); border:1px solid var(--line); border-radius:20px; padding:22px; }
    .sidebar-title { font-family:var(--display); font-size:1rem; font-weight:800; color:var(--ink); margin-bottom:12px; }
    .sidebar-cta { background:linear-gradient(135deg,var(--ink) 0%,#2D1F1A 100%); color:#fff; }
    .sidebar-cta .sidebar-title { color:#fff; }
    .cta-eyebrow { font-size:.68rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--accent-2); margin-bottom:8px; }
    .cta-sub { font-size:.84rem; color:rgba(255,255,255,.65); line-height:1.55; margin-bottom:16px; }
    .cta-btn { display:block; text-align:center; padding:11px 20px; border-radius:999px; font-size:.85rem; font-weight:700; font-family:var(--display); margin-bottom:8px; transition:opacity .15s; }
    .cta-btn-primary { background:var(--accent); color:#fff; }
    .cta-btn-primary:hover { opacity:.88; }
    .cta-btn-outline { background:rgba(255,255,255,.1); color:#fff; border:1px solid rgba(255,255,255,.2); }
    .cta-btn-outline:hover { background:rgba(255,255,255,.18); }
    /* LEAD CAPTURE — download CTA */
    .lead-card { background:linear-gradient(135deg,#0d1a0f,#0a1a12); border:1.5px solid rgba(255,92,122,.3); border-radius:20px; padding:22px; }
    .lead-card-eyebrow { font-size:.68rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#B6FF3C; margin-bottom:8px; }
    .lead-card-title { font-size:1rem; font-weight:800; color:#dfeedd; font-family:var(--display); line-height:1.3; margin-bottom:8px; }
    .lead-card-sub { font-size:.8rem; color:rgba(255,255,255,.5); line-height:1.55; margin-bottom:16px; }
    .lead-perks { list-style:none; margin-bottom:16px; display:flex; flex-direction:column; gap:5px; }
    .lead-perks li { font-size:.78rem; color:rgba(255,255,255,.55); display:flex; align-items:center; gap:6px; }
    .lead-perks li::before { content:'✓'; color:#B6FF3C; font-weight:800; font-size:.75rem; }
    .lead-dl-btn { display:block; text-align:center; padding:11px 20px; border-radius:999px; background:linear-gradient(135deg,#FF5C7A,#ff8fa3); color:#fff; font-size:.88rem; font-weight:800; font-family:var(--display); transition:opacity .2s; text-decoration:none; }
    .lead-dl-btn:hover { opacity:.88; }
    .lead-note { font-size:.7rem; color:rgba(255,255,255,.28); text-align:center; margin-top:8px; }
    /* Inline lead (mobile) */
    .inline-lead { background:linear-gradient(135deg,#f7fdf9,#eefaf3); border:1.5px solid rgba(255,92,122,.2); border-radius:20px; padding:26px 22px; margin:36px 0; }
    .inline-lead-title { font-family:var(--display); font-size:1.15rem; font-weight:800; color:#0a1a10; margin-bottom:6px; }
    .inline-lead-sub { font-size:.86rem; color:#3d6b4a; line-height:1.6; margin-bottom:16px; }
    .inline-lead-dl { display:inline-flex; align-items:center; gap:8px; padding:12px 24px; background:#FF5C7A; border-radius:999px; color:#fff; font-size:.9rem; font-weight:800; font-family:var(--display); transition:opacity .2s; text-decoration:none; }
    .inline-lead-dl:hover { opacity:.88; }
    .inline-lead-note { font-size:.72rem; color:#8aab90; margin-top:10px; }
    @media(min-width:901px){ .inline-lead{ display:none; } }

    /* RELATED ARTICLES */
    .related-articles { margin-top:52px; padding-top:44px; border-top:1px solid var(--line); }
    .related-articles-title { font-family:var(--display); font-size:1.25rem; font-weight:800; color:var(--ink); margin-bottom:20px; }
    .art-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:18px; }
    .art-card { background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; display:flex; flex-direction:column; transition:transform .2s, box-shadow .2s; }
    .art-card:hover { transform:translateY(-3px); box-shadow:0 10px 30px rgba(22,17,15,.07); }
    .art-img { width:100%; aspect-ratio:16/9; object-fit:cover; background:var(--bg-alt); }
    .art-img-ph { width:100%; aspect-ratio:16/9; background:linear-gradient(135deg,var(--bg-alt),var(--line)); display:flex; align-items:center; justify-content:center; font-size:1.8rem; }
    .art-body { padding:16px; }
    .art-cat { font-size:.68rem; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:var(--accent); margin-bottom:5px; }
    .art-name { font-family:var(--display); font-size:.95rem; font-weight:700; color:var(--ink); line-height:1.35; margin-bottom:5px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .art-meta { font-size:.74rem; color:var(--muted); }

    /* RELATED */
    .related { margin-top:52px; }
    .related-title-h { font-family:var(--display); font-size:1.25rem; font-weight:800; color:var(--ink); margin-bottom:20px; }
    .related-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:18px; }
    .related-card { background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; display:flex; flex-direction:column; transition:transform .2s, box-shadow .2s; }
    .related-card:hover { transform:translateY(-3px); box-shadow:0 10px 30px rgba(22,17,15,.07); }
    .related-img { width:100%; aspect-ratio:4/3; object-fit:cover; background:var(--bg-alt); }
    .related-img-ph { width:100%; aspect-ratio:4/3; background:linear-gradient(135deg,var(--bg-alt),var(--line)); display:flex; align-items:center; justify-content:center; font-size:2rem; }
    .related-body { padding:16px; }
    .related-name { font-family:var(--display); font-size:.96rem; font-weight:700; color:var(--ink); line-height:1.3; margin-bottom:6px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .related-meta { font-size:.76rem; color:var(--muted); }

    /* BOTTOM CTA */
    .bottom-cta { background:var(--ink); border-radius:24px; margin:40px 0 0; padding:44px 40px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
    .bottom-cta h2 { font-family:var(--display); font-size:1.5rem; font-weight:800; color:#fff; margin-bottom:8px; }
    .bottom-cta p { font-size:.88rem; color:rgba(255,255,255,.6); max-width:400px; line-height:1.6; }
    .bottom-cta-btns { display:flex; gap:10px; flex-shrink:0; flex-wrap:wrap; }
    .bcta-p { background:var(--accent); color:#fff; padding:12px 24px; border-radius:999px; font-size:.88rem; font-weight:700; font-family:var(--display); white-space:nowrap; transition:opacity .15s; }
    .bcta-p:hover { opacity:.88; }
    .bcta-g { background:rgba(255,255,255,.1); color:#fff; padding:12px 24px; border-radius:999px; font-size:.88rem; font-weight:600; border:1px solid rgba(255,255,255,.2); white-space:nowrap; transition:background .15s; }
    .bcta-g:hover { background:rgba(255,255,255,.18); }
    @media(max-width:640px){ .bottom-cta{flex-direction:column;padding:28px 22px;} .nutrition-bar{grid-template-columns:repeat(2,1fr);} }

    .footer { border-top:1px solid var(--line); padding:28px 32px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
    .footer-copy { font-size:.8rem; color:var(--muted); }
    .footer-links { display:flex; gap:20px; }
    .footer-links a { font-size:.8rem; color:var(--muted); transition:color .15s; }
    .footer-links a:hover { color:var(--ink); }

    /* PRINT BUTTON */
    .recipe-actions { display:flex; gap:10px; margin:0 0 28px; }
    .print-btn { display:inline-flex; align-items:center; gap:6px; padding:8px 18px; border:1.5px solid var(--line); border-radius:999px; background:var(--card); color:var(--ink-soft); font-size:.8rem; font-weight:600; cursor:pointer; font-family:var(--body); transition:all .15s; }
    .print-btn:hover { border-color:var(--accent); color:var(--accent); background:rgba(255,92,122,.04); }

    /* NUTRITION CARD — full-width inline at end of recipe */
    .nutr-card { background:var(--card); border:1.5px solid var(--line); border-radius:22px; padding:28px 32px; margin:36px 0 0; }
    .nutr-card-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
    .nutr-card-title { font-family:var(--display); font-size:1.1rem; font-weight:800; color:var(--ink); }
    .nutr-card-serving { font-size:.75rem; color:var(--muted); background:var(--bg-alt); border:1px solid var(--line); border-radius:999px; padding:3px 12px; }
    .nutr-card-grid { display:grid; grid-template-columns:1fr 1fr; gap:0; }
    @media(min-width:600px){ .nutr-card-grid{ grid-template-columns:1fr 1fr 1fr; } }
    .nutr-card-row { display:flex; align-items:center; justify-content:space-between; padding:11px 0; border-bottom:1px solid var(--line); font-size:.9rem; }
    .nutr-card-row:last-child { border-bottom:none; }
    .nutr-card-col { display:flex; flex-direction:column; gap:1px; padding:0 16px 0 0; border-right:1px solid var(--line); }
    .nutr-card-col:last-child { border-right:none; }
    .nutr-card-col-label { font-size:.68rem; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; }
    .nutr-card-col-val { font-family:var(--display); font-size:1.35rem; font-weight:800; color:var(--ink); }
    .nutr-card-col-val span { font-size:.8rem; font-weight:500; color:var(--muted); }
    .nutr-card-col.accent .nutr-card-col-label { color:rgba(255,92,122,.7); }
    .nutr-card-col.accent .nutr-card-col-val { color:var(--accent); }
    .nutr-card-divider { height:1px; background:var(--line); margin:16px 0; }
    .nutr-card-detail { display:flex; flex-direction:column; gap:0; }
    .nutr-card-detail-row { display:flex; align-items:center; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--line); font-size:.87rem; }
    .nutr-card-detail-row:last-child { border-bottom:none; }
    .nutr-card-detail-row.sub { padding-left:16px; }
    .nutr-card-detail-row.sub .nutr-row-label { color:var(--muted); font-size:.82rem; }
    .nutr-card-detail-row .nutr-row-val { font-weight:700; color:var(--ink); }
    .nutr-card-detail-row .nutr-row-val.accent { color:var(--accent); font-weight:800; }

    /* MID-PAGE LEAD CAPTURE CARD */
    .mid-lead { background:linear-gradient(135deg,#1a0a10 0%,#0d0a1a 50%,#0a1a0f 100%); border:1.5px solid rgba(255,92,122,.35); border-radius:24px; padding:36px; margin:44px 0; display:grid; grid-template-columns:1fr 1fr; gap:36px; align-items:center; position:relative; overflow:hidden; }
    .mid-lead::before { content:''; position:absolute; top:-80px; right:-80px; width:220px; height:220px; border-radius:50%; background:radial-gradient(circle,rgba(255,92,122,.18),transparent 70%); pointer-events:none; }
    .mid-lead::after  { content:''; position:absolute; bottom:-60px; left:-60px; width:160px; height:160px; border-radius:50%; background:radial-gradient(circle,rgba(182,255,60,.1),transparent 70%); pointer-events:none; }
    @media(max-width:680px){ .mid-lead{grid-template-columns:1fr;padding:28px 22px;gap:24px;} }
    .ml-badge { display:inline-flex; align-items:center; gap:6px; background:rgba(255,92,122,.15); border:1px solid rgba(255,92,122,.3); border-radius:999px; padding:5px 13px; font-size:.7rem; font-weight:700; color:#FF5C7A; text-transform:uppercase; letter-spacing:.1em; margin-bottom:14px; }
    .ml-title { font-family:var(--display); font-size:1.3rem; font-weight:800; color:#fff; line-height:1.25; margin-bottom:10px; }
    .ml-sub { font-size:.85rem; color:rgba(255,255,255,.55); line-height:1.65; margin-bottom:16px; }
    .ml-perks { list-style:none; display:flex; flex-direction:column; gap:7px; }
    .ml-perks li { font-size:.82rem; color:rgba(255,255,255,.6); display:flex; align-items:center; gap:8px; }
    .ml-perks li::before { content:'✓'; color:#B6FF3C; font-weight:800; font-size:.75rem; flex-shrink:0; }
    .ml-form { display:flex; flex-direction:column; gap:10px; position:relative; z-index:1; }
    .ml-field { display:flex; flex-direction:column; gap:4px; }
    .ml-label { font-size:.74rem; font-weight:600; color:rgba(255,255,255,.5); }
    .ml-input { padding:12px 14px; background:rgba(255,255,255,.08); border:1.5px solid rgba(255,255,255,.15); border-radius:12px; color:#fff; font-size:.92rem; font-family:var(--body); outline:none; transition:border-color .2s; }
    .ml-input::placeholder { color:rgba(255,255,255,.3); }
    .ml-input:focus { border-color:#FF5C7A; background:rgba(255,255,255,.12); }
    .ml-btn { padding:14px 20px; background:linear-gradient(135deg,#FF5C7A,#ff3d60); border:none; border-radius:12px; color:#fff; font-size:.95rem; font-weight:800; font-family:var(--display); cursor:pointer; transition:opacity .2s,transform .15s; }
    .ml-btn:hover { opacity:.9; transform:translateY(-1px); }
    .ml-btn:disabled { opacity:.6; cursor:not-allowed; transform:none; }
    .ml-note { font-size:.7rem; color:rgba(255,255,255,.28); text-align:center; }
    .ml-msg { font-size:.83rem; font-weight:600; padding:9px 12px; border-radius:8px; display:none; }
    .ml-msg.ok  { display:block; background:rgba(182,255,60,.1); border:1px solid rgba(182,255,60,.25); color:#B6FF3C; }
    .ml-msg.err { display:block; background:rgba(255,92,122,.1); border:1px solid rgba(255,92,122,.25); color:#ff8fa3; }

    /* PRINT STYLES */
    @media print {
      .nav,.sidebar,.exit-overlay,.bottom-cta,.related,.related-articles,
      .inline-lead,.mid-lead,.rate-section,.comments-section,footer,
      .recipe-actions,.print-btn,.lead-card,.sidebar-cta { display:none !important; }
      .nutr-card { border:1px solid #ccc; border-radius:8px; }
      body { background:#fff; }
      .page { display:block; padding:0; max-width:100%; }
      .recipe-cover { max-height:280px; border-radius:8px; }
      .step-item, .ing-item { break-inside:avoid; }
      .nutrition-bar { break-inside:avoid; }
      .info-strip { break-inside:avoid; }
    }

    /* RATING DISPLAY (hero) */
    .rating-row { display:flex; align-items:center; gap:8px; margin-bottom:14px; }
    .rating-stars-disp { display:flex; gap:2px; }
    .star-disp { font-size:1rem; }
    .rating-meta { font-size:.82rem; color:var(--muted); }

    /* RATING WIDGET */
    .rate-section { background:var(--bg-alt); border:1px solid var(--line); border-radius:20px; padding:28px; margin:44px 0 8px; }
    .rate-title { font-family:var(--display); font-size:1.1rem; font-weight:800; color:var(--ink); margin-bottom:16px; }
    .stars-wrap { display:flex; gap:4px; margin-bottom:20px; cursor:pointer; width:fit-content; }
    .star-btn { font-size:2rem; color:var(--line); transition:color .1s, transform .1s; line-height:1; background:none; border:none; cursor:pointer; padding:0; }
    .star-btn.active, .star-btn.hover { color:#f59e0b; transform:scale(1.12); }
    .rate-email-row { display:flex; gap:10px; max-width:420px; }
    .rate-input { flex:1; padding:11px 14px; background:var(--card); border:1.5px solid var(--line); border-radius:10px; color:var(--ink); font-size:.9rem; font-family:var(--body); outline:none; transition:border-color .2s; }
    .rate-input:focus { border-color:var(--accent); }
    .rate-input::placeholder { color:var(--muted); }
    .rate-submit { padding:11px 20px; background:var(--accent); border:none; border-radius:10px; color:#fff; font-size:.88rem; font-weight:700; font-family:var(--display); cursor:pointer; white-space:nowrap; transition:opacity .2s; }
    .rate-submit:hover { opacity:.88; }
    .rate-submit:disabled { opacity:.6; cursor:not-allowed; }
    .rate-msg { margin-top:12px; font-size:.84rem; font-weight:600; }
    .rate-msg.ok  { color:#16a34a; }
    .rate-msg.err { color:#dc2626; }

    /* COMMENTS */
    .comments-section { margin:44px 0; }
    .comments-title { font-family:var(--display); font-size:1.25rem; font-weight:800; color:var(--ink); margin-bottom:24px; display:flex; align-items:center; gap:10px; }
    .comments-count-badge { font-size:.76rem; font-weight:700; background:var(--bg-alt); border:1px solid var(--line); border-radius:999px; padding:3px 10px; color:var(--muted); }
    .comment-list { display:flex; flex-direction:column; gap:16px; margin-bottom:36px; }
    .comment-card { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:18px 20px; }
    .comment-header { display:flex; align-items:center; gap:12px; margin-bottom:10px; }
    .comment-avatar { width:38px; height:38px; border-radius:50%; background:var(--accent); display:flex; align-items:center; justify-content:center; font-family:var(--display); font-weight:800; font-size:.92rem; color:#fff; flex-shrink:0; }
    .comment-meta { display:flex; flex-direction:column; gap:1px; }
    .comment-name { font-family:var(--display); font-size:.92rem; font-weight:700; color:var(--ink); }
    .comment-date { font-size:.74rem; color:var(--muted); }
    .comment-body { font-size:.91rem; color:var(--ink-soft); line-height:1.7; }
    .comment-empty { font-size:.9rem; color:var(--muted); font-style:italic; margin-bottom:32px; }

    /* COMMENT FORM */
    .comment-form { background:var(--card); border:1px solid var(--line); border-radius:20px; padding:24px; }
    .comment-form-title { font-family:var(--display); font-size:1rem; font-weight:700; color:var(--ink); margin-bottom:16px; }
    .cf-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px; }
    @media(max-width:500px){ .cf-row{grid-template-columns:1fr;} }
    .cf-field { display:flex; flex-direction:column; gap:5px; }
    .cf-label { font-size:.78rem; font-weight:600; color:var(--ink-soft); }
    .cf-input { padding:11px 13px; background:var(--bg-alt); border:1.5px solid var(--line); border-radius:10px; color:var(--ink); font-size:.9rem; font-family:var(--body); outline:none; transition:border-color .2s; }
    .cf-input:focus { border-color:var(--accent); background:var(--card); }
    .cf-input::placeholder { color:var(--muted); }
    .cf-textarea { width:100%; padding:12px 13px; background:var(--bg-alt); border:1.5px solid var(--line); border-radius:10px; color:var(--ink); font-size:.9rem; font-family:var(--body); outline:none; transition:border-color .2s; resize:vertical; min-height:110px; margin-bottom:12px; }
    .cf-textarea:focus { border-color:var(--accent); background:var(--card); }
    .cf-textarea::placeholder { color:var(--muted); }
    .cf-submit { padding:12px 24px; background:var(--accent); border:none; border-radius:10px; color:#fff; font-size:.9rem; font-weight:700; font-family:var(--display); cursor:pointer; transition:opacity .2s, transform .15s; }
    .cf-submit:hover { opacity:.88; transform:translateY(-1px); }
    .cf-submit:disabled { opacity:.6; cursor:not-allowed; transform:none; }
    .cf-msg { margin-top:12px; font-size:.84rem; font-weight:600; padding:10px 14px; border-radius:8px; display:none; }
    .cf-msg.ok  { display:block; background:rgba(22,163,74,.08); border:1px solid rgba(22,163,74,.2); color:#15803d; }
    .cf-msg.err { display:block; background:rgba(239,68,68,.07); border:1px solid rgba(239,68,68,.18); color:#dc2626; }

    /* EXIT-INTENT POPUP */
    .exit-overlay { position:fixed; inset:0; z-index:9999; background:rgba(22,17,15,.52); backdrop-filter:blur(5px); display:flex; align-items:center; justify-content:center; padding:20px; opacity:0; pointer-events:none; transition:opacity .3s ease; }
    .exit-overlay.open { opacity:1; pointer-events:all; }
    .exit-card { background:var(--card); border-radius:28px; max-width:460px; width:100%; padding:40px 36px 32px; position:relative; box-shadow:0 32px 80px rgba(22,17,15,.18); transform:translateY(20px) scale(.98); transition:transform .35s cubic-bezier(.22,1,.36,1); }
    .exit-overlay.open .exit-card { transform:translateY(0) scale(1); }
    .exit-close { position:absolute; top:16px; right:18px; background:none; border:none; font-size:1.6rem; color:var(--muted); cursor:pointer; line-height:1; padding:4px 8px; border-radius:8px; transition:color .15s,background .15s; font-family:var(--body); }
    .exit-close:hover { color:var(--ink); background:var(--bg-alt); }
    .exit-eyebrow { font-size:.67rem; font-weight:700; text-transform:uppercase; letter-spacing:.18em; color:var(--accent); margin-bottom:10px; }
    .exit-badge { display:inline-flex; align-items:center; gap:5px; background:rgba(255,92,122,.08); border:1px solid rgba(255,92,122,.2); border-radius:999px; padding:5px 13px; font-size:.76rem; font-weight:600; color:var(--accent); margin-bottom:16px; }
    .exit-title { font-family:var(--display); font-size:clamp(1.55rem,5vw,2rem); font-weight:800; color:var(--ink); line-height:1.18; margin-bottom:10px; }
    .exit-sub { font-size:.91rem; color:var(--ink-soft); line-height:1.68; margin-bottom:20px; }
    .exit-perks { list-style:none; display:flex; flex-direction:column; gap:8px; margin-bottom:26px; }
    .exit-perks li { font-size:.87rem; color:var(--ink-soft); display:flex; align-items:center; gap:10px; }
    .exit-perks li::before { content:'✓'; color:var(--accent); font-weight:800; font-size:.8rem; flex-shrink:0; }
    .exit-cta { display:block; text-align:center; padding:15px 28px; border-radius:999px; background:var(--accent); color:#fff; font-size:.95rem; font-weight:800; font-family:var(--display); transition:opacity .2s; margin-bottom:11px; }
    .exit-cta:hover { opacity:.88; }
    .exit-dismiss { display:block; width:100%; text-align:center; background:none; border:none; font-size:.82rem; color:var(--muted); cursor:pointer; padding:6px; font-family:var(--body); transition:color .15s; }
    .exit-dismiss:hover { color:var(--ink-soft); text-decoration:underline; }
    @media(max-width:480px){ .exit-card{padding:32px 22px 26px;} }
  </style>
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">K</div>
    <span class="nav-logo-text">KetoJourney</span>
  </a>
  <div class="nav-links">
    <a href="/" class="nav-link">Home</a>
    <a href="/blog" class="nav-link">Blog</a>
    <a href="/recipes" class="nav-link">Recipes</a>
  </div>
  <a href="/start" class="nav-cta">Start Free Trial</a>
</nav>

<div class="page">

  <!-- ── Main recipe ── -->
  <main>
    <div class="recipe-hero">
      <div class="breadcrumb">
        <a href="/">Home</a><span>/</span>
        <a href="/recipes">Recipes</a><span>/</span>
        <span>{recipe.title}</span>
      </div>

      <span class={`recipe-diff ${recipe.difficulty === 'Easy' ? 'diff-easy' : recipe.difficulty === 'Medium' ? 'diff-medium' : 'diff-hard'}`}>
        {recipe.difficulty}
      </span>
      <h1 class="recipe-title">{recipe.title}</h1>

      {ratingCount > 0 && (
        <div class="rating-row">
          <div class="rating-stars-disp">
            {[1,2,3,4,5].map(n => (
              <span class="star-disp">{n <= Math.round(ratingAvg) ? '★' : '☆'}</span>
            ))}
          </div>
          <span class="rating-meta">{ratingAvg} ({ratingCount} {ratingCount === 1 ? 'rating' : 'ratings'})</span>
        </div>
      )}
      {recipe.description && <p class="recipe-desc-text">{recipe.description}</p>}

      {recipe.cover_image_url && (
        <img src={recipe.cover_image_url} alt={recipe.title} class="recipe-cover" loading="eager"/>
      )}
    </div>

    <!-- Info strip -->
    <div class="info-strip">
      {recipe.prep_time > 0 && (
        <div class="info-item">
          <div class="info-icon">🔪</div>
          <div class="info-val">{recipe.prep_time} min</div>
          <div class="info-label">Prep</div>
        </div>
      )}
      {recipe.cook_time > 0 && (
        <div class="info-item">
          <div class="info-icon">🔥</div>
          <div class="info-val">{recipe.cook_time} min</div>
          <div class="info-label">Cook</div>
        </div>
      )}
      {totalTime > 0 && (
        <div class="info-item">
          <div class="info-icon">⏱</div>
          <div class="info-val">{totalTime} min</div>
          <div class="info-label">Total</div>
        </div>
      )}
      <div class="info-item">
        <div class="info-icon">👤</div>
        <div class="info-val">{recipe.servings}</div>
        <div class="info-label">Servings</div>
      </div>
    </div>

    <!-- Print button -->
    <div class="recipe-actions">
      <button class="print-btn" onclick="window.print()">🖨️ Print Recipe</button>
    </div>

    <!-- Ingredients -->
    {ingredients.length > 0 && (
      <>
        <div class="section-head">
          <span class="section-label">What you'll need</span>
          <div class="section-title">Ingredients <span style="font-size:.85rem;font-weight:500;color:var(--muted)">· {recipe.servings} serving{recipe.servings !== 1 ? 's' : ''}</span></div>
          <div class="section-divider"></div>
        </div>
        <ul class="ing-list">
          {ingredients.map((ing: string) => (
            <li class="ing-item">
              <span class="ing-dot"></span>
              <span>{ing}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <!-- Mid-page lead capture -->
    <div class="mid-lead">
      <div>
        <div class="ml-badge">📖 Free Recipe Book</div>
        <div class="ml-title">50+ Keto Smoothie &amp; Snack Recipes — Download Free</div>
        <p class="ml-sub">Creamy smoothies &amp; satisfying snacks. Full macros included, all under 5g net carbs.</p>
        <ul class="ml-perks">
          <li>50+ beginner-friendly recipes</li>
          <li>Full nutrition on every recipe</li>
          <li>Ingredient swap guide included</li>
        </ul>
      </div>
      <div class="ml-form" id="mlForm">
        <div class="ml-msg" id="mlMsg"></div>
        <div class="ml-field">
          <label class="ml-label" for="mlName">First Name</label>
          <input class="ml-input" type="text" id="mlName" placeholder="Jane" autocomplete="given-name"/>
        </div>
        <div class="ml-field">
          <label class="ml-label" for="mlEmail">Email Address</label>
          <input class="ml-input" type="email" id="mlEmail" placeholder="you@example.com" autocomplete="email"/>
        </div>
        <button class="ml-btn" id="mlBtn" type="button">Download Free Book →</button>
        <p class="ml-note">No spam, ever. Unsubscribe anytime.</p>
      </div>
    </div>

    <!-- Instructions -->
    {instructions.length > 0 && (
      <>
        <div class="section-head">
          <span class="section-label">How to make it</span>
          <div class="section-title">Instructions</div>
          <div class="section-divider"></div>
        </div>
        <ol class="step-list">
          {instructions.map((step: string, i: number) => (
            <li class="step-item">
              <div class="step-n">{String(i + 1).padStart(2, '0')}</div>
              <p class="step-p">{step}</p>
            </li>
          ))}
        </ol>
      </>
    )}

    <!-- Tags -->
    {recipe.tags && recipe.tags.length > 0 && (
      <div class="tags">
        {recipe.tags.map((tag: string) => <span class="tag">#{tag}</span>)}
      </div>
    )}

    <!-- Nutrition per serving — full-width card -->
    <div class="nutr-card">
      <div class="nutr-card-head">
        <span class="nutr-card-title">Nutrition per serving</span>
        <span class="nutr-card-serving">1 serving · {recipe.servings} total</span>
      </div>
      <div class="nutr-card-grid">
        <div class="nutr-card-col accent">
          <span class="nutr-card-col-label">Calories</span>
          <div class="nutr-card-col-val">{recipe.calories}<span> kcal</span></div>
        </div>
        <div class="nutr-card-col">
          <span class="nutr-card-col-label">Net Carbs</span>
          <div class="nutr-card-col-val">{recipe.net_carbs}<span>g</span></div>
        </div>
        <div class="nutr-card-col">
          <span class="nutr-card-col-label">Protein</span>
          <div class="nutr-card-col-val">{recipe.protein}<span>g</span></div>
        </div>
        <div class="nutr-card-col">
          <span class="nutr-card-col-label">Fat</span>
          <div class="nutr-card-col-val">{recipe.fat}<span>g</span></div>
        </div>
        <div class="nutr-card-col">
          <span class="nutr-card-col-label">Total Carbs</span>
          <div class="nutr-card-col-val">{recipe.carbs}<span>g</span></div>
        </div>
        <div class="nutr-card-col">
          <span class="nutr-card-col-label">Fiber</span>
          <div class="nutr-card-col-val">{recipe.fiber}<span>g</span></div>
        </div>
      </div>
    </div>

    <!-- ── RATE THIS RECIPE ── -->
    <div class="rate-section">
      <div class="rate-title">Rate this recipe</div>
      <div class="stars-wrap" id="starsWrap" role="group" aria-label="Star rating">
        {[1,2,3,4,5].map(n => (
          <button class="star-btn" data-val={n} aria-label={`${n} star`}>★</button>
        ))}
      </div>
      <div class="rate-email-row" id="rateEmailRow" style="display:none;">
        <input class="rate-input" type="email" id="rateEmail" placeholder="Your email (to save your rating)" autocomplete="email"/>
        <button class="rate-submit" id="rateSubmit">Submit →</button>
      </div>
      <div class="rate-msg" id="rateMsg"></div>
    </div>

    <!-- ── COMMENTS ── -->
    <div class="comments-section" id="comments">
      <div class="comments-title">
        Comments
        <span class="comments-count-badge" id="commentsCount">{comments.length}</span>
      </div>

      <div class="comment-list" id="commentList">
        {comments.length === 0 && (
          <p class="comment-empty">No comments yet — be the first to share your experience!</p>
        )}
        {comments.map(c => (
          <div class="comment-card">
            <div class="comment-header">
              <div class="comment-avatar">{c.name.charAt(0).toUpperCase()}</div>
              <div class="comment-meta">
                <span class="comment-name">{c.name}</span>
                <span class="comment-date">{new Date(c.created_at).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' })}</span>
              </div>
            </div>
            <p class="comment-body">{c.body}</p>
          </div>
        ))}
      </div>

      <!-- Comment form -->
      <div class="comment-form">
        <div class="comment-form-title">Leave a comment</div>
        <div class="cf-row">
          <div class="cf-field">
            <label class="cf-label" for="cfName">Your Name *</label>
            <input class="cf-input" type="text" id="cfName" placeholder="Jane Smith" autocomplete="given-name"/>
          </div>
          <div class="cf-field">
            <label class="cf-label" for="cfEmail">Email Address *</label>
            <input class="cf-input" type="email" id="cfEmail" placeholder="you@example.com" autocomplete="email"/>
          </div>
        </div>
        <textarea class="cf-textarea" id="cfBody" placeholder="Share your experience with this recipe — tips, swaps, how it turned out…"></textarea>
        <button class="cf-submit" id="cfSubmit" type="button">Post Comment →</button>
        <div class="cf-msg" id="cfMsg"></div>
      </div>
    </div>

    <!-- Inline lead capture (mobile only) -->
    <div class="inline-lead">
      <p style="font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#FF5C7A;margin-bottom:6px;">📖 Free Recipe Book</p>
      <div class="inline-lead-title">50+ keto smoothie &amp; snack recipes — download free</div>
      <p class="inline-lead-sub">Creamy smoothies &amp; satisfying snacks · Full macros · Under 5g net carbs each</p>
      <div id="ilMsg" style="display:none;font-size:.8rem;font-weight:600;padding:8px 12px;border-radius:8px;margin-bottom:10px;"></div>
      <input class="cf-input" type="text" id="ilName" placeholder="First name" autocomplete="given-name" style="margin-bottom:8px;width:100%;background:#fff;"/>
      <input class="cf-input" type="email" id="ilEmail" placeholder="your@email.com" autocomplete="email" style="margin-bottom:12px;width:100%;background:#fff;"/>
      <button id="ilBtn" class="inline-lead-dl" type="button" style="width:100%;justify-content:center;">Download Free Book →</button>
      <p class="inline-lead-note">No spam, ever. Unsubscribe anytime.</p>
    </div>

    <!-- Bottom CTA -->
    <div class="bottom-cta">
      <div>
        <h2>Want 500+ more keto recipes?</h2>
        <p>Access the full recipe library, personalized meal plans, and progress tracking — free for 7 days.</p>
      </div>
      <div class="bottom-cta-btns">
        <a href="/start" class="bcta-p">Start Free Trial</a>
        <a href="/recipes" class="bcta-g">More Recipes</a>
      </div>
    </div>

    <!-- Related -->
    {related.length > 0 && (
      <div class="related">
        <h2 class="related-title-h">You might also like</h2>
        <div class="related-grid">
          {related.map(r => (
            <a href={`/recipes/${r.slug}`} class="related-card">
              {r.cover_image_url
                ? <img src={r.cover_image_url} alt={r.title} class="related-img" loading="lazy"/>
                : <div class="related-img-ph">🥘</div>
              }
              <div class="related-body">
                <div class="related-name">{r.title}</div>
                <div class="related-meta">{(r.prep_time||0)+(r.cook_time||0)} min · {r.calories} kcal</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
    <!-- Related articles -->
