<div id="exitPopup" class="exit-overlay" role="dialog" aria-modal="true" aria-label="Free Recipe Book offer">
  <div class="exit-card">
    <button class="exit-close" id="exitClose" aria-label="Close">×</button>
    <p class="exit-eyebrow">Wait — before you go</p>
