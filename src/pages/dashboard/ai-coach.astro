---
// src/pages/dashboard/ai-coach.astro â€” AI Coach (Rose Vital editorial design)
import { getUserJourney, getMealCycleDays } from '../../lib/supabase';
import { requireAuth } from '../../lib/auth';
import Sidebar from '../../components/Sidebar.astro';
import { getTranslator, normaliseLang } from '../../lib/i18n';

const auth = await requireAuth(Astro);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { user, profile, db } = auth;

if (profile.subscription_tier !== 'elite_12') return Astro.redirect('/dashboard/upgrade');

const planType  = profile.subscription_tier;
const tierLabel = 'Elite';
const userName  = profile.full_name?.split(' ')[0] || 'there';
const fullName  = profile.full_name || userName;
const lang = normaliseLang(Astro.cookies.get('keto-lang')?.value);
const t    = getTranslator(lang);
const today    = new Date().toISOString().split('T')[0];
const nowHour  = new Date().getHours();

const journey    = await getUserJourney(user.id, db);
const currentDay = journey?.current_day || 1;
const streak     = journey?.streak_days || 0;
const totalXp    = journey?.total_xp || 0;
const level      = journey?.level || 1;
const weekNum    = Math.ceil(currentDay / 7);
const cycledDay  = ((currentDay - 1) % getMealCycleDays(planType)) + 1;

const results = await Promise.all([
  db.from('onboarding_data').select('current_weight,target_weight,dietary_restrictions,fasting_protocol').eq('user_id', user.id).maybeSingle(),
  db.from('daily_checkins').select('energy_level,water_glasses,had_headache,had_fatigue').eq('user_id', user.id).eq('checkin_date', today).maybeSingle(),
  db.from('daily_tasks').select('task_title,completed').eq('user_id', user.id).eq('day_number', currentDay),
  db.from('weight_logs').select('weight,logged_date').eq('user_id', user.id).order('logged_date', { ascending: false }).limit(3),
  db.from('fasting_sessions').select('started_at,target_hours').eq('user_id', user.id).is('ended_at', null).order('started_at', { ascending: false }).limit(1).maybeSingle(),
  db.from('macro_goals').select('daily_calories,protein_g,fat_g,carbs_g').eq('user_id', user.id).maybeSingle(),
  db.from('meal_completions').select('meal_type').eq('user_id', user.id).eq('day_number', currentDay),
  db.from('chat_messages').select('role,content,created_at').eq('user_id', user.id).order('created_at', { ascending: false }).limit(40),
]);

const onboarding    = results[0].data;
const todayCheckin  = results[1].data;
const todayTasks    = results[2].data || [];
const weightLogs    = results[3].data || [];
const activeFast    = results[4].data;
const macroGoals    = results[5].data;
const mealComps     = results[6].data || [];
const chatHistory   = (results[7].data || []).reverse();

const { data: mealPlanDirect } = await db.from('meal_plans').select('meal_type, recipe:recipes(id,title,calories,protein,fat,net_carbs)').eq('plan_type', planType).eq('day_number', cycledDay).order('meal_type');
const { data: mealPlanFallback } = mealPlanDirect?.length ? { data: null } : await db.from('meal_plans').select('meal_type, recipe:recipes(id,title,calories,protein,fat,net_carbs)').eq('plan_type', 'basic_30').eq('day_number', cycledDay).order('meal_type');
const mealPlan = (mealPlanDirect?.length ? mealPlanDirect : mealPlanFallback) || [];

const historyByDate = chatHistory.reduce((acc, msg) => {
  const d = new Date((msg as any).created_at).toISOString().split('T')[0];
  if (!acc[d]) acc[d] = { date: d, msgs: [] };
  acc[d].msgs.push(msg);
  return acc;
}, {} as Record<string, { date: string; msgs: any[] }>);
const historyDates = Object.values(historyByDate).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);

const startWeight   = onboarding?.current_weight || 0;
const goalWeight    = onboarding?.target_weight  || 0;
const latestWeight  = weightLogs[0]?.weight || startWeight;
const weightLost    = Math.max(0, startWeight - latestWeight);
const toGoal        = Math.max(0.1, startWeight - goalWeight);
const goalPct       = Math.min(100, Math.round((weightLost / toGoal) * 100));
const completedTasksCount = todayTasks.filter((t) => t.completed).length;
const eatenCount    = mealComps.length;
const totalMeals    = mealPlan.length || 4;
const fastingActive = !!activeFast;
const fastHours     = activeFast ? Math.floor((Date.now() - new Date(activeFast.started_at).getTime()) / 3600000) : 0;
const fastMins      = activeFast ? Math.floor(((Date.now() - new Date(activeFast.started_at).getTime()) / 60000) % 60) : 0;
const waterCount    = (todayCheckin as any)?.water_glasses || 0;

const eatenSet = new Set(mealComps.map((c) => (c as any).meal_type));
const consumed = mealPlan.filter((m) => eatenSet.has((m as any).meal_type) && (m as any).recipe)
  .reduce((acc, m) => {
    const r = (m as any).recipe;
    return { cal: acc.cal + (r.calories||0), prot: acc.prot + parseFloat(r.protein||0), fat: acc.fat + parseFloat(r.fat||0), carbs: acc.carbs + parseFloat(r.net_carbs||0) };
  }, { cal: 0, prot: 0, fat: 0, carbs: 0 });

const calPct   = macroGoals?.daily_calories ? Math.min(100, Math.round((consumed.cal / macroGoals.daily_calories) * 100)) : 0;
const fatPctOfCal = consumed.cal > 0 ? Math.min(100, Math.round((consumed.fat * 9 / consumed.cal) * 100)) : 0;

const restrictionsList = Array.isArray(onboarding?.dietary_restrictions) ? (onboarding!.dietary_restrictions as string[]) : [];

// Pre-computed booleans
const showLowWater  = !!todayCheckin && waterCount < 4;
const showBreakfast = nowHour < 11;
const showLunch     = nowHour >= 11 && nowHour < 15;
const showSnack     = nowHour >= 15 && nowHour < 19;
const showDinner    = nowHour >= 19;
const hasWeightGain = weightLogs.length > 1 && weightLogs[0].weight > weightLogs[1].weight;
const showNoCheckin = !todayCheckin;

// Chips display strings
const fastDisplay   = fastingActive ? (fastHours + ':' + fastMins.toString().padStart(2,'0')) : 'â€”';
const fastUnit      = fastingActive ? 'hrs' : '';
const fastSub       = fastingActive ? ('window: ' + (activeFast?.target_hours || 16) + 'h') : 'No active fast';
const macroDisplay  = calPct > 0 ? (calPct + '%') : (consumed.cal > 0 ? Math.round(consumed.cal) + '' : 'â€”');
const macroUnit     = calPct > 0 ? 'fat' : (consumed.cal > 0 ? 'kcal' : '');
const macroSub      = macroGoals?.daily_calories ? (Math.round(consumed.cal) + ' / ' + macroGoals.daily_calories + ' kcal') : 'Set macro goals first';
const sessionsCount = chatHistory.filter(m => (m as any).role === 'user').length;

// Dynamic quote
const miraQuoteText = hasWeightGain
  ? 'Your weight went up ' + (weightLogs[0].weight - weightLogs[1].weight).toFixed(1) + 'kg â€” that\'s water from yesterday\'s sodium, not fat. The 7-day trend is what matters.'
  : weightLost > 0
    ? 'You\'ve dropped ' + weightLost.toFixed(1) + 'kg since Day 1. You\'re ' + goalPct + '% toward your goal â€” the adaptation is working.'
    : 'Day ' + currentDay + ' is here. Every day you show up compounds â€” the metabolic shift takes 2â€“3 weeks and you\'re right in it.';

// Memory items
const miraMemory = [
  onboarding?.fasting_protocol ? { l: 'Fasting protocol', v: String(onboarding.fasting_protocol).replace('_',':') + ' IF' } : null,
  goalWeight ? { l: 'Goal weight', v: goalWeight + 'kg Â· ' + (weightLost > 0 ? weightLost.toFixed(1) + 'kg lost so far' : 'working toward it') } : null,
  restrictionsList.length ? { l: 'Dietary restrictions', v: restrictionsList.join(', ') } : null,
  { l: 'Journey progress', v: 'Day ' + currentDay + ' Â· Week ' + weekNum + ' Â· Lv.' + level },
  sessionsCount ? { l: 'Messages sent', v: sessionsCount + ' total across all sessions' } : null,
].filter(Boolean) as Array<{l:string; v:string}>;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>AI Coach Â· Keto Journey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet"/>
</head>
<body>
<div class="rv-pg-shell">
<Sidebar userName={userName} planType={planType} tierLabel={tierLabel} currentDay={currentDay} avatarUrl={profile.avatar_url} activePage="ai-coach" />
<div class="rv-pg-main">

  <!-- â•â• BRIEF / HERO â•â• -->
  <section class="cb">
    <div class="cb-glow lime"></div>
    <div class="cb-glow"></div>
    <div class="cb-inner">
      <div class="cb-bar">
        <div class="cb-mark">âœ¦</div>
        <div>
          <div class="cb-name">Mira <span class="cb-name-sub">Â· your keto coach</span></div>
          <div class="cb-status">Listening Â· context updated just now</div>
        </div>
      </div>

      <div class="cb-headline">
        <div>
          <div class="cb-eyebrow"><span class="cb-pip"></span>TODAY Â· DAY {currentDay} OF 90</div>
          <h1 class="cb-h">
            You're on Week {weekNum}. <em>Ask me anything</em> â€” a craving, a doubt, a win.
          </h1>
        </div>
        <div class="cb-quote-card">
          <div class="cb-qhead"><span class="cb-dot"></span>MIRA NOTICED</div>
          <p class="cb-q">{miraQuoteText}</p>
          <div class="cb-qcta">
            <button data-msg="Tell me more about what you noticed about my progress">Tell me more</button>
            <button class="ghost" onclick="this.closest('.cb-quote-card').style.display='none'">Dismiss</button>
          </div>
        </div>
      </div>

      <div class="cb-chips">
        <div class="cb-cc live">
          <div class="ccc-l">CONTEXT LOADED</div>
          <div class="ccc-v">{currentDay}<em>days of you</em></div>
          <div class="ccc-sub">Meals, weight, check-ins, fasting.</div>
        </div>
        <div class="cb-cc">
          <div class="ccc-l">MACROS TODAY</div>
          <div class="ccc-v">{macroDisplay}<em>{macroUnit}</em></div>
          <div class="ccc-sub">{macroSub}</div>
        </div>
        <div class="cb-cc">
          <div class="ccc-l">TASKS TODAY</div>
          <div class="ccc-v">{completedTasksCount}<em>/{todayTasks.length}</em></div>
          <div class="ccc-sub">{eatenCount}/{totalMeals} meals logged</div>
        </div>
        <div class="cb-cc">
          <div class="ccc-l">FASTING NOW</div>
          <div class="ccc-v">{fastDisplay}<em>{fastUnit}</em></div>
          <div class="ccc-sub">{fastSub}</div>
        </div>
        <div class="cb-cc">
          <div class="ccc-l">SESSIONS</div>
          <div class="ccc-v">{sessionsCount}<em>msgs</em></div>
          <div class="ccc-sub">Your full journey in context</div>
        </div>
      </div>
    </div>
  </section>

  <!-- â•â• BODY â•â• -->
  <div class="ac-body">
    <div class="ac-layout">

      <!-- â”€â”€â”€ CHAT â”€â”€â”€ -->
      <div class="ch-wrap">
        <div class="ch-head">
          <div class="ch-head-mark">âœ¦</div>
          <div>
            <div class="ch-head-title">Conversation with Mira</div>
            <div class="ch-head-sub">Day {currentDay} Â· {streak}-day streak Â· {totalXp} XP Â· Lv.{level}</div>
          </div>
          <div class="ch-head-tools">
            <button id="clearBtn" title="New conversation">+</button>
          </div>
        </div>

        <div class="ch-conv" id="aiMessages">
          <div class="ch-day">Session start</div>

          <!-- Welcome -->
          <div class="ch-row coach">
            <div class="ch-ava">âœ¦</div>
            <div class="ch-bubble-wrap">
              <div class="ch-bubble">
                Morning, <strong>{userName}</strong>! I'm Mira, your personal keto coach â€” I have full context of your journey.<br><br>
                You're on <strong>Day {currentDay}</strong> with a <strong>{streak}-day streak</strong> and <strong>{totalXp} XP</strong>.
                {weightLost > 0 && <> You've lost <strong>{weightLost.toFixed(1)}kg</strong> so far â€” that's real.</>}
                <br><br>
                <span class="ch-hint">Send a food photo for instant macro analysis Â· Ask me anything about keto</span>
              </div>
              <div class="ch-meta">Just now Â· Mira</div>
            </div>
          </div>

          <!-- Pre-rendered history -->
          {chatHistory.map((msg) => (
            <div class={`ch-row ${(msg as any).role === 'user' ? 'user' : 'coach'}`} data-date={(msg as any).created_at ? (msg as any).created_at.split('T')[0] : ''}>
              {(msg as any).role !== 'user' && <div class="ch-ava">âœ¦</div>}
              <div class="ch-bubble-wrap">
                <div class="ch-bubble" data-raw={(msg as any).role === 'assistant' ? (msg as any).content : undefined}>
                  {(msg as any).role === 'user' ? (msg as any).content : ''}
                </div>
                <div class="ch-meta">{(msg as any).role === 'user' ? 'You' : 'Mira'}</div>
              </div>
            </div>
          ))}
        </div>

        <!-- Image preview -->
        <div id="aiImgPreview" class="ch-img-preview">
          <img id="aiImgThumb" src="" alt=""/>
          <div class="ch-img-info">Image ready Â· tap send or add a message</div>
          <button id="aiImgRemove" class="ch-img-remove">Ã—</button>
        </div>

        <div class="ch-compose">
          <div class="ch-compose-row">
            <label class="ch-compose-icon" for="aiImgInput" title="Attach photo">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <input type="file" id="aiImgInput" accept="image/*" style="display:none"/>
            </label>
            <textarea
              class="ch-compose-ta"
              id="aiInput"
              placeholder="Ask Mira anything â€” a craving, a question, a doubtâ€¦"
              rows="1"
            ></textarea>
            <button class="ch-send" id="aiSend">â†’</button>
          </div>
          <div class="ch-foot">
            <span class="ch-pip"></span>
            <span>Context: Day {currentDay} Â· macros Â· weight Â· fasting Â· last {Math.min(14, currentDay)} days</span>
            <span class="ch-spacer"></span>
            <button class="ch-deep" id="deepThinkBtn">
              <span class="ch-deep-box" id="deepBox"></span>
              Deep think
            </button>
          </div>
        </div>
      </div>

      <!-- â”€â”€â”€ RAIL â”€â”€â”€ -->
      <aside class="ac-rail">

        <!-- Persona picker -->
        <div class="cr-card" id="personaPicker">
          <div class="cr-h"><span class="cr-pip"></span>COACH TONE</div>
          <div class="cr-personas">
            <div class="cr-pers active" data-persona="Warm friend">
              <div class="cr-pers-g">â—</div>
              <div>
                <div class="cr-pers-n">Warm friend</div>
                <div class="cr-pers-s">Compassionate, plain language</div>
              </div>
              <div class="cr-pers-check">âœ“</div>
            </div>
            <div class="cr-pers" data-persona="Drill sergeant">
              <div class="cr-pers-g">â—‘</div>
              <div>
                <div class="cr-pers-n">Drill sergeant</div>
                <div class="cr-pers-s">No-nonsense, direct, blunt</div>
              </div>
              <div class="cr-pers-check">âœ“</div>
            </div>
            <div class="cr-pers" data-persona="Clinical">
              <div class="cr-pers-g">â—</div>
              <div>
                <div class="cr-pers-n">Clinical</div>
                <div class="cr-pers-s">Cite biology, numbers, sources</div>
              </div>
              <div class="cr-pers-check">âœ“</div>
            </div>
          </div>
        </div>

        <!-- What Mira remembers -->
        <div class="cr-card">
          <div class="cr-h"><span class="cr-pip lime"></span>WHAT MIRA KNOWS</div>
          <div class="cr-mem-list">
            {miraMemory.map(item => (
              <div class="cr-mem">
                <div class="cr-mem-l">{item.l}</div>
                <div class="cr-mem-v">{item.v}</div>
              </div>
            ))}
          </div>
        </div>

        <!-- Quick tools (dark) -->
        <div class="cr-card cr-dark">
          <div class="cr-h"><span class="cr-pip lime"></span>QUICK TOOLS</div>
          <div class="cr-tools">
            <button class="cr-tool" data-msg={`I'm on Day ${currentDay}. Plan tomorrow's meals for me â€” 3 meals, keto-compliant.`}>
              <div class="cr-tool-g">â—‡</div>
              <div class="cr-tool-l">Plan tomorrow</div>
              <div class="cr-tool-s">3 meals from your goals</div>
            </button>
            <button class="cr-tool" data-msg={`I have ${Math.max(0, (macroGoals?.daily_calories || 1800) - Math.round(consumed.cal))} kcal left today. What should I eat for dinner to hit my macros?`}>
              <div class="cr-tool-g">â—”</div>
              <div class="cr-tool-l">Macro autopilot</div>
              <div class="cr-tool-s">Reverse-fit to dinner</div>
            </button>
            <button class="cr-tool" data-msg={`Recap the last week of my journey. What patterns do you see? What should I fix?`}>
              <div class="cr-tool-g">â—Ž</div>
              <div class="cr-tool-l">Read my week</div>
              <div class="cr-tool-s">Pattern recap & notes</div>
            </button>
            <button class="cr-tool" data-msg={`Give me the single most important keto tip for Day ${currentDay} of a 90-day journey.`}>
              <div class="cr-tool-g">âœ¦</div>
              <div class="cr-tool-l">Day {currentDay} tip</div>
              <div class="cr-tool-s">Best tip for right now</div>
            </button>
          </div>
        </div>

        <!-- Nudges -->
        <div class="cr-card">
          <div class="cr-h"><span class="cr-pip"></span>NUDGES</div>
          <div class="cr-nudge">
            <div class="cr-nudge-l">
              <div class="cr-nudge-h">Morning brief</div>
              <div class="cr-nudge-s">Daily Â· 8:00 AM</div>
            </div>
            <div class="cr-switch on" data-nudge="morning"></div>
          </div>
          <div class="cr-nudge" style="margin-top:.75rem">
            <div class="cr-nudge-l">
              <div class="cr-nudge-h">Pre-meal check-in</div>
              <div class="cr-nudge-s">When you open meal log</div>
            </div>
            <div class="cr-switch on" data-nudge="premeal"></div>
          </div>
          <div class="cr-nudge" style="margin-top:.75rem">
            <div class="cr-nudge-l">
              <div class="cr-nudge-h">Quiet hours</div>
              <div class="cr-nudge-s">10pm â†’ 7am Â· No nudges</div>
            </div>
            <div class="cr-switch on" data-nudge="quiet"></div>
          </div>
        </div>

      </aside>
    </div>

    <!-- â•â• TOPICS â•â• -->
    <div class="ct">
      <div class="ct-head">
        <h2>What do you want to <em>ask</em> today?</h2>
        <p>Click any topic to open a conversation with Mira.</p>
      </div>
      <div class="ct-grid">
        <button class="ct-card rose" data-msg={`I'm on Day ${currentDay} and I haven't lost weight in 5 days â€” is this a real plateau?`}>
          <div class="ct-cat"><div class="ct-g">â—‘</div>STUCK</div>
          <div class="ct-t">I haven't lost weight in {Math.min(5, currentDay)} days.</div>
          <div class="ct-s">Plateaus before day 21 are almost always water. Mira will check yours.</div>
        </button>
        <button class="ct-card lime" data-msg="I am craving bread right now â€” what should I do? What's actually missing?">
          <div class="ct-cat"><div class="ct-g">â—‡</div>CRAVING</div>
          <div class="ct-t">I want bread. Specifically right now.</div>
          <div class="ct-s">We'll find what's actually missing â€” usually fat, salt, or sleep.</div>
        </button>
        <button class="ct-card orange" data-msg="I have dinner out tonight â€” plan my day backwards from there. Keep me in ketosis.">
          <div class="ct-cat"><div class="ct-g">â—Ž</div>PLANNING</div>
          <div class="ct-t">Plan today around my dinner out.</div>
          <div class="ct-s">Reverse-fit the day. Save room for olive oil and a glass of red.</div>
        </button>
        <button class="ct-card rose" data-msg="Why am I crashing at 3pm every day this week? What's causing it on keto?">
          <div class="ct-cat"><div class="ct-g">â—”</div>ENERGY</div>
          <div class="ct-t">Why am I tired at 3pm?</div>
          <div class="ct-s">Likely sodium. Possibly protein timing. Definitely not motivation.</div>
        </button>
        <button class="ct-card lime" data-msg={`Give me a full progress review for Day ${currentDay} of my keto journey â€” honest assessment with specific things to improve.`}>
          <div class="ct-cat"><div class="ct-g">â—¬</div>REVIEW</div>
          <div class="ct-t">Give me a full progress review.</div>
          <div class="ct-s">An honest read on where you are and what to change.</div>
        </button>
        <button class="ct-card orange" data-msg="My morning ketones dropped overnight â€” what changed? What should I do?">
          <div class="ct-cat"><div class="ct-g">â—¯</div>BODY</div>
          <div class="ct-t">My ketones dropped overnight.</div>
          <div class="ct-s">We'll look at protein, salt, and your last 14 hours.</div>
        </button>
      </div>
    </div>

    <!-- â•â• SESSIONS â•â• -->
    {historyDates.length > 0 && (
      <div class="cs">
        <div class="cs-col-h">
          <h3>Conversations <em>so far</em>.</h3>
          <div class="cs-meta">{sessionsCount} messages Â· Day 1 â†’ today</div>
        </div>
        <div class="cs-list">
          {historyDates.map(d => {
            const label = new Date(d.date + 'T12:00:00').toLocaleDateString('en', { month: 'short', day: 'numeric' });
            const firstUser = d.msgs.find((m) => (m as any).role === 'user');
            const preview = firstUser ? String((firstUser as any).content).slice(0, 80) + (String((firstUser as any).content).length > 80 ? 'â€¦' : '') : '';
            const userMsgs = d.msgs.filter((m) => (m as any).role === 'user').length;
            return (
              <div class="cs-row" onclick={`window.scrollToDate('${d.date}')`}>
                <div class="cs-date">{label}<span class="cs-time">{userMsgs} msg{userMsgs !== 1 ? 's' : ''}</span></div>
                <div class="cs-mid">
                  <div class="cs-preview">{preview || 'Session started'}</div>
                </div>
                <div class="cs-arr">â†’</div>
              </div>
            );
          })}
        </div>
      </div>
    )}

  </div><!-- /ac-body -->
</div><!-- /rv-pg-main -->
</div><!-- /rv-pg-shell -->

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:       #FAF6F1;
    --bg-alt:   #F2EDE5;
    --ink:      #16110F;
    --ink-soft: #4A4340;
    --muted:    #8A8077;
    --line:     #E5DED2;
    --accent:   #FF5C7A;
    --accent-2: #B6FF3C;
    --accent-3: #FF914D;
    --card:     #FFFFFF;
    --display:  'Bricolage Grotesque', system-ui, sans-serif;
    --serif:    'Instrument Serif', Georgia, serif;
    --mono:     'Geist Mono', 'Courier New', monospace;
    /* legacy aliases for JS-generated elements */
    --border:   var(--line);
    --border2:  rgba(255,92,122,.28);
    --text:     var(--ink);
    --soft:     var(--ink-soft);
    --green:    var(--accent);
    --green2:   var(--accent-2);
    --gold:     #f59e0b;
    --purple:   #8b5cf6;
    --blue:     #3b82f6;
    --red:      #ef4444;
    --card2:    var(--bg-alt);
  }

  body { background: var(--bg); color: var(--ink); font-family: var(--display); min-height: 100vh; }
  .rv-pg-shell { display: grid; grid-template-columns: 232px 1fr; min-height: 100vh; }
  .rv-pg-main  { overflow-y: auto; min-height: 100vh; }
  @media (max-width: 900px) { .rv-pg-shell { grid-template-columns: 1fr; } }

  /* â•â• BRIEF / HERO â•â• */
  .cb { position: relative; background: var(--ink); color: var(--bg); overflow: hidden; }
  .cb-glow {
    position: absolute; width: 720px; height: 720px; border-radius: 50%;
    background: radial-gradient(circle, rgba(255,71,117,.35), transparent 65%);
    filter: blur(80px); bottom: -360px; right: -200px; z-index: 0; pointer-events: none;
  }
  .cb-glow.lime {
    background: radial-gradient(circle, rgba(182,255,60,.2), transparent 65%);
    top: -240px; left: -120px; width: 540px; height: 540px;
  }
  .cb-inner { position: relative; z-index: 2; max-width: 1320px; margin: 0 auto; padding: 44px 32px 0; }

  .cb-bar { display: flex; align-items: center; gap: 14px; margin-bottom: 28px; }
  .cb-mark {
    width: 48px; height: 48px; border-radius: 14px;
    background: var(--accent); color: #fff;
    display: grid; place-items: center; font-size: 22px;
    box-shadow: 0 0 0 6px rgba(255,71,117,.2), 0 0 60px rgba(255,71,117,.4);
    flex-shrink: 0;
  }
  .cb-name { font-family: var(--display); font-size: 19px; font-weight: 600; letter-spacing: -.02em; }
  .cb-name-sub { font-family: var(--serif); font-style: italic; font-weight: 400; color: rgba(250,246,241,.45); }
  .cb-status { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--accent-2); display: flex; align-items: center; gap: 8px; margin-top: 3px; }
  .cb-status::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 3px rgba(182,255,60,.25); }

  .cb-headline { display: grid; grid-template-columns: minmax(0,1fr) 380px; gap: 56px; align-items: end; }
  .cb-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 16px; display: inline-flex; align-items: center; gap: 8px; }
  .cb-pip { width: 7px; height: 7px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 4px rgba(182,255,60,.22); display: inline-block; }
  .cb-h { font-family: var(--display); font-size: clamp(32px, 4vw, 60px); line-height: 1; letter-spacing: -.04em; font-weight: 600; max-width: 22ch; }
  .cb-h em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }

  .cb-quote-card {
    background: rgba(250,246,241,.06); border: 1px solid rgba(250,246,241,.12);
    border-radius: 20px; padding: 22px 22px 20px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .cb-qhead { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgba(250,246,241,.5); display: flex; align-items: center; gap: 10px; }
  .cb-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-3); display: inline-block; }
  .cb-q { font-family: var(--serif); font-style: italic; font-size: 18px; line-height: 1.4; color: var(--bg); }
  .cb-q::before { content: '"'; font-size: 26px; line-height: 0; vertical-align: -8px; color: var(--accent-2); margin-right: 2px; }
  .cb-qcta { display: flex; gap: 8px; margin-top: 4px; }
  .cb-qcta button { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; padding: 8px 12px; border-radius: 999px; background: var(--accent-2); color: var(--ink); font-weight: 600; cursor: pointer; transition: opacity .15s; }
  .cb-qcta button:hover { opacity: .85; }
  .cb-qcta button.ghost { background: transparent; color: rgba(250,246,241,.7); border: 1px solid rgba(250,246,241,.18); }
  .cb-qcta button.ghost:hover { color: var(--bg); }

  /* Chips strip */
  .cb-chips {
    margin-top: 36px;
    display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr 1fr;
    background: rgba(250,246,241,.06); border: 1px solid rgba(250,246,241,.12);
    border-radius: 22px 22px 0 0; overflow: hidden;
  }
  .cb-cc {
    padding: 18px 20px; border-right: 1px solid rgba(250,246,241,.1);
    display: flex; flex-direction: column; gap: 6px; min-height: 110px;
  }
  .cb-cc:last-child { border-right: none; }
  .ccc-l { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: rgba(250,246,241,.45); }
  .ccc-v { font-family: var(--display); font-size: 28px; font-weight: 600; letter-spacing: -.03em; line-height: 1; margin-top: auto; }
  .ccc-v em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent-2); font-size: 13px; margin-left: 4px; }
  .ccc-sub { font-family: var(--serif); font-style: italic; font-size: 12px; color: rgba(250,246,241,.5); }
  .cb-cc.live .ccc-l { color: var(--accent-2); }
  .cb-cc.live .ccc-l::before { content: 'â— '; }

  @media (max-width: 1100px) {
    .cb-inner { padding: 28px 18px 0; }
    .cb-headline { grid-template-columns: 1fr; gap: 24px; }
    .cb-chips { grid-template-columns: 1fr 1fr; }
    .cb-cc:nth-child(n+4) { display: none; }
  }
  @media (max-width: 640px) {
    .cb-chips { grid-template-columns: 1fr 1fr; }
    .cb-cc:nth-child(n+3) { display: none; }
  }

  /* â•â• BODY â•â• */
  .ac-body { max-width: 1320px; margin: 0 auto; padding: 32px 32px 80px; }
  .ac-layout { display: grid; grid-template-columns: minmax(0,1fr) 340px; gap: 22px; align-items: start; }
  @media (max-width: 1100px) { .ac-layout { grid-template-columns: 1fr; } }
  @media (max-width: 640px)  { .ac-body   { padding: 20px 14px 60px; } }

  /* â•â• CHAT â•â• */
  .ch-wrap {
    background: var(--card); border: 1px solid var(--line);
    border-radius: 28px; display: flex; flex-direction: column;
    min-height: 680px; overflow: hidden;
  }
  .ch-head {
    display: flex; align-items: center; gap: 14px;
    padding: 18px 22px; border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }
  .ch-head-mark {
    width: 36px; height: 36px; border-radius: 12px;
    background: var(--ink); color: var(--accent-2);
    display: grid; place-items: center; font-size: 16px; flex-shrink: 0;
  }
  .ch-head-title { font-family: var(--display); font-size: 16px; font-weight: 600; letter-spacing: -.02em; }
  .ch-head-sub { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-top: 2px; }
  .ch-head-tools { margin-left: auto; display: flex; gap: 4px; }
  .ch-head-tools button {
    width: 34px; height: 34px; border-radius: 50%;
    background: none; border: none; color: var(--ink-soft);
    display: grid; place-items: center; font-size: 18px; cursor: pointer; transition: background .15s;
  }
  .ch-head-tools button:hover { background: var(--bg-alt); color: var(--ink); }

  /* Conversation */
  .ch-conv {
    flex: 1; overflow-y: auto; padding: 28px 26px 18px;
    display: flex; flex-direction: column; gap: 16px;
    scroll-behavior: smooth; min-height: 0;
  }
  .ch-conv::-webkit-scrollbar { width: 3px; }
  .ch-conv::-webkit-scrollbar-thumb { background: var(--line); border-radius: 99px; }
  .ch-day {
    display: flex; align-items: center; gap: 10px; margin: 4px 0;
    font-family: var(--mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted);
  }
  .ch-day::before, .ch-day::after { content: ''; flex: 1; height: 1px; background: var(--line); }

  .ch-row { display: flex; gap: 12px; max-width: 100%; }
  .ch-row.user { justify-content: flex-end; }
  .ch-ava {
    width: 32px; height: 32px; border-radius: 10px;
    background: var(--ink); color: var(--accent-2);
    display: grid; place-items: center; font-size: 14px; flex-shrink: 0;
  }
  .ch-bubble-wrap { display: flex; flex-direction: column; gap: 5px; max-width: 78%; }
  .ch-row.user .ch-bubble-wrap { align-items: flex-end; }

  .ch-bubble {
    font-size: 14.5px; line-height: 1.55; padding: 13px 16px;
    border-radius: 16px; white-space: pre-wrap;
  }
  .ch-row.coach .ch-bubble {
    background: var(--bg-alt); color: var(--ink); border-bottom-left-radius: 4px;
  }
  .ch-row.user .ch-bubble {
    background: var(--ink); color: var(--bg); border-bottom-right-radius: 4px;
  }
  .ch-bubble em { font-family: var(--serif); font-style: italic; color: var(--accent); }
  .ch-bubble strong { font-weight: 700; }
  .ch-meta { font-family: var(--mono); font-size: 9px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); padding: 0 6px; }
  .ch-hint { font-size: 12px; opacity: .6; }

  /* Typing indicator */
  .ch-thinking {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--bg-alt); border-radius: 16px; border-bottom-left-radius: 4px;
    padding: 14px 16px; font-family: var(--serif); font-style: italic; font-size: 15px; color: var(--ink-soft);
  }
  .ch-pulse { display: inline-flex; gap: 4px; }
  .ch-pulse span { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: chp 1s infinite ease-in-out; }
  .ch-pulse span:nth-child(2) { animation-delay: .15s; }
  .ch-pulse span:nth-child(3) { animation-delay: .3s; }
  @keyframes chp { 0%,80%,100% { transform: scale(.5); opacity: .4; } 40% { transform: scale(1); opacity: 1; } }

  /* Markdown styles in chat bubbles */
  .ch-row.coach .ch-bubble .ai-h2 { font-size: 15px; font-weight: 700; margin: .5rem 0 .25rem; padding-bottom: .2rem; border-bottom: 1px solid var(--line); }
  .ch-row.coach .ch-bubble .ai-h3 { font-size: 14px; font-weight: 700; color: var(--accent); margin: .4rem 0 .2rem; }
  .ch-row.coach .ch-bubble .ai-li { padding: .1rem 0 .1rem .5rem; border-left: 2px solid rgba(255,92,122,.3); margin: .1rem 0; }
  .ch-row.coach .ch-bubble .ai-li-num { padding: .1rem 0; }
  .ch-row.coach .ch-bubble .ai-num { display: inline-block; min-width: 1.4rem; font-weight: 700; color: var(--accent); }
  .ch-row.coach .ch-bubble code { background: var(--bg-alt); border: 1px solid var(--line); border-radius: 4px; padding: .1rem .3rem; font-family: var(--mono); font-size: 12px; }

  /* Image preview */
  .ch-img-preview {
    display: none; align-items: center; gap: 10px;
    margin: 0 16px 8px; padding: 10px 14px;
    background: var(--bg-alt); border: 1px solid var(--line); border-radius: 12px;
  }
  .ch-img-preview.show { display: flex; }
  .ch-img-preview img { width: 48px; height: 48px; object-fit: cover; border-radius: 8px; flex-shrink: 0; }
  .ch-img-info { flex: 1; font-size: 12px; color: var(--muted); }
  .ch-img-remove { background: none; border: none; color: var(--muted); font-size: 18px; cursor: pointer; padding: 0 4px; line-height: 1; transition: color .15s; }
  .ch-img-remove:hover { color: var(--red); }

  /* Compose */
  .ch-compose { border-top: 1px solid var(--line); padding: 14px 16px 16px; background: var(--bg); display: flex; flex-direction: column; gap: 10px; flex-shrink: 0; }
  .ch-compose-row {
    display: flex; gap: 10px; align-items: flex-end;
    background: var(--card); border: 1px solid var(--line);
    border-radius: 22px; padding: 10px 10px 10px 14px;
  }
  .ch-compose-icon {
    width: 32px; height: 32px; border-radius: 50%;
    display: grid; place-items: center; color: var(--ink-soft);
    cursor: pointer; transition: background .15s; flex-shrink: 0;
  }
  .ch-compose-icon:hover { background: var(--bg-alt); color: var(--ink); }
  .ch-compose-ta {
    flex: 1; background: transparent; border: none; outline: none; resize: none;
    font-size: 14.5px; line-height: 1.5; min-height: 28px; max-height: 140px;
    color: var(--ink); font-family: inherit;
  }
  .ch-compose-ta::placeholder { color: var(--muted); }
  .ch-send {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--accent); color: #fff; border: none;
    display: grid; place-items: center; font-size: 18px; font-weight: 600;
    cursor: pointer; transition: background .15s; flex-shrink: 0;
  }
  .ch-send:hover:not(:disabled) { background: var(--ink); }
  .ch-send:disabled { opacity: .4; cursor: default; }
  .ch-foot {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted);
    padding: 0 4px;
  }
  .ch-pip { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 3px rgba(182,255,60,.25); flex-shrink: 0; }
  .ch-spacer { flex: 1; }
  .ch-deep {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px; border-radius: 999px; border: 1px solid var(--line);
    background: var(--card); cursor: pointer; font-family: inherit;
    font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted);
    transition: all .15s;
  }
  .ch-deep.on { background: var(--accent-2); color: var(--ink); border-color: var(--accent-2); }
  .ch-deep-box { width: 10px; height: 10px; border-radius: 3px; background: var(--bg-alt); border: 1px solid var(--line); display: grid; place-items: center; font-size: 8px; flex-shrink: 0; }
  .ch-deep.on .ch-deep-box { background: var(--ink); color: var(--accent-2); border-color: var(--ink); }

  @keyframes msgIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:none; } }
  .ch-row { animation: msgIn .22s ease both; }

  /* â•â• RAIL â•â• */
  .ac-rail { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 24px; }
  @media (max-width: 1100px) { .ac-rail { position: static; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; } }
  @media (max-width: 640px)  { .ac-rail { grid-template-columns: 1fr; } }

  .cr-card { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 20px; }
  .cr-h { display: flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .cr-pip { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: inline-block; flex-shrink: 0; }
  .cr-pip.lime { background: var(--accent-2); box-shadow: 0 0 0 3px rgba(182,255,60,.25); }

  /* Persona picker */
  .cr-personas { display: flex; flex-direction: column; gap: 6px; }
  .cr-pers {
    display: flex; align-items: center; gap: 12px; padding: 10px 12px;
    border-radius: 12px; border: 1px solid var(--line);
    cursor: pointer; transition: all .15s;
  }
  .cr-pers:hover { background: var(--bg-alt); }
  .cr-pers.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .cr-pers-g { width: 32px; height: 32px; border-radius: 10px; background: var(--bg-alt); color: var(--accent); display: grid; place-items: center; font-size: 14px; flex-shrink: 0; }
  .cr-pers.active .cr-pers-g { background: rgba(250,246,241,.12); color: var(--accent-2); }
  .cr-pers-n { font-family: var(--display); font-size: 14px; font-weight: 600; letter-spacing: -.01em; }
  .cr-pers-s { font-family: var(--serif); font-style: italic; font-size: 12.5px; color: var(--ink-soft); margin-top: 2px; }
  .cr-pers.active .cr-pers-s { color: rgba(250,246,241,.6); }
  .cr-pers-check { width: 18px; height: 18px; border-radius: 50%; margin-left: auto; border: 1.5px solid var(--line); display: grid; place-items: center; font-size: 10px; color: transparent; flex-shrink: 0; }
  .cr-pers.active .cr-pers-check { background: var(--accent-2); border-color: var(--accent-2); color: var(--ink); }

  /* Memory */
  .cr-mem-list { display: flex; flex-direction: column; }
  .cr-mem { padding: 10px 0; border-bottom: 1px dashed var(--line); }
  .cr-mem:last-child { border-bottom: none; padding-bottom: 0; }
  .cr-mem-l { font-size: 13.5px; font-weight: 500; letter-spacing: -.005em; }
  .cr-mem-v { font-family: var(--mono); font-size: 9.5px; letter-spacing: .1em; color: var(--muted); margin-top: 2px; text-transform: uppercase; }

  /* Dark card */
  .cr-dark { background: var(--ink); color: var(--bg); border-color: transparent; }
  .cr-dark .cr-h { color: rgba(250,246,241,.5); }
  .cr-tools { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .cr-tool {
    background: rgba(250,246,241,.06); border: 1px solid rgba(250,246,241,.12);
    padding: 12px; border-radius: 14px; text-align: left; cursor: pointer; transition: all .15s;
  }
  .cr-tool:hover { background: var(--accent-2); color: var(--ink); border-color: var(--accent-2); }
  .cr-tool:hover .cr-tool-g { background: var(--ink); color: var(--accent-2); }
  .cr-tool:hover .cr-tool-s { color: rgba(22,17,15,.6); }
  .cr-tool-g { width: 28px; height: 28px; border-radius: 9px; background: rgba(250,246,241,.1); color: var(--accent-2); display: grid; place-items: center; font-size: 13px; margin-bottom: 10px; }
  .cr-tool-l { font-family: var(--display); font-size: 13px; font-weight: 600; line-height: 1.2; letter-spacing: -.01em; }
  .cr-tool-s { font-family: var(--mono); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: rgba(250,246,241,.5); margin-top: 4px; }

  /* Nudges */
  .cr-nudge { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .cr-nudge-l { display: flex; flex-direction: column; gap: 2px; }
  .cr-nudge-h { font-size: 14px; font-weight: 500; }
  .cr-nudge-s { font-family: var(--mono); font-size: 9.5px; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; }
  .cr-switch { width: 40px; height: 22px; border-radius: 999px; background: var(--bg-alt); position: relative; flex-shrink: 0; cursor: pointer; transition: background .15s; }
  .cr-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2); transition: left .15s; }
  .cr-switch.on { background: var(--accent); }
  .cr-switch.on::after { left: 20px; }

  /* â•â• TOPICS â•â• */
  .ct { margin-top: 48px; }
  .ct-head { display: flex; align-items: end; gap: 24px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .ct-head h2 { font-family: var(--display); font-size: clamp(24px, 3vw, 40px); font-weight: 600; letter-spacing: -.035em; line-height: 1; }
  .ct-head h2 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
  .ct-head p { font-family: var(--serif); font-style: italic; font-size: 15px; color: var(--ink-soft); margin-left: auto; text-align: right; line-height: 1.4; max-width: 30ch; }
  .ct-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media (max-width: 900px) { .ct-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .ct-grid { grid-template-columns: 1fr; } }
  .ct-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 20px;
    padding: 22px 22px 20px; display: flex; flex-direction: column; gap: 14px;
    text-align: left; cursor: pointer; transition: all .2s;
    position: relative; min-height: 200px; overflow: hidden;
  }
  .ct-card:hover { transform: translateY(-2px); border-color: var(--ink); }
  .ct-card::after { content: 'â†’'; position: absolute; top: 22px; right: 22px; font-size: 18px; color: var(--muted); transition: all .2s; }
  .ct-card:hover::after { color: var(--accent); transform: translate(4px,-2px); }
  .ct-cat { font-family: var(--mono); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 8px; }
  .ct-g { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; font-size: 13px; }
  .ct-card.rose .ct-g { background: var(--accent); color: #fff; }
  .ct-card.lime .ct-g { background: var(--accent-2); color: var(--ink); }
  .ct-card.orange .ct-g { background: var(--accent-3); color: #fff; }
  .ct-t { font-family: var(--display); font-size: 20px; font-weight: 600; line-height: 1.1; letter-spacing: -.025em; }
  .ct-s { font-family: var(--serif); font-style: italic; font-size: 13.5px; color: var(--ink-soft); line-height: 1.45; margin-top: auto; }

  /* â•â• SESSIONS â•â• */
  .cs { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
  .cs-col-h { display: flex; align-items: end; gap: 16px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .cs-col-h h3 { font-family: var(--display); font-size: 28px; font-weight: 600; letter-spacing: -.035em; line-height: 1; }
  .cs-col-h h3 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
  .cs-meta { font-family: var(--mono); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin-left: auto; }
  .cs-list { display: flex; flex-direction: column; }
  .cs-row {
    display: grid; grid-template-columns: 90px minmax(0,1fr) 30px; gap: 18px;
    padding: 16px 0; border-bottom: 1px dashed var(--line); cursor: pointer; transition: padding .15s;
  }
  .cs-row:last-child { border-bottom: none; }
  .cs-row:hover { padding-left: 8px; }
  .cs-date { font-family: var(--mono); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .cs-time { display: block; color: var(--ink-soft); margin-top: 3px; }
  .cs-preview { font-family: var(--serif); font-style: italic; font-size: 14.5px; color: var(--ink-soft); line-height: 1.45; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cs-arr { font-size: 18px; color: var(--muted); display: flex; align-items: center; transition: color .15s; }
  .cs-row:hover .cs-arr { color: var(--accent); }
</style>

<script is:inline define:vars={{ userName, currentDay, streak, totalXp, level, weightLost: weightLost }}>
(function() {
  // â”€â”€ Markdown renderer â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  function md(raw) {
    if (!raw) return '';
    var s = raw, codeBlocks = [], inlineCodes = [];
    s = s.replace(/```[\w]*\n?([\s\S]*?)```/g, function(_, code) { var i = codeBlocks.length; codeBlocks.push(code.trim().replace(/</g,'&lt;').replace(/>/g,'&gt;')); return '\x00CB'+i+'\x00'; });
    s = s.replace(/`([^`\n]+)`/g, function(_, code) { var i = inlineCodes.length; inlineCodes.push(code.replace(/</g,'&lt;').replace(/>/g,'&gt;')); return '\x00IC'+i+'\x00'; });
    s = s.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
    s = s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    s = s.replace(/\*([^\*\n]+?)\*/g, '<em>$1</em>');
    s = s.replace(/^### (.+)$/gm, '<div class="ai-h3">$1</div>');
    s = s.replace(/^## (.+)$/gm,  '<div class="ai-h2">$1</div>');
    s = s.replace(/^(\d+)\. (.+)$/gm, '<div class="ai-li-num"><span class="ai-num">$1.</span> $2</div>');
    s = s.replace(/^[-*â€¢] (.+)$/gm, '<div class="ai-li">$1</div>');
    s = s.replace(/\n\n/g, '<br><br>'); s = s.replace(/\n/g, '<br>');
    codeBlocks.forEach(function(c,i) { s = s.replace('\x00CB'+i+'\x00', '<pre><code>'+c+'</code></pre>'); });
    inlineCodes.forEach(function(c,i) { s = s.replace('\x00IC'+i+'\x00', '<code>'+c+'</code>'); });
    return s;
  }

  // Render pre-loaded history
  document.querySelectorAll('.ch-row.coach .ch-bubble[data-raw]').forEach(function(el) {
    var raw = el.getAttribute('data-raw');
    if (raw) el.innerHTML = md(raw);
    el.removeAttribute('data-raw');
  });

  // â”€â”€ State â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  var msgs      = document.getElementById('aiMessages');
  var input     = document.getElementById('aiInput');
  var sendBtn   = document.getElementById('aiSend');
  var imgInput  = document.getElementById('aiImgInput');
  var imgPrev   = document.getElementById('aiImgPreview');
  var imgThumb  = document.getElementById('aiImgThumb');
  var imgRem    = document.getElementById('aiImgRemove');
  var clearBtn  = document.getElementById('clearBtn');
  var deepBtn   = document.getElementById('deepThinkBtn');
  var deepBox   = document.getElementById('deepBox');

  var pendingImg   = null;
  var isLoading    = false;
  var deepThink    = false;
  var coachPersona = 'Warm friend';

  scrollBottom();

  // â”€â”€ Persona picker â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  var picker = document.getElementById('personaPicker');
  if (picker) {
    picker.addEventListener('click', function(e) {
      var p = e.target.closest('.cr-pers');
      if (!p) return;
      coachPersona = p.dataset.persona || 'Warm friend';
      picker.querySelectorAll('.cr-pers').forEach(function(el) { el.classList.toggle('active', el === p); });
    });
  }

  // â”€â”€ Deep think toggle â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if (deepBtn) {
    deepBtn.addEventListener('click', function() {
      deepThink = !deepThink;
      deepBtn.classList.toggle('on', deepThink);
      if (deepBox) deepBox.textContent = deepThink ? 'âœ“' : '';
    });
  }

  // â”€â”€ Nudge toggles â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.querySelectorAll('.cr-switch').forEach(function(sw) {
    sw.addEventListener('click', function() { this.classList.toggle('on'); });
  });

  // â”€â”€ Topic / suggestion cards â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  document.addEventListener('click', function(e) {
    var el = e.target.closest('[data-msg]');
    if (el && input) {
      var msg = el.getAttribute('data-msg');
      if (msg) { input.value = msg; autoResize(); scrollBottom(); sendMsg(); }
    }
  });

  // â”€â”€ Image handling â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if (imgInput) imgInput.addEventListener('change', function() {
    var file = this.files && this.files[0];
    if (!file) return;
    if (file.size > 4194304) { alert('Max image size: 4 MB'); return; }
    var reader = new FileReader();
    reader.onload = function(ev) {
      var result = ev.target.result;
      pendingImg = { base64: String(result).split(',')[1], type: file.type };
      imgThumb.src = String(result);
      imgPrev.classList.add('show');
    };
    reader.readAsDataURL(file);
  });
  if (imgRem) imgRem.addEventListener('click', clearImage);
  function clearImage() {
    pendingImg = null; if (imgInput) imgInput.value = '';
    imgPrev.classList.remove('show'); imgThumb.src = '';
  }

  // â”€â”€ Clear / new chat â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if (clearBtn) clearBtn.addEventListener('click', function() {
    if (!confirm('Start a new conversation? This will clear the current chat.')) return;
    fetch('/api/chat/history', { method: 'DELETE' }).then(function() {
      msgs.innerHTML = '';
      var w = document.createElement('div');
      w.className = 'ch-row coach';
      w.innerHTML = '<div class="ch-ava">âœ¦</div><div class="ch-bubble-wrap"><div class="ch-bubble"><strong>Fresh start!</strong> Ask me anything, ' + escHtml(userName) + '.</div><div class="ch-meta">Just now Â· Mira</div></div>';
      msgs.appendChild(w);
      scrollBottom();
    });
  });

  // â”€â”€ Send â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if (sendBtn) sendBtn.addEventListener('click', sendMsg);
  if (input) input.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMsg(); }
  });
  if (input) input.addEventListener('input', autoResize);
  function autoResize() { if (!input) return; input.style.height = '28px'; input.style.height = Math.min(input.scrollHeight, 140) + 'px'; }

  async function sendMsg() {
    var text = input ? input.value.trim() : '';
    if ((!text && !pendingImg) || isLoading) return;
    isLoading = true; sendBtn.disabled = true;

    if (pendingImg) {
      addBubble('<img src="data:' + pendingImg.type + ';base64,' + pendingImg.base64 + '" style="max-width:200px;border-radius:10px;margin-bottom:.3rem;display:block"/>' + (text ? escHtml(text) : 'ðŸ“¸ Image sent'), 'user');
    } else {
      addBubble(escHtml(text), 'user');
    }

    input.value = ''; input.style.height = '28px';
    var typing = addTyping();

    try {
      var res = await fetch('/api/chat/gemini', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text || '', imageBase64: pendingImg ? pendingImg.base64 : null, imageType: pendingImg ? pendingImg.type : null, persona: coachPersona, deepThink: deepThink }),
      });
      typing.remove();
      var data = await res.json();
      if (!res.ok || data.error) {
        addBubble('âŒ ' + (data.error || 'Something went wrong. Please try again.'), 'coach');
      } else {
        var row = addBubble('', 'coach');
        row.querySelector('.ch-bubble').innerHTML = md(data.reply);
      }
    } catch (err) {
      typing.remove();
      addBubble('âŒ Connection error. Please check your network and try again.', 'coach');
    }

    clearImage();
    isLoading = false; sendBtn.disabled = false;
    if (input) input.focus();
  }

  function addBubble(htmlContent, role) {
    var row = document.createElement('div');
    row.className = 'ch-row ' + role;
    if (role === 'coach') {
      var ava = document.createElement('div');
      ava.className = 'ch-ava'; ava.textContent = 'âœ¦';
      row.appendChild(ava);
    }
    var wrap = document.createElement('div'); wrap.className = 'ch-bubble-wrap';
    var bubble = document.createElement('div'); bubble.className = 'ch-bubble';
    bubble.innerHTML = htmlContent;
    var meta = document.createElement('div'); meta.className = 'ch-meta';
    meta.textContent = role === 'user' ? 'You' : 'Mira';
    wrap.appendChild(bubble); wrap.appendChild(meta);
    row.appendChild(wrap);
    msgs.appendChild(row);
    scrollBottom();
    return row;
  }

  function addTyping() {
    var row = document.createElement('div'); row.className = 'ch-row coach';
    row.innerHTML = '<div class="ch-ava">âœ¦</div><div class="ch-bubble-wrap"><div class="ch-thinking"><span class="ch-pulse"><span></span><span></span><span></span></span>Mira is reading your dayâ€¦</div></div>';
    msgs.appendChild(row); scrollBottom();
    return row;
  }

  function scrollBottom() { if (msgs) msgs.scrollTop = msgs.scrollHeight; }
  function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  window.scrollToDate = function(date) {
    var els = msgs.querySelectorAll('[data-date]');
    for (var i = 0; i < els.length; i++) {
      if (els[i].getAttribute('data-date') === date) { els[i].scrollIntoView({ behavior: 'smooth', block: 'start' }); return; }
    }
  };
})();
</script>
</body>
</html>

