---
import { requireAuth } from '../../lib/auth';
import Sidebar from '../../components/Sidebar.astro';
import { getTranslator, normaliseLang } from '../../lib/i18n';
import { getUserJourney } from '../../lib/supabase';

const auth = await requireAuth(Astro);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { user, profile, db } = auth;

const planType  = profile.subscription_tier || 'basic_30';
const tierLabel = planType === 'elite_12' ? 'Elite' : planType === 'pro_6' ? 'Pro' : 'Basic';
const lang      = normaliseLang(Astro.cookies.get('keto-lang')?.value);
const t         = getTranslator(lang);

const journey    = await getUserJourney(user.id, db);
const currentDay = journey?.current_day || 1;
const userName   = profile.full_name?.split(' ')[0] || 'Friend';

function getMealType(bookId) {
  if (!bookId) return 'Other';
  if (bookId.startsWith('ds')) return 'Dessert';
  if (bookId.startsWith('d'))  return 'Dinner';
  if (bookId.startsWith('sm')) return 'Smoothie';
  if (bookId.startsWith('s'))  return 'Snack';
  if (bookId.startsWith('bk')) return 'Baking';
  if (bookId.startsWith('b'))  return 'Breakfast';
  if (bookId.startsWith('l'))  return 'Lunch';
  return 'Other';
}

const dinnerBookIds = ['d1','d2','d3','d4','d5','d6','d7','d8','d9','d10','d11','d12'];

const [tonightRes, recipesRes, favsRes] = await Promise.allSettled([
  db.from('recipes')
    .select('id, title, description, calories, protein, fat, net_carbs, image_url, prep_time, cook_time, difficulty')
    .in('book_id', dinnerBookIds)
    .not('image_url', 'is', null)
    .limit(3),
  db.from('recipes')
    .select('id, title, description, calories, protein, fat, net_carbs, image_url, prep_time, cook_time, difficulty, book_id, tags')
    .not('image_url', 'is', null)
    .limit(60),
  db.from('recipe_favorites')
    .select('recipe_id')
    .eq('user_id', user.id),
]);

const tonightRecipes = tonightRes.status === 'fulfilled' ? (tonightRes.value?.data || []) : [];
const allRecipes     = recipesRes.status === 'fulfilled' ? (recipesRes.value?.data || []) : [];
const favsRaw        = favsRes.status === 'fulfilled' ? (favsRes.value?.data || []) : [];

const favSet = new Set(favsRaw.map((f) => f.recipe_id));

const favIds = favsRaw.map((f) => f.recipe_id).slice(0, 8);
const savedResult = favIds.length > 0
  ? await db.from('recipes').select('id, title, image_url, net_carbs, calories').in('id', favIds).limit(8)
  : null;
const savedRecipes = savedResult?.data || [];

const collectionDefs = [
  {
    id: 'ec-carbs', title: 'Under 5g net carbs', sub: "Strict-mode meals that don't taste like punishment.", tone: 'rose', filter: 'low-carb',
    previews: allRecipes.filter((r) => (r.net_carbs || 0) <= 5).slice(0, 3),
    count: allRecipes.filter((r) => (r.net_carbs || 0) <= 5).length,
  },
  {
    id: 'ec-quick', title: '20 minutes or less', sub: 'For the nights when cooking is the enemy.', tone: 'lime', filter: 'quick',
    previews: allRecipes.filter((r) => (r.prep_time || 0) + (r.cook_time || 0) <= 20).slice(0, 3),
    count: allRecipes.filter((r) => (r.prep_time || 0) + (r.cook_time || 0) <= 20).length,
  },
  {
    id: 'ec-dinner', title: "Tonight's dinner", sub: 'High-fat dinner recipes to end your day in ketosis.', tone: 'dark', filter: 'dinner',
    previews: allRecipes.filter((r) => getMealType(r.book_id) === 'Dinner').slice(0, 3),
    count: allRecipes.filter((r) => getMealType(r.book_id) === 'Dinner').length,
  },
  {
    id: 'ec-breakfast', title: 'Power breakfast', sub: 'Start keto-strong. Every. Single. Morning.', tone: 'orange', filter: 'breakfast',
    previews: allRecipes.filter((r) => getMealType(r.book_id) === 'Breakfast').slice(0, 3),
    count: allRecipes.filter((r) => getMealType(r.book_id) === 'Breakfast').length,
  },
  {
    id: 'ec-protein', title: 'High protein', sub: '30g+ to protect muscle while burning fat.', tone: 'rose', filter: 'high-protein',
    previews: allRecipes.filter((r) => (r.protein || 0) >= 30).slice(0, 3),
    count: allRecipes.filter((r) => (r.protein || 0) >= 30).length,
  },
];

const tn0 = tonightRecipes[0] || null;
const tn1 = tonightRecipes[1] || null;
const tn2 = tonightRecipes[2] || null;
const hasTn = tn0 !== null;
const hasSmalls = tn1 !== null;

// Pre-compute all derived card data so the template map needs NO const declarations
const recipeCards = allRecipes.map((r) => {
  const meal = getMealType(r.book_id);
  const totalTime = (r.prep_time || 0) + (r.cook_time || 0);
  const isFaved = favSet.has(r.id);
  const tagsStr = Array.isArray(r.tags) ? r.tags.join(',').toLowerCase() : '';
  const raw = r.description || '';
  const descFull = raw.length > 60 ? raw.slice(0, 60) + '…' : raw;
  return {
    id: r.id,
    title: r.title,
    calories: r.calories || 0,
    fat: r.fat || 0,
    protein: r.protein || 0,
    net_carbs: r.net_carbs || 0,
    image_url: r.image_url,
    meal,
    totalTime,
    isFaved,
    tagsStr,
    descFull,
  };
});

// Pre-compute collection previews so template map needs NO const either
const colCards = collectionDefs.map((c) => ({
  ...c,
  cover: c.previews[0] ? c.previews[0].image_url : null,
  thumbs: c.previews.filter((p) => !!p.image_url).slice(0, 3),
}));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recipes — Keto Journey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />

  <style>
    :root {
      --display: 'Bricolage Grotesque', system-ui, sans-serif;
      --serif: 'Instrument Serif', Georgia, serif;
      --mono: 'SFMono-Regular', 'Consolas', monospace;
      --bg: #FAF6F1;
      --bg-alt: #F2EDE5;
      --ink: #16110F;
      --ink-soft: #4A4340;
      --muted: #8A8077;
      --line: #E5DED2;
      --card: #FFFFFF;
      --accent: #FF5C7A;
      --accent-2: #B6FF3C;
      --accent-3: #FF914D;
    }
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Bricolage Grotesque', system-ui, sans-serif; background: var(--bg); color: var(--ink); min-height: 100vh; overflow-x: hidden; }
    button { cursor: pointer; font-family: inherit; background: none; border: none; }
    a { text-decoration: none; color: inherit; }

    .rx-shell { display: grid; grid-template-columns: 232px 1fr; min-height: 100vh; }
    .rx-main { min-width: 0; overflow-x: hidden; }
    @media (max-width: 900px) { .rx-shell { grid-template-columns: 1fr; } }

    /* ─── TONIGHT ─── */
    .tonight { background: var(--ink); color: #FFF6F0; padding: 52px 48px 48px; }
    .tn-inner { max-width: 1360px; margin: 0 auto; display: grid; grid-template-columns: 1fr 480px; gap: 48px; align-items: center; }
    .tn-label { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 18px; }
    .tn-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent-2); display: inline-block; }
    .tn-title { font-size: clamp(28px, 4vw, 50px); font-weight: 700; letter-spacing: -0.04em; line-height: 1.05; margin-bottom: 12px; }
    .tn-title em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--accent); }
    .tn-sub { font-size: 14px; color: rgba(255,246,240,.5); line-height: 1.5; max-width: 38ch; margin-bottom: 24px; }
    .tn-pick-btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border-radius: 10px; background: var(--accent); color: #fff; font-size: 13px; font-weight: 600; transition: all .15s; }
    .tn-pick-btn:hover { background: color-mix(in oklab, var(--accent) 85%, #fff); }

    /* Card layout */
    .tn-cards { display: flex; gap: 12px; height: 360px; }
    .tn-card { border-radius: 18px; overflow: hidden; position: relative; cursor: pointer; transition: transform .2s; display: block; flex-shrink: 0; }
    .tn-card:hover { transform: translateY(-3px); }
    .tn-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .tn-card:hover img { transform: scale(1.05); }
    .tn-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 25%, rgba(22,17,15,.88) 100%); }
    .tn-card-body { position: absolute; left: 16px; right: 16px; bottom: 16px; z-index: 2; }
    .tn-rank { font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 6px; }
    .tn-name { font-size: 18px; font-weight: 600; letter-spacing: -0.02em; color: #FFF6F0; line-height: 1.2; margin-bottom: 8px; }
    .tn-macros { display: flex; gap: 6px; flex-wrap: wrap; }
    .tn-chip { font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border-radius: 5px; background: rgba(255,246,240,.12); border: 1px solid rgba(255,246,240,.18); color: #FFF6F0; }
    .tn-chip-green { background: rgba(182,255,60,.15); border-color: rgba(182,255,60,.3); color: var(--accent-2); }
    .tn-btns { display: flex; gap: 7px; margin-top: 10px; }
    .tn-btn-p { padding: 7px 13px; border-radius: 8px; font-size: 11px; font-weight: 600; background: var(--accent); color: #fff; border: 1.5px solid var(--accent); transition: all .15s; }
    .tn-btn-g { padding: 7px 13px; border-radius: 8px; font-size: 11px; font-weight: 600; background: transparent; color: #FFF6F0; border: 1.5px solid rgba(255,246,240,.25); transition: all .15s; }
    .tn-btn-p:hover { opacity: .88; }
    .tn-btn-g:hover { border-color: rgba(255,246,240,.5); }
    .tn-card-hero { flex: 1; min-width: 0; }
    .tn-card-hero .tn-name { font-size: 22px; }
    .tn-smalls { width: 195px; display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; }
    .tn-card-sm { flex: 1; }
    .tn-card-sm .tn-btns { display: none; }
    .tn-card-sm .tn-name { font-size: 13.5px; }
    .tn-card-sm .tn-chip { font-size: 8.5px; padding: 2px 6px; }

    @media (max-width: 1100px) { .tn-inner { grid-template-columns: 1fr; gap: 28px; } .tn-cards { height: 260px; } }
    @media (max-width: 700px) { .tonight { padding: 32px 20px 28px; } .tn-cards { display: none; } }

    /* ─── FILTER BAR ─── */
    .fl { position: sticky; top: 0; z-index: 30; background: color-mix(in oklab, var(--bg) 88%, transparent); backdrop-filter: blur(16px) saturate(1.2); -webkit-backdrop-filter: blur(16px) saturate(1.2); border-bottom: 1px solid var(--line); }
    .fl-inner { max-width: 1360px; margin: 0 auto; padding: 12px 32px; display: flex; flex-direction: column; gap: 10px; }
    .fl-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    .fl-search { position: relative; flex: 1; min-width: 180px; max-width: 320px; }
    .fl-search input { width: 100%; padding: 10px 12px 10px 36px; border-radius: 999px; border: 1px solid var(--line); background: var(--card); font-size: 13px; color: var(--ink); outline: none; font-family: inherit; transition: border-color .15s; }
    .fl-search input:focus { border-color: var(--ink); }
    .fl-search input::placeholder { color: var(--muted); }
    .fl-search-ic { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 14px; color: var(--muted); pointer-events: none; }

    .fl-pills { display: flex; gap: 3px; padding: 3px; background: var(--bg-alt); border: 1px solid var(--line); border-radius: 999px; flex-wrap: wrap; }
    .fl-pill { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase; padding: 7px 12px; border-radius: 999px; color: var(--muted); font-weight: 600; transition: all .15s; white-space: nowrap; }
    .fl-pill:hover { color: var(--ink); }
    .fl-pill.active { background: var(--ink); color: var(--bg); }

    .fl-spacer { flex: 1; min-width: 8px; }

    .fl-sl { display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); }
    .fl-sl .fl-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); white-space: nowrap; }
    .fl-sl input[type="range"] { flex: 1; -webkit-appearance: none; appearance: none; height: 3px; border-radius: 999px; background: var(--bg-alt); outline: none; width: 80px; cursor: pointer; }
    .fl-sl input[type="range"]::-webkit-slider-thumb { -webkit-appearance: none; width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); box-shadow: 0 0 0 1px var(--accent); cursor: pointer; }
    .fl-sl input[type="range"]::-moz-range-thumb { width: 14px; height: 14px; border-radius: 50%; background: var(--accent); border: 2px solid var(--bg); cursor: pointer; }
    .fl-sl .fl-v { font-family: var(--mono); font-size: 11px; font-weight: 600; color: var(--ink); min-width: 50px; text-align: right; }

    .fl-view { display: flex; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; background: var(--card); flex-shrink: 0; }
    .fl-view button { width: 32px; height: 32px; display: grid; place-items: center; font-size: 13px; color: var(--muted); border-right: 1px solid var(--line); }
    .fl-view button:last-child { border-right: none; }
    .fl-view button.on { background: var(--ink); color: var(--bg); }

    .fl-diets { display: flex; gap: 5px; flex-wrap: wrap; align-items: center; }
    .fl-diet { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.14em; text-transform: uppercase; padding: 6px 10px; border-radius: 999px; border: 1px dashed var(--line); color: var(--muted); font-weight: 600; transition: all .15s; }
    .fl-diet:hover { border-style: solid; border-color: var(--ink); color: var(--ink); }
    .fl-diet.active { background: var(--ink); color: var(--accent-2); border-color: var(--ink); border-style: solid; }

    .fl-result { font-family: var(--mono); font-size: 9.5px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-left: auto; white-space: nowrap; }
    .fl-result strong { font-family: 'Bricolage Grotesque', system-ui, sans-serif; color: var(--ink); font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }

    @media (max-width: 1100px) { .fl-inner { padding: 10px 16px; } .fl-sl { display: none; } .fl-spacer { display: none; } }

    /* ─── BODY ─── */
    .rx-body { max-width: 1360px; margin: 0 auto; padding: 36px 32px 80px; }
    .rx-section { margin-bottom: 52px; }
    @media (max-width: 1100px) { .rx-body { padding: 24px 16px 60px; } }

    .sec-head { display: flex; align-items: flex-end; gap: 24px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
    .sec-head h2 { font-size: clamp(24px, 3vw, 38px); font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
    .sec-head h2 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--accent); }
    .sec-head p { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: 14px; color: var(--muted); margin-left: auto; text-align: right; line-height: 1.45; max-width: 30ch; }
    @media (max-width: 900px) { .sec-head { flex-direction: column; align-items: flex-start; } .sec-head p { margin-left: 0; text-align: left; } }

    /* ─── COLLECTIONS ─── */
    .col-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
    .col-card { position: relative; border-radius: 16px; overflow: hidden; cursor: pointer; aspect-ratio: 4/5; transition: transform .2s; }
    .col-card:hover { transform: translateY(-3px); }
    .col-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .col-card:hover img { transform: scale(1.06); }
    .col-card::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 30%, rgba(22,17,15,.78) 100%); }
    .col-card.rose::after { background: linear-gradient(180deg, transparent 30%, color-mix(in oklab, var(--accent) 82%, transparent) 100%); }
    .col-card.lime::after { background: linear-gradient(180deg, transparent 30%, color-mix(in oklab, var(--accent-2) 82%, transparent) 100%); }
    .col-card.lime .col-body { color: var(--ink); }
    .col-card.lime .col-count { background: rgba(22,17,15,.15); }
    .col-card.orange::after { background: linear-gradient(180deg, transparent 30%, color-mix(in oklab, var(--accent-3) 86%, transparent) 100%); }
    .col-placeholder { width: 100%; height: 100%; background: var(--bg-alt); }
    .col-body { position: absolute; left: 14px; right: 14px; bottom: 14px; color: #fff; z-index: 2; }
    .col-count { font-family: var(--mono); font-size: 8.5px; letter-spacing: 0.18em; text-transform: uppercase; opacity: .9; margin-bottom: 6px; display: inline-block; padding: 3px 7px; background: rgba(0,0,0,.38); border-radius: 4px; backdrop-filter: blur(4px); }
    .col-title { font-size: 17px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; }
    .col-sub { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: 12px; line-height: 1.3; margin-top: 6px; opacity: .88; }
    .col-stack { position: absolute; top: 12px; right: 12px; display: flex; z-index: 2; }
    .col-thumb { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; border: 2px solid rgba(250,246,241,.7); margin-left: -8px; }
    .col-thumb:first-child { margin-left: 0; }
    @media (max-width: 1000px) { .col-strip { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 580px) { .col-strip { grid-template-columns: repeat(2, 1fr); gap: 8px; } }

    /* ─── RECIPE GRID ─── */
    .rx-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .rc-card { border-radius: 18px; overflow: hidden; background: var(--card); border: 1px solid var(--line); transition: transform .2s, box-shadow .2s, border-color .2s; display: flex; flex-direction: column; }
    .rc-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(22,17,15,.09); border-color: color-mix(in oklab, var(--line) 30%, var(--accent)); }
    .rc-card.hidden { display: none !important; }
    .rc-img { position: relative; aspect-ratio: 3/2; overflow: hidden; flex-shrink: 0; }
    .rc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .rc-card:hover .rc-img img { transform: scale(1.04); }
    .rc-img-grad { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(22,17,15,.4) 100%); }
    .rc-meal { position: absolute; top: 10px; left: 10px; font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; padding: 4px 8px; border-radius: 5px; background: rgba(250,246,241,.92); color: var(--ink); backdrop-filter: blur(4px); }
    .rc-heart { position: absolute; top: 10px; right: 10px; width: 32px; height: 32px; border-radius: 50%; background: rgba(250,246,241,.92); border: none; cursor: pointer; display: grid; place-items: center; font-size: 14px; transition: all .2s; backdrop-filter: blur(4px); z-index: 2; }
    .rc-heart:hover { transform: scale(1.12); }
    .rc-heart.saved { background: var(--accent); color: #fff; }
    .rc-time { position: absolute; bottom: 10px; right: 10px; font-family: var(--mono); font-size: 9px; letter-spacing: 0.08em; background: rgba(22,17,15,.7); color: #FFF6F0; padding: 3px 7px; border-radius: 5px; backdrop-filter: blur(4px); }
    .rc-info { padding: 14px 16px 0; flex: 1; }
    .rc-title { font-size: 14.5px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.3; margin-bottom: 3px; color: var(--ink); }
    .rc-desc { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: 12.5px; color: var(--muted); line-height: 1.4; }
    .rc-macros { display: flex; border-top: 1px solid var(--line); margin-top: 14px; padding: 10px 16px; font-family: var(--mono); }
    .rc-macro { flex: 1; text-align: center; }
    .rc-macro:not(:last-child) { border-right: 1px solid var(--line); }
    .rc-mv { font-size: 14px; font-weight: 700; letter-spacing: -0.02em; font-family: 'Bricolage Grotesque', system-ui, sans-serif; display: block; color: var(--ink); }
    .rc-ml { font-size: 8px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); display: block; margin-top: 1px; }

    /* List view */
    .rx-grid.list-view { grid-template-columns: 1fr; }
    .rx-grid.list-view .rc-card { flex-direction: row; }
    .rx-grid.list-view .rc-img { width: 140px; aspect-ratio: unset; flex-shrink: 0; }
    .rx-grid.list-view .rc-img img { width: 140px; height: 100%; }
    .rx-grid.list-view .rc-info { padding: 16px 18px; }
    .rx-grid.list-view .rc-macros { border-top: none; border-left: 1px solid var(--line); padding: 16px 20px; margin-top: 0; flex-direction: column; gap: 6px; width: 160px; flex-shrink: 0; }
    .rx-grid.list-view .rc-macro { border-right: none !important; text-align: left; display: flex; align-items: center; gap: 8px; }
    .rx-grid.list-view .rc-macro .rc-mv { font-size: 13px; }
    .rx-grid.list-view .rc-macro .rc-ml { margin-top: 0; }

    .no-results { display: none; text-align: center; padding: 60px 20px; }
    .no-results.show { display: block; }
    .no-results h3 { font-size: 18px; font-weight: 600; margin-bottom: 6px; color: var(--ink-soft); }
    .no-results p { color: var(--muted); font-size: 13.5px; }

    @media (max-width: 1100px) { .rx-grid { grid-template-columns: repeat(2, 1fr); } .rx-grid.list-view .rc-macros { display: none; } }
    @media (max-width: 600px) { .rx-grid { grid-template-columns: 1fr; } .rx-grid.list-view { grid-template-columns: 1fr; } }

    /* ─── KITCHEN ─── */
    .kitchen { background: var(--ink); border-radius: 24px; padding: 32px 36px; color: #FFF6F0; }
    .kc-head { margin-bottom: 22px; }
    .kc-head h2 { font-size: 28px; font-weight: 600; letter-spacing: -0.03em; margin-bottom: 4px; }
    .kc-head h2 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; color: var(--accent); }
    .kc-sub { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: 14px; color: rgba(255,246,240,.48); }
    .kc-board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
    .kc-thumb { border-radius: 14px; overflow: hidden; position: relative; aspect-ratio: 1; cursor: pointer; transition: transform .2s; display: block; }
    .kc-thumb:hover { transform: scale(1.03); }
    .kc-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .kc-thumb::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(22,17,15,.75) 100%); }
    .kc-thumb-lbl { position: absolute; bottom: 8px; left: 8px; right: 8px; z-index: 2; font-size: 10px; font-weight: 600; color: #FFF6F0; line-height: 1.2; }
    .kc-empty { grid-column: 1/-1; text-align: center; padding: 40px 20px; color: rgba(255,246,240,.38); }
    .kc-empty h3 { font-size: 17px; font-weight: 600; margin-bottom: 6px; }
    .kc-empty p { font-size: 13px; line-height: 1.5; }
    @media (max-width: 900px) { .kitchen { padding: 24px 20px; } .kc-board { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 580px) { .kc-board { grid-template-columns: repeat(2, 1fr); } }

    /* ─── TOAST ─── */
    .toast { position: fixed; bottom: 24px; right: 24px; z-index: 9999; background: var(--ink); color: #FFF6F0; padding: 12px 20px; border-radius: 12px; font-size: 13px; font-weight: 600; box-shadow: 0 8px 24px rgba(22,17,15,.28); transform: translateY(16px); opacity: 0; pointer-events: none; transition: all .3s cubic-bezier(.4,0,.2,1); }
    .toast.show { transform: translateY(0); opacity: 1; }

    @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>

<div class="rx-shell">
  <Sidebar userName={userName} planType={planType} tierLabel={tierLabel} currentDay={currentDay} avatarUrl={profile.avatar_url} activePage="recipes" />
  <main class="rx-main">

    <!-- ── TONIGHT ── -->
    <section class="tonight">
      <div class="tn-inner">
        <div>
          <div class="tn-label"><span class="tn-dot"></span>Tonight's Table</div>
          <h2 class="tn-title">Your keto kitchen,<br /><em>curated for today.</em></h2>
          <p class="tn-sub">Day {currentDay} &middot; Dinner picks aligned with your keto goals.</p>
          {hasTn && (
            <a href={`/dashboard/recipe/${tn0.id}`} class="tn-pick-btn">View top pick &rarr;</a>
          )}
        </div>

        {hasTn && (
          <div class="tn-cards">
            <!-- Hero -->
            <a class="tn-card tn-card-hero" href={`/dashboard/recipe/${tn0.id}`}>
              <img src={tn0.image_url} alt={tn0.title} loading="eager" />
              <div class="tn-card-body">
                <div class="tn-rank">Pick #1</div>
                <div class="tn-name">{tn0.title}</div>
                <div class="tn-macros">
                  <span class="tn-chip">{tn0.calories} kcal</span>
                  <span class="tn-chip">{tn0.fat}g fat</span>
                  <span class="tn-chip tn-chip-green">{tn0.net_carbs}g net</span>
                </div>
                <div class="tn-btns">
                  <span class="tn-btn-p">View recipe</span>
                </div>
              </div>
            </a>
            <!-- Small cards -->
            {hasSmalls && (
              <div class="tn-smalls">
                <a class="tn-card tn-card-sm" href={`/dashboard/recipe/${tn1.id}`}>
                  <img src={tn1.image_url} alt={tn1.title} loading="lazy" />
                  <div class="tn-card-body">
                    <div class="tn-rank">Pick #2</div>
                    <div class="tn-name">{tn1.title}</div>
                    <div class="tn-macros">
                      <span class="tn-chip">{tn1.calories} kcal</span>
                      <span class="tn-chip tn-chip-green">{tn1.net_carbs}g net</span>
                    </div>
                  </div>
                </a>
                {tn2 && (
                  <a class="tn-card tn-card-sm" href={`/dashboard/recipe/${tn2.id}`}>
                    <img src={tn2.image_url} alt={tn2.title} loading="lazy" />
                    <div class="tn-card-body">
                      <div class="tn-rank">Pick #3</div>
                      <div class="tn-name">{tn2.title}</div>
                      <div class="tn-macros">
                        <span class="tn-chip">{tn2.calories} kcal</span>
                        <span class="tn-chip tn-chip-green">{tn2.net_carbs}g net</span>
                      </div>
                    </div>
                  </a>
                )}
              </div>
            )}
          </div>
        )}
        {!hasTn && (
          <p style="color:rgba(255,246,240,.35);font-size:14px;">No dinner recipes found.</p>
        )}
      </div>
    </section>

    <!-- ── FILTER BAR ── -->
    <div class="fl" id="filterBar">
      <div class="fl-inner">
        <div class="fl-row">
          <div class="fl-search">
            <span class="fl-search-ic">&#x2315;</span>
            <input id="rxSearch" type="text" placeholder="Search recipes&hellip;" autocomplete="off" />
          </div>

          <div class="fl-pills" id="mealPills">
            {['All','Breakfast','Lunch','Dinner','Snack','Dessert','Smoothie'].map(m => (
              <button class={`fl-pill${m === 'All' ? ' active' : ''}`} data-meal={m}>{m}</button>
            ))}
          </div>

          <div class="fl-spacer"></div>

          <div class="fl-sl">
            <span class="fl-l">TIME</span>
            <input type="range" id="timeSlider" min="5" max="90" step="5" value="90" />
            <span class="fl-v" id="timeVal">Any</span>
          </div>

          <div class="fl-sl">
            <span class="fl-l">NET CARBS</span>
            <input type="range" id="carbSlider" min="1" max="20" step="1" value="20" />
            <span class="fl-v" id="carbVal">&le; 20g</span>
          </div>

          <div class="fl-view" id="viewToggle">
            <button class="on" data-view="grid" title="Grid">&#x229E;</button>
            <button data-view="list" title="List">&#x2261;</button>
          </div>
        </div>

        <div class="fl-row">
          <span style="font-family:var(--mono);font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-right:4px;">DIET</span>
          <div class="fl-diets" id="dietChips">
            {['Vegetarian','Dairy-free','Gluten-free','No-cook','Quick','Batch-friendly'].map(d => (
              <button class="fl-diet" data-diet={d.toLowerCase()}>{d}</button>
            ))}
          </div>
          <div class="fl-result"><strong id="resultNum">{allRecipes.length}</strong>&nbsp;recipes</div>
        </div>
      </div>
    </div>

    <!-- ── BODY ── -->
    <div class="rx-body">

      <!-- COLLECTIONS -->
      <section class="rx-section">
        <div class="sec-head">
          <h2>Collections, <em>built for the days you're having</em>.</h2>
          <p>Themed bundles. Click to filter the library below.</p>
        </div>
        <div class="col-strip">
          {colCards.map((c) => (
            <div class={`col-card ${c.tone}`} onclick={`window.applyColFilter('${c.filter}')`} role="button" tabindex="0">
              {c.cover
                ? <img src={c.cover} alt={c.title} loading="lazy" />
                : <div class="col-placeholder"></div>
              }
              <div class="col-stack">
                {c.thumbs.map((p) => (
                  <img class="col-thumb" src={p.image_url} alt={p.title} loading="lazy" />
                ))}
              </div>
              <div class="col-body">
                <div class="col-count">{c.count} recipes</div>
                <div class="col-title">{c.title}</div>
                <div class="col-sub">{c.sub}</div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- RECIPE GRID -->
      <section class="rx-section">
        <div class="sec-head">
          <h2>The library, <em>every recipe</em>.</h2>
          <p>Browse and filter. Use the bar above to narrow down.</p>
        </div>

        <div class="rx-grid" id="rxGrid">
          {recipeCards.map((r) => (
            <div
              class="rc-card"
              data-id={r.id}
              data-meal={r.meal}
              data-net={r.net_carbs}
              data-time={r.totalTime}
              data-protein={r.protein}
              data-tags={r.tagsStr}
            >
              <div class="rc-img">
                <img src={r.image_url} alt={r.title} loading="lazy" />
                <div class="rc-img-grad"></div>
                <span class="rc-meal">{r.meal}</span>
                <button
                  class={`rc-heart${r.isFaved ? ' saved' : ''}`}
                  data-id={r.id}
                  data-saved={r.isFaved ? '1' : '0'}
                  onclick="window.toggleSave(this)"
                  aria-label={r.isFaved ? 'Unsave recipe' : 'Save recipe'}
                >
                  {r.isFaved ? '♥' : '♡'}
                </button>
                {r.totalTime > 0 && <span class="rc-time">{r.totalTime} min</span>}
              </div>
              <a href={`/dashboard/recipe/${r.id}`} class="rc-info">
                <div class="rc-title">{r.title}</div>
                {r.descFull && <div class="rc-desc">{r.descFull}</div>}
              </a>
              <div class="rc-macros">
                <div class="rc-macro">
                  <span class="rc-mv">{r.calories}</span>
                  <span class="rc-ml">kcal</span>
                </div>
                <div class="rc-macro">
                  <span class="rc-mv">{r.fat}g</span>
                  <span class="rc-ml">fat</span>
                </div>
                <div class="rc-macro">
                  <span class="rc-mv">{r.protein}g</span>
                  <span class="rc-ml">protein</span>
                </div>
                <div class="rc-macro">
                  <span class="rc-mv">{r.net_carbs}g</span>
                  <span class="rc-ml">net</span>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="no-results" id="noResults">
          <h3>No recipes match</h3>
          <p>Try adjusting your filters or search term.</p>
        </div>
      </section>

      <!-- KITCHEN -->
      <section class="rx-section">
        <div class="kitchen">
          <div class="kc-head">
            <h2>Your kitchen, <em>saved for later</em>.</h2>
            <p class="kc-sub">Recipes you&rsquo;ve hearted. Tap any to open.</p>
          </div>
          <div class="kc-board">
            {savedRecipes.map((r) => (
              <a class="kc-thumb" href={`/dashboard/recipe/${r.id}`}>
                <img src={r.image_url} alt={r.title} loading="lazy" />
                <span class="kc-thumb-lbl">{r.title}</span>
              </a>
            ))}
            {savedRecipes.length === 0 && (
              <div class="kc-empty">
                <h3>Nothing saved yet</h3>
                <p>Tap &hearts; on any recipe above to save it here.</p>
              </div>
            )}
          </div>
        </div>
      </section>

    </div><!-- rx-body -->
  </main>
</div>

<div class="toast" id="toast"></div>

<script is:inline>
(function() {
  var _state = { meal: 'All', search: '', time: 90, net: 20, diets: [], view: 'grid' };

  function applyFilters() {
    var cards = document.querySelectorAll('#rxGrid .rc-card');
    var visible = 0;
    cards.forEach(function(card) {
      var meal = card.dataset.meal || '';
      var net = parseFloat(card.dataset.net) || 0;
      var time = parseFloat(card.dataset.time) || 0;
      var tags = (card.dataset.tags || '').split(',');
      var titleEl = card.querySelector('.rc-title');
      var title = titleEl ? titleEl.textContent.toLowerCase() : '';
      var show = true;
      if (_state.meal !== 'All' && meal !== _state.meal) show = false;
      if (_state.search && title.indexOf(_state.search) === -1) show = false;
      if (net > _state.net) show = false;
      if (_state.time < 90 && time > _state.time && time > 0) show = false;
      if (_state.diets.length > 0) {
        var dietMatch = _state.diets.some(function(d) {
          return tags.some(function(tag) { return tag.trim() === d; });
        });
        if (!dietMatch) show = false;
      }
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    var numEl = document.getElementById('resultNum');
    if (numEl) numEl.textContent = visible;
    var noRes = document.getElementById('noResults');
    if (noRes) noRes.classList.toggle('show', visible === 0);
  }

  // Meal pills
  var pills = document.getElementById('mealPills');
  if (pills) {
    pills.addEventListener('click', function(e) {
      var btn = e.target.closest('.fl-pill');
      if (!btn) return;
      _state.meal = btn.dataset.meal;
      pills.querySelectorAll('.fl-pill').forEach(function(p) { p.classList.remove('active'); });
      btn.classList.add('active');
      applyFilters();
    });
  }

  // Search
  var searchEl = document.getElementById('rxSearch');
  if (searchEl) {
    searchEl.addEventListener('input', function(e) {
      _state.search = e.target.value.toLowerCase().trim();
      applyFilters();
    });
  }

  // Time slider
  var timeSlider = document.getElementById('timeSlider');
  var timeVal = document.getElementById('timeVal');
  if (timeSlider && timeVal) {
    timeSlider.addEventListener('input', function(e) {
      _state.time = parseInt(e.target.value);
      timeVal.textContent = _state.time >= 90 ? 'Any' : '≤ ' + _state.time + ' min';
      applyFilters();
    });
  }

  // Carb slider
  var carbSlider = document.getElementById('carbSlider');
  var carbVal = document.getElementById('carbVal');
  if (carbSlider && carbVal) {
    carbSlider.addEventListener('input', function(e) {
      _state.net = parseInt(e.target.value);
      carbVal.textContent = '≤ ' + _state.net + 'g';
      applyFilters();
    });
  }

  // View toggle
  var viewToggle = document.getElementById('viewToggle');
  if (viewToggle) {
    viewToggle.addEventListener('click', function(e) {
      var btn = e.target.closest('button');
      if (!btn || !btn.dataset.view) return;
      _state.view = btn.dataset.view;
      viewToggle.querySelectorAll('button').forEach(function(b) { b.classList.remove('on'); });
      btn.classList.add('on');
      var grid = document.getElementById('rxGrid');
      if (grid) grid.classList.toggle('list-view', _state.view === 'list');
    });
  }

  // Diet chips
  var dietChips = document.getElementById('dietChips');
  if (dietChips) {
    dietChips.addEventListener('click', function(e) {
      var btn = e.target.closest('.fl-diet');
      if (!btn) return;
      var diet = btn.dataset.diet;
      var idx = _state.diets.indexOf(diet);
      if (idx > -1) { _state.diets.splice(idx, 1); btn.classList.remove('active'); }
      else { _state.diets.push(diet); btn.classList.add('active'); }
      applyFilters();
    });
  }

  // Collection filter shortcut
  window.applyColFilter = function(filter) {
    if (filter === 'low-carb') {
      _state.net = 5;
      if (carbSlider) carbSlider.value = 5;
      if (carbVal) carbVal.textContent = '≤ 5g';
    }
    if (filter === 'quick') {
      _state.time = 20;
      if (timeSlider) timeSlider.value = 20;
      if (timeVal) timeVal.textContent = '≤ 20 min';
    }
    if (filter === 'dinner' || filter === 'breakfast') {
      var meal = filter === 'dinner' ? 'Dinner' : 'Breakfast';
      _state.meal = meal;
      if (pills) {
        pills.querySelectorAll('.fl-pill').forEach(function(p) {
          p.classList.toggle('active', p.dataset.meal === meal);
        });
      }
    }
    if (filter === 'high-protein') {
      _state.search = '';
    }
    applyFilters();
    var grid = document.getElementById('rxGrid');
    if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  // Save toggle
  window.toggleSave = function(btn) {
    var id = btn.dataset.id;
    var wasSaved = btn.dataset.saved === '1';
    var nowSaved = !wasSaved;
    btn.dataset.saved = nowSaved ? '1' : '0';
    btn.textContent = nowSaved ? '♥' : '♡';
    btn.classList.toggle('saved', nowSaved);
    showToast(nowSaved ? '♥ Saved to favorites' : 'Removed from favorites');
    fetch('/api/recipes/favorite', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ recipeId: id, favorited: nowSaved }),
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d && d.error) {
        btn.dataset.saved = wasSaved ? '1' : '0';
        btn.textContent = wasSaved ? '♥' : '♡';
        btn.classList.toggle('saved', wasSaved);
        showToast('Could not save — try again');
      }
    }).catch(function() {
      btn.dataset.saved = wasSaved ? '1' : '0';
      btn.textContent = wasSaved ? '♥' : '♡';
      btn.classList.toggle('saved', wasSaved);
      showToast('Could not save — try again');
    });
  };

  function showToast(msg) {
    var t = document.getElementById('toast');
    if (!t) return;
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(function() { t.classList.remove('show'); }, 2600);
  }
  window.showToast = showToast;
})();
</script>

</body>
</html>
