---
// src/pages/dashboard/community.astro â€” Community (Rose Vital editorial design)
import { requireAuth } from '../../lib/auth';
import Sidebar from '../../components/Sidebar.astro';
import { getTranslator, normaliseLang } from '../../lib/i18n';

const auth = await requireAuth(Astro);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { user, profile, db } = auth;

if (profile.subscription_tier === 'basic_30' || !profile.subscription_tier) {
  return Astro.redirect('/dashboard/upgrade');
}

const planType  = profile.subscription_tier;
const userName  = profile.full_name || 'Member';
const tierLabel = planType === 'elite_12' ? 'Elite' : 'Pro';
const lang = normaliseLang(Astro.cookies.get('keto-lang')?.value);
const t    = getTranslator(lang);

const [memberRes, journeyRes, weightRes, onboardingRes] = await Promise.allSettled([
  db.from('profiles').select('id', { count: 'exact', head: true }).in('subscription_tier', ['pro_6', 'elite_12']),
  db.from('user_journey').select('current_day,streak_days,total_xp,level').eq('user_id', user.id).maybeSingle(),
  db.from('weight_logs').select('weight').eq('user_id', user.id).order('logged_date', { ascending: false }).limit(1).maybeSingle(),
  db.from('onboarding_data').select('current_weight').eq('user_id', user.id).maybeSingle(),
]);

const memberCount  = memberRes.status    === 'fulfilled' ? (memberRes.value?.count    ?? 0) : 0;
const journey      = journeyRes.status   === 'fulfilled' ? (journeyRes.value?.data    ?? null) : null;
const latestWtRow  = weightRes.status    === 'fulfilled' ? (weightRes.value?.data     ?? null) : null;
const onboarding   = onboardingRes.status === 'fulfilled' ? (onboardingRes.value?.data ?? null) : null;

const startWtKg    = onboarding?.current_weight || profile.weight_kg || 0;
const latestWtKg   = latestWtRow?.weight || startWtKg;
const weightLostKg = Math.max(0, Math.round((startWtKg - latestWtKg) * 10) / 10);
const currentDay   = journey?.current_day || 1;

const dayClubRes   = await db.from('user_journey').select('id', { count: 'exact', head: true }).eq('current_day', currentDay);
const dayClubCount = dayClubRes.count || 0;

const myProgressData = {
  day:        currentDay,
  streak:     journey?.streak_days || 0,
  level:      journey?.level       || 1,
  xp:         journey?.total_xp    || 0,
  weightLost: weightLostKg,
  unit:       'kg',
};

const showWeightLost = weightLostKg > 0;
const userInitial    = userName.charAt(0).toUpperCase();
const firstName      = userName.split(' ')[0];
const challengePct   = Math.min(100, Math.round((currentDay / 28) * 100));
const challengePctStyle = `width:${challengePct}%`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Community Â· Keto Journey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
</head>
<body>
<div class="rv-pg-shell">
<Sidebar userName={userName} planType={planType} tierLabel={tierLabel} currentDay={currentDay} avatarUrl={profile.avatar_url} activePage="community" />
<div class="rv-pg-main">

  <!-- â•â• HERO â•â• -->
  <header class="ch">
    <div class="ch-noise"></div>
    <div class="ch-inner">
      <p class="ch-eyebrow">KETO JOURNEY Â· {tierLabel.toUpperCase()} COMMUNITY</p>
      <h1 class="ch-title">Share your <em>wins,</em><br>find your people.</h1>
      <p class="ch-sub">{memberCount} members growing stronger together</p>
      <div class="ch-pulse">
        <div class="pulse-cell pulse-featured">
          <div class="pulse-lbl">MEMBERS</div>
          <div class="pulse-num">{memberCount}</div>
          <div class="pulse-desc">Pro &amp; Elite</div>
        </div>
        <div class="pulse-cell">
          <div class="pulse-lbl">YOUR DAY</div>
          <div class="pulse-num">{currentDay}</div>
          <div class="pulse-desc">of journey</div>
        </div>
        <div class="pulse-cell">
          <div class="pulse-lbl">DAY CLUB</div>
          <div class="pulse-num">{dayClubCount}</div>
          <div class="pulse-desc">same day as you</div>
        </div>
        <div class="pulse-cell">
          <div class="pulse-lbl">STREAK</div>
          <div class="pulse-num">{myProgressData.streak}</div>
          <div class="pulse-desc">days ðŸ”¥</div>
        </div>
        <div class="pulse-cell">
          <div class="pulse-lbl">LEVEL</div>
          <div class="pulse-num">{myProgressData.level}</div>
          <div class="pulse-desc">â­ {myProgressData.xp} XP</div>
        </div>
      </div>
    </div>
  </header>

  <!-- â•â• BODY â•â• -->
  <div class="co-body">
    <div class="co-layout">

      <!-- â”€â”€â”€ FEED â”€â”€â”€ -->
      <section class="feed-col">

        <div id="feedTabs" class="feed-tabs">
          <button class="feed-tab on" data-cat="all">All</button>
          <button class="feed-tab" data-cat="progress">Progress</button>
          <button class="feed-tab" data-cat="recipes">Recipes</button>
          <button class="feed-tab" data-cat="tips">Tips</button>
          <button class="feed-tab" data-cat="motivation">Motivation</button>
          <button class="feed-tab" data-cat="general">General</button>
        </div>

        <div class="composer">
          <div class="composer-av">{userInitial}</div>
          <div class="composer-body">
            <button id="comWriteBtn" class="composer-prompt">What's happening on Day {currentDay}, {firstName}?</button>
            <div class="composer-actions">
              <button id="quickPhotoBtn" class="composer-action">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                Photo
              </button>
              <button id="quickProgressBtn" class="composer-action">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                Progress
              </button>
              <button id="openPostBtn" class="composer-post">Post</button>
            </div>
          </div>
        </div>

        <div id="postsList">
          <div class="co-loading"><div class="co-spinner"></div></div>
        </div>
        <button id="loadMoreBtn" style="display:none" class="load-more-btn">Load more posts</button>

      </section>

      <!-- â”€â”€â”€ RAIL â”€â”€â”€ -->
      <aside class="rail">

        <div class="rail-card">
          <div class="rail-title">Your Journey</div>
          <div class="journey-rows">
            <div class="jr"><span class="jr-icon">ðŸ“…</span><span class="jr-label">Day</span><strong class="jr-val jr-accent">{currentDay}</strong></div>
            <div class="jr"><span class="jr-icon">ðŸ”¥</span><span class="jr-label">Streak</span><strong class="jr-val">{myProgressData.streak} days</strong></div>
            <div class="jr"><span class="jr-icon">â­</span><span class="jr-label">Level</span><strong class="jr-val">{myProgressData.level}</strong></div>
            <div class="jr"><span class="jr-icon">âœ¦</span><span class="jr-label">XP</span><strong class="jr-val">{myProgressData.xp}</strong></div>
            {showWeightLost && (
              <div class="jr"><span class="jr-icon">âš–ï¸</span><span class="jr-label">Lost</span><strong class="jr-val jr-accent">{weightLostKg} kg</strong></div>
            )}
          </div>
          <button id="sidebarProgressBtn" class="share-btn">â†— Share my progress</button>
        </div>

        <div class="rail-card">
          <div class="rail-title">Day {currentDay} Club</div>
          <p class="rail-sub">{dayClubCount} members on the same day as you</p>
          <div class="daymates">
            <div class="dm-av" style="background:#FF5C7A">K</div>
            <div class="dm-av" style="background:#3b82f6">M</div>
            <div class="dm-av" style="background:#8b5cf6">A</div>
            <div class="dm-av" style="background:#f59e0b">S</div>
            {dayClubCount > 4 && <div class="dm-av dm-more">+{dayClubCount - 4}</div>}
          </div>
        </div>

        <div class="rail-card rail-dark">
          <div class="challenge-badge">ACTIVE CHALLENGE</div>
          <div class="challenge-title">No Sugar<br><em>28-Day</em></div>
          <div class="challenge-progress">
            <div class="cp-track"><div class="cp-fill" style={challengePctStyle}></div></div>
            <span class="cp-pct">{challengePct}%</span>
          </div>
          <p class="challenge-sub">Day {currentDay} of 28 â€” keep going!</p>
        </div>

        <div class="rail-card">
          <div class="rail-title">Community Rules</div>
          <ol class="rules-list">
            <li>Be kind and supportive</li>
            <li>No spam or self-promotion</li>
            <li>Share accurate health info</li>
            <li>Respect everyone's journey</li>
            <li>No personal attacks</li>
          </ol>
        </div>

      </aside>
    </div>
  </div>

  <!-- â•â• CREATE POST MODAL â•â• -->
  <div id="postModal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-head">
        <h2 class="modal-h">Create Post</h2>
        <button id="closeModal" class="modal-close">Ã—</button>
      </div>
      <div class="modal-author-row">
        <div class="modal-av">{userInitial}</div>
        <div>
          <div class="modal-name">{userName}</div>
          <select id="postCategory" class="cat-select">
            <option value="general">ðŸ’¬ General</option>
            <option value="progress">ðŸ“ˆ Progress Update</option>
            <option value="recipes">ðŸ³ Recipe Share</option>
            <option value="tips">ðŸ’¡ Tips &amp; Tricks</option>
            <option value="motivation">ðŸ”¥ Motivation</option>
          </select>
        </div>
      </div>
      <div id="postModeTabs" class="mode-tabs">
        <button class="com-mode-tab active" data-mode="text">âœï¸ Text</button>
        <button class="com-mode-tab" data-mode="photo">ðŸ“· Photo</button>
        <button class="com-mode-tab" data-mode="progress">ðŸ“Š Progress</button>
      </div>
      <div id="modeText" class="mode-panel">
        <textarea id="postContent" class="modal-ta" placeholder="Share your progress, a recipe, tip or winâ€¦" maxlength="2000"></textarea>
      </div>
      <div id="modePhoto" class="mode-panel" style="display:none">
        <div id="photoDropzone">
          <input type="file" id="photoFileInput" accept="image/jpeg,image/png,image/webp" style="display:none" />
          <button id="photoPickBtn" class="photo-pick">ðŸ“· Choose a photo</button>
          <p class="photo-hint">JPEG Â· PNG Â· WebP Â· max 2 MB</p>
        </div>
        <div id="photoPreviewWrap" style="display:none">
          <img id="photoPreviewImg" src="" alt="Preview" class="photo-preview" />
          <button id="photoRemoveBtn" class="photo-remove">âœ• Remove</button>
        </div>
        <textarea id="photoCaption" class="modal-ta" style="min-height:72px;border-top:1px solid var(--line)" placeholder="Add a caption (optional)â€¦" maxlength="500"></textarea>
        <p id="photoUploadError" class="modal-err" style="padding:.25rem 1.25rem .5rem"></p>
      </div>
      <div id="modeProgress" class="mode-panel" style="display:none">
        <div class="pp-card" id="progressPreviewCard">
          <div class="pp-card-label">ðŸ“Š Your Progress</div>
          <div class="pp-grid">
            <div class="pp-stat"><div class="pp-val" id="ppStreak">0</div><div class="pp-lbl">Day Streak ðŸ”¥</div></div>
            <div class="pp-stat"><div class="pp-val" id="ppDay">1</div><div class="pp-lbl">Journey Day</div></div>
            <div class="pp-stat"><div class="pp-val" id="ppLevel">1</div><div class="pp-lbl">Level â­</div></div>
            <div class="pp-stat" id="ppWeightWrap" style="display:none">
              <div class="pp-val" id="ppWeight">0</div>
              <div class="pp-lbl" id="ppWeightLbl">kg lost âš–ï¸</div>
            </div>
          </div>
        </div>
        <textarea id="progressCaption" class="modal-ta" style="min-height:72px;border-top:1px solid var(--line)" placeholder="Add a message (optional)â€¦" maxlength="500"></textarea>
      </div>
      <div class="modal-char-row">
        <span id="postError" class="modal-err"></span>
        <span id="charCount" class="modal-count">0 / 2000</span>
      </div>
      <div class="modal-footer">
        <button id="cancelPost" class="btn-ghost">Cancel</button>
        <button id="submitPost" class="btn-primary">Post</button>
      </div>
    </div>
  </div>

  <!-- â•â• REPORT MODAL â•â• -->
  <div id="reportModal" class="modal-overlay">
    <div class="modal-box" style="max-width:420px">
      <div class="modal-head">
        <h2 class="modal-h">Report Content</h2>
        <button id="closeReportModal" class="modal-close">Ã—</button>
      </div>
      <div style="padding:1.25rem">
        <p style="font-size:.85rem;color:var(--ink-soft);margin-bottom:1rem;line-height:1.5">Select a reason and our moderators will review this content.</p>
        <select id="reportReason" class="report-select">
          <option value="spam">Spam or self-promotion</option>
          <option value="harassment">Harassment or bullying</option>
          <option value="inappropriate">Inappropriate content</option>
          <option value="misinformation">Health misinformation</option>
          <option value="other">Other</option>
        </select>
        <div style="margin-top:.75rem;min-height:1.2rem"><span id="reportError" class="modal-err"></span></div>
      </div>
      <div class="modal-footer">
        <button id="closeReportModal2" class="btn-ghost" onclick="document.getElementById('reportModal').classList.remove('open')">Cancel</button>
        <button id="submitReport" class="btn-primary" style="background:#ef4444">Submit Report</button>
      </div>
    </div>
  </div>

  <!-- â•â• LIGHTBOX â•â• -->
  <div id="lightboxOverlay" onclick="closeLightbox()">
    <button id="lightboxClose" onclick="closeLightbox()">Ã—</button>
    <img id="lightboxImg" src="" alt="" />
  </div>

  <div id="comToast"></div>

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:       #FAF6F1;
      --bg-alt:   #F2EDE5;
      --ink:      #16110F;
      --ink-soft: #4A4340;
      --muted:    #8A8077;
      --line:     #E5DED2;
      --accent:   #FF5C7A;
      --accent-2: #B6FF3C;
      --accent-3: #FF914D;
      --card:     #FFFFFF;
      --display:  'Bricolage Grotesque', system-ui, sans-serif;
      --serif:    'Instrument Serif', Georgia, serif;
      /* legacy alias for JS-generated post cards */
      --border:   var(--line);
      --border2:  rgba(255,92,122,.28);
      --text:     var(--ink);
      --soft:     var(--ink-soft);
      --green:    var(--accent);
      --green2:   var(--accent-2);
      --gold:     #f59e0b;
      --purple:   #8b5cf6;
      --blue:     #3b82f6;
      --red:      #ef4444;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: var(--display);
      min-height: 100vh;
    }

    .rv-pg-shell { display: grid; grid-template-columns: 232px 1fr; min-height: 100vh; }
    .rv-pg-main  { overflow-y: auto; }
    @media (max-width: 900px) { .rv-pg-shell { grid-template-columns: 1fr; } }

    /* â•â• HERO â•â• */
    .ch {
      position: relative;
      background: var(--ink);
      color: var(--bg);
      overflow: hidden;
    }
    .ch-noise {
      position: absolute; inset: 0; opacity: .04;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      background-size: 200px;
    }
    .ch-inner {
      position: relative;
      max-width: 1280px; margin: 0 auto;
      padding: 3rem 2rem 0;
    }
    .ch-eyebrow {
      font-size: .68rem; font-weight: 700; letter-spacing: .14em;
      color: var(--accent); margin-bottom: 1rem;
    }
    .ch-title {
      font-family: var(--display);
      font-size: clamp(2.2rem, 5vw, 4rem);
      font-weight: 800; letter-spacing: -.03em;
      line-height: 1.1; margin-bottom: .75rem;
    }
    .ch-title em {
      font-family: var(--serif);
      font-style: italic;
      color: var(--accent);
    }
    .ch-sub {
      font-size: .88rem; color: rgba(250,246,241,.55); margin-bottom: 2rem;
    }

    /* Pulse strip */
    .ch-pulse {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr 1fr;
      border-radius: 16px 16px 0 0;
      overflow: hidden;
      border: 1px solid rgba(255,255,255,.08);
      border-bottom: none;
    }
    @media (max-width: 700px) {
      .ch-pulse { grid-template-columns: repeat(3, 1fr); border-radius: 14px 14px 0 0; }
      .pulse-cell:nth-child(n+4) { display: none; }
    }
    @media (max-width: 480px) {
      .ch-pulse { grid-template-columns: 1fr 1fr; }
      .pulse-cell:nth-child(n+3) { display: none; }
      .pulse-featured { display: flex; }
    }
    .pulse-cell {
      padding: 1.1rem 1rem .9rem;
      border-right: 1px solid rgba(255,255,255,.07);
      display: flex; flex-direction: column; gap: .2rem;
    }
    .pulse-cell:last-child { border-right: none; }
    .pulse-featured {
      background: rgba(255,92,122,.12);
      border-right-color: rgba(255,92,122,.2);
    }
    .pulse-lbl {
      font-size: .58rem; font-weight: 700; letter-spacing: .1em;
      color: rgba(250,246,241,.4); text-transform: uppercase;
    }
    .pulse-num {
      font-size: 1.6rem; font-weight: 800; letter-spacing: -.04em;
      color: var(--bg); line-height: 1;
    }
    .pulse-featured .pulse-num { color: var(--accent); }
    .pulse-desc { font-size: .68rem; color: rgba(250,246,241,.4); }

    /* â•â• BODY LAYOUT â•â• */
    .co-body {
      max-width: 1280px; margin: 0 auto;
      padding: 2rem 1.5rem 5rem;
    }
    .co-layout {
      display: grid;
      grid-template-columns: minmax(0,1fr) 340px;
      gap: 1.5rem;
      align-items: start;
    }
    @media (max-width: 1000px) { .co-layout { grid-template-columns: 1fr; } }
    @media (max-width: 640px)  { .co-body   { padding: 1.25rem .75rem 5rem; } }

    /* â”€â”€ Feed column â”€â”€ */
    .feed-col { display: flex; flex-direction: column; gap: 1rem; min-width: 0; }

    /* Feed tabs */
    .feed-tabs {
      display: flex; gap: .35rem; flex-wrap: wrap;
    }
    .feed-tab {
      padding: .42rem 1rem; border-radius: 999px;
      border: 1px solid var(--line);
      background: transparent; color: var(--ink-soft);
      font-size: .8rem; font-weight: 600;
      cursor: pointer; white-space: nowrap;
      transition: all .15s; font-family: inherit;
    }
    .feed-tab:hover  { border-color: var(--accent); color: var(--ink); }
    .feed-tab.on {
      background: var(--ink); color: var(--bg);
      border-color: var(--ink);
    }

    /* Composer */
    .composer {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: .85rem;
      align-items: start;
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 20px;
      padding: 1rem 1.1rem;
      box-shadow: 0 1px 3px rgba(22,17,15,.04);
    }
    .composer-av {
      width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
      background: linear-gradient(135deg, var(--accent), var(--accent-3));
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 1rem; color: #fff;
    }
    .composer-body { display: flex; flex-direction: column; gap: .6rem; }
    .composer-prompt {
      width: 100%; text-align: left;
      background: var(--bg-alt); border: 1px solid var(--line);
      border-radius: 999px; padding: .6rem 1.1rem;
      color: var(--muted); font-size: .88rem; font-family: inherit;
      cursor: pointer; transition: border-color .2s, color .2s;
    }
    .composer-prompt:hover { border-color: var(--accent); color: var(--ink); }
    .composer-actions { display: flex; gap: .4rem; flex-wrap: wrap; }
    .composer-action {
      display: flex; align-items: center; gap: .3rem;
      padding: .38rem .8rem; border-radius: 999px;
      border: 1px solid var(--line); background: transparent;
      color: var(--ink-soft); font-size: .78rem; font-weight: 600;
      cursor: pointer; transition: all .15s; font-family: inherit;
    }
    .composer-action:hover { border-color: var(--accent); color: var(--accent); }
    .composer-post {
      margin-left: auto; padding: .38rem 1.1rem; border-radius: 999px;
      background: var(--accent); color: #fff; border: none;
      font-size: .8rem; font-weight: 700; cursor: pointer;
      font-family: inherit; transition: opacity .2s;
    }
    .composer-post:hover { opacity: .88; }

    /* Load more */
    .load-more-btn {
      width: 100%; padding: .85rem; background: transparent;
      border: 1px dashed var(--line); border-radius: 14px;
      color: var(--muted); font-size: .85rem; cursor: pointer;
      transition: all .2s; font-family: inherit;
    }
    .load-more-btn:hover { color: var(--ink); border-color: var(--accent); }

    /* â•â• POST CARDS (generated by JS â€” com-* classes) â•â• */
    .com-post {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 20px; overflow: hidden;
      transition: border-color .2s, box-shadow .2s;
      animation: coFadeUp .28s ease both;
    }
    .com-post:hover { border-color: rgba(255,92,122,.3); box-shadow: 0 4px 20px rgba(22,17,15,.07); }
    @keyframes coFadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:none; } }

    .com-post-head { display: flex; align-items: center; gap: .75rem; padding: 1rem 1.1rem .75rem; }
    .com-av {
      width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
