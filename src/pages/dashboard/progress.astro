  .st-m-s { font-family: var(--serif); font-style: italic; font-size: 13px; color: color-mix(in oklab, #FAF6F1 72%, transparent); margin-top: 3px; line-height: 1.4; }
  .st-m-badge { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-size: 14px; background: color-mix(in oklab, #FAF6F1 8%, transparent); color: color-mix(in oklab, #FAF6F1 45%, transparent); }
  .st-m.earned .st-m-badge { background: var(--accent-2); color: #16110F; }
  .st-m.current .st-m-badge { background: var(--accent); color: #FAF6F1; box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 30%, transparent); }
  .st-m.future { opacity: 0.55; }

  /* ── Insights (always dark) ──────────────────────────────────────────── */
  .ins {
    --bg: #FAF6F1; --ink: #16110F; --accent: #FF5C7A; --accent-2: #B6FF3C; --accent-3: #FF914D;
