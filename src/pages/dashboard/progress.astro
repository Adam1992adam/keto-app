</style>

<script is:inline define:vars={{ wcPointsJson, WC_W, WC_H, WC_L, WC_R, WC_T, WC_B }}>
(function() {
  var wcPoints = JSON.parse(wcPointsJson);
  if (!wcPoints.length) return;

  var svg = document.getElementById('wcSvg');
  var wrap = document.getElementById('wcWrap');
  var tooltip = document.getElementById('wcTooltip');
  var crosshair = document.getElementById('wcCrosshair');
  var crossLine = document.getElementById('wcCrossLine');
  var crossDot = document.getElementById('wcCrossDot');
  var ttLabel = document.getElementById('wcTtLabel');
  var ttVal = document.getElementById('wcTtVal');
  var ttSub = document.getElementById('wcTtSub');
  if (!svg || !tooltip) return;

  svg.addEventListener('mousemove', function(e) {
    var rect = svg.getBoundingClientRect();
    var px = ((e.clientX - rect.left) / rect.width) * WC_W;
    if (px < WC_L || px > WC_W - WC_R) { hide(); return; }

    var nearest = null, minDist = Infinity;
    for (var i = 0; i < wcPoints.length; i++) {
      var dist = Math.abs(wcPoints[i].x - px);
      if (dist < minDist) { minDist = dist; nearest = wcPoints[i]; }
    }
    if (!nearest) { hide(); return; }

    crosshair.style.display = '';
    crossLine.setAttribute('x1', nearest.x); crossLine.setAttribute('x2', nearest.x);
    crossLine.setAttribute('y1', WC_T); crossLine.setAttribute('y2', WC_H - WC_B);
    crossDot.setAttribute('cx', nearest.x); crossDot.setAttribute('cy', nearest.y);

    ttLabel.textContent = 'DAY ' + nearest.day + ' · ' + new Date(nearest.date + 'T12:00:00').toLocaleDateString('en-US', { month: 'short', day: 'numeric' }).toUpperCase();
    ttVal.textContent = nearest.weight.toFixed(1) + nearest.unit;
    ttSub.textContent = 'Day ' + nearest.day + ' of journey';

    tooltip.style.display = '';
    tooltip.style.left = ((nearest.x / WC_W) * 100) + '%';
    tooltip.style.top = ((nearest.y / WC_H) * 100) + '%';
  });

  svg.addEventListener('mouseleave', hide);

  function hide() {
    crosshair.style.display = 'none';
    tooltip.style.display = 'none';
  }
})();
</script>

