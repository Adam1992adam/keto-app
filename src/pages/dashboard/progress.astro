    filter: blur(70px); bottom: -240px; left: -160px; pointer-events: none;
  }
  .ins-inner { position: relative; z-index: 1; }
  .ins-h { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; padding-bottom: 28px; border-bottom: 1px solid color-mix(in oklab, #FAF6F1 14%, transparent); margin-bottom: 28px; }
  .ins-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent-2); display: inline-flex; align-items: center; gap: 10px; margin-bottom: 14px; }
