---
import { getUserJourney, getMaxJourneyDays, kgToLbs, cmToInches, updateCurrentDay } from '../../lib/supabase';
import { requireAuth } from '../../lib/auth';
import { generateInsights } from '../../lib/insights';
import Sidebar from '../../components/Sidebar.astro';
import { getTranslator, normaliseLang } from '../../lib/i18n';

const auth = await requireAuth(Astro);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { user, profile, db } = auth;
const lang = normaliseLang(Astro.cookies.get('keto-lang')?.value);
const t = getTranslator(lang);
const planType = profile.subscription_tier || 'basic_30';

await updateCurrentDay(user.id).catch(() => null);

let journey = null as any;
try {
  journey = await getUserJourney(user.id, db);
} catch (e) {
  console.error('[Progress] DB unavailable:', e);
  return new Response(
    `<!DOCTYPE html><html><head><title>Temporarily Unavailable</title><meta http-equiv="refresh" content="15;url=/dashboard/progress"></head><body style="background:#FAF6F1;color:#16110F;font-family:system-ui,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;flex-direction:column;gap:1.2rem;text-align:center;padding:2rem"><h2 style="color:#FF5C7A">Keto Journey</h2><p>Progress page temporarily unavailable</p><a href="/dashboard/progress" style="color:#FF5C7A">Retry now</a></body></html>`,
    { status: 503, headers: { 'Content-Type': 'text/html' } }
  );
}
if (!journey) return Astro.redirect('/dashboard');

const currentDay = journey.current_day || 1;
const streakDays = journey.streak_days || 0;
const maxDays = getMaxJourneyDays(planType);
const userName = profile.full_name?.split(' ')[0] || 'there';

const units = profile.preferred_units || 'metric';
const wUnit = units === 'imperial' ? 'lbs' : 'kg';
const toW = (kg) => units === 'imperial' ? kgToLbs(kg) : Math.round(kg * 10) / 10;

const ninetyDaysAgo = new Date(Date.now() - 89 * 86400000).toISOString().split('T')[0];
const fourteenAgo = new Date(Date.now() - 13 * 86400000).toISOString().split('T')[0];

let progressBatch = new Array(12).fill({ data: null });
try {
  progressBatch = await Promise.all([
    db.from('weight_logs').select('weight, logged_date').eq('user_id', user.id).gte('logged_date', ninetyDaysAgo).order('logged_date', { ascending: true }).limit(90),
    db.from('onboarding_data').select('*').eq('user_id', user.id).maybeSingle(),
    db.from('daily_checkins').select('checkin_date, energy_level, mood_level, hunger_level, followed_meals, water_glasses').eq('user_id', user.id).order('checkin_date', { ascending: false }).limit(14),
    db.from('ketone_logs').select('ketone_mmol, logged_date').eq('user_id', user.id).order('logged_date', { ascending: false }).limit(14),
    db.from('body_measurements').select('logged_date, neck_cm, waist_cm, hips_cm, chest_cm, arm_cm, thigh_cm').eq('user_id', user.id).order('logged_date', { ascending: false }).limit(2),
    db.from('progress_photos').select('id, photo_data, taken_date, notes').eq('user_id', user.id).order('taken_date', { ascending: false }).limit(4),
    db.from('daily_checkins').select('checkin_date, energy_level').eq('user_id', user.id).gte('checkin_date', ninetyDaysAgo).order('checkin_date', { ascending: true }),
    db.from('macro_goals').select('daily_calories, protein_g, fat_g, carbs_g').eq('user_id', user.id).maybeSingle(),
    db.from('food_logs').select('logged_date, calories, protein_g, fat_g, carbs_g').eq('user_id', user.id).gte('logged_date', fourteenAgo).order('logged_date', { ascending: true }),
    db.from('daily_tasks').select('id').eq('user_id', user.id).eq('completed', true),
    db.from('habits').select('id').eq('user_id', user.id),
    db.from('xp_transactions').select('action_type, xp_amount').eq('user_id', user.id).order('created_at', { ascending: false }).limit(5),
  ]);
} catch (e) {
  console.error('[Progress] DB batch unavailable:', e);
}

const [
  { data: weightLogs },
  { data: onboarding },
  { data: checkins },
  { data: ketoneLogs },
  { data: measurements },
  { data: progressPhotos },
  { data: checkin90 },
  { data: macroGoals },
  { data: foodLogTrend },
  { data: completedTasksData },
] = progressBatch;

const smartInsights = await generateInsights(user.id, db, currentDay, streakDays).catch(() => []);

const startWeight = onboarding?.current_weight || profile.weight_kg || 0;
const targetWeight = onboarding?.target_weight || profile.target_weight_kg || 0;
const latestWeight = weightLogs?.[weightLogs.length - 1]?.weight || startWeight;
const weightLost = Math.max(0, startWeight - latestWeight);
const weightLeft = Math.max(0, latestWeight - targetWeight);
const weightGoalPct = targetWeight && startWeight > targetWeight
  ? Math.min(100, Math.round((weightLost / (startWeight - targetWeight)) * 100)) : 0;

const dispWeightLost = toW(weightLost).toFixed(1);
const dispLatest = toW(latestWeight).toFixed(1);
const dispStart = toW(startWeight).toFixed(1);
const dispTarget = toW(targetWeight).toFixed(1);
const dispLeft = toW(weightLeft).toFixed(1);

// avg weekly loss
const avgWeeklyLoss = weightLost > 0 && currentDay > 7
  ? (weightLost / (currentDay / 7)) : 0;
const dispAvgWeek = avgWeeklyLoss > 0 ? `−${toW(avgWeeklyLoss).toFixed(1)}` : '—';

// projected at goal day
const projectedWeight = avgWeeklyLoss > 0
  ? Math.round((latestWeight - avgWeeklyLoss * ((maxDays - currentDay) / 7)) * 10) / 10
  : latestWeight;
const dispProjected = toW(projectedWeight).toFixed(1);

// ── Spark helper ─────────────────────────────────────────────────────────────
const buildSpark = (values, w, h) => {
  if (!values || values.length < 2) return null;
  const pad = 6;
  const mn = Math.min(...values);
  const mx = Math.max(...values);
  const rng = (mx - mn) || 1;
  const pts = values.map((v, i) => ({
    x: (i / (values.length - 1)) * (w - pad * 2) + pad,
    y: h - pad - ((v - mn) / rng) * (h - pad * 2),
  }));
  const line = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
  const area = `${line} L ${pts[pts.length - 1].x.toFixed(1)} ${h} L ${pts[0].x.toFixed(1)} ${h} Z`;
  return { line, area, last: pts[pts.length - 1] };
};

// ── Hero sparkline ───────────────────────────────────────────────────────────
const sparkSeries = (weightLogs || []).map(w => w.weight);
const heroSpark = buildSpark(sparkSeries, 720, 80);

// ── Weight curve SVG ─────────────────────────────────────────────────────────
const startDateStr = journey?.start_date || new Date(Date.now() - (currentDay - 1) * 86400000).toISOString().split('T')[0];
const syArr = startDateStr.split('-').map(Number);
const startDateLocal = new Date(syArr[0], syArr[1] - 1, syArr[2]);

const wSeriesWithDays = (weightLogs || []).map(w => {
  const dArr = w.logged_date.split('-').map(Number);
  const dDate = new Date(dArr[0], dArr[1] - 1, dArr[2]);
  const dayNum = Math.max(1, Math.round((dDate.getTime() - startDateLocal.getTime()) / 86400000) + 1);
  return { day: dayNum, date: w.logged_date, weight: w.weight };
});

const WC_W = 1100, WC_H = 360, WC_L = 64, WC_R = 24, WC_T = 28, WC_B = 48;
const wcIW = WC_W - WC_L - WC_R;
const wcIH = WC_H - WC_T - WC_B;
const allWVals = wSeriesWithDays.map(d => d.weight);
const wcMinW = allWVals.length ? Math.min(...allWVals, targetWeight > 0 ? targetWeight : 999) - 1 : 60;
const wcMaxW = allWVals.length ? Math.max(...allWVals) + 1 : 100;
const wcRange = (wcMaxW - wcMinW) || 1;
const wcXFor = (day) => WC_L + ((day - 1) / Math.max(1, maxDays - 1)) * wcIW;
const wcYFor = (wVal) => WC_T + ((wcMaxW - wVal) / wcRange) * wcIH;

const wcPoints = wSeriesWithDays.map(d => ({ x: wcXFor(d.day), y: wcYFor(d.weight), day: d.day, date: d.date, weight: d.weight }));
const wcLinePath = wcPoints.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(' ');
const wcAreaPath = wcPoints.length ? `${wcLinePath} L ${wcPoints[wcPoints.length - 1].x.toFixed(1)} ${WC_H - WC_B} L ${wcPoints[0].x.toFixed(1)} ${WC_H - WC_B} Z` : '';
const wcLastP = wcPoints[wcPoints.length - 1] || { x: WC_L, y: WC_T + wcIH / 2 };
const wcProjEndX = wcXFor(maxDays);
const wcProjEndY = targetWeight > 0 ? wcYFor(targetWeight) : wcLastP.y;

const wcTickMin = Math.floor(wcMinW);
const wcTickMax = Math.ceil(wcMaxW);
const wcTickCount = Math.floor((wcTickMax - wcTickMin) / 2) + 1;
const wcTicks = Array.from({ length: wcTickCount }, (_, i) => wcTickMin + i * 2).filter(v => v <= wcTickMax);
const wcXTickDays = [1, 14, 28, 42, 56, 70, maxDays].filter((d, i, a) => d <= maxDays && a.indexOf(d) === i);

// annotations — key points
const wcAnnotations = [] as { day: number; label: string; body: string }[];
if (currentDay >= 7 && wSeriesWithDays.find(d => d.day === 7)) wcAnnotations.push({ day: 7, label: 'Week 1', body: 'Initial adaptation phase.' });
if (currentDay >= 28 && wSeriesWithDays.find(d => d.day >= 27 && d.day <= 29)) wcAnnotations.push({ day: 28, label: 'One month', body: 'Steady fat loss underway.' });
if (wSeriesWithDays.length > 0) wcAnnotations.push({ day: wSeriesWithDays[wSeriesWithDays.length - 1].day, label: 'Today', body: `Current: ${dispLatest}${wUnit}` });

// ── Adherence calendar ───────────────────────────────────────────────────────
const calDays = Math.min(maxDays, 90);
const calCols = calDays <= 30 ? 6 : calDays <= 60 ? 10 : 18;

const checkinMap = new Map();
for (const c of (checkin90 || [])) {
  checkinMap.set(c.checkin_date.split('T')[0], c.energy_level || 5);
}

const adherence = Array.from({ length: calDays }, (_, i) => {
  const dayNum = i + 1;
  if (dayNum > currentDay) return null;
  const d2 = new Date(startDateLocal.getFullYear(), startDateLocal.getMonth(), startDateLocal.getDate() + i);
  const key = `${d2.getFullYear()}-${String(d2.getMonth() + 1).padStart(2, '0')}-${String(d2.getDate()).padStart(2, '0')}`;
  if (!checkinMap.has(key)) return 0;
  const e = checkinMap.get(key) || 5;
  if (e >= 8) return 3;
  if (e >= 6) return 2;
  return 1;
});

const adherenceClasses = adherence.map((c, i) => {
  const isFuture = c === null;
  const isToday = i === currentDay - 1;
  const base = isFuture ? 'future' : c === 0 ? '' : c === 1 ? 'l1' : c === 2 ? 'l2' : 'l3';
  return `st-cell ${base}${isToday ? ' today' : ''}`;
});

const curStreakAdherence = (() => {
  let s = 0;
  for (let i = Math.min(currentDay - 1, adherence.length - 1); i >= 0; i--) {
    if ((adherence[i] || 0) >= 2) s++; else break;
  }
  return s;
})();
const longestAdherence = (() => {
  let best = 0, run = 0;
  for (let i = 0; i < currentDay && i < adherence.length; i++) {
    if ((adherence[i] || 0) >= 2) { run++; if (run > best) best = run; } else run = 0;
  }
  return best;
})();
const onPlanCount = adherence.slice(0, currentDay).filter(c => (c || 0) >= 2).length;
const adherencePct = currentDay > 0 ? Math.round((onPlanCount / currentDay) * 100) : 0;

// ── Milestones ────────────────────────────────────────────────────────────────
const milestoneBase = [
  { day: 7,  l: 'ONE WEEK',     sub: 'Survived the first week of adaptation.' },
  { day: 14, l: 'TWO WEEKS',    sub: 'Past the keto-flu. Energy is climbing.' },
  { day: 30, l: 'ONE MONTH',    sub: 'A full month on the plan.' },
  { day: 60, l: 'TWO MONTHS',   sub: 'Deep in the rhythm. Fat loss is consistent.' },
  { day: maxDays, l: 'GOAL DAY', sub: 'The finish line.' },
].filter(m => m.day <= maxDays && (maxDays <= 30 ? m.day <= 30 : true));

// dedupe on maxDays (avoid showing day 30 AND day 30 as GOAL DAY)
const milestones = milestoneBase.filter((m, i, a) => a.findIndex(x => x.day === m.day) === i).map(m => ({
  ...m, earned: currentDay >= m.day, current: false,
}));

// mark most-recently-earned as current
for (let i = milestones.length - 1; i >= 0; i--) {
  if (milestones[i].earned) { milestones[i] = { ...milestones[i], current: true }; break; }
}

const milestoneClasses = milestones.map(m => `st-m ${m.current ? 'current' : m.earned ? 'earned' : 'future'}`);
const milestoneBadge = milestones.map(m => m.current ? '◉' : m.earned ? '✓' : '◯');
const milestoneLabel = milestones.map(m => m.current ? 'TODAY' : m.earned ? `EARNED — D${m.day}` : `UNLOCKS D${m.day}`);

// ── Signals ───────────────────────────────────────────────────────────────────
const recentCheckins = (checkins || []).slice().reverse();
const energySeries = recentCheckins.map(c => c.energy_level || 5);
const moodSeries = recentCheckins.map(c => c.mood_level || 5);
const hungerSeries = recentCheckins.map(c => Math.max(1, 10 - (c.hunger_level || 5)));
const ketoneSeriesRaw = (ketoneLogs || []).slice().reverse().map(k => k.ketone_mmol || 0);

const avg7fn = (arr) => {
  const sl = arr.slice(-7);
  return sl.length ? (sl.reduce((a, b) => a + b, 0) / sl.length).toFixed(1) : '—';
};
const deltaFn = (arr) => {
  if (arr.length < 2) return '—';
  const diff = arr[arr.length - 1] - arr[0];
  return (diff >= 0 ? '+' : '') + diff.toFixed(1);
};

const sigEnergy = buildSpark(energySeries, 480, 80);
const sigKetone = buildSpark(ketoneSeriesRaw, 480, 80);
const sigMood = buildSpark(moodSeries, 480, 80);
const sigCraving = buildSpark(hungerSeries, 480, 80);

const energyCur = energySeries.length ? energySeries[energySeries.length - 1].toFixed(1) : '—';
const ketoneCur = ketoneLogs?.length ? ketoneLogs[0].ketone_mmol.toFixed(1) : '—';
const moodCur = moodSeries.length ? moodSeries[moodSeries.length - 1].toFixed(1) : '—';
const cravingCur = hungerSeries.length ? hungerSeries[hungerSeries.length - 1].toFixed(1) : '—';

const energyDelta = deltaFn(energySeries);
const ketoneDelta = deltaFn(ketoneSeriesRaw);
const moodDelta = deltaFn(moodSeries);
const cravingDelta = deltaFn(hungerSeries);

// ── Insights ──────────────────────────────────────────────────────────────────
const insightTones = ['rose', 'lime', 'orange'];
const formattedInsights = ((smartInsights || []) as any[]).slice(0, 3).map((ins, i) => ({
  n: i + 1,
  l: ins.category || ins.type || 'INSIGHT',
  t: ins.title || ins.message || ins.text || '',
  body: ins.body || ins.description || ins.detail || ins.note || '',
  tone: insightTones[i % 3],
}));

// ── Body measurements comparison ──────────────────────────────────────────────
const latestM = measurements?.[0] || null;
const prevM = measurements?.[1] || null;
const bodyMeasures = [
  { l: 'WAIST', cur: latestM?.waist_cm, prev: prevM?.waist_cm, u: 'cm' },
  { l: 'HIPS',  cur: latestM?.hips_cm,  prev: prevM?.hips_cm,  u: 'cm' },
  { l: 'CHEST', cur: latestM?.chest_cm, prev: prevM?.chest_cm, u: 'cm' },
  { l: 'THIGH', cur: latestM?.thigh_cm, prev: prevM?.thigh_cm, u: 'cm' },
  { l: 'ARM',   cur: latestM?.arm_cm,   prev: prevM?.arm_cm,   u: 'cm' },
].filter(m => m.cur != null);

// ── Progress photos ───────────────────────────────────────────────────────────
const sortedPhotos = (progressPhotos || []).slice().sort((a, b) => new Date(a.taken_date).getTime() - new Date(b.taken_date).getTime());
const firstPhoto = sortedPhotos[0] || null;
const lastPhoto = sortedPhotos[sortedPhotos.length - 1] || null;

// ── Pre-compute to avoid const-in-map in JSX ─────────────────────────────────
const bodyMeasuresWithDelta = bodyMeasures.map(m => {
  const delta = (m.prev !== undefined && m.prev !== null) ? Math.round((m.cur - m.prev) * 10) / 10 : null;
  const deltaStr = delta !== null ? (delta >= 0 ? `+${delta}` : `${delta}`) : null;
  const deltaGood = delta !== null && delta < 0;
  return { l: m.l, cur: m.cur, u: m.u, delta, deltaStr, deltaGood };
});

const wcAnnotationsRendered = wcAnnotations.map((a, i) => ({
  day: a.day, label: a.label, body: a.body, idx: i,
  pt: wcPoints.find(p => p.day === a.day) || null,
})).filter(a => a.pt !== null);

// ── Client data for JS ────────────────────────────────────────────────────────
const wcPointsJson = JSON.stringify(wcPoints.map(p => ({ x: p.x, y: p.y, day: p.day, date: p.date, weight: p.weight, unit: wUnit })));
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Progress · Keto Journey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #FAF6F1; --bg-alt: #F2EDE5; --ink: #16110F; --ink-soft: #4A4340;
      --muted: #8A8077; --line: #E5DED2; --card: #FFFFFF;
      --accent: #FF5C7A; --accent-2: #B6FF3C; --accent-3: #FF914D;
      --display: 'Bricolage Grotesque', system-ui, sans-serif;
      --serif: 'Instrument Serif', serif;
      --body: 'Geist', system-ui, sans-serif;
      --mono: 'Geist Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { background: var(--bg); color: var(--ink); font-family: var(--body); -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
    img { display: block; max-width: 100%; }
  </style>
</head>
<body>

<div class="pg-shell">
  <Sidebar activeId="progress" />
  <main class="pg-main rv-pg-main">

    <!-- ═══════════════════════════ HERO ════════════════════════════════ -->
    <section class="ph">
      <div class="ph-glow lime"></div>
      <div class="ph-glow"></div>
      <div class="ph-inner">

        <div class="ph-bar">
          <div class="ph-bar-l">PROGRESS · DAY {currentDay} OF {maxDays}</div>
          <div class="ph-bar-r">
            <a href="/dashboard/profile" class="ph-tab">Profile</a>
            <a href="/dashboard/checkin" class="ph-tab">Check-in</a>
            <a href="/dashboard/food-log" class="ph-tab active">Log food</a>
          </div>
        </div>

        <div class="ph-headline">
          <div>
            <div class="ph-big">
              <span class="sign">−</span>{dispWeightLost}<span class="ph-unit">{wUnit} lost</span>
            </div>
            <div class="ph-cap">
              You started at {dispStart} and you're at {dispLatest} today.
              That's <span class="ph-em">{weightGoalPct}%</span> of the way to your goal
              — {maxDays - currentDay} days left on the clock.
            </div>
            <a href="/dashboard/profile" class="ph-log-btn">+ Log today's weight</a>
          </div>

          <div class="ph-right">
            {heroSpark && (
              <div class="ph-spark-wrap">
                <div class="ph-spark-head">
                  <span>YOUR LINE · DAY 1 → DAY {currentDay}</span>
                  <span class="ph-now-lbl">{weightLost > 0 ? '↓ TRENDING DOWN' : '→ HOLDING'}</span>
                </div>
                <svg class="ph-spark-svg" viewBox="0 0 720 80" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="phspark" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--accent-2)" stop-opacity="0.4"/>
                      <stop offset="100%" stop-color="var(--accent-2)" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d={heroSpark.area} fill="url(#phspark)"/>
                  <path d={heroSpark.line} fill="none" stroke="var(--accent-2)" stroke-width="2"/>
                  <circle cx={heroSpark.last.x} cy={heroSpark.last.y} r="4" fill="var(--accent)"/>
                  <circle cx={heroSpark.last.x} cy={heroSpark.last.y} r="8" fill="var(--accent)" opacity="0.25"/>
                </svg>
                <div class="ph-spark-rail">
                  <span class="start"><b>{dispStart}</b>{wUnit} · start</span>
                  <span class="end"><b>{dispLatest}</b>{wUnit} · today</span>
                </div>
              </div>
            )}

            <div class="ph-progress">
              <div class="ph-progress-fill" style={`width:${weightGoalPct}%`}></div>
              <div class="ph-progress-track">
                <span class="ph-pt-start">START · {dispStart}</span>
                <span class="ph-pt-now" style={`left:${Math.max(12, Math.min(88, weightGoalPct))}%`}>NOW · {dispLatest}</span>
                <span class="ph-pt-end">GOAL · <b>{dispTarget}</b></span>
              </div>
            </div>

            <div class="ph-stats">
              <div class="ph-stat">
                <div class="ph-stat-l">LEFT TO GO</div>
                <div class="ph-stat-v">{dispLeft}<span class="ph-stat-u">{wUnit}</span></div>
                <div class="ph-stat-s">to reach {dispTarget}{wUnit}</div>
              </div>
              <div class="ph-stat">
                <div class="ph-stat-l">AVG / WEEK</div>
                <div class="ph-stat-v">{dispAvgWeek}<span class="ph-stat-u">{wUnit}</span></div>
                <div class="ph-stat-s">Sustainable range</div>
              </div>
              <div class="ph-stat">
                <div class="ph-stat-l">PROJECTED D{maxDays}</div>
                <div class="ph-stat-v">{dispProjected}<span class="ph-stat-u">{wUnit}</span></div>
                <div class="ph-stat-s">{projectedWeight <= targetWeight ? 'On track ✓' : 'Keep pushing'}</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════ MAIN BODY ══════════════════════════════ -->
    <div class="pg-body">

      <!-- ── Weight Curve ─────────────────────────────────────────────── -->
      <div class="pg-section">
        <div class="wc">
          <div class="wc-head">
            <h2>The <em>line</em>.</h2>
            <div class="wc-head-sub">Every morning weigh-in, plus the moments that mattered.</div>
          </div>

          <div class="wc-legend">
            <div class="wc-key"><span class="wc-swatch"></span>WEIGHT</div>
            {targetWeight > 0 && <div class="wc-key"><span class="wc-swatch proj"></span>PROJECTED</div>}
            {targetWeight > 0 && <div class="wc-key"><span class="wc-swatch target"></span>GOAL · {dispTarget}{wUnit}</div>}
          </div>

          <div class="wc-wrap" id="wcWrap">
            <svg class="wc-svg" id="wcSvg" viewBox={`0 0 ${WC_W} ${WC_H}`} preserveAspectRatio="none">
              <defs>
                <linearGradient id="wcArea" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.15"/>
                  <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
                </linearGradient>
              </defs>

              {wcTicks.map(tk => (
                <g>
                  <line x1={WC_L} x2={WC_W - WC_R} y1={wcYFor(tk)} y2={wcYFor(tk)} stroke="var(--line)" stroke-width="1" stroke-dasharray="2 3"/>
                  <text x={WC_L - 10} y={wcYFor(tk) + 4} fill="var(--muted)" font-size="10" text-anchor="end" font-family="var(--mono)" letter-spacing="0.5">{tk}</text>
                </g>
              ))}

              {targetWeight > 0 && (
                <g>
                  <line x1={WC_L} x2={WC_W - WC_R} y1={wcYFor(targetWeight)} y2={wcYFor(targetWeight)} stroke="var(--accent-2)" stroke-width="1.5" stroke-dasharray="4 4"/>
                  <text x={WC_W - WC_R} y={wcYFor(targetWeight) - 6} fill="var(--muted)" font-size="10" text-anchor="end" font-family="var(--mono)">GOAL · {dispTarget}{wUnit}</text>
                </g>
              )}

              {wcXTickDays.map(d => (
                <g>
                  <line x1={wcXFor(d)} x2={wcXFor(d)} y1={WC_H - WC_B} y2={WC_H - WC_B + 6} stroke="var(--line)"/>
                  <text x={wcXFor(d)} y={WC_H - WC_B + 22} fill="var(--muted)" font-size="10" text-anchor="middle" font-family="var(--mono)">D{d}</text>
                </g>
              ))}

              {wcAreaPath && <path d={wcAreaPath} fill="url(#wcArea)"/>}
              {wcLinePath && <path d={wcLinePath} fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>}

              {wcLastP && targetWeight > 0 && (
                <line x1={wcLastP.x} y1={wcLastP.y} x2={wcProjEndX} y2={wcProjEndY} stroke="var(--accent)" stroke-width="2" stroke-dasharray="4 4" opacity="0.55"/>
              )}

              {wcLastP && (
                <g>
                  <circle cx={wcLastP.x} cy={wcLastP.y} r="6" fill="var(--accent)"/>
                  <circle cx={wcLastP.x} cy={wcLastP.y} r="12" fill="var(--accent)" opacity="0.18"/>
                </g>
              )}

              {wcAnnotationsRendered.map(a => (
                <g>
                  <line x1={a.pt.x} x2={a.pt.x} y1={a.pt.y - 8} y2={a.pt.y - 26} stroke="var(--ink)" stroke-width="1.5"/>
                  <circle cx={a.pt.x} cy={a.pt.y} r="5" fill="var(--card)" stroke="var(--ink)" stroke-width="2"/>
                  <g transform={`translate(${a.pt.x}, ${a.pt.y - 36})`}>
                    <rect x="-12" y="-12" width="24" height="22" rx="6" fill="var(--ink)"/>
                    <text x="0" y="3" fill="var(--accent-2)" font-size="11" font-family="var(--display)" font-weight="700" text-anchor="middle">{a.idx + 1}</text>
                  </g>
                </g>
              ))}

              <g id="wcCrosshair" style="display:none" pointer-events="none">
                <line id="wcCrossLine" stroke="var(--accent)" stroke-width="1" stroke-dasharray="2 2"/>
                <circle id="wcCrossDot" r="5" fill="var(--accent)" stroke="var(--card)" stroke-width="2"/>
              </g>
            </svg>

            <div id="wcTooltip" class="wc-tooltip" style="display:none">
              <div id="wcTtLabel" class="wc-tt-l"></div>
              <div id="wcTtVal" class="wc-tt-v"></div>
              <div id="wcTtSub" class="wc-tt-s"></div>
            </div>
          </div>

          {wcAnnotationsRendered.length > 0 && (
            <div class="wc-anno">
              {wcAnnotationsRendered.map(a => (
                <div class="wc-a">
                  <div class="wc-a-n">{a.day}</div>
                  <div>
                    <div class="wc-a-l">PIN {String(a.idx + 1).padStart(2, '0')}</div>
                    <div class="wc-a-t">{a.label}</div>
                    <div class="wc-a-b">{a.body}</div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      <!-- ── Body ─────────────────────────────────────────────────────── -->
      {(bodyMeasures.length > 0 || progressPhotos?.length) && (
        <div class="pg-section">
          <div class="bd">

            <!-- Photos panel (always dark) -->
            <div class="bd-photos">
              <div class="bd-photos-glow"></div>
              <div class="bd-photos-head">
                <h3>The <em>body</em> shift.</h3>
                <div class="bd-photos-meta">{sortedPhotos.length} PROGRESS PHOTOS</div>
              </div>
              <div class="bd-stage">
                <div class="bd-frame then">
                  {firstPhoto ? (
                    <img src={firstPhoto.photo_data} alt="Before" style="width:100%;height:100%;object-fit:cover;"/>
                  ) : (
                    <div class="bd-silhouette wide">
                      <svg viewBox="0 0 100 140" fill="none">
                        <defs>
                          <linearGradient id="sg1" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.7"/>
                            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.25"/>
                          </linearGradient>
                        </defs>
                        <g transform="translate(50 8) scale(1.12 1) translate(-50 0)">
                          <circle cx="50" cy="18" r="11" fill="url(#sg1)"/>
                          <path d="M 28 38 Q 50 30 72 38 L 70 78 Q 50 84 30 78 Z" fill="url(#sg1)"/>
                          <path d="M 28 38 Q 22 60 24 88 L 30 88 Q 32 60 33 42 Z" fill="url(#sg1)" opacity="0.85"/>
                          <path d="M 72 38 Q 78 60 76 88 L 70 88 Q 68 60 67 42 Z" fill="url(#sg1)" opacity="0.85"/>
                          <path d="M 32 78 L 36 130 L 46 130 L 48 82 Z" fill="url(#sg1)" opacity="0.9"/>
                          <path d="M 68 78 L 64 130 L 54 130 L 52 82 Z" fill="url(#sg1)" opacity="0.9"/>
                        </g>
                      </svg>
                    </div>
                  )}
                  <div class="bd-frame-tag">THEN</div>
                  <div class="bd-frame-label">
                    Day 1
                    <em>{dispStart}{wUnit}</em>
                  </div>
                </div>
                <div class="bd-frame now">
                  {lastPhoto && firstPhoto && lastPhoto.id !== firstPhoto.id ? (
                    <img src={lastPhoto.photo_data} alt="Now" style="width:100%;height:100%;object-fit:cover;"/>
                  ) : (
                    <div class="bd-silhouette">
                      <svg viewBox="0 0 100 140" fill="none">
                        <defs>
                          <linearGradient id="sg2" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.7"/>
                            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.25"/>
                          </linearGradient>
                        </defs>
                        <g transform="translate(50 8) scale(0.94 1) translate(-50 0)">
                          <circle cx="50" cy="18" r="11" fill="url(#sg2)"/>
                          <path d="M 28 38 Q 50 30 72 38 L 70 78 Q 50 84 30 78 Z" fill="url(#sg2)"/>
                          <path d="M 28 38 Q 22 60 24 88 L 30 88 Q 32 60 33 42 Z" fill="url(#sg2)" opacity="0.85"/>
                          <path d="M 72 38 Q 78 60 76 88 L 70 88 Q 68 60 67 42 Z" fill="url(#sg2)" opacity="0.85"/>
                          <path d="M 32 78 L 36 130 L 46 130 L 48 82 Z" fill="url(#sg2)" opacity="0.9"/>
                          <path d="M 68 78 L 64 130 L 54 130 L 52 82 Z" fill="url(#sg2)" opacity="0.9"/>
                        </g>
                      </svg>
                    </div>
                  )}
                  <div class="bd-frame-tag now-tag">NOW</div>
                  <div class="bd-frame-label">
                    Day {currentDay}
                    <em>{dispLatest}{wUnit}</em>
                  </div>
                </div>
              </div>
              {sortedPhotos.length === 0 && (
                <div class="bd-photo-cta">
                  <a href="/dashboard/photos" class="bd-photo-btn">+ Add progress photos</a>
                </div>
              )}
            </div>

            <!-- Stats panel -->
            <div class="bd-stats">
              {bodyMeasures.length > 0 && (
                <div class="bd-card">
                  <div class="bd-card-head">
                    <h3>Measurements</h3>
                    <a href="/dashboard/progress#measurements" class="bd-card-link">+ Log</a>
                  </div>
                  <div class="bd-meas">
                    {bodyMeasuresWithDelta.map(m => (
                      <div class="bd-meas-row">
                        <div class="bd-meas-l">{m.l}</div>
                        <div class="bd-meas-bar-wrap">
                          <div class="bd-meas-bar" style={`width:${Math.min(100, m.cur / (m.cur + 8) * 100)}%`}></div>
                        </div>
                        <div class="bd-meas-val">{m.cur}<span class="bd-meas-u">{m.u}</span></div>
                        {m.deltaStr && (
                          <div class={`bd-meas-delta ${m.deltaGood ? 'good' : 'bad'}`}>{m.deltaStr}</div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <div class="bd-card">
                <div class="bd-card-head">
                  <h3>Weight journey</h3>
                </div>
                <div class="bd-comp">
                  <div class="bd-comp-row">
                    <div class="bd-comp-l">START WEIGHT</div>
                    <div class="bd-comp-bar-wrap">
                      <div class="bd-comp-bar start" style="width:100%"></div>
                    </div>
                    <div class="bd-comp-val">{dispStart}{wUnit}</div>
                  </div>
                  <div class="bd-comp-row">
                    <div class="bd-comp-l">CURRENT</div>
                    <div class="bd-comp-bar-wrap">
                      <div class="bd-comp-bar now" style={`width:${startWeight > 0 ? Math.round((latestWeight / startWeight) * 100) : 100}%`}></div>
                    </div>
                    <div class="bd-comp-val">{dispLatest}{wUnit}</div>
                  </div>
                  {targetWeight > 0 && (
                    <div class="bd-comp-row">
                      <div class="bd-comp-l">GOAL</div>
                      <div class="bd-comp-bar-wrap">
                        <div class="bd-comp-bar goal" style={`width:${startWeight > 0 ? Math.round((targetWeight / startWeight) * 100) : 100}%`}></div>
                      </div>
                      <div class="bd-comp-val">{dispTarget}{wUnit}</div>
                    </div>
                  )}
                </div>
                <div class="bd-lost-badge">
                  <span class="bd-lost-num">−{dispWeightLost}</span>
                  <span class="bd-lost-u">{wUnit} lost</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- ── Signals ────────────────────────────────────────────────── -->
      <div class="pg-section">
        <div class="sg-head">
          <h2>Signals beyond <em>the scale</em>.</h2>
          <p>What the body's telling you, since day 1. Trends matter more than today's number.</p>
        </div>

        <div class="sg-grid">
          <!-- Energy -->
          <div class="sg-card rose">
            <div class="sg-card-h">
              <div>
                <div class="sg-card-l">ENERGY</div>
                <div class="sg-num" style="margin-top:10px">{energyCur}<em>/10</em></div>
                <div class="sg-avg">7-DAY AVG <b>{avg7fn(energySeries)}/10</b></div>
              </div>
              <div class={`sg-delta ${energyDelta.startsWith('+') ? 'up' : 'down'}`}>{energyDelta} {energyDelta.startsWith('+') ? '↑' : '↓'}</div>
            </div>
            {sigEnergy && (
              <div class="sg-chart">
                <svg viewBox="0 0 480 80" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="sg-energy" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"/>
                      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d={sigEnergy.area} fill="url(#sg-energy)"/>
                  <path d={sigEnergy.line} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"/>
                  <circle cx={sigEnergy.last.x} cy={sigEnergy.last.y} r="4" fill="var(--accent)"/>
                  <circle cx={sigEnergy.last.x} cy={sigEnergy.last.y} r="9" fill="var(--accent)" opacity="0.2"/>
                </svg>
              </div>
            )}
            <div class="sg-title">Energy climbs as ketosis deepens.</div>
            <div class="sg-note">Self-rated daily energy since day 1.</div>
          </div>

          <!-- Ketones -->
          <div class="sg-card lime">
            <div class="sg-card-h">
              <div>
                <div class="sg-card-l">KETONES</div>
                <div class="sg-num" style="margin-top:10px">{ketoneCur}<em>mmol/L</em></div>
                <div class="sg-avg">7-DAY AVG <b>{avg7fn(ketoneSeriesRaw)} mmol/L</b></div>
              </div>
              <div class={`sg-delta ${ketoneDelta.startsWith('+') ? 'up' : 'down'}`}>{ketoneDelta} {ketoneDelta.startsWith('+') ? '↑' : '↓'}</div>
            </div>
            {sigKetone && (
              <div class="sg-chart">
                <svg viewBox="0 0 480 80" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="sg-ketone" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--accent-2)" stop-opacity="0.3"/>
                      <stop offset="100%" stop-color="var(--accent-2)" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d={sigKetone.area} fill="url(#sg-ketone)"/>
                  <path d={sigKetone.line} fill="none" stroke="var(--accent-2)" stroke-width="2" stroke-linejoin="round"/>
                  <circle cx={sigKetone.last.x} cy={sigKetone.last.y} r="4" fill="var(--accent-2)"/>
                  <circle cx={sigKetone.last.x} cy={sigKetone.last.y} r="9" fill="var(--accent-2)" opacity="0.2"/>
                </svg>
              </div>
            )}
            <div class="sg-title">Ketone levels since first log.</div>
            <div class="sg-note">Optimal fat-burning range: 1.5–3.0 mmol/L.</div>
          </div>

          <!-- Mood -->
          <div class="sg-card rose">
            <div class="sg-card-h">
              <div>
                <div class="sg-card-l">MOOD</div>
                <div class="sg-num" style="margin-top:10px">{moodCur}<em>/10</em></div>
                <div class="sg-avg">7-DAY AVG <b>{avg7fn(moodSeries)}/10</b></div>
              </div>
              <div class={`sg-delta ${moodDelta.startsWith('+') ? 'up' : 'down'}`}>{moodDelta} {moodDelta.startsWith('+') ? '↑' : '↓'}</div>
            </div>
            {sigMood && (
              <div class="sg-chart">
                <svg viewBox="0 0 480 80" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="sg-mood" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.3"/>
                      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d={sigMood.area} fill="url(#sg-mood)"/>
                  <path d={sigMood.line} fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round"/>
                  <circle cx={sigMood.last.x} cy={sigMood.last.y} r="4" fill="var(--accent)"/>
                  <circle cx={sigMood.last.x} cy={sigMood.last.y} r="9" fill="var(--accent)" opacity="0.2"/>
                </svg>
              </div>
            )}
            <div class="sg-title">Mood improves as the body adapts.</div>
            <div class="sg-note">Daily mood check-in, 1–10 scale.</div>
          </div>

          <!-- Cravings (inverted hunger) -->
          <div class="sg-card lime">
            <div class="sg-card-h">
              <div>
                <div class="sg-card-l">CRAVINGS (LOW = GOOD)</div>
                <div class="sg-num" style="margin-top:10px">{cravingCur}<em>/10</em></div>
                <div class="sg-avg">7-DAY AVG <b>{avg7fn(hungerSeries)}/10</b></div>
              </div>
              <div class={`sg-delta ${cravingDelta.startsWith('-') ? 'up' : 'down'}`}>{cravingDelta} {cravingDelta.startsWith('-') ? '↓' : '↑'}</div>
            </div>
            {sigCraving && (
              <div class="sg-chart">
                <svg viewBox="0 0 480 80" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="sg-craving" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--accent-2)" stop-opacity="0.3"/>
                      <stop offset="100%" stop-color="var(--accent-2)" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                  <path d={sigCraving.area} fill="url(#sg-craving)"/>
                  <path d={sigCraving.line} fill="none" stroke="var(--accent-2)" stroke-width="2" stroke-linejoin="round"/>
                  <circle cx={sigCraving.last.x} cy={sigCraving.last.y} r="4" fill="var(--accent-2)"/>
                  <circle cx={sigCraving.last.x} cy={sigCraving.last.y} r="9" fill="var(--accent-2)" opacity="0.2"/>
                </svg>
              </div>
            )}
            <div class="sg-title">Cravings dropping as ketosis stabilises.</div>
            <div class="sg-note">Derived from daily hunger check-in score.</div>
          </div>
        </div>
      </div>

      <!-- ── Streaks + Milestones ──────────────────────────────────── -->
      <div class="pg-section">
        <div class="st">

          <!-- Calendar -->
          <div class="st-cal">
            <div class="st-h">
              <h2>The <em>habit</em> shape.</h2>
              <div class="st-h-meta">Day 1 → Day {maxDays} · how you showed up</div>
            </div>

            <div class="st-stats">
              <div class="st-stat">
                <div class="st-stat-l">CURRENT STREAK</div>
                <div class="st-stat-v">{curStreakAdherence}<em>days</em></div>
              </div>
              <div class="st-stat">
                <div class="st-stat-l">LONGEST</div>
                <div class="st-stat-v">{longestAdherence}<em>days</em></div>
              </div>
              <div class="st-stat">
                <div class="st-stat-l">ON-PLAN</div>
                <div class="st-stat-v accent-val">{adherencePct}%</div>
              </div>
              <div class="st-stat">
                <div class="st-stat-l">DAYS LOGGED</div>
                <div class="st-stat-v">{onPlanCount}<em>/{currentDay}</em></div>
              </div>
            </div>

            <div class="st-grid" style={`grid-template-columns: repeat(${calCols}, 1fr)`}>
              {adherenceClasses.map((cls, i) => (
                <div class={cls} title={`Day ${i + 1}`}></div>
              ))}
            </div>

            <div class="st-legend">
              <span>LESS</span>
              <div class="st-scale">
                <div class="st-b b0"></div>
                <div class="st-b b1"></div>
                <div class="st-b b2"></div>
                <div class="st-b b3"></div>
              </div>
              <span>MORE</span>
              <span style="margin-left:auto">▢ = TODAY</span>
            </div>
          </div>

          <!-- Milestones (always dark) -->
          <div class="st-mile">
            <div class="st-mile-glow"></div>
            <div class="st-mile-h">
              <h2>Milestones <em>collected</em>.</h2>
            </div>
            <div class="st-mile-list">
              {milestones.map((m, i) => (
                <div class={milestoneClasses[i]}>
                  <div class="st-m-day">{m.day}</div>
                  <div>
                    <div class="st-m-l">{milestoneLabel[i]}</div>
                    <div class="st-m-t">{m.l}</div>
                    <div class="st-m-s">{m.sub}</div>
                  </div>
                  <div class="st-m-badge">{milestoneBadge[i]}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- ── Insights (always dark) ─────────────────────────────────── -->
      {formattedInsights.length > 0 && (
        <div class="pg-section">
          <section class="ins">
            <div class="ins-inner">
              <div class="ins-h">
                <div>
                  <div class="ins-eyebrow">✦ MIRA'S READ OF YOUR LAST {currentDay} DAYS</div>
                  <h2>Patterns hiding in your <em>numbers</em>.</h2>
                </div>
                <div class="ins-cta">
                  <a href="/dashboard/ai-coach" class="ins-btn primary">Ask Mira →</a>
                  <a href="/dashboard/reflections" class="ins-btn ghost">View reflections</a>
                </div>
              </div>
              <div class="ins-grid">
                {formattedInsights.map(ins => (
                  <div class={`ins-card ${ins.tone}`}>
                    <div class="ins-n">{String(ins.n).padStart(2, '0')}</div>
                    <div>
                      <div class="ins-l">{ins.l}</div>
                      <div class="ins-t">{ins.t}</div>
                      <div class="ins-b">{ins.body}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        </div>
      )}

    </div><!-- /.pg-body -->
  </main>
</div><!-- /.pg-shell -->

<style>
  /* ── Layout ────────────────────────────────────────────────────────── */
  .pg-shell { display: flex; min-height: 100vh; }
  .pg-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .pg-body { max-width: 1360px; width: 100%; margin: 0 auto; padding: 36px 32px 80px; }
  .pg-section + .pg-section { margin-top: 56px; }

  /* ── Hero (always dark — immune to dark-mode) ───────────────────────── */
  .ph {
    --bg: #FAF6F1; --bg-alt: #F2EDE5; --ink: #16110F; --ink-soft: #4A4340;
    --muted: #8A8077; --line: #E5DED2; --accent: #FF5C7A; --accent-2: #B6FF3C; --accent-3: #FF914D;
    position: relative; background: #16110F; color: #FAF6F1; overflow: hidden;
  }
  .ph-glow {
    position: absolute; width: 760px; height: 760px; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent) 50%, transparent), transparent 65%);
    filter: blur(80px); bottom: -380px; right: -180px; z-index: 0; pointer-events: none;
  }
  .ph-glow.lime {
    background: radial-gradient(circle, color-mix(in oklab, var(--accent-2) 30%, transparent), transparent 65%);
    top: -240px; left: -180px; width: 580px; height: 580px; bottom: auto; right: auto;
  }
  .ph-inner { position: relative; z-index: 2; max-width: 1360px; margin: 0 auto; padding: 44px 32px 36px; }

  .ph-bar { display: flex; align-items: center; gap: 14px; margin-bottom: 32px; }
  .ph-bar-l {
    font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--accent-2); display: inline-flex; align-items: center; gap: 8px;
  }
  .ph-bar-l::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--accent-2); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-2) 22%, transparent); }
  .ph-bar-r { margin-left: auto; display: flex; gap: 8px; }
  .ph-tab {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    padding: 9px 14px; border-radius: 999px;
    color: color-mix(in oklab, #FAF6F1 60%, transparent);
    border: 1px solid color-mix(in oklab, #FAF6F1 14%, transparent);
    transition: all .15s;
  }
  .ph-tab.active { background: #FAF6F1; color: #16110F; border-color: #FAF6F1; }
  .ph-tab:not(.active):hover { color: #FAF6F1; border-color: color-mix(in oklab, #FAF6F1 32%, transparent); }

  .ph-headline {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 64px; align-items: end; padding-bottom: 36px;
    border-bottom: 1px solid color-mix(in oklab, #FAF6F1 14%, transparent);
  }
  .ph-big {
    font-family: var(--display); font-size: clamp(80px, 12vw, 180px);
    line-height: 0.82; letter-spacing: -0.06em; font-weight: 600; color: #FAF6F1;
  }
  .ph-big .sign { color: var(--accent); font-weight: 500; }
  .ph-unit {
    font-family: var(--serif); font-style: italic; font-size: 0.22em;
    color: color-mix(in oklab, #FAF6F1 50%, transparent);
    font-weight: 400; margin-left: 0.15em; letter-spacing: -0.02em;
  }
  .ph-cap {
    font-family: var(--serif); font-style: italic; font-size: 20px;
    color: color-mix(in oklab, #FAF6F1 75%, transparent); margin-top: 14px; max-width: 34ch; line-height: 1.35;
  }
  .ph-em {
    color: var(--accent-2); font-style: normal; font-family: var(--mono); font-size: 11px;
    letter-spacing: 0.18em; text-transform: uppercase; padding: 3px 6px; border-radius: 4px;
    background: color-mix(in oklab, var(--accent-2) 18%, transparent); margin: 0 4px;
  }
  .ph-log-btn {
    display: inline-flex; align-items: center; gap: 6px; margin-top: 20px;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    padding: 10px 16px; border-radius: 999px; background: var(--accent); color: #FAF6F1;
    transition: opacity .15s;
  }
  .ph-log-btn:hover { opacity: 0.85; }

  .ph-right { display: flex; flex-direction: column; gap: 22px; }

  .ph-spark-wrap {
    background: color-mix(in oklab, #FAF6F1 5%, transparent);
    border: 1px solid color-mix(in oklab, #FAF6F1 12%, transparent);
    border-radius: 20px; padding: 18px 20px;
  }
  .ph-spark-head {
    display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    color: color-mix(in oklab, #FAF6F1 55%, transparent);
  }
  .ph-now-lbl { color: var(--accent-2); }
  .ph-spark-svg { width: 100%; display: block; }
  .ph-spark-rail {
    display: flex; justify-content: space-between; margin-top: 4px;
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; color: color-mix(in oklab, #FAF6F1 50%, transparent);
  }
  .ph-spark-rail b { font-family: var(--display); font-size: 12px; color: #FAF6F1; font-weight: 600; letter-spacing: -0.02em; margin-right: 2px; }

  .ph-progress {
    position: relative; height: 56px;
    background: color-mix(in oklab, #FAF6F1 6%, transparent);
    border: 1px solid color-mix(in oklab, #FAF6F1 12%, transparent);
    border-radius: 20px; overflow: hidden;
  }
  .ph-progress-fill {
    position: absolute; left: 0; top: 0; bottom: 0;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-3) 100%);
    border-radius: 20px; transition: width .4s ease;
  }
  .ph-progress-fill::after { content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: 2px; background: var(--accent-2); }
  .ph-progress-track {
    position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center;
    height: 100%; padding: 0 18px;
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .ph-pt-start { color: color-mix(in oklab, #FAF6F1 95%, transparent); }
  .ph-pt-now {
    color: #16110F; font-weight: 700; background: var(--accent-2); padding: 5px 10px; border-radius: 999px;
    position: absolute; top: 50%; transform: translate(-50%, -50%); white-space: nowrap;
  }
  .ph-pt-end { color: color-mix(in oklab, #FAF6F1 50%, transparent); }
  .ph-pt-end b { font-family: var(--display); font-size: 13px; color: #FAF6F1; font-weight: 600; letter-spacing: -0.02em; }

  .ph-stats {
    display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0;
    border: 1px solid color-mix(in oklab, #FAF6F1 12%, transparent);
    border-radius: 20px; overflow: hidden;
  }
  .ph-stat { padding: 16px 18px; border-right: 1px solid color-mix(in oklab, #FAF6F1 12%, transparent); }
  .ph-stat:last-child { border-right: none; }
  .ph-stat-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: color-mix(in oklab, #FAF6F1 55%, transparent); margin-bottom: 8px; }
  .ph-stat-v { font-family: var(--display); font-size: 28px; font-weight: 600; letter-spacing: -0.035em; line-height: 0.95; color: #FAF6F1; }
  .ph-stat-u { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent-2); font-size: 13px; margin-left: 2px; }
  .ph-stat-s { font-family: var(--serif); font-style: italic; font-size: 12px; color: color-mix(in oklab, #FAF6F1 60%, transparent); margin-top: 4px; }

  /* ── Weight Curve ──────────────────────────────────────────────────── */
  .wc { background: var(--card); border: 1px solid var(--line); border-radius: 28px; padding: 26px 26px 24px; }
  .wc-head { display: flex; align-items: end; gap: 16px; margin-bottom: 18px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .wc-head h2 { font-family: var(--display); font-size: 30px; font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
  .wc-head h2 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
  .wc-head-sub { font-family: var(--serif); font-style: italic; font-size: 14.5px; color: var(--ink-soft); margin-left: auto; max-width: 36ch; text-align: right; }

  .wc-legend { display: flex; gap: 18px; margin-bottom: 16px; }
  .wc-key { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
  .wc-swatch { width: 14px; height: 3px; border-radius: 2px; background: var(--ink); }
  .wc-swatch.proj { background: var(--accent); opacity: 0.5; }
  .wc-swatch.target { background: transparent; outline: 1.5px dashed var(--accent-2); }

  .wc-wrap { position: relative; }
  .wc-svg { width: 100%; height: auto; display: block; cursor: crosshair; }

  .wc-tooltip {
    position: absolute; background: var(--ink); color: var(--bg);
    border-radius: 10px; padding: 10px 12px; font-size: 12px; pointer-events: none;
    transform: translate(-50%, -130%); white-space: nowrap; z-index: 5;
    box-shadow: 0 6px 24px color-mix(in oklab, var(--ink) 30%, transparent);
  }
  .wc-tooltip::after {
    content: ''; position: absolute; left: 50%; bottom: -4px;
    transform: translateX(-50%) rotate(45deg); width: 8px; height: 8px; background: var(--ink);
  }
  .wc-tt-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent-2); margin-bottom: 2px; }
  .wc-tt-v { font-family: var(--display); font-size: 18px; font-weight: 600; letter-spacing: -0.025em; }
  .wc-tt-s { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; color: color-mix(in oklab, var(--bg) 60%, transparent); margin-top: 2px; }

  .wc-anno {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;
    margin-top: 22px; padding-top: 22px; border-top: 1px dashed var(--line);
  }
  .wc-a { display: flex; gap: 12px; }
  .wc-a-n {
    font-family: var(--display); font-size: 22px; font-weight: 600; line-height: 1;
    letter-spacing: -0.03em; color: var(--accent); flex-shrink: 0;
  }
  .wc-a-n::before { content: 'D'; font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 12px; color: var(--muted); margin-right: 1px; vertical-align: 6px; }
  .wc-a-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 3px; }
  .wc-a-t { font-family: var(--display); font-size: 14px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; }
  .wc-a-b { font-family: var(--serif); font-style: italic; font-size: 13px; color: var(--ink-soft); margin-top: 3px; line-height: 1.4; }

  /* ── Body ──────────────────────────────────────────────────────────── */
  .bd { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 22px; align-items: start; }

  .bd-photos {
    --bg: #FAF6F1; --ink: #16110F; --accent: #FF5C7A; --accent-2: #B6FF3C;
    background: #16110F; color: #FAF6F1;
    border-radius: 28px; padding: 24px 24px 22px; position: relative; overflow: hidden;
  }
  .bd-photos-glow {
    position: absolute; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent) 30%, transparent), transparent 70%);
    filter: blur(60px); top: -180px; right: -100px; pointer-events: none;
  }
  .bd-photos-head { position: relative; z-index: 1; display: flex; align-items: end; gap: 14px; margin-bottom: 18px; }
  .bd-photos-head h3 { font-family: var(--display); font-size: 26px; font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
  .bd-photos-head h3 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
  .bd-photos-meta { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: color-mix(in oklab, #FAF6F1 55%, transparent); margin-left: auto; }

  .bd-stage { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 14px; }

  .bd-frame {
    position: relative; border-radius: 18px; overflow: hidden; aspect-ratio: 3/4;
    background: radial-gradient(circle at 50% 35%, color-mix(in oklab, var(--accent) 30%, transparent), transparent 60%),
                linear-gradient(160deg, color-mix(in oklab, #FAF6F1 12%, #16110F) 0%, #16110F 100%);
  }
  .bd-frame::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,0.6) 100%); pointer-events: none;
  }
  .bd-silhouette { position: absolute; inset: 0; display: grid; place-items: center; }
  .bd-silhouette svg { width: 60%; height: 70%; }
  .bd-frame.then .bd-silhouette svg { opacity: 0.55; transform: scaleX(1.08); transform-origin: center bottom; }
  .bd-frame.now .bd-silhouette svg { opacity: 0.85; transform: scaleX(0.94); transform-origin: center bottom; }
  .bd-frame-tag {
    position: absolute; top: 12px; left: 12px;
    font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase;
    background: color-mix(in oklab, #000 60%, transparent); color: #FAF6F1;
    padding: 4px 8px; border-radius: 4px; backdrop-filter: blur(8px); z-index: 2;
  }
  .bd-frame-tag.now-tag { background: var(--accent-2); color: #16110F; }
  .bd-frame-label {
    position: absolute; left: 14px; bottom: 12px; z-index: 2;
    font-family: var(--display); font-size: 14px; font-weight: 600; letter-spacing: -0.02em; color: #fff;
  }
  .bd-frame-label em { display: block; font-family: var(--serif); font-style: italic; font-weight: 400; font-size: 12px; color: var(--accent-2); margin-top: 2px; }
  .bd-photo-cta { position: relative; z-index: 1; margin-top: 12px; }
  .bd-photo-btn {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    padding: 10px 16px; border-radius: 999px;
    border: 1px dashed color-mix(in oklab, #FAF6F1 30%, transparent);
    color: color-mix(in oklab, #FAF6F1 70%, transparent);
    transition: all .15s;
  }
  .bd-photo-btn:hover { border-color: var(--accent); color: #FAF6F1; }

  .bd-stats { display: flex; flex-direction: column; gap: 16px; }
  .bd-card { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 22px 24px; }
  .bd-card-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .bd-card-head h3 { font-family: var(--display); font-size: 18px; font-weight: 600; letter-spacing: -0.025em; }
  .bd-card-link { font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin-left: auto; padding: 6px 12px; border-radius: 999px; border: 1px solid color-mix(in oklab, var(--accent) 30%, transparent); transition: all .15s; }
  .bd-card-link:hover { background: var(--accent); color: #fff; }

  .bd-meas { display: flex; flex-direction: column; gap: 12px; }
  .bd-meas-row { display: grid; grid-template-columns: 64px 1fr auto auto; gap: 10px; align-items: center; }
  .bd-meas-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); }
  .bd-meas-bar-wrap { height: 6px; background: var(--bg-alt); border-radius: 3px; overflow: hidden; }
  .bd-meas-bar { height: 100%; background: var(--accent); border-radius: 3px; transition: width .4s ease; }
  .bd-meas-val { font-family: var(--display); font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }
  .bd-meas-u { font-family: var(--mono); font-size: 9px; color: var(--muted); margin-left: 2px; }
  .bd-meas-delta { font-family: var(--mono); font-size: 9px; letter-spacing: 0.12em; font-weight: 700; padding: 3px 7px; border-radius: 4px; }
  .bd-meas-delta.good { background: color-mix(in oklab, var(--accent-2) 20%, transparent); color: var(--ink); }
  .bd-meas-delta.bad  { background: color-mix(in oklab, var(--accent) 18%, transparent); color: var(--ink); }

  .bd-comp { display: flex; flex-direction: column; gap: 14px; }
  .bd-comp-row { display: grid; grid-template-columns: 80px 1fr auto; gap: 10px; align-items: center; }
  .bd-comp-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
  .bd-comp-bar-wrap { height: 8px; background: var(--bg-alt); border-radius: 4px; overflow: hidden; }
  .bd-comp-bar { height: 100%; border-radius: 4px; transition: width .4s ease; }
  .bd-comp-bar.start { background: color-mix(in oklab, var(--ink) 30%, transparent); }
  .bd-comp-bar.now { background: var(--accent); }
  .bd-comp-bar.goal { background: var(--accent-2); }
  .bd-comp-val { font-family: var(--display); font-size: 14px; font-weight: 600; letter-spacing: -0.02em; }
  .bd-lost-badge { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--line); display: flex; align-items: baseline; gap: 6px; }
  .bd-lost-num { font-family: var(--display); font-size: 36px; font-weight: 600; letter-spacing: -0.04em; color: var(--accent); line-height: 1; }
  .bd-lost-u { font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--ink-soft); }

  /* ── Signals ────────────────────────────────────────────────────────── */
  .sg-head { display: flex; align-items: end; gap: 16px; margin-bottom: 22px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .sg-head h2 { font-family: var(--display); font-size: clamp(28px, 3vw, 40px); font-weight: 600; letter-spacing: -0.035em; line-height: 1; max-width: 22ch; }
  .sg-head h2 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
  .sg-head p { font-family: var(--serif); font-style: italic; font-size: 15.5px; color: var(--ink-soft); margin-left: auto; max-width: 36ch; text-align: right; line-height: 1.45; }

  .sg-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .sg-card { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 22px 24px 20px; }
  .sg-card-h { display: flex; align-items: start; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .sg-card-l {
    font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .sg-card-l::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--muted); }
  .sg-card.rose .sg-card-l::before { background: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 22%, transparent); }
  .sg-card.lime .sg-card-l::before { background: var(--accent-2); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-2) 22%, transparent); }
  .sg-card.orange .sg-card-l::before { background: var(--accent-3); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-3) 22%, transparent); }

  .sg-delta { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; padding: 5px 10px; border-radius: 4px; font-weight: 700; }
  .sg-delta.up { background: color-mix(in oklab, var(--accent-2) 22%, transparent); color: var(--ink); }
  .sg-delta.down { background: color-mix(in oklab, var(--accent) 18%, transparent); color: var(--ink); }

  .sg-num { font-family: var(--display); font-size: 52px; font-weight: 600; letter-spacing: -0.04em; line-height: 0.9; }
  .sg-num em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); font-size: 16px; margin-left: 4px; }
  .sg-avg { font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 8px; }
  .sg-avg b { color: var(--ink); font-weight: 600; }

  .sg-chart { margin: 14px 0; }
  .sg-chart svg { width: 100%; height: 80px; display: block; }

  .sg-title { font-family: var(--display); font-size: 17px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; padding-top: 14px; border-top: 1px solid var(--line); }
  .sg-note { font-family: var(--serif); font-style: italic; font-size: 13.5px; color: var(--ink-soft); margin-top: 4px; line-height: 1.4; }

  /* ── Streaks ────────────────────────────────────────────────────────── */
  .st { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 22px; align-items: start; }

  .st-cal { background: var(--card); border: 1px solid var(--line); border-radius: 24px; padding: 24px 24px 22px; }
  .st-h { display: flex; align-items: end; gap: 16px; margin-bottom: 22px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
  .st-h h2 { font-family: var(--display); font-size: 26px; font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
  .st-h h2 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
  .st-h-meta { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-left: auto; }

  .st-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-bottom: 22px; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .st-stat { padding: 14px 16px; border-right: 1px solid var(--line); }
  .st-stat:last-child { border-right: none; }
  .st-stat-l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .st-stat-v { font-family: var(--display); font-size: 26px; font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
  .st-stat-v em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); font-size: 13px; margin-left: 2px; }
  .accent-val { color: var(--accent); }

  .st-grid { display: grid; gap: 4px; margin-bottom: 14px; }
  .st-cell { aspect-ratio: 1; border-radius: 4px; background: var(--bg-alt); cursor: pointer; transition: transform .15s; }
  .st-cell:hover { transform: scale(1.15); z-index: 2; }
  .st-cell.l1 { background: color-mix(in oklab, var(--accent) 25%, var(--bg-alt)); }
  .st-cell.l2 { background: color-mix(in oklab, var(--accent) 50%, transparent); }
  .st-cell.l3 { background: var(--accent); }
  .st-cell.future { background: transparent; border: 1px dashed var(--line); }
  .st-cell.today { outline: 2px solid var(--ink); outline-offset: 2px; }

  .st-legend { display: flex; align-items: center; gap: 14px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .st-scale { display: flex; gap: 3px; align-items: center; }
  .st-b { width: 12px; height: 12px; border-radius: 3px; }
  .st-b.b0 { background: var(--bg-alt); }
  .st-b.b1 { background: color-mix(in oklab, var(--accent) 25%, var(--bg-alt)); }
  .st-b.b2 { background: color-mix(in oklab, var(--accent) 50%, transparent); }
  .st-b.b3 { background: var(--accent); }

  /* Milestones — always dark */
  .st-mile {
    --bg: #FAF6F1; --ink: #16110F; --accent: #FF5C7A; --accent-2: #B6FF3C; --accent-3: #FF914D;
    background: #16110F; color: #FAF6F1;
