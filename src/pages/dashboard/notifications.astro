---
import { getUserJourney, updateCurrentDay } from '../../lib/supabase';
import { requireAuth } from '../../lib/auth';
import Sidebar from '../../components/Sidebar.astro';

const auth = await requireAuth(Astro);
if ('redirect' in auth) return Astro.redirect(auth.redirect);
const { user, profile, db } = auth;

const planType  = profile.subscription_tier || 'basic_30';
const tierLabel = planType === 'elite_12' ? 'Elite' : planType === 'pro_6' ? 'Pro' : 'Basic';
const userName  = profile.full_name?.split(' ')[0] || 'there';

await updateCurrentDay(user.id).catch(() => null);
const journey = await getUserJourney(user.id, db);
const currentDay = journey?.current_day || 1;

const [prefsRes, notifsRes] = await Promise.allSettled([
  db.from('notification_preferences').select('*').eq('user_id', user.id).maybeSingle(),
  db.from('notifications').select('id,type,title,body,action_url,action_label,priority,is_read,is_dismissed,created_at')
    .eq('user_id', user.id).eq('is_dismissed', false)
    .order('created_at', { ascending: false }).limit(60),
]);

const rawPrefs  = prefsRes.status  === 'fulfilled' ? prefsRes.value.data  : null;
const rawNotifs = notifsRes.status === 'fulfilled' ? notifsRes.value.data : [];

const prefs = rawPrefs || {
  checkin_reminder: true, streak_warning: true, incomplete_tasks: true,
  weight_reminder: true, fasting_active: true, weekly_review: true,
  milestone: true, level_up: true,
};

// Normalize DB notification types to 5 design categories
const NT_MAP = {
  checkin_reminder: 'coach', energy_trend: 'coach',
  streak_warning: 'milestone', weight_progress: 'milestone',
  incomplete_tasks: 'reminder', weight_reminder: 'reminder',
  fasting_active: 'reminder', low_water: 'reminder', weekly_review: 'reminder',
  welcome: 'system', day1_start: 'system',
};
const NT_CATS = ['coach','community','milestone','reminder','system'];

function normType(type) {
  if (!type) return 'system';
  if (NT_MAP[type]) return NT_MAP[type];
  if (type.startsWith('milestone') || type.startsWith('level_up')) return 'milestone';
  if (NT_CATS.includes(type)) return type;
  return 'system';
}

const nowMs = Date.now();
const todayStart = new Date(); todayStart.setHours(0, 0, 0, 0);
const weekStart  = new Date(todayStart); weekStart.setDate(weekStart.getDate() - 7);

const notifs = (rawNotifs || []).map(n => {
  const created = new Date(n.created_at);
  const diffMs  = nowMs - created.getTime();
  const diffMin = Math.floor(diffMs / 60000);
  const diffHr  = Math.floor(diffMin / 60);
  const diffDay = Math.floor(diffHr / 24);
  const when = diffMin < 1   ? 'just now'
             : diffMin < 60  ? `${diffMin}m ago`
             : diffHr  < 24  ? `${diffHr}h ago`
             : diffDay === 1 ? 'yesterday'
             : created.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

  const bucket = created >= todayStart ? 'today' : created >= weekStart ? 'week' : 'older';
  return { ...n, nt: normType(n.type), bucket, when };
});

const unread    = notifs.filter(n => !n.is_read).length;
const todayN    = notifs.filter(n => n.bucket === 'today');
const weekN     = notifs.filter(n => n.bucket === 'week');
const olderN    = notifs.filter(n => n.bucket === 'older');

const typesMeta = {
  coach:     { label: 'Coach',     glyph: '✦' },
  community: { label: 'Community', glyph: '◬' },
  milestone: { label: 'Milestone', glyph: '◑' },
  reminder:  { label: 'Reminder',  glyph: '◔' },
  system:    { label: 'System',    glyph: '◯' },
};

const countByType = {};
const totalByType = {};
NT_CATS.forEach(t => {
  countByType[t] = notifs.filter(n => n.nt === t && !n.is_read).length;
  totalByType[t] = notifs.filter(n => n.nt === t).length;
});

const topNotif = notifs.find(n => !n.is_read && n.priority === 'urgent')
              || notifs.find(n => !n.is_read);

const channels = [
  { id: 'coach',     name: 'Coach nudges',     sub: 'Patterns, insights, and briefs from Mira.',    glyph: '✦', inapp: prefs.checkin_reminder !== false, push: true,  email: true },
  { id: 'community', name: 'Community',         sub: 'Replies, cheers, mentions from your cohort.',  glyph: '◬', inapp: true,                              push: false, email: false },
  { id: 'milestone', name: 'Milestones',        sub: 'Streaks, weight markers, level-ups.',          glyph: '◑', inapp: prefs.milestone !== false,           push: true,  email: true },
  { id: 'reminder',  name: 'Reminders',         sub: 'Check-in, tasks, weigh-in, fasting tips.',    glyph: '◔', inapp: prefs.weight_reminder !== false,     push: true,  email: false },
  { id: 'system',    name: 'From Keto Journey', sub: 'Account updates, exports, product news.',     glyph: '◯', inapp: true,                              push: false, email: true },
];

// Pre-compute sub text to avoid complex JSX fragments
const nhSubPrefix = todayN.length > 0
  ? `You have ${todayN.filter(n => !n.is_read).length} unread from today —`
  : "You're all caught up —";
const nhCoachPart = countByType.coach > 0
  ? `<b>${countByType.coach}</b> coach ${countByType.coach === 1 ? 'nudge' : 'nudges'}${(countByType.milestone > 0 || countByType.reminder > 0) ? ', ' : '.'}`
  : '';
const nhMilestonePart = countByType.milestone > 0
  ? `<b>${countByType.milestone}</b> ${countByType.milestone === 1 ? 'milestone' : 'milestones'}${countByType.reminder > 0 ? ', ' : '.'}`
  : '';
const nhReminderPart = countByType.reminder > 0
  ? `<b>${countByType.reminder}</b> ${countByType.reminder === 1 ? 'reminder' : 'reminders'}.`
  : '';
const nhSubHtml = `${nhSubPrefix} ${nhCoachPart}${nhMilestonePart}${nhReminderPart}` || `${nhSubPrefix} stay on track today.`;

const unreadWord = unread === 1 ? 'thing' : 'things';

const scriptData = {
  chanState: Object.fromEntries(channels.map(c => [c.id, { inapp: c.inapp, push: c.push, email: c.email }])),
  unread,
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Notifications — Keto Journey</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:#FAF6F1; --bg-alt:#F2EDE5; --ink:#16110F; --ink-soft:#4A4340;
      --muted:#8A8077; --line:#E5DED2; --card:#FFFFFF;
      --accent:#FF5C7A; --accent-2:#B6FF3C; --accent-3:#FF914D;
      --display:'Bricolage Grotesque',system-ui,sans-serif;
      --serif:'Instrument Serif',serif;
      --body:'Bricolage Grotesque',system-ui,sans-serif;
      --mono:'Geist Mono',monospace;
    }
    *,*::before,*::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { font-family:var(--body); background:var(--bg); color:var(--ink); min-height:100vh; -webkit-font-smoothing:antialiased; }
    a { color:inherit; text-decoration:none; }
    button { font-family:inherit; cursor:pointer; border:none; background:none; color:inherit; }

    /* ── APP SHELL ── */
    .nt-shell { display:grid; grid-template-columns:232px 1fr; min-height:100vh; }
    .nt-main  { display:flex; flex-direction:column; min-width:0; }
    .nt-body  { max-width:1360px; width:100%; margin:0 auto; padding:32px 32px 80px; }
    .nt-layout { display:grid; grid-template-columns:minmax(0,1fr) 360px; gap:28px; align-items:start; }
    .nt-rail-wrap { position:sticky; top:24px; }

    /* ── HERO ── */
    .nh { position:relative; background:var(--ink); color:var(--bg); overflow:hidden; }
    .nh-glow {
      position:absolute; width:720px; height:720px; border-radius:50%;
      background:radial-gradient(circle, color-mix(in oklab,var(--accent) 45%,transparent),transparent 65%);
      filter:blur(80px); top:-340px; right:-180px; z-index:0; pointer-events:none;
    }
    .nh-glow.lime {
      background:radial-gradient(circle,color-mix(in oklab,var(--accent-2) 26%,transparent),transparent 65%);
      bottom:-260px; left:-140px; width:560px; height:560px; top:auto;
    }
    .nh-inner { position:relative; z-index:2; max-width:1360px; margin:0 auto; padding:36px 32px 32px; }

    .nh-bar { display:flex; align-items:center; gap:14px; margin-bottom:28px; }
    .nh-bar .l {
      font-family:var(--mono); font-size:11px; letter-spacing:0.22em; text-transform:uppercase;
      color:var(--accent-2); display:inline-flex; align-items:center; gap:8px;
    }
    .nh-bar .l::before { content:''; width:7px; height:7px; border-radius:50%; background:var(--accent-2); box-shadow:0 0 0 4px color-mix(in oklab,var(--accent-2) 22%,transparent); }
    .nh-bar-r { margin-left:auto; display:flex; gap:8px; }
    .nh-act {
      font-family:var(--mono); font-size:10px; letter-spacing:0.18em; text-transform:uppercase;
      padding:9px 14px; border-radius:999px;
      color:color-mix(in oklab,var(--bg) 70%,transparent);
      border:1px solid color-mix(in oklab,var(--bg) 14%,transparent); transition:all .15s;
    }
    .nh-act:hover { color:var(--bg); border-color:color-mix(in oklab,var(--bg) 32%,transparent); }
    .nh-act.primary { background:var(--accent-2); color:var(--ink); border-color:var(--accent-2); font-weight:700; }
    .nh-act.primary:hover { background:var(--bg); border-color:var(--bg); }

    .nh-head {
      display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);
      gap:64px; align-items:end;
      padding-bottom:28px;
      border-bottom:1px solid color-mix(in oklab,var(--bg) 14%,transparent);
      margin-bottom:24px;
    }
    .nh-big {
      font-family:var(--display); font-size:clamp(48px,6vw,100px);
      line-height:0.9; letter-spacing:-0.055em; font-weight:600;
      max-width:14ch; text-wrap:balance;
    }
    .nh-big em { font-family:var(--serif); font-style:italic; font-weight:400; color:var(--accent); }
    .nh-big .nh-cnt {
      display:inline-block; background:var(--accent); color:#fff;
      padding:0 0.18em 0.04em; line-height:0.92; border-radius:14px;
      font-weight:700; font-family:var(--display); font-style:normal;
      transform:rotate(-1.5deg); margin-right:0.06em;
    }
    .nh-sub {
      font-family:var(--serif); font-style:italic;
      font-size:17px; color:color-mix(in oklab,var(--bg) 78%,transparent);
      line-height:1.5; max-width:38ch; margin-top:16px;
    }
    .nh-sub b { font-family:var(--body); font-style:normal; font-weight:600; color:var(--bg); }

    .nh-top {
      background:color-mix(in oklab,var(--bg) 6%,transparent);
      border:1px solid color-mix(in oklab,var(--bg) 14%,transparent);
      border-radius:22px; padding:22px 24px;
      display:flex; flex-direction:column; gap:14px;
    }
    .nh-top-h {
      display:flex; align-items:center; gap:10px;
      font-family:var(--mono); font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--accent);
    }
    .nh-top-h::before { content:'✦'; font-size:14px; color:var(--accent); }
    .nh-top-h .pip { margin-left:auto; font-size:9px; letter-spacing:0.16em; color:color-mix(in oklab,var(--bg) 60%,transparent); }
    .nh-top-t { font-family:var(--display); font-size:20px; font-weight:600; letter-spacing:-0.025em; line-height:1.15; max-width:26ch; text-wrap:balance; }
    .nh-top-b { font-family:var(--serif); font-style:italic; font-size:14px; line-height:1.5; color:color-mix(in oklab,var(--bg) 78%,transparent); }
    .nh-top-cta { display:flex; gap:8px; flex-wrap:wrap; }
    .nh-top-cta a, .nh-top-cta button {
      font-family:var(--mono); font-size:10px; letter-spacing:0.16em; text-transform:uppercase;
      padding:10px 14px; border-radius:999px; font-weight:700; cursor:pointer;
    }
    .nh-top-cta .primary { background:var(--accent-2); color:var(--ink); }
    .nh-top-cta .ghost { background:transparent; color:color-mix(in oklab,var(--bg) 80%,transparent); border:1px solid color-mix(in oklab,var(--bg) 18%,transparent); }
    .nh-empty-card {
      background:color-mix(in oklab,var(--bg) 6%,transparent);
      border:1px solid color-mix(in oklab,var(--bg) 14%,transparent);
      border-radius:22px; padding:32px 24px; text-align:center;
    }
    .nh-empty-card .e-glyph { font-size:36px; margin-bottom:10px; opacity:.5; }
    .nh-empty-card .e-title { font-family:var(--display); font-size:18px; font-weight:600; color:var(--bg); margin-bottom:6px; }
    .nh-empty-card .e-sub { font-family:var(--serif); font-style:italic; font-size:14px; color:color-mix(in oklab,var(--bg) 65%,transparent); }

    .nh-strip {
      display:grid; grid-template-columns:repeat(5,1fr);
      border:1px solid color-mix(in oklab,var(--bg) 12%,transparent);
      border-radius:20px; overflow:hidden;
    }
    .nh-cell {
      padding:16px 18px;
      border-right:1px solid color-mix(in oklab,var(--bg) 12%,transparent);
      cursor:pointer; transition:background .15s;
      display:flex; flex-direction:column; gap:6px;
    }
    .nh-cell:last-child { border-right:none; }
    .nh-cell:hover { background:color-mix(in oklab,var(--bg) 6%,transparent); }
    .nh-cell.active-filter { background:color-mix(in oklab,var(--accent-2) 14%,transparent); }
    .nh-cell .l {
      font-family:var(--mono); font-size:9px; letter-spacing:0.18em; text-transform:uppercase;
      color:color-mix(in oklab,var(--bg) 55%,transparent); display:inline-flex; align-items:center; gap:6px;
    }
    .nh-cell .l .g {
      width:18px; height:18px; border-radius:5px;
      background:color-mix(in oklab,var(--bg) 10%,transparent);
      display:grid; place-items:center; font-size:10px;
    }
    .nh-cell.coach .l .g     { background:var(--accent);   color:#fff; }
    .nh-cell.community .l .g { background:var(--accent-3); color:#fff; }
    .nh-cell.milestone .l .g { background:var(--accent-2); color:var(--ink); }
    .nh-cell.reminder .l .g  { background:var(--bg);       color:var(--ink); }
    .nh-cell.system .l .g    { background:color-mix(in oklab,var(--bg) 18%,transparent); color:var(--bg); }
    .nh-cell .v { font-family:var(--display); font-size:30px; font-weight:600; letter-spacing:-0.04em; line-height:1; }
    .nh-cell .v em { font-family:var(--serif); font-style:italic; color:var(--accent-2); font-weight:400; font-size:12px; margin-left:3px; }
    .nh-cell .v.zero { color:color-mix(in oklab,var(--bg) 35%,transparent); }
    .nh-cell .nm { font-family:var(--mono); font-size:9px; letter-spacing:0.14em; text-transform:uppercase; color:color-mix(in oklab,var(--bg) 70%,transparent); }

    /* ── FEED ── */
    .nf-pill-bar { display:flex; gap:8px; flex-wrap:wrap; margin-bottom:24px; }
    .nf-pill {
      font-family:var(--mono); font-size:10px; letter-spacing:0.18em; text-transform:uppercase;
      padding:8px 14px; border-radius:999px; border:1px solid var(--line);
      color:var(--muted); cursor:pointer; transition:all .15s;
      display:inline-flex; align-items:center; gap:6px; background:var(--card);
    }
    .nf-pill:hover { border-color:var(--ink-soft); color:var(--ink); }
    .nf-pill.active { background:var(--ink); color:var(--bg); border-color:var(--ink); }
    .nf-pill .badge {
      min-width:18px; height:18px; border-radius:9px; padding:0 5px;
      background:var(--accent); color:#fff; font-size:9px; font-weight:700;
      display:grid; place-items:center; line-height:1;
    }
    .nf-pill.active .badge { background:var(--accent-2); color:var(--ink); }

    .nf-group { margin-bottom:32px; }
    .nf-group-h {
      font-family:var(--mono); font-size:10px; letter-spacing:0.22em; text-transform:uppercase;
      color:var(--muted); margin-bottom:12px; padding-left:4px;
      display:flex; align-items:center; gap:8px;
    }
    .nf-group-h::before { content:''; flex:0 0 16px; height:1px; background:var(--line); }

    .nf-row {
      display:grid; grid-template-columns:44px 1fr auto;
      gap:14px; padding:16px 8px 16px 20px;
      border-radius:16px; transition:background .15s; position:relative;
    }
    .nf-row:hover { background:var(--bg-alt); }
    .nf-row.unread::before {
      content:''; position:absolute; left:4px; top:50%; transform:translateY(-50%);
      width:6px; height:6px; border-radius:50%; background:var(--accent);
      box-shadow:0 0 0 3px color-mix(in oklab,var(--accent) 22%,transparent);
    }
    .nf-av { width:44px; height:44px; border-radius:14px; display:grid; place-items:center; font-size:18px; flex-shrink:0; }
    .nf-av.coach     { background:var(--accent);   color:#fff; }
    .nf-av.community { background:var(--accent-3); color:#fff; }
    .nf-av.milestone { background:var(--accent-2); color:var(--ink); }
    .nf-av.reminder  { background:var(--ink);      color:var(--accent-2); }
    .nf-av.system    { background:var(--bg-alt);   color:var(--muted); border:1px solid var(--line); }
    .nf-cont { min-width:0; }
    .nf-meta { display:flex; align-items:center; gap:8px; margin-bottom:5px; }
    .nf-tag { font-family:var(--mono); font-size:9px; letter-spacing:0.18em; text-transform:uppercase; padding:2px 7px; border-radius:4px; }
    .nf-tag.coach     { background:color-mix(in oklab,var(--accent)   18%,transparent); color:var(--accent); }
    .nf-tag.community { background:color-mix(in oklab,var(--accent-3) 18%,transparent); color:var(--accent-3); }
    .nf-tag.milestone { background:color-mix(in oklab,var(--accent-2) 22%,transparent); color:color-mix(in oklab,var(--ink) 75%,var(--accent-2)); }
    .nf-tag.reminder  { background:color-mix(in oklab,var(--ink)      8%,transparent);  color:var(--ink-soft); }
    .nf-tag.system    { background:var(--bg-alt); color:var(--muted); }
    .nf-when { font-family:var(--mono); font-size:9px; letter-spacing:0.12em; color:var(--muted); margin-left:auto; white-space:nowrap; }
    .nf-title { font-family:var(--display); font-size:15px; font-weight:600; letter-spacing:-0.015em; line-height:1.25; margin-bottom:4px; }
    .nf-body { font-family:var(--serif); font-style:italic; font-size:13.5px; color:var(--ink-soft); line-height:1.5; text-wrap:pretty; }
    .nf-actions { display:flex; gap:8px; flex-wrap:wrap; margin-top:10px; }
    .nf-btn {
      font-family:var(--mono); font-size:9px; letter-spacing:0.16em; text-transform:uppercase;
      padding:7px 12px; border-radius:999px; cursor:pointer; transition:all .15s;
      text-decoration:none; display:inline-flex; align-items:center; font-weight:700;
    }
    .nf-btn.primary { background:var(--accent-2); color:var(--ink); }
    .nf-btn.primary:hover { background:var(--ink); color:var(--accent-2); }
    .nf-btn.ghost { background:transparent; color:var(--muted); border:1px solid var(--line); }
    .nf-btn.ghost:hover { color:var(--ink); border-color:var(--ink-soft); }
    .nf-right { display:flex; flex-direction:column; align-items:center; gap:6px; opacity:0; transition:opacity .15s; padding-top:2px; }
    .nf-row:hover .nf-right { opacity:1; }
    .nf-icon-btn {
      width:28px; height:28px; border-radius:8px; background:var(--bg-alt);
      border:1px solid var(--line); display:grid; place-items:center;
      font-size:13px; cursor:pointer; color:var(--muted); transition:all .15s;
    }
    .nf-icon-btn:hover { background:var(--ink); color:var(--bg); border-color:var(--ink); }

    .nf-empty-state {
      text-align:center; padding:48px 24px; color:var(--muted);
    }
    .nf-empty-state .eg { font-size:36px; margin-bottom:12px; }
    .nf-empty-state .et { font-family:var(--display); font-size:18px; font-weight:600; color:var(--ink); margin-bottom:6px; }
    .nf-empty-state .es { font-family:var(--serif); font-style:italic; font-size:14px; }

    /* ── RAIL ── */
    .rl { display:flex; flex-direction:column; gap:16px; }
    .rl-card { background:var(--card); border:1px solid var(--line); border-radius:22px; padding:22px; }
    .rl-card.dark { background:var(--ink); color:var(--bg); border-color:var(--ink); }
    .rl-h {
      display:flex; align-items:center; gap:10px;
      font-family:var(--mono); font-size:10px; letter-spacing:0.18em; text-transform:uppercase; color:var(--muted);
      margin-bottom:18px;
    }
    .rl-card.dark .rl-h { color:color-mix(in oklab,var(--bg) 55%,transparent); }
    .rl-h .pip { width:6px; height:6px; border-radius:50%; background:var(--accent); }
    .rl-h .pip.lime { background:var(--accent-2); box-shadow:0 0 0 3px color-mix(in oklab,var(--accent-2) 25%,transparent); }

    .rl-quiet-title { font-family:var(--display); font-size:20px; font-weight:600; letter-spacing:-0.025em; margin-bottom:6px; }
    .rl-quiet-title em { font-family:var(--serif); font-style:italic; font-weight:400; color:var(--accent); }
    .rl-quiet-sub { font-family:var(--serif); font-style:italic; font-size:13px; color:color-mix(in oklab,var(--bg) 75%,transparent); margin-bottom:18px; line-height:1.45; }

    .rl-toggle-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 0; }
    .rl-toggle-row .tl { font-size:13.5px; font-weight:500; }
    .rl-toggle-row .ts { font-family:var(--mono); font-size:10px; letter-spacing:0.12em; color:color-mix(in oklab,var(--bg) 55%,transparent); margin-top:2px; text-transform:uppercase; }

    .rl-switch {
      width:38px; height:22px; border-radius:999px;
      background:color-mix(in oklab,var(--bg) 16%,transparent);
      position:relative; cursor:pointer; flex-shrink:0; transition:background .15s;
    }
    .rl-switch::after {
      content:''; position:absolute; top:2px; left:2px;
      width:18px; height:18px; border-radius:50%; background:var(--bg); transition:left .15s;
    }
    .rl-switch.on { background:var(--accent-2); }
    .rl-switch.on::after { left:18px; background:var(--ink); }

    .rl-ch { padding:16px 0; border-bottom:1px dashed var(--line); }
    .rl-ch:last-child { border-bottom:none; padding-bottom:0; }
    .rl-ch-h { display:flex; align-items:start; gap:12px; margin-bottom:10px; }
    .rl-ch-g {
      width:32px; height:32px; border-radius:10px;
      background:var(--bg-alt); color:var(--ink);
      display:grid; place-items:center; font-size:14px; flex-shrink:0;
    }
    .rl-ch.coach .rl-ch-g     { background:var(--accent);   color:#fff; }
    .rl-ch.community .rl-ch-g { background:var(--accent-3); color:#fff; }
    .rl-ch.milestone .rl-ch-g { background:var(--accent-2); color:var(--ink); }
    .rl-ch.reminder .rl-ch-g  { background:var(--ink);      color:var(--accent-2); }
    .rl-ch-n { font-family:var(--display); font-size:15px; font-weight:600; letter-spacing:-0.015em; line-height:1.2; }
    .rl-ch-s { font-family:var(--serif); font-style:italic; font-size:13px; color:var(--ink-soft); margin-top:4px; line-height:1.4; }

    .rl-ch-controls { display:grid; grid-template-columns:1fr 1fr 1fr; gap:6px; margin-left:44px; }
    .rl-ch-btn {
      display:flex; flex-direction:column; align-items:center; gap:4px;
      padding:8px 6px; border-radius:10px;
      font-family:var(--mono); font-size:9px; letter-spacing:0.12em; text-transform:uppercase;
      color:var(--muted); background:var(--bg-alt); border:1px solid transparent; transition:all .15s;
    }
    .rl-ch-btn:hover { color:var(--ink); }
    .rl-ch-btn.on { background:var(--ink); color:var(--accent-2); border-color:var(--ink); }
    .rl-ch-btn .ic { font-size:13px; }

    .rl-tip-q {
      font-family:var(--serif); font-style:italic;
      font-size:16px; line-height:1.5; color:var(--bg); margin-bottom:14px; text-wrap:pretty;
    }
    .rl-tip-q::before { content:'"'; font-family:var(--display); font-style:normal; font-weight:700; color:var(--accent-2); margin-right:4px; font-size:22px; vertical-align:-4px; }
    .rl-tip-cta {
      font-family:var(--mono); font-size:10px; letter-spacing:0.16em; text-transform:uppercase;
      padding:9px 14px; border-radius:999px;
      background:var(--accent-2); color:var(--ink); font-weight:700;
      display:inline-flex; align-items:center; gap:8px; cursor:pointer;
      border:none; transition:background .15s;
    }
    .rl-tip-cta:hover { background:var(--bg); }

    /* ── TOAST ── */
    .toast {
      position:fixed; top:5rem; right:1.25rem; z-index:9999;
      padding:.75rem 1.25rem; border-radius:12px; font-family:var(--mono);
      font-size:11px; letter-spacing:0.12em; font-weight:700;
      box-shadow:0 12px 32px rgba(0,0,0,.28); pointer-events:none;
      transform:translateX(120px); opacity:0; transition:all .3s cubic-bezier(.4,0,.2,1);
      display:flex; align-items:center; gap:.5rem;
    }
    .toast.show { transform:translateX(0); opacity:1; }
    .toast-success { background:var(--ink); color:var(--accent-2); }
    .toast-info    { background:var(--ink); color:var(--bg); }
    .toast-error   { background:#ef4444;   color:#fff; }

    /* ── RESPONSIVE ── */
    @media (max-width:1100px) {
      .nt-shell { grid-template-columns:1fr; }
      .nt-body  { padding:22px 16px 60px; }
      .nt-layout { grid-template-columns:1fr; }
      .nt-rail-wrap { position:static; }
      .nh-inner { padding:26px 18px 24px; }
      .nh-head  { grid-template-columns:1fr; gap:28px; }
      .nh-strip { grid-template-columns:1fr 1fr; }
      .nh-cell  { border-right:none; border-bottom:1px solid color-mix(in oklab,var(--bg) 12%,transparent); }
      .rl { display:grid; grid-template-columns:1fr 1fr; gap:14px; align-items:start; }
    }
    @media (max-width:700px) {
      .rl { grid-template-columns:1fr; }
      .nh-strip { grid-template-columns:1fr 1fr 1fr; }
    }
    @media (max-width:480px) {
      .nh-strip { grid-template-columns:1fr 1fr; }
    }
  </style>
</head>
<body>

<div class="nt-shell">
  <Sidebar userName={userName} planType={planType} tierLabel={tierLabel} currentDay={currentDay} avatarUrl={profile.avatar_url} activePage="notifications" />

  <main class="nt-main">

    <!-- ── HERO ── -->
    <section class="nh">
      <div class="nh-glow lime"></div>
      <div class="nh-glow"></div>
      <div class="nh-inner">

        <!-- Status bar -->
        <div class="nh-bar">
          <div class="l">INBOX · DAY {currentDay} · {notifs.length} TOTAL · <span id="heroUnread">{unread}</span> UNREAD</div>
          <div class="nh-bar-r">
            <button class="nh-act" id="markAllBtn">Mark all read</button>
            <a href="/dashboard/notifications" class="nh-act primary">Notification settings</a>
          </div>
        </div>

        <!-- Big headline + top card -->
        <div class="nh-head">
          <div>
            <h1 class="nh-big">
              <span class="nh-cnt" id="unreadBadge">{unread}</span>
              {unreadWord} <em>worth knowing</em> today.
            </h1>
            <p class="nh-sub" set:html={nhSubHtml}></p>
          </div>

          <!-- Top important notification or empty state -->
          {topNotif ? (
            <div class="nh-top" id="nhTopCard" data-id={topNotif.id}>
              <div class="nh-top-h">
                MOST IMPORTANT · {topNotif.when.toUpperCase()}
                <span class="pip">{typesMeta[topNotif.nt].label.toUpperCase()}</span>
              </div>
              <div class="nh-top-t">{topNotif.title}</div>
              <div class="nh-top-b">{topNotif.body}</div>
              <div class="nh-top-cta">
                {topNotif.action_url
                  ? <a href={topNotif.action_url} class="primary">{topNotif.action_label || 'Open'} →</a>
                  : <button class="primary" onclick="document.getElementById('ntFeed').scrollIntoView({behavior:'smooth'})">View in feed →</button>
                }
                <button class="ghost" onclick="dismissTop()">Dismiss</button>
              </div>
            </div>
          ) : (
            <div class="nh-empty-card">
              <div class="e-glyph">✦</div>
              <div class="e-title">All clear</div>
              <div class="e-sub">No new notifications right now. You're on top of it.</div>
            </div>
          )}
        </div>

        <!-- Type breakdown strip -->
        <div class="nh-strip">
          {NT_CATS.map(t => (
            <div class={`nh-cell ${t}`} data-strip-filter={t} role="button" tabindex="0">
              <div class="l">
                <span class="g">{typesMeta[t].glyph}</span>
                {typesMeta[t].label}
              </div>
              <div class={`v${countByType[t] === 0 ? ' zero' : ''}`} id={`cnt-${t}`}>
                {countByType[t]}<em>new</em>
              </div>
              <div class="nm" id={`tot-${t}`}>{totalByType[t]} TOTAL</div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ── BODY ── -->
    <div class="nt-body">
      <div class="nt-layout">

        <!-- FEED -->
        <div id="ntFeed">
          <!-- Filter pills -->
          <div class="nf-pill-bar">
            <button class="nf-pill active" data-filter="all">All</button>
            <button class="nf-pill" data-filter="unread">
              Unread
              {unread > 0 && <span class="badge" id="unreadPill">{unread}</span>}
            </button>
            <button class="nf-pill" data-filter="coach">Coach</button>
            <button class="nf-pill" data-filter="community">Community</button>
            <button class="nf-pill" data-filter="milestone">Milestone</button>
            <button class="nf-pill" data-filter="reminder">Reminder</button>
            <button class="nf-pill" data-filter="system">System</button>
          </div>

          <!-- Empty state (shown when all filtered) -->
          <div class="nf-empty-state" id="feedEmpty" style="display:none;">
            <div class="eg">◯</div>
            <div class="et">Nothing here</div>
            <div class="es">No notifications match this filter.</div>
          </div>

          <!-- TODAY -->
          {todayN.length > 0 && (
            <div class="nf-group" data-group="today">
              <div class="nf-group-h">Today</div>
              {todayN.map(n => (
                <div class={`nf-row${n.is_read ? '' : ' unread'}`} data-id={n.id} data-type={n.nt} data-read={n.is_read ? 'true' : 'false'} data-bucket="today">
                  <div class={`nf-av ${n.nt}`}>{typesMeta[n.nt].glyph}</div>
                  <div class="nf-cont">
                    <div class="nf-meta">
                      <span class={`nf-tag ${n.nt}`}>{typesMeta[n.nt].label}</span>
                      <span class="nf-when">{n.when}</span>
                    </div>
                    <div class="nf-title">{n.title}</div>
                    {n.body && <div class="nf-body">{n.body}</div>}
                    {n.action_url && (
                      <div class="nf-actions">
                        <a href={n.action_url} class="nf-btn primary">{n.action_label || 'Open'}</a>
                        <button class="nf-btn ghost" data-dismiss={n.id}>Dismiss</button>
                      </div>
                    )}
                  </div>
                  <div class="nf-right">
                    <button class="nf-icon-btn" data-mark={n.id} title="Mark read">○</button>
                    <button class="nf-icon-btn" data-dismiss={n.id} title="Dismiss">×</button>
                  </div>
                </div>
              ))}
            </div>
          )}

          <!-- THIS WEEK -->
          {weekN.length > 0 && (
            <div class="nf-group" data-group="week">
              <div class="nf-group-h">Earlier this week</div>
              {weekN.map(n => (
                <div class={`nf-row${n.is_read ? '' : ' unread'}`} data-id={n.id} data-type={n.nt} data-read={n.is_read ? 'true' : 'false'} data-bucket="week">
                  <div class={`nf-av ${n.nt}`}>{typesMeta[n.nt].glyph}</div>
                  <div class="nf-cont">
                    <div class="nf-meta">
                      <span class={`nf-tag ${n.nt}`}>{typesMeta[n.nt].label}</span>
                      <span class="nf-when">{n.when}</span>
                    </div>
                    <div class="nf-title">{n.title}</div>
                    {n.body && <div class="nf-body">{n.body}</div>}
                    {n.action_url && (
                      <div class="nf-actions">
                        <a href={n.action_url} class="nf-btn primary">{n.action_label || 'Open'}</a>
                        <button class="nf-btn ghost" data-dismiss={n.id}>Dismiss</button>
                      </div>
                    )}
                  </div>
                  <div class="nf-right">
                    <button class="nf-icon-btn" data-mark={n.id} title="Mark read">○</button>
                    <button class="nf-icon-btn" data-dismiss={n.id} title="Dismiss">×</button>
                  </div>
                </div>
              ))}
            </div>
          )}

          <!-- OLDER -->
          {olderN.length > 0 && (
            <div class="nf-group" data-group="older">
              <div class="nf-group-h">Older</div>
              {olderN.map(n => (
                <div class={`nf-row${n.is_read ? '' : ' unread'}`} data-id={n.id} data-type={n.nt} data-read={n.is_read ? 'true' : 'false'} data-bucket="older">
                  <div class={`nf-av ${n.nt}`}>{typesMeta[n.nt].glyph}</div>
                  <div class="nf-cont">
                    <div class="nf-meta">
                      <span class={`nf-tag ${n.nt}`}>{typesMeta[n.nt].label}</span>
                      <span class="nf-when">{n.when}</span>
                    </div>
                    <div class="nf-title">{n.title}</div>
                    {n.body && <div class="nf-body">{n.body}</div>}
                    {n.action_url && (
                      <div class="nf-actions">
                        <a href={n.action_url} class="nf-btn primary">{n.action_label || 'Open'}</a>
                        <button class="nf-btn ghost" data-dismiss={n.id}>Dismiss</button>
                      </div>
                    )}
                  </div>
                  <div class="nf-right">
                    <button class="nf-icon-btn" data-mark={n.id} title="Mark read">○</button>
                    <button class="nf-icon-btn" data-dismiss={n.id} title="Dismiss">×</button>
                  </div>
                </div>
              ))}
            </div>
          )}

        </div>

        <!-- RAIL -->
        <div class="nt-rail-wrap">
          <aside class="rl">

            <!-- Quiet hours -->
            <div class="rl-card dark">
              <div class="rl-h"><span class="pip lime"></span>QUIET HOURS</div>
              <div class="rl-quiet-title">No nudges while you're <em>resting</em>.</div>
              <div class="rl-quiet-sub">Everything queues up and lands in your morning brief.</div>
              <div class="rl-toggle-row">
                <div>
                  <div class="tl">Quiet hours active</div>
                  <div class="ts">10:00pm → 7:00am</div>
                </div>
                <div class="rl-switch on" id="switchQuiet" role="switch" aria-checked="true"></div>
              </div>
              <div class="rl-toggle-row">
                <div>
                  <div class="tl">Allow important coach</div>
                  <div class="ts">Mira can still reach you</div>
                </div>
                <div class="rl-switch on" id="switchImportant" role="switch" aria-checked="true"></div>
              </div>
            </div>

            <!-- Channels -->
            <div class="rl-card">
              <div class="rl-h"><span class="pip"></span>CHANNELS · WHERE TO REACH YOU</div>
              {channels.map(ch => (
                <div class={`rl-ch ${ch.id}`}>
                  <div class="rl-ch-h">
                    <div class="rl-ch-g">{ch.glyph}</div>
                    <div style="min-width:0;flex:1;">
                      <div class="rl-ch-n">{ch.name}</div>
                      <div class="rl-ch-s">{ch.sub}</div>
                    </div>
                  </div>
                  <div class="rl-ch-controls">
                    <button class={`rl-ch-btn${ch.inapp ? ' on' : ''}`} data-ch={ch.id} data-opt="inapp">
                      <span class="ic">◐</span>
                      <span>In-app</span>
                    </button>
                    <button class={`rl-ch-btn${ch.push ? ' on' : ''}`} data-ch={ch.id} data-opt="push">
                      <span class="ic">◔</span>
                      <span>Push</span>
                    </button>
                    <button class={`rl-ch-btn${ch.email ? ' on' : ''}`} data-ch={ch.id} data-opt="email">
                      <span class="ic">✉</span>
                      <span>Email</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>

            <!-- Mira tip -->
            <div class="rl-card dark">
              <div class="rl-h"><span class="pip lime"></span>FROM MIRA</div>
              <div class="rl-tip-q">Too many nudges? Mute Community push first — that's where the noise lives. Coach and milestone alerts are usually worth it.</div>
              <button class="rl-tip-cta" onclick="document.querySelector('.nf-pill[data-filter=coach]').click()">Show coach only →</button>
            </div>

          </aside>
        </div>

      </div>
    </div>
  </main>
</div>

<div class="toast" id="toast"></div>

<script is:inline define:vars={{ scriptData }}>
var chanState = scriptData.chanState;
var currentFilter = 'all';
var quietActive = true;
var importantActive = true;
var unreadCount = scriptData.unread;

/* ── FILTER PILLS ── */
document.querySelectorAll('.nf-pill').forEach(function(pill) {
  pill.addEventListener('click', function() {
    currentFilter = pill.dataset.filter;
    document.querySelectorAll('.nf-pill').forEach(function(p) { p.classList.remove('active'); });
    pill.classList.add('active');
    applyFilter();
  });
});

function applyFilter() {
  var rows = document.querySelectorAll('.nf-row');
  var visibleAny = false;
  rows.forEach(function(row) {
    var type   = row.dataset.type;
    var isRead = row.dataset.read === 'true';
    var show   = true;
    if (currentFilter === 'unread' && isRead)                        show = false;
    if (currentFilter !== 'all' && currentFilter !== 'unread' && type !== currentFilter) show = false;
    row.style.display = show ? '' : 'none';
    if (show) visibleAny = true;
  });

  // Hide/show groups when empty
  document.querySelectorAll('.nf-group').forEach(function(group) {
    var visRows = group.querySelectorAll('.nf-row');
    var hasVis  = false;
    visRows.forEach(function(r) { if (r.style.display !== 'none') hasVis = true; });
    group.style.display = hasVis ? '' : 'none';
  });

  // Toggle empty state
  var empty = document.getElementById('feedEmpty');
  if (empty) {
    if (visibleAny) {
      empty.style.display = 'none';
    } else {
      var allRows = document.querySelectorAll('.nf-row');
      if (allRows.length === 0) {
        empty.querySelector('.et').textContent = "You're all caught up";
        empty.querySelector('.es').textContent = 'No notifications right now. Check back after completing today\'s tasks.';
      } else {
        empty.querySelector('.et').textContent = 'Nothing here';
        empty.querySelector('.es').textContent = 'No notifications match this filter.';
      }
      empty.style.display = 'block';
    }
  }
}

/* ── STRIP CELLS as filter shortcuts ── */
document.querySelectorAll('.nh-cell[data-strip-filter]').forEach(function(cell) {
  cell.addEventListener('click', function() {
    var f = cell.dataset.stripFilter;
    currentFilter = f;
    document.querySelectorAll('.nf-pill').forEach(function(p) {
      p.classList.toggle('active', p.dataset.filter === f);
    });
    document.querySelectorAll('.nh-cell').forEach(function(c) { c.classList.remove('active-filter'); });
    cell.classList.add('active-filter');
    document.getElementById('ntFeed').scrollIntoView({ behavior: 'smooth', block: 'start' });
    applyFilter();
  });
  cell.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' || e.key === ' ') cell.click();
  });
});

/* ── MARK READ ── */
document.addEventListener('click', function(e) {
  var markBtn = e.target.closest('[data-mark]');
  if (!markBtn) return;
  var id  = markBtn.dataset.mark;
  var row = document.querySelector('.nf-row[data-id="' + id + '"]');
  if (!row) return;
  var wasRead = row.dataset.read === 'true';
  row.dataset.read = wasRead ? 'false' : 'true';
  wasRead ? row.classList.add('unread') : row.classList.remove('unread');
  markBtn.textContent = wasRead ? '○' : '●';
  markBtn.title = wasRead ? 'Mark read' : 'Mark unread';
  if (!wasRead) unreadCount = Math.max(0, unreadCount - 1);
  else unreadCount += 1;
  refreshUnreadUI();
  applyFilter();
});

/* ── DISMISS ── */
document.addEventListener('click', function(e) {
  var dismissBtn = e.target.closest('[data-dismiss]');
  if (!dismissBtn) return;
  var id  = dismissBtn.dataset.dismiss;
  var row = document.querySelector('.nf-row[data-id="' + id + '"]');
  if (!row) return;
  if (row.dataset.read !== 'true') {
    unreadCount = Math.max(0, unreadCount - 1);
    refreshUnreadUI();
  }
  row.style.opacity = '0';
  row.style.transform = 'translateX(12px)';
  row.style.transition = 'opacity .25s, transform .25s';
  setTimeout(function() {
    row.remove();
    applyFilter();
    updateStripCounts();
  }, 260);
});

/* ── DISMISS TOP CARD ── */
function dismissTop() {
  var card = document.getElementById('nhTopCard');
  if (!card) return;
  var id = card.dataset.id;
  card.style.opacity = '0';
  card.style.transition = 'opacity .3s';
  setTimeout(function() { card.remove(); }, 310);
  if (id) {
    var row = document.querySelector('.nf-row[data-id="' + id + '"]');
    if (row && row.dataset.read !== 'true') {
      unreadCount = Math.max(0, unreadCount - 1);
      refreshUnreadUI();
    }
  }
}

/* ── MARK ALL READ ── */
document.getElementById('markAllBtn').addEventListener('click', function() {
  document.querySelectorAll('.nf-row.unread').forEach(function(row) {
    row.classList.remove('unread');
    row.dataset.read = 'true';
    var markBtn = row.querySelector('[data-mark]');
    if (markBtn) { markBtn.textContent = '●'; markBtn.title = 'Mark unread'; }
  });
  unreadCount = 0;
  refreshUnreadUI();
  applyFilter();
  updateStripCounts();
  showToast('All caught up ✓', 'success');
  fetch('/api/notifications/generate', { method: 'POST', credentials: 'same-origin' }).catch(function(){});
});

/* ── REFRESH UNREAD UI ── */
function refreshUnreadUI() {
  var heroEl  = document.getElementById('heroUnread');
  var badgeEl = document.getElementById('unreadBadge');
  var pillBadge = document.getElementById('unreadPill');
  if (heroEl)  heroEl.textContent  = unreadCount;
  if (badgeEl) badgeEl.textContent = unreadCount;
  if (pillBadge) {
    if (unreadCount > 0) { pillBadge.textContent = unreadCount; pillBadge.style.display = ''; }
    else pillBadge.style.display = 'none';
  }
}

/* ── UPDATE STRIP COUNTS ── */
function updateStripCounts() {
  var types = ['coach','community','milestone','reminder','system'];
  types.forEach(function(t) {
    var unreadEl = document.getElementById('cnt-' + t);
    if (!unreadEl) return;
    var rows    = document.querySelectorAll('.nf-row[data-type="' + t + '"]');
    var unread  = 0;
    var total   = 0;
    rows.forEach(function(r) {
      total++;
      if (r.dataset.read !== 'true') unread++;
    });
    unreadEl.innerHTML = unread + '<em>new</em>';
    unreadEl.className = 'v' + (unread === 0 ? ' zero' : '');
    var totEl = document.getElementById('tot-' + t);
    if (totEl) totEl.textContent = total + ' TOTAL';
  });
}

/* ── QUIET SWITCHES ── */
document.getElementById('switchQuiet').addEventListener('click', function() {
  quietActive = !quietActive;
  this.classList.toggle('on', quietActive);
  this.setAttribute('aria-checked', quietActive ? 'true' : 'false');
  showToast(quietActive ? 'Quiet hours on' : 'Quiet hours off', 'info');
});
document.getElementById('switchImportant').addEventListener('click', function() {
  importantActive = !importantActive;
  this.classList.toggle('on', importantActive);
  this.setAttribute('aria-checked', importantActive ? 'true' : 'false');
  showToast(importantActive ? 'Coach interrupts allowed' : 'Coach interrupts off', 'info');
});

/* ── CHANNEL BUTTONS ── */
document.querySelectorAll('.rl-ch-btn[data-ch]').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var type = btn.dataset.ch;
    var opt  = btn.dataset.opt;
    chanState[type][opt] = !chanState[type][opt];
    btn.classList.toggle('on', chanState[type][opt]);

    // Persist in-app preference to DB
    if (opt === 'inapp') {
      var data = {};
      var enabled = chanState[type][opt];
      if (type === 'coach')     { data.checkin_reminder = enabled; data.streak_warning = enabled; }
      if (type === 'milestone') { data.milestone = enabled; data.level_up = enabled; }
      if (type === 'reminder')  { data.weight_reminder = enabled; data.fasting_active = enabled; data.incomplete_tasks = enabled; data.weekly_review = enabled; }
      if (Object.keys(data).length > 0) {
        fetch('/api/notifications/preferences', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data), credentials: 'same-origin',
        }).then(function() {
          showToast(enabled ? type + ' on' : type + ' off', 'success');
        }).catch(function() {
          showToast('Could not save', 'error');
        });
      } else {
        showToast(enabled ? type + ' on' : type + ' off', 'info');
      }
    } else {
      showToast((opt === 'push' ? 'Push ' : 'Email ') + (chanState[type][opt] ? 'on' : 'off'), 'info');
    }
  });
});

/* ── TOAST ── */
function showToast(msg, type) {
  var t = document.getElementById('toast');
  if (!t) return;
  t.textContent = msg;
  t.className = 'toast toast-' + (type || 'info') + ' show';
  clearTimeout(t._tid);
  t._tid = setTimeout(function() { t.classList.remove('show'); }, 3000);
}

/* ── BOOT: call generate to populate ── */
(function boot() {
  var GEN_KEY = 'rv_notif_gen_ts';
  try {
    var lastGen = parseInt(sessionStorage.getItem(GEN_KEY) || '0', 10);
    if (Date.now() - lastGen > 120000) {
      fetch('/api/notifications/generate', { method: 'POST', credentials: 'same-origin' })
        .then(function() {
          try { sessionStorage.setItem(GEN_KEY, String(Date.now())); } catch(e) {}
        }).catch(function(){});
    }
  } catch(e) {}
  applyFilter();
})();
</script>

</body>
</html>
