<script is:inline>
(function () {
  /* ── Confetti ── */
  var canvas = document.getElementById('confettiCanvas');
  var ctx    = canvas.getContext('2d');
  canvas.width  = window.innerWidth;
  canvas.height = window.innerHeight;
  var W = canvas.width, H = canvas.height;
  var colors = ['#FF5C7A','#B6FF3C','#FFD700','#60a5fa','#f97316','#a78bfa'];
  var particles = [];
  for (var i = 0; i < 150; i++) {
    particles.push({
      x: Math.random() * W,
      y: -20 - Math.random() * 180,
      r: 5 + Math.random() * 7,
      color: colors[Math.floor(Math.random() * colors.length)],
      rot: Math.random() * 360,
      vx: (Math.random() - .5) * 2.8,
      vy: 2.2 + Math.random() * 3.5,
      vrot: (Math.random() - .5) * 6,
      shape: Math.random() < .4 ? 'circle' : 'rect',
      opacity: 1
    });
  }
  var frame = 0;
  function draw() {
    ctx.clearRect(0, 0, W, H);
    frame++;
    var allDone = true;
    particles.forEach(function(p) {
      if (p.y < H + 20) allDone = false;
      p.x += p.vx; p.y += p.vy; p.rot += p.vrot; p.vy += .04;
      if (p.y > H * .6) p.opacity = Math.max(0, p.opacity - .012);
      ctx.save();
      ctx.globalAlpha = p.opacity;
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI / 180);
      ctx.fillStyle = p.color;
      if (p.shape === 'circle') {
        ctx.beginPath(); ctx.arc(0, 0, p.r, 0, Math.PI * 2); ctx.fill();
      } else {
        ctx.fillRect(-p.r, -p.r / 2, p.r * 2, p.r);
      }
      ctx.restore();
    });
    if (!allDone && frame < 320) requestAnimationFrame(draw);
    else ctx.clearRect(0, 0, W, H);
  }
  setTimeout(draw, 400);
}());
</script>

