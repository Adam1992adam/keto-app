<script is:inline>
(function () {

  /* ── Read name/email from URL params then localStorage ── */
  var params   = new URLSearchParams(window.location.search);
  var name     = params.get('name') || (function(){ try { return localStorage.getItem('kj_firstName'); } catch(e){ return null; } })() || 'friend';
  var email    = params.get('email') || (function(){ try { return localStorage.getItem('kj_email'); } catch(e){ return null; } })() || '';

  var cfName = document.getElementById('cfName');
  if (cfName) cfName.textContent = name;
  var cfEmail = document.getElementById('cfEmail');
  if (cfEmail) cfEmail.textContent = email || 'your inbox';
  var envName = document.getElementById('envelopeName');
  if (envName) envName.textContent = name;
  var envEmail = document.getElementById('envelopeEmail');
  if (envEmail) envEmail.textContent = email;

  /* ── ETA countdown ── */
  var TOTAL = 72;
  var seconds = TOTAL;
  var etaText = document.getElementById('etaText');
  var etaBar  = document.getElementById('etaBar');

  function updateEta() {
    if (!etaText) return;
    if (seconds > 0) {
      etaText.innerHTML = '~ ' + seconds + ' seconds <b>EN ROUTE</b>';
    } else {
      etaText.innerHTML = 'Should be there! <b>DELIVERED</b>';
    }
    if (etaBar) {
      etaBar.style.width = ((TOTAL - seconds) / TOTAL * 100) + '%';
    }
  }

  updateEta();
  var etaTimer = setInterval(function () {
    seconds = Math.max(0, seconds - 1);
    updateEta();
    if (seconds === 0) clearInterval(etaTimer);
  }, 1000);

  /* ── Confetti ── */
  var canvas = document.getElementById('confettiCanvas');
  if (canvas) {
    var ctx = canvas.getContext('2d');
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
    var W = canvas.width, H = canvas.height;
    var colors = ['#FF5C7A','#B6FF3C','#FF914D','#60a5fa','#f97316','#a78bfa'];
    var particles = [];
    for (var i = 0; i < 140; i++) {
      particles.push({
        x: Math.random() * W, y: -20 - Math.random() * 180,
        r: 5 + Math.random() * 7,
        color: colors[Math.floor(Math.random() * colors.length)],
        rot: Math.random() * 360, vx: (Math.random() - .5) * 2.8,
        vy: 2.2 + Math.random() * 3.5, vrot: (Math.random() - .5) * 6,
        shape: Math.random() < .4 ? 'circle' : 'rect', opacity: 1
      });
    }
    var cf = 0;
    function drawConfetti() {
      ctx.clearRect(0, 0, W, H); cf++;
      var done = true;
      particles.forEach(function(p) {
        if (p.y < H + 20) done = false;
        p.x += p.vx; p.y += p.vy; p.rot += p.vrot; p.vy += .04;
        if (p.y > H * .6) p.opacity = Math.max(0, p.opacity - .012);
        ctx.save(); ctx.globalAlpha = p.opacity;
        ctx.translate(p.x, p.y); ctx.rotate(p.rot * Math.PI / 180);
        ctx.fillStyle = p.color;
        if (p.shape === 'circle') { ctx.beginPath(); ctx.arc(0,0,p.r,0,Math.PI*2); ctx.fill(); }
        else { ctx.fillRect(-p.r, -p.r/2, p.r*2, p.r); }
        ctx.restore();
      });
      if (!done && cf < 320) requestAnimationFrame(drawConfetti);
      else ctx.clearRect(0, 0, W, H);
    }
    setTimeout(drawConfetti, 400);
  }

  /* ── Carousel ── */
  var INTERVAL = 4000;
  var slides   = document.querySelectorAll('.carousel-slide');
  var dots     = document.querySelectorAll('.carousel-dot');
  var bar      = document.getElementById('progressBar');
  var shell    = document.getElementById('carouselShell');
  var current  = 0;
  var total    = slides.length;
  var timer    = null;

  function goTo(idx, dir) {
    var prev = current;
    current  = (idx + total) % total;
    if (prev === current) return;
    slides[prev].classList.remove('active');
    slides[prev].classList.add('exit-left');
    slides[current].style.transform = dir === 'prev' ? 'translateX(-40px)' : 'translateX(40px)';
    slides[current].style.opacity   = '0';
    slides[current].offsetHeight;
    slides[current].style.transform = '';
    slides[current].style.opacity   = '';
    slides[current].classList.add('active');
    var exitEl = slides[prev];
    setTimeout(function() { exitEl.classList.remove('exit-left'); }, 650);
    dots.forEach(function(d, i) { d.classList.toggle('active', i === current); });
    restartBar();
  }

  function next() { goTo(current + 1, 'next'); }
  function prev() { goTo(current - 1, 'prev'); }
  function startAuto() { clearInterval(timer); timer = setInterval(next, INTERVAL); }
  function stopAuto()  { clearInterval(timer); }

  function restartBar() {
    if (!bar) return;
    bar.style.transition = 'none';
    bar.style.width      = '0%';
    bar.offsetHeight;
    bar.style.transition = 'width ' + INTERVAL + 'ms linear';
    bar.style.width      = '100%';
  }

  restartBar();
  startAuto();

  if (shell) {
    shell.addEventListener('mouseenter', function() { stopAuto(); if (bar) { bar.style.transition = 'none'; } });
    shell.addEventListener('mouseleave', function() { restartBar(); startAuto(); });
  }

  var nextBtn = document.getElementById('nextBtn');
  var prevBtn = document.getElementById('prevBtn');
  if (nextBtn) nextBtn.addEventListener('click', function() { stopAuto(); next(); startAuto(); });
  if (prevBtn) prevBtn.addEventListener('click', function() { stopAuto(); prev(); startAuto(); });

  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(dot.getAttribute('data-dot'), 10);
      stopAuto(); goTo(idx, idx > current ? 'next' : 'prev'); startAuto();
    });
  });

  var touchX = 0;
  if (shell) {
    shell.addEventListener('touchstart', function(e) { touchX = e.touches[0].clientX; }, { passive: true });
    shell.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) < 40) return;
      stopAuto();
      if (dx < 0) next(); else prev();
      startAuto();
    });
  }

}());
</script>

