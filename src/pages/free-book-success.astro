---
export const prerender = true;
const PAGE_TITLE = 'Your book is on the way — Keto Journey';
const PAGE_DESC  = 'Check your inbox — your free keto recipe book is being delivered right now.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC}/>
  <meta name="robots" content="noindex"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-72.png"/>
  <meta name="theme-color" content="#FF5C7A"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg: #FAF6F1; --bg-alt: #F2EDE5; --ink: #16110F; --ink-soft: #4A4340;
      --muted: #8A8077; --line: #E5DED2;
      --accent: #FF5C7A; --accent-2: #B6FF3C; --accent-3: #FF914D; --card: #FFFFFF;
      --green: #22c55e;
      --display: 'Bricolage Grotesque', system-ui, sans-serif;
      --serif: 'Instrument Serif', serif;
      --body: 'Geist', system-ui, sans-serif;
      --mono: 'Geist Mono', monospace;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    html, body { background: var(--bg); color: var(--ink); font-family: var(--body); -webkit-font-smoothing: antialiased; }
    body { overflow-x: hidden; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
    img { display: block; max-width: 100%; }
    ::selection { background: var(--accent); color: #fff; }
    input { font-family: inherit; }

    /* ============================================================
       CONFETTI CANVAS
       ============================================================ */
    #confettiCanvas { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 200; }

    /* ============================================================
       CONFIRM — dark hero
       ============================================================ */
    .cf {
      position: relative;
      background: var(--ink);
      color: var(--bg);
      overflow: hidden;
      min-height: 100vh;
      padding: 28px 32px 72px;
    }
    .cf::before {
      content: ''; position: absolute;
      width: 820px; height: 820px; border-radius: 50%;
      background: radial-gradient(circle, color-mix(in oklab, var(--accent) 45%, transparent), transparent 65%);
      filter: blur(90px);
      top: -380px; right: -240px; pointer-events: none;
    }
    .cf::after {
      content: ''; position: absolute;
      width: 640px; height: 640px; border-radius: 50%;
      background: radial-gradient(circle, color-mix(in oklab, var(--accent-2) 26%, transparent), transparent 65%);
      filter: blur(80px);
      bottom: -340px; left: -200px; pointer-events: none;
    }

    .cf-nav {
      position: relative; z-index: 5;
      max-width: 1360px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      padding-bottom: 24px;
    }
    .cf-logo { display: flex; align-items: center; gap: 10px; }
    .cf-logo .mark { width: 32px; height: 32px; border-radius: 9px; background: var(--bg); color: var(--ink); display: grid; place-items: center; font-weight: 800; font-size: 14px; }
    .cf-logo .name { font-family: var(--display); font-weight: 700; font-size: 15px; letter-spacing: -0.01em; color: var(--bg); }
    .cf-nav-r { display: flex; gap: 18px; align-items: center; font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: color-mix(in oklab, var(--bg) 65%, transparent); }
    .cf-nav-r a:hover { color: var(--bg); }
    .cf-nav-r .login { background: var(--accent-2); color: var(--ink); padding: 9px 14px; border-radius: 999px; font-weight: 700; }

    .cf-inner {
      position: relative; z-index: 2;
      max-width: 1360px; margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      gap: 64px; align-items: center;
      padding-top: 32px;
    }

    .cf-status {
      display: inline-flex; align-items: center; gap: 12px;
      font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--accent-2); margin-bottom: 24px;
      padding: 9px 14px;
      background: color-mix(in oklab, var(--accent-2) 12%, transparent);
      border: 1px solid color-mix(in oklab, var(--accent-2) 28%, transparent);
      border-radius: 999px;
    }
    .cf-status .pulse { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--accent-2); }
    .cf-status .pulse::after {
      content: ''; position: absolute; inset: -4px;
      border-radius: 50%; background: var(--accent-2); opacity: 0.4;
      animation: cfpulse 1.6s ease-out infinite;
    }
    @keyframes cfpulse {
      0% { transform: scale(0.6); opacity: 0.6; }
      100% { transform: scale(2.4); opacity: 0; }
    }

    .cf-h {
      font-family: var(--display);
      font-size: clamp(54px, 7vw, 108px);
      line-height: 1; letter-spacing: -0.05em; font-weight: 600;
      max-width: 16ch; text-wrap: balance; margin-bottom: 28px;
    }
    .cf-h em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
    .cf-h .stamp {
      display: inline-block; background: var(--accent-2); color: var(--ink);
      font-family: var(--display); font-weight: 700;
      padding: 0 0.1em 0.05em; transform: rotate(-2deg); line-height: 0.9;
    }

    .cf-sub {
      font-family: var(--serif); font-style: italic;
      font-size: clamp(18px, 1.5vw, 22px);
      color: color-mix(in oklab, var(--bg) 78%, transparent);
      max-width: 52ch; line-height: 1.5; margin-bottom: 32px; text-wrap: pretty;
    }
    .cf-sub b { font-family: var(--body); font-style: normal; font-weight: 600; color: var(--bg); }
    .cf-sub mark { background: transparent; color: var(--accent-2); font-family: var(--mono); font-style: normal; font-size: 0.85em; letter-spacing: 0.08em; font-weight: 600; }

    .cf-eta {
      background: color-mix(in oklab, var(--bg) 6%, transparent);
      border: 1px solid color-mix(in oklab, var(--bg) 14%, transparent);
      border-radius: 22px; padding: 22px 24px; margin-bottom: 28px;
      max-width: 580px;
      display: grid; grid-template-columns: auto 1fr auto; gap: 22px; align-items: center;
    }
    .cf-eta-icon {
      width: 60px; height: 60px; border-radius: 16px;
      background: var(--accent); color: #fff;
      display: grid; place-items: center; font-size: 24px; font-weight: 700; position: relative;
    }
    .cf-eta-icon::before {
      content: ''; position: absolute; inset: -4px; border-radius: 20px;
      border: 1px dashed color-mix(in oklab, var(--accent) 55%, transparent);
      animation: cfrotate 14s linear infinite;
    }
    @keyframes cfrotate { 100% { transform: rotate(360deg); } }
    .cf-eta-l { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: color-mix(in oklab, var(--bg) 60%, transparent); margin-bottom: 4px; }
    .cf-eta-v { font-family: var(--display); font-size: 22px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.15; }
    .cf-eta-v b { color: var(--accent-2); font-family: var(--mono); font-size: 14px; letter-spacing: 0.06em; margin-left: 6px; padding: 2px 8px; border-radius: 4px; background: color-mix(in oklab, var(--accent-2) 14%, transparent); }
    .cf-eta-progress { margin-top: 10px; height: 4px; background: color-mix(in oklab, var(--bg) 12%, transparent); border-radius: 999px; overflow: hidden; }
    .cf-eta-progress-bar { height: 100%; background: linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 100%); border-radius: 999px; width: 0%; transition: width 1s linear; }
    .cf-eta-cta { background: var(--bg); color: var(--ink); padding: 11px 16px; border-radius: 999px; font-size: 13px; font-weight: 600; white-space: nowrap; }
    .cf-eta-cta:hover { background: var(--accent-2); }

    .cf-steps {
      display: grid; grid-template-columns: repeat(3, 1fr);
      border-radius: 20px; overflow: hidden;
      border: 1px solid color-mix(in oklab, var(--bg) 12%, transparent);
      background: color-mix(in oklab, var(--bg) 5%, transparent);
    }
    .cf-step { padding: 22px; border-right: 1px solid color-mix(in oklab, var(--bg) 12%, transparent); display: flex; flex-direction: column; gap: 10px; }
    .cf-step:last-child { border-right: none; }
    .cf-step .n { font-family: var(--display); font-size: 36px; font-weight: 700; line-height: 0.85; letter-spacing: -0.04em; color: var(--accent-2); }
    .cf-step .n::before { content: 'STEP '; font-family: var(--mono); font-style: normal; font-weight: 600; font-size: 9px; letter-spacing: 0.2em; color: color-mix(in oklab, var(--bg) 50%, transparent); display: block; margin-bottom: 6px; }
    .cf-step .t { font-family: var(--display); font-size: 16px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
    .cf-step .b { font-family: var(--serif); font-style: italic; font-size: 13.5px; color: color-mix(in oklab, var(--bg) 72%, transparent); line-height: 1.45; }
    .cf-step .b b { font-family: var(--body); font-style: normal; font-weight: 600; color: var(--bg); }

    .cf-stage { position: relative; display: grid; place-items: center; min-height: 560px; }
    .cf-envelope {
      position: absolute; left: 50%; top: 50%;
      transform: translate(-50%, -42%) rotate(-4deg);
      width: 340px; height: 220px;
      background: linear-gradient(155deg, #F2E8D8 0%, #E6DAC4 100%);
      border-radius: 4px;
      box-shadow: 0 30px 60px -20px rgba(0,0,0,0.5); z-index: 1;
    }
    .cf-envelope::before {
      content: ''; position: absolute; left: 0; right: 0; top: 0;
      height: 60%;
      background: linear-gradient(180deg, #FBF5E6 0%, #F2E8D8 100%);
      clip-path: polygon(0 0, 100% 0, 50% 100%);
    }
    .cf-envelope .seal {
      position: absolute; left: 50%; top: 56%; transform: translate(-50%, -50%);
      width: 50px; height: 50px; border-radius: 50%;
      background: var(--accent); color: #fff;
      font-family: var(--display); font-size: 14px; font-weight: 700;
      display: grid; place-items: center; z-index: 3;
      box-shadow: 0 4px 12px -2px rgba(0,0,0,0.3);
    }
    .cf-envelope .stamp-rect {
      position: absolute; top: 14px; right: 14px;
      width: 60px; height: 40px;
      background: var(--accent-2);
      border: 2px dashed color-mix(in oklab, var(--ink) 60%, transparent);
      font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: 0.14em; color: var(--ink);
      display: grid; place-items: center; text-align: center; line-height: 1.2; padding: 2px;
    }
    .cf-envelope .addr {
      position: absolute; left: 24px; bottom: 22px;
      font-family: var(--mono); font-size: 10px; letter-spacing: 0.16em; color: var(--ink-soft); line-height: 1.6;
    }
    .cf-envelope .addr b { font-family: var(--display); font-size: 13px; letter-spacing: -0.01em; color: var(--ink); display: block; text-transform: none; font-weight: 600; }

    .cf-book-peek {
      position: absolute; left: 50%; top: 30%;
      transform: translate(-44%, -50%) rotate(-12deg);
      z-index: 4;
      animation: cfbookin 1.2s cubic-bezier(.25,1.4,.5,1) both;
    }
    @keyframes cfbookin {
      0% { transform: translate(-44%, 30%) rotate(-22deg); opacity: 0; }
      100% { transform: translate(-44%, -50%) rotate(-12deg); opacity: 1; }
    }
    .cf-book-img {
      width: 220px; height: auto;
      border-radius: 3px 10px 10px 3px;
      filter: drop-shadow(0 24px 40px rgba(0,0,0,.5));
      transform: perspective(800px) rotateY(-8deg) rotateX(3deg);
      display: block;
    }

    .cf-receipt {
      position: absolute; bottom: 4%; right: 0;
      background: var(--bg); color: var(--ink);
      border-radius: 14px; padding: 16px 18px;
      width: 230px;
      font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em; line-height: 1.6;
      z-index: 5; transform: rotate(3deg);
      box-shadow: 0 16px 36px -12px rgba(0,0,0,0.5);
    }
    .cf-receipt::before {
      content: ''; position: absolute; left: 0; right: 0; top: -8px; height: 8px;
      background: var(--bg);
      clip-path: polygon(0 100%, 4px 0, 8px 100%, 12px 0, 16px 100%, 20px 0, 24px 100%, 28px 0, 32px 100%, 36px 0, 40px 100%, 44px 0, 48px 100%, 52px 0, 56px 100%, 60px 0, 64px 100%, 68px 0, 72px 100%, 76px 0, 80px 100%, 84px 0, 88px 100%, 92px 0, 96px 100%, 100px 0, 100% 100%);
    }
    .cf-receipt::after {
      content: ''; position: absolute; left: 0; right: 0; bottom: -8px; height: 8px;
      background: var(--bg);
      clip-path: polygon(0 0, 4px 100%, 8px 0, 12px 100%, 16px 0, 20px 100%, 24px 0, 28px 100%, 32px 0, 36px 100%, 40px 0, 44px 100%, 48px 0, 52px 100%, 56px 0, 60px 100%, 64px 0, 68px 100%, 72px 0, 76px 100%, 80px 0, 84px 100%, 88px 0, 92px 100%, 96px 0, 100% 0, 100% 0);
    }
    .cf-receipt .tt { font-family: var(--display); font-size: 13px; font-weight: 700; letter-spacing: -0.015em; color: var(--ink); text-transform: none; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px dashed var(--line); }
    .cf-receipt .row { display: flex; justify-content: space-between; color: var(--muted); text-transform: uppercase; }
    .cf-receipt .row b { color: var(--ink); font-weight: 600; }
    .cf-receipt .row.total { margin-top: 8px; padding-top: 8px; border-top: 1px dashed var(--line); font-family: var(--display); text-transform: none; font-size: 13px; letter-spacing: -0.01em; color: var(--ink); font-weight: 600; }
    .cf-receipt .row.total b { color: var(--accent); }

    .cf-confetti { position: absolute; font-size: 18px; color: var(--accent-2); z-index: 3; animation: cff 6s ease-in-out infinite; }
    .cf-confetti.c1 { top: 14%; left: 10%; }
    .cf-confetti.c2 { top: 20%; right: 14%; color: var(--accent); }
    .cf-confetti.c3 { bottom: 26%; left: 8%; color: var(--accent-3); }
    .cf-confetti.c4 { top: 50%; right: 8%; }
    @keyframes cff { 0%, 100% { transform: translateY(0) rotate(0deg); } 50% { transform: translateY(-12px) rotate(20deg); } }

    @media (max-width: 1100px) {
      .cf { padding: 22px 18px 60px; }
      .cf-inner { grid-template-columns: 1fr; gap: 36px; }
      .cf-stage { min-height: 380px; }
      .cf-steps { grid-template-columns: 1fr; }
      .cf-step { border-right: none; border-bottom: 1px solid color-mix(in oklab, var(--bg) 12%, transparent); }
      .cf-step:last-child { border-bottom: none; }
      .cf-eta { grid-template-columns: 1fr; gap: 14px; }
      .cf-receipt { display: none; }
    }

    /* ============================================================
       SNEAK — "while you wait" recipe
       ============================================================ */
    .sn { max-width: 1360px; margin: 0 auto; padding: 96px 32px 32px; }
    .sn-head { display: flex; align-items: end; gap: 32px; margin-bottom: 36px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
    .sn-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; display: inline-flex; align-items: center; gap: 10px; }
    .sn-eyebrow .pip { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 22%, transparent); }
    .sn-head h2 { font-family: var(--display); font-size: clamp(38px, 4.8vw, 68px); line-height: 0.94; letter-spacing: -0.045em; font-weight: 600; max-width: 18ch; text-wrap: balance; }
    .sn-head h2 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
    .sn-head .meta { margin-left: auto; font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--ink-soft); max-width: 32ch; text-align: right; line-height: 1.5; }
    .sn-head .meta b { font-family: var(--body); font-style: normal; font-weight: 600; color: var(--ink); }

    .sn-card { background: var(--card); border: 1px solid var(--line); border-radius: 28px; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1fr) 360px; position: relative; }
    .sn-body { padding: 36px; display: flex; flex-direction: column; gap: 22px; min-width: 0; }
    .sn-rcat { font-family: var(--mono); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); }
    .sn-rname { font-family: var(--display); font-size: clamp(34px, 4vw, 54px); font-weight: 600; letter-spacing: -0.04em; line-height: 0.95; text-wrap: balance; max-width: 18ch; }
    .sn-rname em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
    .sn-rsub { font-family: var(--serif); font-style: italic; font-size: 17px; color: var(--ink-soft); line-height: 1.45; max-width: 50ch; }

    .sn-stats { display: grid; grid-template-columns: repeat(4, 1fr); padding: 14px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .sn-stat { padding: 0 14px; border-right: 1px solid var(--line); }
    .sn-stat:first-child { padding-left: 0; }
    .sn-stat:last-child { border-right: none; padding-right: 0; }
    .sn-stat .v { font-family: var(--display); font-size: 24px; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
    .sn-stat .v em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); font-size: 13px; margin-left: 2px; }
    .sn-stat .l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-top: 6px; }

    .sn-two { display: grid; grid-template-columns: 1fr 1.2fr; gap: 32px; margin-top: 4px; }
    .sn-col-h { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 12px; }
    .sn-ingr { list-style: none; padding: 0; margin: 0; }
    .sn-ingr li { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 14.5px; align-items: baseline; }
    .sn-ingr li:last-child { border-bottom: none; }
    .sn-ingr li .q { font-family: var(--mono); color: var(--accent); font-weight: 600; font-size: 13px; letter-spacing: 0.02em; }

    .sn-step { display: grid; grid-template-columns: 32px 1fr; gap: 14px; padding: 10px 0; border-bottom: 1px dashed var(--line); }
    .sn-step:last-of-type { border-bottom: none; }
    .sn-step .n { font-family: var(--display); font-size: 18px; font-weight: 600; letter-spacing: -0.03em; color: var(--accent); line-height: 1; padding-top: 2px; }
    .sn-step .b { font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); }
    .sn-step .b b { color: var(--ink); font-weight: 600; }

    .sn-tip { background: color-mix(in oklab, var(--accent-2) 22%, var(--bg)); border-left: 3px solid var(--accent-2); border-radius: 12px; padding: 16px 18px; font-family: var(--serif); font-style: italic; font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); text-wrap: pretty; margin-top: 8px; }
    .sn-tip b { font-family: var(--body); font-style: normal; font-weight: 600; color: var(--ink); text-transform: uppercase; letter-spacing: 0.18em; font-size: 10px; display: block; margin-bottom: 6px; }

    .sn-art { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: end; min-height: 480px; }
    .sn-art-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center center; z-index: 0; }
    .sn-art-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(22,17,15,.92) 0%, rgba(22,17,15,.55) 28%, rgba(22,17,15,.0) 55%); z-index: 1; }
    .sn-art-stamp { position: absolute; top: 24px; left: 24px; font-family: var(--mono); font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; background: var(--ink); color: var(--accent-2); padding: 6px 10px; border-radius: 4px; z-index: 2; }
    .sn-art-page { position: absolute; top: 24px; right: 24px; font-family: var(--mono); font-size: 9px; letter-spacing: 0.18em; color: rgba(255,255,255,0.7); z-index: 2; }

    .sn-art-foot { position: relative; z-index: 2; padding: 28px; display: flex; flex-direction: column; gap: 10px; }
    .sn-art-foot .tt { font-family: var(--display); font-size: 22px; font-weight: 600; letter-spacing: -0.025em; color: #fff; line-height: 1.1; }
    .sn-art-foot .tt em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent-2); }
    .sn-art-foot .sub { font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: color-mix(in oklab, var(--bg) 80%, transparent); }

    @media (max-width: 1100px) {
      .sn { padding: 60px 18px 32px; }
      .sn-head { flex-direction: column; align-items: start; gap: 16px; }
      .sn-head .meta { margin-left: 0; text-align: left; }
      .sn-card { grid-template-columns: 1fr; }
      .sn-two { grid-template-columns: 1fr; gap: 24px; }
      .sn-body { padding: 28px 22px; }
    }

    /* ============================================================
       CAROUSEL
       ============================================================ */
    .carousel-section { max-width: 1360px; margin: 0 auto; padding: 64px 32px 32px; }
    .carousel-section-head { text-align: center; margin-bottom: 36px; }
    .carousel-section-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px; display: inline-flex; align-items: center; gap: 10px; }
