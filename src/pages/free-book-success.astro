<script is:inline>
(function () {

  /* ── Confetti ── */
  var canvas = document.getElementById('confettiCanvas');
  var ctx    = canvas.getContext('2d');
  canvas.width  = window.innerWidth;
  canvas.height = window.innerHeight;
  var W = canvas.width, H = canvas.height;
  var colors = ['#FF5C7A','#B6FF3C','#FFD700','#60a5fa','#f97316','#a78bfa'];
  var particles = [];
  for (var i = 0; i < 150; i++) {
    particles.push({
      x: Math.random() * W, y: -20 - Math.random() * 180,
      r: 5 + Math.random() * 7,
      color: colors[Math.floor(Math.random() * colors.length)],
      rot: Math.random() * 360, vx: (Math.random() - .5) * 2.8,
      vy: 2.2 + Math.random() * 3.5, vrot: (Math.random() - .5) * 6,
      shape: Math.random() < .4 ? 'circle' : 'rect', opacity: 1
    });
  }
  var cf = 0;
  function drawConfetti() {
    ctx.clearRect(0, 0, W, H); cf++;
    var done = true;
    particles.forEach(function(p) {
      if (p.y < H + 20) done = false;
      p.x += p.vx; p.y += p.vy; p.rot += p.vrot; p.vy += .04;
      if (p.y > H * .6) p.opacity = Math.max(0, p.opacity - .012);
      ctx.save(); ctx.globalAlpha = p.opacity;
      ctx.translate(p.x, p.y); ctx.rotate(p.rot * Math.PI / 180);
      ctx.fillStyle = p.color;
      if (p.shape === 'circle') { ctx.beginPath(); ctx.arc(0,0,p.r,0,Math.PI*2); ctx.fill(); }
      else { ctx.fillRect(-p.r, -p.r/2, p.r*2, p.r); }
      ctx.restore();
    });
    if (!done && cf < 320) requestAnimationFrame(drawConfetti);
    else ctx.clearRect(0, 0, W, H);
  }
  setTimeout(drawConfetti, 400);

  /* ── Carousel ── */
  var INTERVAL = 4000;
  var slides   = document.querySelectorAll('.carousel-slide');
  var dots     = document.querySelectorAll('.carousel-dot');
  var bar      = document.getElementById('progressBar');
  var shell    = document.getElementById('carouselShell');
  var current  = 0;
  var total    = slides.length;
  var timer    = null;
  var barTimer = null;

  function goTo(idx, dir) {
    var prev = current;
    current  = (idx + total) % total;
    if (prev === current) return;

    /* Animate exit */
    slides[prev].classList.remove('active');
    slides[prev].classList.add('exit-left');

    /* Animate enter — reset position first, then set active */
    slides[current].style.transform = dir === 'prev' ? 'translateX(-40px)' : 'translateX(40px)';
    slides[current].style.opacity   = '0';
    slides[current].offsetHeight;   /* force reflow */
    slides[current].style.transform = '';
    slides[current].style.opacity   = '';
    slides[current].classList.add('active');

    /* Clean up exit class after transition */
    var exitEl = slides[prev];
    setTimeout(function() { exitEl.classList.remove('exit-left'); }, 650);

    /* Update dots */
    dots.forEach(function(d, i) { d.classList.toggle('active', i === current); });

    /* Restart progress bar */
    restartBar();
  }

  function next() { goTo(current + 1, 'next'); }
  function prev() { goTo(current - 1, 'prev'); }

  function startAuto() {
    clearInterval(timer);
    timer = setInterval(next, INTERVAL);
  }
  function stopAuto() {
    clearInterval(timer);
    clearTimeout(barTimer);
  }

  function restartBar() {
    if (!bar) return;
    bar.style.transition = 'none';
    bar.style.width      = '0%';
    bar.offsetHeight;
    bar.style.transition = 'width ' + INTERVAL + 'ms linear';
    bar.style.width      = '100%';
  }

  /* Init */
  restartBar();
  startAuto();

  /* Pause on hover */
  if (shell) {
    shell.addEventListener('mouseenter', function() { stopAuto(); bar.style.transition = 'none'; });
    shell.addEventListener('mouseleave', function() { restartBar(); startAuto(); });
  }

  /* Buttons */
  document.getElementById('nextBtn').addEventListener('click', function() { stopAuto(); next(); startAuto(); });
  document.getElementById('prevBtn').addEventListener('click', function() { stopAuto(); prev(); startAuto(); });

  /* Dot nav */
  dots.forEach(function(dot) {
    dot.addEventListener('click', function() {
      var idx = parseInt(dot.getAttribute('data-dot'), 10);
      stopAuto(); goTo(idx, idx > current ? 'next' : 'prev'); startAuto();
    });
  });

  /* Touch swipe */
  var touchX = 0;
  if (shell) {
    shell.addEventListener('touchstart', function(e) { touchX = e.touches[0].clientX; }, { passive:true });
    shell.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) < 40) return;
      stopAuto();
      if (dx < 0) next(); else prev();
      startAuto();
    });
  }

}());
</script>

