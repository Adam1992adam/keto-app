---
export const prerender = true;
const PAGE_TITLE = 'Your Free Keto Book Is On Its Way! | KetoJourney';
const PAGE_DESC  = 'Check your inbox — your free keto recipe book is being delivered right now.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC}/>
  <meta name="robots" content="noindex"/>
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-72.png"/>
  <meta name="theme-color" content="#FF5C7A"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    html { scroll-behavior:smooth; }
    a { color:inherit; text-decoration:none; }
    img { display:block; max-width:100%; }
    :root {
      --bg:#FAF6F1; --bg-alt:#F2EDE5; --ink:#16110F; --ink-soft:#4A4340;
      --muted:#8A8077; --line:#E5DED2; --accent:#FF5C7A; --accent-2:#B6FF3C;
      --card:#FFFFFF; --green:#22c55e;
      --display:'Bricolage Grotesque',system-ui,sans-serif;
      --serif:'Instrument Serif',serif;
      --body:'Geist',system-ui,sans-serif;
    }
    body { font-family:var(--body); background:var(--bg); color:var(--ink); overflow-x:hidden; min-height:100vh; }

    /* ── NAV ── */
    .nav { position:sticky; top:0; z-index:100; background:rgba(250,246,241,.94); backdrop-filter:blur(14px); border-bottom:1px solid var(--line); padding:16px 32px; display:flex; align-items:center; justify-content:space-between; }
    .nav-logo { display:flex; align-items:center; gap:10px; }
    .nav-logo-mark { width:34px; height:34px; background:var(--ink); border-radius:8px; display:flex; align-items:center; justify-content:center; font-family:var(--display); font-weight:800; font-size:.9rem; color:var(--accent-2); }
    .nav-logo-text { font-family:var(--display); font-weight:800; font-size:1rem; }
    .nav-cta { background:var(--accent); color:#fff; padding:8px 18px; border-radius:999px; font-size:.85rem; font-weight:700; font-family:var(--display); transition:opacity .15s; }
    .nav-cta:hover { opacity:.88; }
    @media(max-width:640px){ .nav{ padding:14px 18px; } }

    /* ── CONFETTI ── */
    #confettiCanvas { position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:200; }

    /* ── SUCCESS HERO ── */
    .success-hero { max-width:680px; margin:0 auto; padding:72px 32px 56px; text-align:center; }
    .check-ring { width:88px; height:88px; margin:0 auto 28px; }
    .check-ring svg { width:88px; height:88px; }
    .check-circle { fill:none; stroke:var(--green); stroke-width:3; stroke-dasharray:251; stroke-dashoffset:251; animation:drawCircle .7s ease forwards .2s; }
    .check-mark   { fill:none; stroke:var(--green); stroke-width:3.5; stroke-linecap:round; stroke-linejoin:round; stroke-dasharray:48; stroke-dashoffset:48; animation:drawCheck .4s ease forwards .9s; }
    @keyframes drawCircle { to { stroke-dashoffset:0; } }
    @keyframes drawCheck  { to { stroke-dashoffset:0; } }
    .success-eyebrow { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--green); margin-bottom:14px; }
    .success-title { font-family:var(--display); font-size:clamp(2rem,5vw,3rem); font-weight:800; color:var(--ink); line-height:1.1; margin-bottom:16px; }
    .success-title em { font-family:var(--serif); font-style:italic; color:var(--accent); }
    .success-sub { font-size:1rem; color:var(--ink-soft); line-height:1.75; max-width:500px; margin:0 auto; }

    /* ── SPAM GUIDE CARD ── */
    .spam-card { max-width:640px; margin:0 auto 64px; background:var(--card); border:1px solid var(--line); border-radius:22px; padding:32px 36px; box-shadow:0 4px 28px rgba(22,17,15,.07); }
    @media(max-width:600px){ .spam-card{ padding:24px 20px; margin:0 16px 48px; } }
    .spam-card-title { font-family:var(--display); font-size:1.05rem; font-weight:800; color:var(--ink); margin-bottom:22px; display:flex; align-items:center; gap:10px; }
    .spam-steps { display:flex; flex-direction:column; gap:16px; }
    .spam-step { display:flex; align-items:flex-start; gap:14px; }
    .spam-step-num { width:32px; height:32px; min-width:32px; border-radius:50%; background:rgba(255,92,122,.1); border:1.5px solid rgba(255,92,122,.25); display:flex; align-items:center; justify-content:center; font-family:var(--display); font-size:.82rem; font-weight:800; color:var(--accent); }
    .spam-step-body { padding-top:4px; }
    .spam-step-label { font-family:var(--display); font-size:.92rem; font-weight:700; color:var(--ink); margin-bottom:3px; }
    .spam-step-desc { font-size:.83rem; color:var(--muted); line-height:1.65; }
    .spam-step-desc strong { color:var(--ink-soft); }
    .spam-tabs-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
    .spam-tab-badge { display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:999px; font-size:.76rem; font-weight:600; }
    .spam-tab-badge.spam    { background:rgba(239,68,68,.08);  border:1px solid rgba(239,68,68,.2);  color:#dc2626; }
    .spam-tab-badge.promo   { background:rgba(59,130,246,.08); border:1px solid rgba(59,130,246,.22); color:#2563eb; }
    .spam-tab-badge.updates { background:rgba(168,85,247,.08); border:1px solid rgba(168,85,247,.22); color:#7c3aed; }
    .spam-tip { margin-top:20px; padding:12px 16px; background:rgba(182,255,60,.1); border:1px solid rgba(182,255,60,.3); border-radius:12px; font-size:.82rem; color:var(--ink-soft); line-height:1.65; }
    .spam-tip strong { color:var(--ink); }

    /* ── DIVIDER ── */
    .divider { max-width:1000px; margin:0 auto 64px; display:flex; align-items:center; gap:16px; padding:0 32px; }
    @media(max-width:600px){ .divider{ padding:0 16px; } }
    .divider-line { flex:1; height:1px; background:var(--line); }
    .divider-text { font-size:.76rem; font-weight:700; text-transform:uppercase; letter-spacing:.12em; color:var(--muted); white-space:nowrap; }

    /* ── PLAN SECTION ── */
    .plan-section { max-width:1080px; margin:0 auto; padding:0 32px 80px; }
    @media(max-width:600px){ .plan-section{ padding:0 16px 60px; } }
    .plan-eyebrow { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--accent); margin-bottom:12px; text-align:center; }
    .plan-title { font-family:var(--display); font-size:clamp(1.8rem,4vw,2.8rem); font-weight:800; color:var(--ink); text-align:center; line-height:1.15; margin-bottom:14px; }
    .plan-title em { font-family:var(--serif); font-style:italic; color:var(--accent); }
    .plan-sub { font-size:.97rem; color:var(--ink-soft); line-height:1.75; text-align:center; max-width:560px; margin:0 auto 52px; }

    /* ─────────────────────────────────────────
       STORIES CAROUSEL
    ───────────────────────────────────────── */
    .carousel-wrap { position:relative; margin-bottom:56px; }

    /* Outer card shell */
    .carousel-shell {
      border-radius:28px;
      overflow:hidden;
      box-shadow:0 16px 64px rgba(22,17,15,.13);
      background:var(--card);
      border:1px solid var(--line);
      position:relative;
    }

    /* Slides container — all slides stacked, only active visible */
    .carousel-slides { position:relative; width:100%; }

    .carousel-slide {
      display:grid;
      grid-template-columns:420px 1fr;
      min-height:520px;
      position:absolute;
      inset:0;
      opacity:0;
      transform:translateX(40px);
      transition:opacity .6s ease, transform .6s ease;
      pointer-events:none;
      z-index:0;
    }
    /* First slide sets the natural height */
    .carousel-slide:first-child { position:relative; }
    .carousel-slide.active {
      opacity:1;
      transform:translateX(0);
      pointer-events:auto;
      z-index:1;
    }
    .carousel-slide.exit-left {
      opacity:0;
      transform:translateX(-40px);
      z-index:0;
    }
    @media(max-width:860px){ .carousel-slide{ grid-template-columns:320px 1fr; } }
    @media(max-width:680px){
      .carousel-slide{ grid-template-columns:1fr; min-height:auto; }
      .carousel-slide:first-child { position:relative; }
    }

    /* ── Image column ── */
    .slide-img-col {
      position:relative;
      overflow:hidden;
      background:var(--bg-alt);
      /* IMAGE SLOT: portrait photo 560×700 px minimum (displayed up to ~420 px wide, full card height) */
    }
    .slide-img {
      width:100%;
      height:100%;
      object-fit:cover;
      object-position:top center;
      display:block;
      transition:transform 8s ease;
    }
    .carousel-slide.active .slide-img { transform:scale(1.04); }
    /* Gradient right-edge fade into story content */
    .slide-img-col::after {
      content:'';
      position:absolute;
      inset:0;
      background:linear-gradient(to right, transparent 55%, var(--card) 100%),
                 linear-gradient(to top, rgba(22,17,15,.55) 0%, transparent 40%);
      pointer-events:none;
    }
    /* Placeholder when image missing */
    .slide-img-ph {
      position:absolute; inset:0; display:none;
      flex-direction:column; align-items:center; justify-content:center; gap:12px;
      background:linear-gradient(145deg,#EEE8E0,#DDD5C8);
    }
    .slide-img-ph-icon  { font-size:3.5rem; }
    .slide-img-ph-label { font-size:.76rem; font-weight:600; color:var(--muted); text-align:center; padding:0 16px; line-height:1.5; }
    /* Result badge bottom-left of image */
    .slide-result-badge {
      position:absolute; bottom:20px; left:20px; z-index:2;
      display:inline-flex; align-items:center; gap:6px;
      padding:7px 16px; background:var(--accent); border-radius:999px;
      font-family:var(--display); font-size:.86rem; font-weight:800; color:#fff;
      box-shadow:0 4px 16px rgba(255,92,122,.4);
    }
    @media(max-width:680px){
      .slide-img-col { aspect-ratio:4/3; height:auto; }
      .slide-img-col::after { background:linear-gradient(to top, rgba(22,17,15,.55) 0%, transparent 50%); }
    }

    /* ── Story column ── */
    .slide-story-col {
      padding:52px 48px 48px 44px;
      display:flex;
      flex-direction:column;
      justify-content:center;
      gap:20px;
    }
    @media(max-width:860px){ .slide-story-col{ padding:40px 32px 36px 28px; gap:16px; } }
    @media(max-width:680px){ .slide-story-col{ padding:28px 24px 32px; gap:14px; } }

    .slide-plan-badge {
      display:inline-flex; align-items:center; gap:5px;
      padding:5px 13px; background:rgba(255,92,122,.07);
      border:1px solid rgba(255,92,122,.2); border-radius:999px;
      font-size:.72rem; font-weight:700; color:var(--accent); width:fit-content;
    }
    .slide-name-row { display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
    .slide-name { font-family:var(--display); font-size:clamp(1.5rem,3vw,2rem); font-weight:800; color:var(--ink); line-height:1.1; }
    .slide-age  { font-size:.9rem; font-weight:600; color:var(--muted); }

    .slide-stars { color:var(--accent); font-size:.9rem; letter-spacing:2px; }

    .slide-quote {
      font-family:var(--serif); font-style:italic;
      font-size:clamp(1rem,1.8vw,1.2rem); color:var(--ink-soft);
      line-height:1.75; position:relative; padding-left:20px;
    }
    .slide-quote::before {
      content:'"';
      position:absolute; left:0; top:-4px;
      font-family:var(--serif); font-size:2.4rem; color:var(--accent);
      line-height:1; font-style:normal;
    }

    .slide-stats { display:flex; gap:28px; flex-wrap:wrap; }
    .slide-stat { display:flex; flex-direction:column; gap:3px; }
    .slide-stat-val { font-family:var(--display); font-size:1.5rem; font-weight:800; color:var(--green); line-height:1; }
    .slide-stat-label { font-size:.75rem; color:var(--muted); line-height:1.4; }

    .slide-divider { width:48px; height:3px; background:var(--accent); border-radius:99px; }

    /* ── Progress bar (time indicator) ── */
    .carousel-progress {
      height:3px;
      background:var(--line);
      border-radius:0 0 28px 28px;
      overflow:hidden;
    }
    .carousel-progress-bar {
      height:100%;
      background:linear-gradient(to right, var(--accent), #ff8fa3);
      width:0%;
      transition:width linear;
    }

    /* ── Controls ── */
    .carousel-controls {
      display:flex;
      align-items:center;
      justify-content:center;
      gap:16px;
      margin-top:20px;
    }
    .carousel-btn {
      width:40px; height:40px; border-radius:50%;
      border:1.5px solid var(--line);
      background:var(--card);
      display:flex; align-items:center; justify-content:center;
      cursor:pointer; transition:all .18s;
      color:var(--ink-soft);
    }
    .carousel-btn:hover { border-color:var(--accent); color:var(--accent); background:rgba(255,92,122,.05); transform:scale(1.08); }
    .carousel-btn svg { width:16px; height:16px; }

    .carousel-dots { display:flex; align-items:center; gap:8px; }
    .carousel-dot {
      width:8px; height:8px; border-radius:50%;
      background:var(--line); border:none; cursor:pointer;
      transition:all .25s; padding:0;
    }
    .carousel-dot.active {
      background:var(--accent); width:24px; border-radius:4px;
    }

    /* ── PLAN CARD (dark CTA) ── */
    .plan-card { background:var(--ink); border-radius:28px; padding:48px 44px; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center; position:relative; overflow:hidden; }
    @media(max-width:760px){ .plan-card{ grid-template-columns:1fr; gap:32px; padding:36px 28px; } }
    .plan-card::before { content:''; position:absolute; top:-60px; right:-60px; width:300px; height:300px; background:radial-gradient(circle, rgba(255,92,122,.18) 0%, transparent 70%); pointer-events:none; }
    .plan-card::after  { content:''; position:absolute; bottom:-80px; left:-40px; width:260px; height:260px; background:radial-gradient(circle, rgba(182,255,60,.12) 0%, transparent 70%); pointer-events:none; }

    .plan-left .plan-badge { display:inline-flex; align-items:center; gap:7px; background:rgba(255,92,122,.18); border:1px solid rgba(255,92,122,.3); border-radius:999px; padding:6px 14px; font-size:.72rem; font-weight:700; color:var(--accent); text-transform:uppercase; letter-spacing:.1em; margin-bottom:20px; }
    .plan-left h3 { font-family:var(--display); font-size:clamp(1.5rem,3vw,2rem); font-weight:800; color:#fff; line-height:1.2; margin-bottom:14px; }
    .plan-left p  { font-size:.9rem; color:rgba(255,255,255,.6); line-height:1.75; margin-bottom:28px; }
    .plan-price-row { display:flex; align-items:baseline; gap:8px; margin-bottom:28px; }
    .plan-price-big { font-family:var(--display); font-size:2.6rem; font-weight:800; color:#fff; }
    .plan-price-sub { font-size:.88rem; color:rgba(255,255,255,.45); }
    .plan-cta-btn { display:inline-flex; align-items:center; gap:8px; padding:16px 30px; background:var(--accent); color:#fff; font-family:var(--display); font-weight:800; font-size:1rem; border-radius:999px; transition:opacity .15s, transform .15s; }
    .plan-cta-btn:hover { opacity:.9; transform:translateY(-2px); }
    .plan-cta-note { margin-top:12px; font-size:.77rem; color:rgba(255,255,255,.38); }

    .plan-right { position:relative; z-index:1; }
    .plan-features { display:flex; flex-direction:column; gap:14px; }
    .plan-feature { display:flex; align-items:flex-start; gap:12px; }
    .plan-feature-check { width:22px; height:22px; min-width:22px; border-radius:50%; background:rgba(182,255,60,.15); border:1.5px solid rgba(182,255,60,.35); display:flex; align-items:center; justify-content:center; margin-top:1px; }
    .plan-feature-check svg { width:11px; height:11px; }
    .plan-feature-body .feat-name { font-family:var(--display); font-size:.9rem; font-weight:700; color:#fff; margin-bottom:2px; }
    .plan-feature-body .feat-desc { font-size:.8rem; color:rgba(255,255,255,.5); line-height:1.5; }

    /* ── SOCIAL PROOF ── */
    .proof-strip { max-width:700px; margin:0 auto 80px; padding:0 32px; display:flex; gap:10px; flex-wrap:wrap; justify-content:center; }
    @media(max-width:600px){ .proof-strip{ padding:0 16px; } }
    .proof-pill { display:flex; align-items:center; gap:6px; background:var(--card); border:1px solid var(--line); border-radius:999px; padding:8px 16px; font-size:.82rem; color:var(--ink-soft); }
    .proof-pill strong { color:var(--ink); font-weight:700; }

    /* ── FOOTER ── */
    .footer { border-top:1px solid var(--line); padding:24px 32px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
    .footer-copy  { font-size:.8rem; color:var(--muted); }
    .footer-links { display:flex; gap:20px; }
    .footer-links a { font-size:.8rem; color:var(--muted); transition:color .15s; }
    .footer-links a:hover { color:var(--ink); }

    /* ── ANIMATIONS ── */
    @keyframes fadeUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
    .fade-up { opacity:0; animation:fadeUp .6s ease forwards; }
    .delay-1 { animation-delay:.15s; }
    .delay-2 { animation-delay:.3s; }
    .delay-3 { animation-delay:.5s; }
    .delay-4 { animation-delay:.7s; }
    .delay-5 { animation-delay:.9s; }
  </style>
</head>
<body>

<canvas id="confettiCanvas"></canvas>

<!-- ── NAV ── -->
<nav class="nav">
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">K</div>
    <span class="nav-logo-text">KetoJourney</span>
  </a>
  <a href="/start" class="nav-cta">Start Free Trial →</a>
</nav>

<!-- ── SUCCESS HERO ── -->
<section class="success-hero">
  <div class="check-ring fade-up">
    <svg viewBox="0 0 88 88" fill="none">
      <circle class="check-circle" cx="44" cy="44" r="40"/>
      <path   class="check-mark"   d="M27 45l12 12 22-24"/>
    </svg>
  </div>
  <p class="success-eyebrow fade-up delay-1">Your copy is on its way</p>
  <h1 class="success-title fade-up delay-1">Your Free Book Is<br/><em>Heading to Your Inbox!</em></h1>
  <p class="success-sub fade-up delay-2">We just sent 80+ keto recipes straight to your email. It should arrive within the next couple of minutes.</p>
</section>

<!-- ── SPAM GUIDE CARD ── -->
<div class="spam-card fade-up delay-2">
  <div class="spam-card-title"><span>📬</span> Make sure you receive it</div>
  <div class="spam-steps">
    <div class="spam-step">
      <div class="spam-step-num">1</div>
      <div class="spam-step-body">
        <div class="spam-step-label">Open your inbox now</div>
        <div class="spam-step-desc">Look for an email from <strong>KetoJourney</strong> with the subject line <strong>"📖 Your free keto recipe book is here!"</strong></div>
      </div>
    </div>
    <div class="spam-step">
      <div class="spam-step-num">2</div>
      <div class="spam-step-body">
        <div class="spam-step-label">Check these folders if you don't see it</div>
        <div class="spam-step-desc">Email filters sometimes misroute new senders. Look in:</div>
        <div class="spam-tabs-row">
          <span class="spam-tab-badge spam">🚫 Spam</span>
          <span class="spam-tab-badge promo">🏷 Promotions</span>
          <span class="spam-tab-badge updates">🔔 Updates</span>
        </div>
      </div>
    </div>
    <div class="spam-step">
      <div class="spam-step-num">3</div>
      <div class="spam-step-body">
        <div class="spam-step-label">Move it to your Primary inbox</div>
        <div class="spam-step-desc">This one step ensures all future recipes, tips, and meal plans land where you'll see them — not buried in a tab.</div>
      </div>
    </div>
  </div>
  <div class="spam-tip">
    <strong>Gmail tip:</strong> If the email landed in <em>Promotions</em> — drag it to your <strong>Primary</strong> tab and click <strong>"Yes"</strong> when Gmail asks if you'd like to do this for future messages. If it's in <em>Spam</em>, open it → click <strong>"Not Spam"</strong>. Done!
  </div>
</div>

<!-- ── DIVIDER ── -->
<div class="divider fade-up delay-3">
  <div class="divider-line"></div>
  <div class="divider-text">While you wait, discover what's next</div>
  <div class="divider-line"></div>
</div>

<!-- ── PLAN SECTION ── -->
<section class="plan-section">
  <p class="plan-eyebrow fade-up delay-3">Take your journey further</p>
  <h2 class="plan-title fade-up delay-3">The Recipes Are Just the<br/><em>Beginning</em></h2>
  <p class="plan-sub fade-up delay-3">Thousands of people are already using KetoJourney to stay on track, build habits, and hit their goals. Your free book gets you started — the app gets you there.</p>

  <!-- ──────────────────────────────────────
       STORIES CAROUSEL
       IMAGE SLOTS (portrait, min 560×700 px):
         /public/images/story-sarah.jpg
         /public/images/story-james.jpg
         /public/images/story-maria.jpg
         /public/images/story-david.jpg
  ─────────────────────────────────────── -->
  <div class="carousel-wrap fade-up delay-4">
    <div class="carousel-shell" id="carouselShell">
      <div class="carousel-slides" id="carouselSlides">

        <!-- SLIDE 1 — Sarah -->
        <div class="carousel-slide active" data-index="0">
          <div class="slide-img-col">
            <img
              src="/images/story-sarah.jpg"
              alt="Sarah M. — Lost 22 lbs in 8 weeks"
