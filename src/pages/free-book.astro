---
export const prerender = true;
const SITE_URL  = (import.meta.env.PUBLIC_APP_URL || 'https://ketojourney.fun').replace(/\/$/, '');
const PAGE_TITLE = 'Free Keto Recipe Book — 80+ Recipes Under 5g Net Carbs | KetoJourney';
const PAGE_DESC  = 'Get our free keto recipe collection: 80+ beginner-friendly recipes with full macros, shopping lists, and meal prep tips. Completely free — sent to your inbox instantly.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC}/>
  <meta property="og:title"       content={PAGE_TITLE}/>
  <meta property="og:description" content={PAGE_DESC}/>
  <meta property="og:type"        content="website"/>
  <meta property="og:image"       content={`${SITE_URL}/images/free-book-cover.png`}/>
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-72.png"/>
  <meta name="theme-color" content="#FF5C7A"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
    html { scroll-behavior:smooth; }
    a { color:inherit; text-decoration:none; }
    img { display:block; max-width:100%; }
    :root {
      --bg:#FAF6F1; --bg-alt:#F2EDE5; --ink:#16110F; --ink-soft:#4A4340;
      --muted:#8A8077; --line:#E5DED2; --accent:#FF5C7A; --accent-2:#B6FF3C;
      --card:#FFFFFF;
      --display:'Bricolage Grotesque',system-ui,sans-serif;
      --serif:'Instrument Serif',serif;
      --body:'Geist',system-ui,sans-serif;
    }
    body { font-family:var(--body); background:var(--bg); color:var(--ink); overflow-x:hidden; }

    /* NAV */
    .nav { position:sticky; top:0; z-index:100; background:rgba(250,246,241,.94); backdrop-filter:blur(14px); border-bottom:1px solid var(--line); padding:16px 32px; display:flex; align-items:center; justify-content:space-between; }
    .nav-logo { display:flex; align-items:center; gap:10px; }
    .nav-logo-mark { width:34px; height:34px; background:var(--ink); border-radius:8px; display:flex; align-items:center; justify-content:center; font-family:var(--display); font-weight:800; font-size:.9rem; color:var(--accent-2); }
    .nav-logo-text { font-family:var(--display); font-weight:800; font-size:1rem; }
    .nav-links { display:flex; align-items:center; gap:8px; }
    .nav-link { font-size:.85rem; font-weight:500; color:var(--ink-soft); padding:6px 12px; border-radius:8px; transition:all .15s; }
    .nav-link:hover { color:var(--ink); background:var(--bg-alt); }
    .nav-cta { background:var(--accent); color:#fff; padding:8px 18px; border-radius:999px; font-size:.85rem; font-weight:700; font-family:var(--display); transition:opacity .15s; }
    .nav-cta:hover { opacity:.88; }
    @media(max-width:640px){ .nav-links{display:none;} .nav{padding:14px 18px;} }

    /* ── HERO ── */
    .hero { max-width:1100px; margin:0 auto; padding:72px 32px 64px; display:grid; grid-template-columns:1fr 420px; gap:64px; align-items:center; }
    @media(max-width:960px){ .hero{grid-template-columns:1fr; gap:40px; padding:48px 20px 40px;} }

    .hero-badge { display:inline-flex; align-items:center; gap:7px; background:rgba(255,92,122,.08); border:1px solid rgba(255,92,122,.22); border-radius:999px; padding:6px 14px; font-size:.76rem; font-weight:700; color:var(--accent); text-transform:uppercase; letter-spacing:.1em; margin-bottom:22px; }
    .hero-title { font-family:var(--display); font-size:clamp(2.1rem,5vw,3.4rem); font-weight:800; line-height:1.1; color:var(--ink); margin-bottom:18px; }
    .hero-title em { font-family:var(--serif); font-style:italic; color:var(--accent); }
    .hero-sub { font-size:1.05rem; color:var(--ink-soft); line-height:1.75; margin-bottom:36px; max-width:520px; }

    /* FORM CARD */
    .form-card { background:var(--card); border:1px solid var(--line); border-radius:20px; padding:28px; box-shadow:0 4px 28px rgba(22,17,15,.07); margin-bottom:20px; }
    .form-card-label { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.12em; color:var(--muted); margin-bottom:16px; }
    .form-fields { display:flex; flex-direction:column; gap:12px; margin-bottom:14px; }
    .field-wrap { display:flex; flex-direction:column; gap:5px; }
    .field-label { font-size:.8rem; font-weight:600; color:var(--ink-soft); }
    .field-input { padding:13px 15px; background:var(--bg-alt); border:1.5px solid var(--line); border-radius:12px; color:var(--ink); font-size:.95rem; font-family:var(--body); outline:none; transition:border-color .2s; }
    .field-input:focus { border-color:var(--accent); background:var(--card); }
    .field-input::placeholder { color:var(--muted); }
    .form-submit { width:100%; padding:15px 24px; background:var(--accent); border:none; border-radius:12px; color:#fff; font-size:1rem; font-weight:800; font-family:var(--display); cursor:pointer; transition:opacity .2s, transform .15s; }
    .form-submit:hover { opacity:.88; transform:translateY(-1px); }
    .form-submit:disabled { opacity:.6; cursor:not-allowed; transform:none; }
    .form-note { font-size:.74rem; color:var(--muted); text-align:center; margin-top:10px; }
    .form-msg { margin-top:12px; padding:11px 14px; border-radius:10px; font-size:.85rem; font-weight:600; display:none; }
    .form-msg.success { display:block; background:rgba(255,92,122,.07); border:1px solid rgba(255,92,122,.2); color:#C7303F; }
    .form-msg.error   { display:block; background:rgba(239,68,68,.06); border:1px solid rgba(239,68,68,.18); color:#dc2626; }

    .trust-row { display:flex; gap:18px; flex-wrap:wrap; }
    .trust-item { display:flex; align-items:center; gap:6px; font-size:.82rem; color:var(--muted); }
    .trust-item::before { content:'✓'; color:var(--accent); font-weight:800; font-size:.78rem; }

    /* BOOK COVER SLOT */
    .hero-visual { position:relative; display:flex; justify-content:center; }
    .book-cover-wrap { position:relative; width:100%; max-width:380px; }
    /* IMAGE SLOT: /public/images/free-book-cover.png — book cover mockup · 760×988 px (2× for retina) */
    .book-cover-img { width:100%; border-radius:20px; box-shadow:0 32px 72px rgba(22,17,15,.18), 0 8px 20px rgba(22,17,15,.1); }
    .book-cover-ph { width:100%; aspect-ratio:3/4; background:linear-gradient(145deg,var(--ink) 0%,#2D1F1A 100%); border-radius:20px; box-shadow:0 32px 72px rgba(22,17,15,.18); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:16px; color:#fff; padding:32px; text-align:center; }
    .book-cover-ph-icon { font-size:3.5rem; }
    .book-cover-ph-title { font-family:var(--display); font-size:1.3rem; font-weight:800; line-height:1.25; }
    .book-cover-ph-sub { font-size:.82rem; color:rgba(255,255,255,.55); }
    .book-badge { position:absolute; top:-14px; right:-14px; width:76px; height:76px; background:var(--accent-2); border-radius:50%; display:flex; flex-direction:column; align-items:center; justify-content:center; box-shadow:0 4px 16px rgba(182,255,60,.3); }
    .book-badge-top { font-size:.55rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--ink); }
    .book-badge-num { font-family:var(--display); font-size:1.4rem; font-weight:800; color:var(--ink); line-height:1; }
    .book-badge-bot { font-size:.55rem; font-weight:700; text-transform:uppercase; letter-spacing:.08em; color:var(--ink); }
    @media(max-width:960px){ .hero-visual{display:none;} }

    /* PROOF BAR */
    .proof-bar { background:var(--ink); }
    .proof-bar-inner { max-width:1100px; margin:0 auto; padding:28px 32px; display:grid; grid-template-columns:repeat(4,1fr); gap:0; }
    .proof-stat { text-align:center; padding:0 16px; border-right:1px solid rgba(255,255,255,.1); }
    .proof-stat:last-child { border-right:none; }
    .proof-num { font-family:var(--display); font-size:1.8rem; font-weight:800; color:var(--accent-2); line-height:1; margin-bottom:4px; }
    .proof-label { font-size:.78rem; color:rgba(255,255,255,.5); text-transform:uppercase; letter-spacing:.06em; }
    @media(max-width:640px){ .proof-bar-inner{grid-template-columns:repeat(2,1fr); gap:20px; padding:28px 20px;} .proof-stat{border-right:none;} }

    /* CATEGORIES */
    .cats-section { max-width:1100px; margin:0 auto; padding:80px 32px 64px; }
    .section-eyebrow { font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.16em; color:var(--accent); margin-bottom:12px; text-align:center; }
    .section-title { font-family:var(--display); font-size:clamp(1.6rem,3.5vw,2.4rem); font-weight:800; color:var(--ink); text-align:center; margin-bottom:48px; line-height:1.2; }
    .section-title em { font-family:var(--serif); font-style:italic; }
    .cats-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:16px; }
    @media(max-width:900px){ .cats-grid{grid-template-columns:repeat(3,1fr);} }
    @media(max-width:560px){ .cats-grid{grid-template-columns:repeat(2,1fr);} }
    .cat-card { background:var(--card); border:1px solid var(--line); border-radius:18px; overflow:hidden; transition:transform .2s, box-shadow .2s; cursor:default; }
    .cat-card:hover { transform:translateY(-3px); box-shadow:0 12px 32px rgba(22,17,15,.08); }
    /* IMAGE SLOTS: /public/images/free-book-cat-{name}.jpg — category cover · 320×200 px each */
    /* Names: free-book-cat-breakfast.jpg, free-book-cat-lunch.jpg, free-book-cat-dinner.jpg, free-book-cat-snacks.jpg, free-book-cat-desserts.jpg */
    .cat-img { width:100%; aspect-ratio:16/10; object-fit:cover; }
    .cat-img-ph { width:100%; aspect-ratio:16/10; display:flex; align-items:center; justify-content:center; font-size:2.4rem; }
    .cat-body { padding:14px 14px 16px; }
    .cat-name { font-family:var(--display); font-size:.96rem; font-weight:800; color:var(--ink); margin-bottom:2px; }
    .cat-count { font-size:.75rem; font-weight:600; color:var(--accent); margin-bottom:5px; }
    .cat-examples { font-size:.74rem; color:var(--muted); line-height:1.5; }

    /* FEATURED RECIPES */
    .featured-section { background:var(--bg-alt); border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:80px 32px; }
    .featured-inner { max-width:1100px; margin:0 auto; }
    .featured-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
    @media(max-width:900px){ .featured-grid{grid-template-columns:repeat(2,1fr);} }
    @media(max-width:480px){ .featured-grid{grid-template-columns:1fr;} }
    .feat-card { background:var(--card); border:1px solid var(--line); border-radius:18px; overflow:hidden; transition:transform .2s, box-shadow .2s; }
    .feat-card:hover { transform:translateY(-3px); box-shadow:0 12px 32px rgba(22,17,15,.08); }
    /* IMAGE SLOTS: /public/images/free-book-feat-{n}.jpg — featured recipe photo · 480×320 px each */
    /* Names: free-book-feat-1.jpg (Bacon & Egg Cups), free-book-feat-2.jpg (Garlic Butter Chicken), free-book-feat-3.jpg (Cheesecake Bites), free-book-feat-4.jpg (Zucchini Pesto) */
    .feat-img { width:100%; aspect-ratio:3/2; object-fit:cover; }
    .feat-img-ph { width:100%; aspect-ratio:3/2; display:flex; align-items:center; justify-content:center; font-size:2.8rem; }
    .feat-body { padding:16px; }
    .feat-name { font-family:var(--display); font-size:.96rem; font-weight:700; color:var(--ink); margin-bottom:5px; line-height:1.3; }
    .feat-macros { font-size:.76rem; color:var(--muted); margin-bottom:6px; }
    .feat-tag { display:inline-block; padding:3px 10px; background:rgba(255,92,122,.07); border:1px solid rgba(255,92,122,.18); border-radius:999px; font-size:.72rem; font-weight:700; color:var(--accent); }

    /* WHAT'S INCLUDED */
    .included-section { max-width:900px; margin:0 auto; padding:80px 32px; }
    .included-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-top:48px; }
    @media(max-width:700px){ .included-grid{grid-template-columns:1fr 1fr;} }
    @media(max-width:440px){ .included-grid{grid-template-columns:1fr;} }
    .inc-card { background:var(--card); border:1px solid var(--line); border-radius:18px; padding:24px 20px; }
    .inc-icon { font-size:1.8rem; margin-bottom:12px; }
    .inc-title { font-family:var(--display); font-size:.96rem; font-weight:700; color:var(--ink); margin-bottom:6px; }
    .inc-desc { font-size:.82rem; color:var(--muted); line-height:1.6; }

    /* TESTIMONIALS */
    .testi-section { background:var(--bg-alt); border-top:1px solid var(--line); border-bottom:1px solid var(--line); padding:80px 32px; }
    .testi-inner { max-width:1000px; margin:0 auto; }
    .testi-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:48px; }
    @media(max-width:700px){ .testi-grid{grid-template-columns:1fr;} }
    .testi-card { background:var(--card); border:1px solid var(--line); border-radius:18px; padding:26px 22px; }
    .testi-stars { color:var(--accent); font-size:.9rem; margin-bottom:12px; letter-spacing:2px; }
    .testi-text { font-size:.9rem; color:var(--ink-soft); line-height:1.7; margin-bottom:16px; font-style:italic; }
    .testi-author { display:flex; align-items:center; gap:10px; }
    .testi-avatar { width:36px; height:36px; border-radius:50%; background:var(--bg-alt); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0; }
    .testi-name { font-family:var(--display); font-size:.86rem; font-weight:700; color:var(--ink); }
    .testi-detail { font-size:.74rem; color:var(--muted); }

    /* SECOND CTA */
    .second-cta { max-width:700px; margin:0 auto; padding:80px 32px; text-align:center; }
    .second-cta h2 { font-family:var(--display); font-size:clamp(1.6rem,3vw,2.2rem); font-weight:800; color:var(--ink); margin-bottom:12px; line-height:1.2; }
    .second-cta p { font-size:.96rem; color:var(--ink-soft); line-height:1.7; margin-bottom:32px; }
    .second-form-card { background:var(--card); border:1px solid var(--line); border-radius:20px; padding:28px; box-shadow:0 4px 28px rgba(22,17,15,.07); text-align:left; }

    /* BOTTOM TRIAL CTA */
    .bottom-cta-wrap { max-width:1000px; margin:0 auto; padding:0 32px 80px; }
    .bottom-cta { background:var(--ink); border-radius:24px; padding:48px 44px; display:flex; align-items:center; justify-content:space-between; gap:28px; }
    .bottom-cta-text h2 { font-family:var(--display); font-size:1.6rem; font-weight:800; color:#fff; margin-bottom:10px; line-height:1.25; }
    .bottom-cta-text p { font-size:.88rem; color:rgba(255,255,255,.55); line-height:1.7; max-width:380px; }
    .bottom-cta-btn { display:inline-block; padding:15px 30px; background:var(--accent); color:#fff; font-family:var(--display); font-weight:800; font-size:.92rem; border-radius:999px; white-space:nowrap; transition:opacity .15s; flex-shrink:0; }
    .bottom-cta-btn:hover { opacity:.88; }
    @media(max-width:680px){ .bottom-cta{flex-direction:column;padding:32px 24px;} .bottom-cta-text p{max-width:none;} }

    /* FOOTER */
    .footer { border-top:1px solid var(--line); padding:24px 32px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
    .footer-copy { font-size:.8rem; color:var(--muted); }
    .footer-links { display:flex; gap:20px; }
    .footer-links a { font-size:.8rem; color:var(--muted); transition:color .15s; }
    .footer-links a:hover { color:var(--ink); }

    /* placeholder bg when image is missing */
    .cat-img-ph  { background:var(--bg-alt); }
    .feat-img-ph { background:var(--bg-alt); }
  </style>
</head>
<body>

<nav class="nav">
  <a href="/" class="nav-logo">
    <div class="nav-logo-mark">K</div>
    <span class="nav-logo-text">KetoJourney</span>
  </a>
  <div class="nav-links">
    <a href="/" class="nav-link">Home</a>
    <a href="/blog" class="nav-link">Blog</a>
    <a href="/recipes" class="nav-link">Recipes</a>
  </div>
  <a href="/start" class="nav-cta">Start Free Trial</a>
</nav>

<!-- ── HERO ── -->
<section class="hero" id="get-book">
  <div class="hero-left">
    <div class="hero-badge">📖 Free Recipe Book</div>
    <h1 class="hero-title">80+ Keto Recipes,<br/><em>Completely Free</em></h1>
    <p class="hero-sub">Breakfasts, lunches, dinners, snacks, and desserts — every recipe under 5g net carbs, with full macros, shopping lists, and step-by-step guides. Sent straight to your inbox.</p>

    <div class="form-card">
      <p class="form-card-label">Get your free copy →</p>
      <div class="form-fields">
        <div class="field-wrap">
          <label class="field-label" for="nameInput">First Name</label>
          <input class="field-input" type="text" id="nameInput" placeholder="Your first name" autocomplete="given-name"/>
        </div>
        <div class="field-wrap">
          <label class="field-label" for="emailInput">Email Address</label>
          <input class="field-input" type="email" id="emailInput" placeholder="your@email.com" autocomplete="email"/>
        </div>
      </div>
      <button class="form-submit" id="submitBtn" type="button">Send Me the Recipes →</button>
      <p class="form-note">🔒 No spam, ever. Unsubscribe anytime.</p>
      <div class="form-msg" id="formMsg"></div>
    </div>

    <div class="trust-row">
      <span class="trust-item">Sent to your inbox</span>
      <span class="trust-item">80+ recipes</span>
      <span class="trust-item">No credit card</span>
    </div>
  </div>

  <!-- IMAGE SLOT: /public/images/free-book-cover.png
       Size: 760×988 px (displayed at 380×494 px, 2× for retina)
       Content: book cover / mockup showing the recipe book -->
  <div class="hero-visual">
    <div class="book-cover-wrap">
      <img
        src="/images/free-book-cover.png"
        alt="KetoJourney Free Recipe Book — 80+ Keto Recipes"
        class="book-cover-img"
        loading="eager"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
      />
      <div class="book-cover-ph" style="display:none;">
        <div class="book-cover-ph-icon">📖</div>
        <div class="book-cover-ph-title">Free Keto Recipe Book</div>
        <div class="book-cover-ph-sub">80+ recipes · Full macros · Free</div>
      </div>
      <div class="book-badge">
        <span class="book-badge-top">80+</span>
        <span class="book-badge-num">Free</span>
        <span class="book-badge-bot">Recipes</span>
      </div>
    </div>
  </div>
</section>

<!-- ── PROOF BAR ── -->
<div class="proof-bar">
  <div class="proof-bar-inner">
    <div class="proof-stat">
      <div class="proof-num">12k+</div>
      <div class="proof-label">Subscribers</div>
    </div>
    <div class="proof-stat">
      <div class="proof-num">80+</div>
      <div class="proof-label">Recipes</div>
    </div>
    <div class="proof-stat">
      <div class="proof-num">5</div>
      <div class="proof-label">Categories</div>
    </div>
    <div class="proof-stat">
      <div class="proof-num">4.9 ★</div>
      <div class="proof-label">Average Rating</div>
    </div>
  </div>
</div>

<!-- ── CATEGORIES ── -->
<section class="cats-section">
  <p class="section-eyebrow">Inside the free book</p>
  <h2 class="section-title">Every Meal,<br/><em>Every Day</em> — Covered</h2>
  <div class="cats-grid">

    <!-- IMAGE SLOT: /public/images/free-book-cat-breakfast.jpg · 320×200 px -->
    <div class="cat-card">
      <img src="/images/free-book-cat-breakfast.jpg" alt="Keto Breakfast Recipes" class="cat-img"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" loading="lazy"/>
      <div class="cat-img-ph" style="display:none;">🥚</div>
      <div class="cat-body">
        <div class="cat-name">Breakfast</div>
        <div class="cat-count">18 recipes</div>
        <div class="cat-examples">Egg cups · Pancakes · Smoothies</div>
      </div>
    </div>

    <!-- IMAGE SLOT: /public/images/free-book-cat-lunch.jpg · 320×200 px -->
    <div class="cat-card">
      <img src="/images/free-book-cat-lunch.jpg" alt="Keto Lunch Recipes" class="cat-img"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" loading="lazy"/>
      <div class="cat-img-ph" style="display:none;">🥗</div>
      <div class="cat-body">
        <div class="cat-name">Lunch</div>
        <div class="cat-count">16 recipes</div>
        <div class="cat-examples">Wraps · Salads · Soups</div>
      </div>
    </div>

    <!-- IMAGE SLOT: /public/images/free-book-cat-dinner.jpg · 320×200 px -->
    <div class="cat-card">
      <img src="/images/free-book-cat-dinner.jpg" alt="Keto Dinner Recipes" class="cat-img"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" loading="lazy"/>
      <div class="cat-img-ph" style="display:none;">🍗</div>
      <div class="cat-body">
        <div class="cat-name">Dinner</div>
        <div class="cat-count">22 recipes</div>
        <div class="cat-examples">Chicken · Beef · Seafood</div>
      </div>
    </div>

    <!-- IMAGE SLOT: /public/images/free-book-cat-snacks.jpg · 320×200 px -->
