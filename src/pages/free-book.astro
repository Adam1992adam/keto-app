  <script is:inline>
    (function () {
      /* ---- Sticky bar scroll toggle ---- */
      var stickyBar = document.getElementById('stickyBar');
      var ticking = false;
      window.addEventListener('scroll', function () {
        if (!ticking) {
          requestAnimationFrame(function () {
            if (window.scrollY > 720) {
              stickyBar.classList.add('visible');
            } else {
              stickyBar.classList.remove('visible');
            }
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      /* ---- FAQ accordion ---- */
      var faqList = document.getElementById('faqList');
      if (faqList) {
        faqList.addEventListener('click', function (e) {
          var item = e.target.closest('.fq-item');
          if (!item) return;
          var isOpen = item.classList.contains('open');
          faqList.querySelectorAll('.fq-item').forEach(function (el) { el.classList.remove('open'); });
          if (!isOpen) item.classList.add('open');
        });
      }

      /* ---- Form submission ---- */
      var submittedEmail = '';

      async function submitLead(name, email) {
        try {
          localStorage.setItem('kj_firstName', name);
          localStorage.setItem('kj_email', email);
        } catch(e) {}
        try {
          var res = await fetch('/api/leads/collect', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: name, email: email })
          });
          var dest = '/free-book-success?name=' + encodeURIComponent(name) + '&email=' + encodeURIComponent(email);
          window.location.href = dest;
        } catch (err) {
          window.location.href = '/free-book-success';
        }
      }

      function showHeroSuccess(name, email) {
        var formWrap = document.getElementById('heroFormWrap');
        var sent = document.getElementById('heroSent');
        var sentName = document.getElementById('heroSentName');
        var sentEmail = document.getElementById('heroSentEmail');
        if (formWrap) formWrap.style.display = 'none';
        if (sent) sent.classList.add('visible');
        if (sentName) sentName.textContent = 'On its way to your inbox, ' + name + '.';
        if (sentEmail) sentEmail.textContent = email;
      }

      function showStickySuccess(email) {
        var formWrap = document.getElementById('stFormWrap');
        var sent = document.getElementById('stSent');
        var sentEmail = document.getElementById('stSentEmail');
        if (formWrap) formWrap.style.display = 'none';
        if (sent) sent.classList.add('visible');
        if (sentEmail) sentEmail.textContent = email;
      }

      /* Hero form */
      var heroForm = document.getElementById('heroForm');
      if (heroForm) {
        heroForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          var name = document.getElementById('heroName').value.trim();
          var email = document.getElementById('heroEmail').value.trim();
          if (!name || !email) return;
          submittedEmail = email;
          showHeroSuccess(name, email);
          showStickySuccess(email);
          await submitLead(name, email);
        });
      }

      /* Sticky form */
      var stickyForm = document.getElementById('stickyForm');
      if (stickyForm) {
        stickyForm.addEventListener('submit', async function (e) {
          e.preventDefault();
          var name = document.getElementById('stName').value.trim();
          var email = document.getElementById('stEmail').value.trim();
          if (!name || !email) return;
          submittedEmail = email;
          showHeroSuccess(name, email);
          showStickySuccess(email);
          await submitLead(name, email);
        });
      }
    })();
  </script>
</body>
</html>
