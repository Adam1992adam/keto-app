---
export const prerender = true;
const SITE_URL  = (import.meta.env.PUBLIC_APP_URL || 'https://ketojourney.fun').replace(/\/$/, '');
const PAGE_TITLE = 'Free Keto Smoothies & Snacks Book — 50+ Recipes Under 6g Net Carbs | Keto Journey';
const PAGE_DESC  = 'Get our free keto smoothie & snack recipe book: 52 delicious recipes with full macros, prep tips, and ingredient swaps. Completely free — sent to your inbox instantly.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{PAGE_TITLE}</title>
  <meta name="description" content={PAGE_DESC}/>
  <meta property="og:title" content={PAGE_TITLE}/>
  <meta property="og:description" content={PAGE_DESC}/>
  <meta property="og:type" content="website"/>
  <meta property="og:image" content={`${SITE_URL}/images/free-book-cover.jpg`}/>
  <link rel="icon" type="image/png" sizes="32x32" href="/icon-72.png"/>
  <meta name="theme-color" content="#FF5C7A"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg: #FAF6F1; --bg-alt: #F2EDE5; --ink: #16110F; --ink-soft: #4A4340;
      --muted: #8A8077; --line: #E5DED2;
      --accent: #FF5C7A; --accent-2: #B6FF3C; --accent-3: #FF914D; --card: #FFFFFF;
      --display: 'Bricolage Grotesque', system-ui, sans-serif;
      --serif: 'Instrument Serif', serif;
      --body: 'Geist', system-ui, sans-serif;
      --mono: 'Geist Mono', monospace;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    html, body { background: var(--bg); color: var(--ink); font-family: var(--body); -webkit-font-smoothing: antialiased; }
    body { overflow-x: hidden; padding-bottom: 88px; }
    a { color: inherit; text-decoration: none; }
    button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
    img { display: block; max-width: 100%; }
    ::selection { background: var(--accent); color: #fff; }
    input { font-family: inherit; }

    /* ============================================================
       BOOK COVER (image-based, 3D tilt)
       ============================================================ */
    @keyframes bcfloat {
      0%, 100% { translate: 0 0; }
      50%       { translate: 0 -14px; }
    }
    .bc-img-wrap {
      perspective: 1600px;
      display: inline-block;
      position: relative;
    }
    .bc-img-inner {
      position: relative;
      transform: rotateY(-22deg) rotateX(4deg);
      filter: drop-shadow(0 40px 60px rgba(22,17,15,.42));
    }
    .bc-img-wrap.floating .bc-img-inner {
      animation: bcfloat 6s ease-in-out infinite;
    }
    .bc-img-inner img {
      display: block;
      width: 300px;
      height: auto;
      border-radius: 3px 10px 10px 3px;
      position: relative;
      z-index: 2;
    }
    .bc-img-pages {
      position: absolute;
      top: 2px; bottom: 2px; right: -12px;
      width: 12px;
      background: repeating-linear-gradient(
        to right,
        #f0ebe4 0px, #f0ebe4 1px,
        #e8e1d6 1px, #e8e1d6 2px
      );
      border-radius: 0 2px 2px 0;
      z-index: 1;
    }

    /* ============================================================
       HERO
       ============================================================ */
    .he {
      position: relative;
      min-height: 100vh;
      background: var(--bg);
      overflow: hidden;
      padding: 28px 32px 56px;
    }
    .he-bg-grain {
      position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(circle at 12% 18%, color-mix(in oklab, var(--accent) 18%, transparent), transparent 35%),
        radial-gradient(circle at 88% 82%, color-mix(in oklab, var(--accent-3) 14%, transparent), transparent 40%);
    }
    .he-nav {
      position: relative; z-index: 5;
      max-width: 1360px; margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
      padding-bottom: 24px;
    }
    .he-logo { display: flex; align-items: center; gap: 10px; }
    .he-logo .mark {
      width: 32px; height: 32px; border-radius: 9px;
      background: var(--ink); color: var(--accent-2);
      display: grid; place-items: center; font-weight: 800; font-size: 14px;
    }
    .he-logo .name { font-family: var(--display); font-weight: 700; font-size: 15px; letter-spacing: -0.01em; }
    .he-nav-r { display: flex; gap: 18px; align-items: center; font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-soft); }
    .he-nav-r a:hover { color: var(--ink); }
    .he-nav-r .login { background: var(--ink); color: var(--bg); padding: 9px 14px; border-radius: 999px; font-weight: 600; }
    .he-nav-r .login:hover { background: var(--accent); }

    .he-inner {
      position: relative; z-index: 2;
      max-width: 1360px; margin: 0 auto;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 64px; align-items: center;
      padding: 24px 0 36px;
    }
    .he-eyebrow {
      font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--accent);
      display: inline-flex; align-items: center; gap: 10px;
      margin-bottom: 18px;
    }
    .he-eyebrow .pip { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 22%, transparent); }
    .he-eyebrow .pill { font-family: var(--mono); background: var(--accent); color: #fff; padding: 4px 9px; border-radius: 4px; font-weight: 700; letter-spacing: 0.14em; }

    .he-h {
      font-family: var(--display);
      font-size: clamp(54px, 7vw, 104px);
      line-height: 0.9; letter-spacing: -0.05em; font-weight: 600;
      max-width: 14ch; text-wrap: balance; margin-bottom: 18px;
    }
    .he-h em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
    .he-h s { text-decoration: none; color: var(--muted); position: relative; }
    .he-h s::after {
      content: ''; position: absolute; left: -2%; right: -2%; top: 54%;
      height: 8px; background: var(--accent-2); z-index: -1;
      transform: rotate(-1.5deg);
    }

    .he-sub {
      font-family: var(--serif); font-style: italic;
      font-size: clamp(18px, 1.6vw, 22px);
      color: var(--ink-soft); max-width: 50ch; line-height: 1.45;
      margin-bottom: 28px; text-wrap: pretty;
    }
    .he-sub b { font-family: var(--body); font-style: normal; font-weight: 600; color: var(--ink); }

    .he-strip {
      display: grid; grid-template-columns: repeat(4, 1fr);
      margin-bottom: 28px;
      border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
      padding: 14px 0;
    }
    .he-strip-c { padding: 0 14px; border-right: 1px solid var(--line); }
    .he-strip-c:first-child { padding-left: 0; }
    .he-strip-c:last-child { border-right: none; padding-right: 0; }
    .he-strip .v { font-family: var(--display); font-size: 28px; font-weight: 600; letter-spacing: -0.035em; line-height: 1; }
    .he-strip .v em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); font-size: 13px; margin-left: 2px; }
    .he-strip .l { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-top: 6px; }

    .he-form {
      display: grid; grid-template-columns: 0.9fr 1fr auto;
      gap: 8px; padding: 8px;
      background: var(--card); border: 1px solid var(--line); border-radius: 22px;
      box-shadow: 0 12px 36px -16px color-mix(in oklab, var(--ink) 28%, transparent);
      max-width: 620px;
    }
    .he-form input {
      background: var(--bg-alt); border: none; outline: none;
      padding: 14px 16px; border-radius: 14px;
      font-size: 14.5px; color: var(--ink); min-width: 0;
    }
    .he-form input:focus { background: var(--bg); outline: 2px solid var(--accent); outline-offset: -1px; }
    .he-form input::placeholder { color: var(--muted); }
    .he-form button {
      background: var(--ink); color: var(--bg);
      padding: 14px 22px; border-radius: 14px;
      font-size: 14px; font-weight: 600; letter-spacing: -0.005em;
      display: inline-flex; align-items: center; gap: 8px;
      transition: background .15s, transform .15s; white-space: nowrap;
    }
    .he-form button:hover { background: var(--accent); transform: translateY(-1px); }
    .he-form button .arr { transition: transform .2s; }
    .he-form button:hover .arr { transform: translateX(3px); }

    .he-trust {
      display: flex; align-items: center; gap: 14px; margin-top: 14px;
      font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted);
      flex-wrap: wrap;
    }
    .he-trust .check { color: var(--accent); }
    .he-trust .sep { opacity: 0.4; }
    .he-trust .avatars { display: flex; }
    .he-trust .avatars span {
      width: 24px; height: 24px; border-radius: 50%; margin-left: -7px;
      border: 2px solid var(--bg); display: inline-grid;
      background: linear-gradient(135deg, var(--accent), var(--accent-3));
    }
    .he-trust .avatars span:nth-child(2) { background: linear-gradient(135deg, var(--accent-2), var(--accent-3)); }
    .he-trust .avatars span:nth-child(3) { background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
    .he-trust .avatars span:first-child { margin-left: 0; }

    .he-sent {
      background: var(--ink); color: var(--bg);
      border-radius: 22px; padding: 24px 26px; max-width: 620px; display: none;
    }
    .he-sent.visible { display: block; }
    .he-sent .ck { width: 38px; height: 38px; border-radius: 50%; background: var(--accent-2); color: var(--ink); display: grid; place-items: center; font-size: 18px; margin-bottom: 14px; }
    .he-sent .ti { font-family: var(--display); font-size: 22px; font-weight: 600; letter-spacing: -0.025em; margin-bottom: 6px; }
    .he-sent .bo { font-family: var(--serif); font-style: italic; font-size: 15px; color: color-mix(in oklab, var(--bg) 78%, transparent); line-height: 1.5; }
    .he-sent .bo b { font-family: var(--body); font-style: normal; color: var(--accent-2); font-weight: 600; }

    .he-stage {
      position: relative; display: grid; place-items: center; min-height: 540px;
    }
    .he-stage .platter {
      position: absolute; inset: 0;
      background:
        radial-gradient(circle at 50% 60%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 55%),
        radial-gradient(circle at 30% 30%, color-mix(in oklab, var(--accent-2) 18%, transparent), transparent 45%);
    }
    .he-prop {
      position: absolute; background: var(--card); border: 1px solid var(--line); border-radius: 16px;
      padding: 12px 14px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft);
      box-shadow: 0 12px 28px -10px color-mix(in oklab, var(--ink) 28%, transparent);
      display: flex; flex-direction: column; gap: 4px; z-index: 10;
      animation: hefloat 5s ease-in-out infinite;
    }
    @keyframes hefloat {
      0%, 100% { translate: 0 0; }
      50%       { translate: 0 -8px; }
    }
    .he-prop .v { font-family: var(--display); font-size: 17px; font-weight: 600; letter-spacing: -0.02em; color: var(--ink); }
    .he-prop .v em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); font-size: 11px; margin-left: 2px; }
    .he-prop .l { font-size: 9px; }
    .he-prop.p1 { top: 22%; left: -6%; animation-delay: 0s; }
    .he-prop.p2 { top: 12%; right: -2%; animation-delay: 1.2s; transform: rotate(3deg); }
    .he-prop.p3 { bottom: 18%; left: 4%; animation-delay: 2.4s; transform: rotate(-2deg); font-size: 22px; color: var(--accent); display: grid; place-items: center; padding: 18px; }
    .he-prop.p4 { bottom: 8%; right: -4%; animation-delay: 0.6s; transform: rotate(2deg); }

    @media (max-width: 1100px) {
      .he { padding: 22px 18px 36px; }
      .he-inner { grid-template-columns: 1fr; gap: 36px; padding: 18px 0 24px; }
      .he-form { grid-template-columns: 1fr; }
      .he-stage { min-height: 420px; }
      .he-prop.p1, .he-prop.p2, .he-prop.p3, .he-prop.p4 { display: none; }
      .he-strip { grid-template-columns: 1fr 1fr; }
      .he-strip-c { padding: 8px 14px; border-right: none; border-bottom: 1px solid var(--line); }
      .he-strip-c:last-child, .he-strip-c:nth-child(3) { border-bottom: none; }
    }

    /* ============================================================
       INSIDE (4-chapter grid)
       ============================================================ */
    .ins {
      max-width: 1360px; margin: 0 auto; padding: 96px 32px 56px;
    }
    .ins-head { margin-bottom: 32px; padding-bottom: 22px; border-bottom: 1px solid var(--line); display: flex; align-items: end; gap: 24px; }
    .ins-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; display: inline-flex; align-items: center; gap: 10px; }
    .ins-eyebrow .pip { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 22%, transparent); }
    .ins-head h2 {
      font-family: var(--display); font-size: clamp(38px, 4.8vw, 68px);
      line-height: 0.95; letter-spacing: -0.045em; font-weight: 600;
      max-width: 18ch; text-wrap: balance;
    }
    .ins-head h2 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
    .ins-head p { font-family: var(--serif); font-style: italic; font-size: 17px; color: var(--ink-soft); margin-left: auto; max-width: 36ch; text-align: right; line-height: 1.45; }

    .ins-grid {
      display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 14px;
    }
    .ins-ch {
      background: var(--card); border: 1px solid var(--line); border-radius: 22px;
      padding: 22px; display: flex; flex-direction: column; min-height: 360px;
      position: relative; overflow: hidden;
    }
    .ins-ch.hero-ch { background: var(--ink); color: var(--bg); }
    .ins-ch.lime-ch { border-color: color-mix(in oklab, var(--accent-2) 40%, var(--line)); }
    .ins-ch.orange-ch { border-color: color-mix(in oklab, var(--accent-3) 30%, var(--line)); }

    .ins-ch-n { font-family: var(--mono); font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
    .ins-ch.hero-ch .ins-ch-n { color: rgba(255,255,255,.42); }
    .ins-ch-t { font-family: var(--display); font-size: 24px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 6px; }
    .ins-ch-sub { font-family: var(--mono); font-size: 9px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px; }
    .ins-ch.hero-ch .ins-ch-sub { color: rgba(255,255,255,.38); }

    /* Chapter illustrations */
    .ins-jars { display: flex; gap: 10px; margin-top: auto; align-items: flex-end; }
    .ins-jar {
      width: 42px; flex-shrink: 0;
      border-radius: 6px 6px 10px 10px;
      position: relative; overflow: hidden;
    }
    .ins-jar::before {
      content: ''; position: absolute; top: 0; left: 2px; right: 2px; height: 4px;
      background: rgba(255,255,255,.3); border-radius: 3px;
    }
    .ins-jar-body { width: 100%; border-radius: 4px 4px 8px 8px; }

    .ins-bars { display: flex; gap: 7px; margin-top: auto; align-items: flex-end; height: 80px; }
    .ins-bar { flex: 1; border-radius: 4px 4px 0 0; min-width: 14px; }

    .ins-squares { display: flex; flex-wrap: wrap; gap: 5px; margin-top: auto; }
    .ins-sq { width: 16px; height: 16px; border-radius: 4px; }

    .ins-pellets { display: flex; gap: 8px; margin-top: auto; align-items: center; flex-wrap: wrap; }
    .ins-pellet { height: 12px; border-radius: 999px; }

    .ins-footer {
      grid-column: 1 / -1;
      background: var(--bg-alt); border: 1px solid var(--line); border-radius: 16px;
      padding: 16px 22px; margin-top: 4px;
      display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
    }
    .ins-footer .eq { font-family: var(--display); font-size: 18px; font-weight: 600; letter-spacing: -0.025em; }
    .ins-footer .eq em { font-family: var(--serif); font-style: italic; color: var(--accent); font-weight: 400; }
    .ins-footer .extras { margin-left: auto; display: flex; gap: 10px; }
    .ins-footer .tag { font-family: var(--mono); font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; background: var(--card); border: 1px solid var(--line); padding: 6px 10px; border-radius: 8px; color: var(--ink-soft); }

    @media (max-width: 1100px) {
      .ins { padding: 56px 18px 40px; }
      .ins-grid { grid-template-columns: 1fr 1fr; }
      .ins-head { flex-direction: column; align-items: start; gap: 16px; }
      .ins-head p { margin-left: 0; text-align: left; }
    }
    @media (max-width: 640px) {
      .ins-grid { grid-template-columns: 1fr; }
      .ins-ch { min-height: 220px; }
    }

    /* ============================================================
       PREVIEW (dark sample recipe page)
       ============================================================ */
    .pv {
      background: var(--ink); color: var(--bg);
      padding: 96px 32px;
    }
    .pv-inner { max-width: 1360px; margin: 0 auto; }
    .pv-head { display: flex; align-items: end; gap: 24px; margin-bottom: 36px; padding-bottom: 22px; border-bottom: 1px solid rgba(255,255,255,.1); }
    .pv-eyebrow { font-family: var(--mono); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; display: inline-flex; align-items: center; gap: 10px; }
    .pv-eyebrow .pip { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 22%, transparent); }
    .pv-head h2 {
      font-family: var(--display); font-size: clamp(38px, 4.8vw, 68px);
      line-height: 0.95; letter-spacing: -0.045em; font-weight: 600;
      max-width: 18ch; text-wrap: balance;
    }
    .pv-head h2 em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); }
    .pv-head .cta-link {
      margin-left: auto;
      background: var(--accent); color: #fff;
      padding: 14px 24px; border-radius: 999px;
      font-family: var(--display); font-weight: 600; font-size: 15px;
      white-space: nowrap; flex-shrink: 0;
      transition: opacity .15s;
    }
    .pv-head .cta-link:hover { opacity: .88; }

    .pv-spread {
      display: grid; grid-template-columns: 1fr 1fr; gap: 0;
      aspect-ratio: 1.65/1;
      border-radius: 18px; overflow: hidden;
      border: 1px solid rgba(255,255,255,.08);
      box-shadow: 0 40px 80px -20px rgba(0,0,0,.6);
    }
    .pv-page {
      padding: 36px; display: flex; flex-direction: column; gap: 0;
    }
    .pv-page-l { background: var(--bg); color: var(--ink); }
    .pv-page-r { background: var(--bg-alt); color: var(--ink); }

    .pv-cat { font-family: var(--mono); font-size: 8px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
    .pv-title { font-family: var(--display); font-size: clamp(22px, 2.5vw, 34px); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; margin-bottom: 18px; }
    .pv-stats { display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
    .pv-stat { display: flex; flex-direction: column; gap: 2px; }
    .pv-stat .sv { font-family: var(--display); font-size: 20px; font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
    .pv-stat .sv em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--accent); font-size: 10px; margin-left: 1px; }
    .pv-stat .sl { font-family: var(--mono); font-size: 8px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-top: 3px; }
    .pv-divider { border: none; border-top: 1px solid var(--line); margin: 16px 0; }
    .pv-ings-label { font-family: var(--mono); font-size: 8px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-bottom: 8px; }
    .pv-ings { list-style: none; display: flex; flex-direction: column; gap: 5px; }
    .pv-ings li { font-family: var(--serif); font-size: clamp(12px, 1.1vw, 15px); color: var(--ink-soft); display: flex; gap: 8px; align-items: baseline; }
    .pv-ings li b { font-family: var(--body); font-style: normal; font-weight: 600; color: var(--ink); white-space: nowrap; }

    /* Smoothie photo */
    .pv-glass-wrap { position: relative; flex: 1; overflow: hidden; margin: -36px -36px 0; min-height: 220px; }
    .pv-glass-wrap img { width: 100%; height: 100%; object-fit: cover; object-position: center center; display: block; }
    .pv-glass-wrap::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, var(--bg-alt) 0%, transparent 40%); }
    .pv-glass {
      position: relative; width: 60px; height: 110px;
      background: linear-gradient(180deg, rgba(255,92,122,.18) 0%, rgba(255,92,122,.06) 100%);
      border-radius: 4px 4px 12px 12px;
      border: 1.5px solid rgba(255,92,122,.3);
      overflow: visible;
    }
    .pv-foam {
      position: absolute; top: -6px; left: -4px; right: -4px; height: 16px;
      background: rgba(255,255,255,.92);
      border-radius: 8px;
    }
