<script is:inline>
(function () {
  function submitLead(nameId, emailId, btnId, msgId) {
    var nameEl  = document.getElementById(nameId);
    var emailEl = document.getElementById(emailId);
    var btn     = document.getElementById(btnId);
    var msg     = document.getElementById(msgId);
    if (!btn || !emailEl || !msg) return;

    btn.addEventListener('click', function () {
      var name  = nameEl ? nameEl.value.trim() : '';
      var email = emailEl.value.trim();

      if (!email || !email.includes('@')) {
        show(msg, 'Please enter a valid email address.', 'error'); return;
      }

      btn.disabled    = true;
      btn.textContent = 'Sending…';
      msg.className   = 'form-msg';

      fetch('/api/leads/collect', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name: name, email: email })
      })
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (res.ok) {
          window.location.href = '/free-book-success';
        } else {
          show(msg, res.d.error || 'Something went wrong. Please try again.', 'error');
          btn.disabled    = false;
          btn.textContent = 'Send Me the Recipes →';
        }
      })
      .catch(function () {
        show(msg, 'Network error. Please try again.', 'error');
        btn.disabled    = false;
        btn.textContent = 'Download Free Book →';
      });
    });

    if (emailEl) emailEl.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') btn.click();
    });
  }

  function show(el, text, type) {
    el.textContent = text;
    el.className   = 'form-msg ' + type;
  }

  submitLead('nameInput',  'emailInput',  'submitBtn',  'formMsg');
  submitLead('nameInput2', 'emailInput2', 'submitBtn2', 'formMsg2');
}());
</script>

