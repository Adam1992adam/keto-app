/* ── Select page ── */
function selectPage(el) {
  document.querySelectorAll('.ab-page-item').forEach(function(i) { i.classList.remove('active'); });
  el.classList.add('active');
  currentPage = el.getAttribute('data-page');
  currentPageName = el.getAttribute('data-name');
  document.getElementById('abPageLabel').innerHTML = 'Editing: <strong>' + currentPageName + '</strong>';
  loadPageIntoEditor(currentPage);
}

/* ── Init GrapeJS ── */
function initEditor(initialHtml) {
  if (editor) { editor.setComponents(initialHtml); return; }

  editor = grapesjs.init({
    container: '#gjs',
    fromElement: false,
    height: '100%',
    width: '100%',
    storageManager: { autoload: false, autosave: false },
    deviceManager: {
      devices: [
        { name: 'Desktop', width: '' },
        { name: 'Tablet',  width: '768px',  widthMedia: '992px' },
        { name: 'Mobile',  width: '320px',  widthMedia: '480px' },
      ]
    },
    plugins: ['gjs-preset-webpage'],
    pluginsOpts: {
      'gjs-preset-webpage': {
        blocks: ['column1','column2','column3','column3-7','text','link','image','video','map'],
        navbarOpts: false,
        countdownOpts: false,
        formsOpts: false,
      }
    },
    blockManager: { blocks: KETO_BLOCKS },
    styleManager: {
      sectors: [
        { name: 'Layout',      open: true,  buildProps: ['display','flex-direction','align-items','justify-content','gap','padding','margin','width','height','max-width'] },
        { name: 'Typography',  open: false, buildProps: ['font-family','font-size','font-weight','color','text-align','line-height','letter-spacing'] },
        { name: 'Background',  open: false, buildProps: ['background-color','background-image','background-size','background-position'] },
        { name: 'Border',      open: false, buildProps: ['border-radius','border','border-color','border-width','box-shadow'] },
      ]
    },
  });

  editor.setComponents(initialHtml);

  /* ── Keyboard shortcuts ── */
  editor.Keymaps.add('general:undo', 'ctrl+z, cmd+z', function() { editor.UndoManager.undo(); });
  editor.Keymaps.add('general:redo', 'ctrl+shift+z, cmd+shift+z', function() { editor.UndoManager.redo(); });

  /* ── Show toolbar ── */
  document.getElementById('abDeviceGrp').style.display = 'flex';
  document.getElementById('abUndoBtn').style.display   = 'flex';
  document.getElementById('abRedoBtn').style.display   = 'flex';
  document.getElementById('abSaveBtn').style.display   = 'inline-flex';
  document.getElementById('abPublishBtn').style.display = 'inline-flex';
  document.getElementById('abStatus').style.display    = 'inline';
}

/* ── Load page content from API ── */
function loadPageIntoEditor(page) {
  document.getElementById('abEmpty').style.display = 'none';
  document.getElementById('gjs').style.display = 'flex';

  setStatus('Loading…', '');

  fetch('/api/admin/page-config?page=' + page, { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var html = (d.config && d.config.gjs_html) ? d.config.gjs_html : (STARTERS[page] || '<p>Start building your page here.</p>');
      initEditor(html);
      setStatus('', '');
    })
    .catch(function() {
      initEditor(STARTERS[page] || '<p>Start building.</p>');
      setStatus('', '');
    });
}

/* ── Save page ── */
function savePage(publish) {
  if (!editor || !currentPage) return;
  setStatus('Saving…', '');

  var html = editor.getHtml();
  var css  = editor.getCss();

  fetch('/api/admin/page-config', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      page: currentPage,
      html: html,
      css: css,
      publish: publish,
    }),
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.success) {
      setStatus(publish ? '✓ Published' : '✓ Saved', 'saved');
      showToast(publish ? '✓ Page published live!' : '✓ Draft saved', 'ok');
      setTimeout(function() { setStatus('', ''); }, 3000);
    } else {
      setStatus('✗ Error', 'error');
      showToast('Error: ' + (d.error || 'Save failed'), 'err');
    }
  })
  .catch(function() {
    setStatus('✗ Error', 'error');
    showToast('Network error — please retry', 'err');
  });
}

/* ── Device switcher ── */
function setDevice(d) {
  if (!editor) return;
  var map = { desktop: 'Desktop', tablet: 'Tablet', mobile: 'Mobile' };
  editor.setDevice(map[d] || 'Desktop');
  document.querySelectorAll('.ab-device-btn').forEach(function(b) { b.classList.remove('on'); });
  document.getElementById('ab' + d.charAt(0).toUpperCase() + d.slice(1) + 'Btn').classList.add('on');
}

function editorUndo() { if (editor) editor.UndoManager.undo(); }
function editorRedo() { if (editor) editor.UndoManager.redo(); }

/* ── Helpers ── */
function setStatus(msg, cls) {
  var el = document.getElementById('abStatus');
  el.textContent = msg;
  el.className = 'ab-status' + (cls ? ' ' + cls : '');
}

function showToast(msg, type) {
  var t = document.createElement('div');
  t.className = 'ab-toast ' + (type || '');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function() { t.remove(); }, 3200);
}

/* ── Site settings ── */
document.getElementById('abSettingsOverlay').addEventListener('click', function(e) {
  if (e.target === this) this.classList.remove('open');
});

function loadSettings() {
  fetch('/api/admin/site-settings', { credentials: 'same-origin' })
    .then(function(r) { return r.json(); })
    .then(function(d) { renderSettings(d.settings || {}); })
    .catch(function() {});
}

function renderSettings(settings) {
  var CATS = { colors: 'Colors', typography: 'Typography', brand: 'Brand', email: 'Email Defaults', contact: 'Contact' };
  var grouped = {};
  Object.keys(settings).forEach(function(k) {
    var s = settings[k];
    var cat = s.category || 'other';
    if (!grouped[cat]) grouped[cat] = [];
    grouped[cat].push({ key: k, value: s.value || '', label: s.label || k });
  });

  var html = '';
  Object.keys(CATS).forEach(function(cat) {
    if (!grouped[cat]) return;
    html += '<div><div class="ab-settings-category">' + CATS[cat] + '</div><div class="ab-settings-grid">';
    grouped[cat].forEach(function(s) {
      var isColor = s.key.includes('color') || s.key.includes('_color');
      if (isColor) {
        html += '<div class="ab-settings-field">' +
          '<label class="ab-settings-label">' + s.label + '</label>' +
          '<div class="ab-color-wrap">' +
          '<div class="ab-color-swatch" style="background:' + (s.value || '#ccc') + ';" onclick="document.getElementById(\'cp_' + s.key.replace(/\./g,'_') + '\').click()"></div>' +
          '<input type="color" id="cp_' + s.key.replace(/\./g,'_') + '" value="' + (s.value || '#000000') + '" onchange="document.getElementById(\'sf_' + s.key.replace(/\./g,'_') + '\').value=this.value;this.previousElementSibling.style.background=this.value;" />' +
          '<input class="ab-settings-input" id="sf_' + s.key.replace(/\./g,'_') + '" data-key="' + s.key + '" value="' + (s.value || '') + '" style="flex:1;" />' +
          '</div></div>';
      } else {
        html += '<div class="ab-settings-field">' +
          '<label class="ab-settings-label">' + s.label + '</label>' +
          '<input class="ab-settings-input" data-key="' + s.key + '" value="' + (s.value || '') + '" />' +
          '</div>';
      }
    });
    html += '</div></div>';
  });
  html += '<button class="ab-settings-save" onclick="saveSettings()">Save All Settings</button>';

  document.getElementById('abSettingsBody').innerHTML = html;
}

function saveSettings() {
  var inputs = document.querySelectorAll('#abSettingsBody [data-key]');
  var updates = {};
  inputs.forEach(function(inp) { updates[inp.getAttribute('data-key')] = inp.value; });

  fetch('/api/admin/site-settings', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ settings: updates }),
  })
  .then(function(r) { return r.json(); })
  .then(function(d) {
    if (d.success) showToast('✓ Settings saved!', 'ok');
    else showToast('Error saving settings', 'err');
  })
  .catch(function() { showToast('Network error', 'err'); });
}

/* ── Boot ── */
loadSettings();
</script>
</body>
</html>
